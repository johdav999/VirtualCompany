{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "0.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Virtual Company",
    "websiteUrl": "https://invalid.local",
    "privacyUrl": "https://invalid.local/privacy",
    "termsOfUseUrl": "https://invalid.local/terms"
  },
  "name": {
    "short": "Alex Presenter",
    "full": "Alex Sales Meeting Presenter"
  },
  "description": {
    "short": "Present with Alex in Microsoft Teams.",
    "full": "Alex helps an authorized salesperson present Virtual Company sales material in a Microsoft Teams meeting."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#2563EB",
  "configurableTabs": [
    {
      "id": "alex-sales-meeting",
      "configurationUrl": "https://invalid.local/teams/meetings/configure",
      "canUpdateConfiguration": true,
      "scopes": [
        "groupChat"
      ],
      "meetingSurfaces": [
        "sidePanel",
        "stage"
      ],
      "context": [
        "meetingChatTab",
        "meetingDetailsTab",
        "meetingSidePanel",
        "meetingStage"
      ],
      "supportedPlatform": [
        "desktop",
        "mobile"
      ]
    }
  ],
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": [
        "personal",
        "groupChat"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "supportsCalling": false,
      "supportsVideo": false
    }
  ],
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "invalid.local"
  ],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://invalid.local/00000000-0000-0000-0000-000000000000"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MeetingStage.Write.Chat",
          "type": "Delegated"
        }
      ]
    }
  }
}
