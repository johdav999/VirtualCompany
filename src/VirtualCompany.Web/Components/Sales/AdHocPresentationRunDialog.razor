@using VirtualCompany.Web.Services
@inject SalesPresentationAdHocApiClient AdHoc
@inject SalesPresentationPresetApiClient Presets

<div class="adhoc-backdrop" @onclick="Close"><section class="adhoc-dialog" role="dialog" aria-modal="true" aria-labelledby="adhoc-title" @onclick:stopPropagation="true">
 <header><div><span class="vc-kicker">USE PRESET</span><h2 id="adhoc-title">Prepare ad-hoc presentation</h2><p>Prepare an isolated presentation run. No meeting or live presenter starts automatically.</p></div><button class="preset-icon-button" aria-label="Close ad-hoc presentation" @onclick="Close">×</button></header>
 @if(loading){<div class="adhoc-state" role="status">Loading preparation options…</div>}
 else if(run is not null){<div class="adhoc-result"><span class="run-status run-status--@run.PreparationStatus">@Status(run.PreparationStatus)</span><h3>@run.PresetName · published version @run.PresetVersionNumber</h3><p>@(run.ReadinessBlockers.Count==0?"Reusable content and selected customer evidence are prepared.":"Review the missing evidence before presenting.")</p><div class="adhoc-evidence">@foreach(var item in run.Artifacts){<article><strong>@Present(item.Type)</strong><p>@item.Content</p>@if(item.SourceReference is not null){<small>Source: @item.SourceReference</small>}</article>}</div>@if(!run.CanOpenPresenter){<div class="adhoc-warning"><strong>Preparation only</strong><p>Schedule or select an authorized meeting before opening a live presenter.</p></div>}<button class="sales-button sales-button--primary" @onclick="Close">Done</button></div>}
 else
 {
  <section class="adhoc-preset"><div><strong>@Preset.Name</strong><span>Published version @Version.VersionNumber · @Version.Asset?.SlideCount slides</span><p>@Preset.Description</p></div><span class="sales-badge sales-badge--published">Published</span></section>
  @if(slides.Count>0){<div class="adhoc-slides" aria-label="Preset preview">@foreach(var slide in slides.Take(3)){<article><div>Slide @slide.SlideNumber</div><strong>@(slide.Title??slide.Objective)</strong></article>}</div>}
  <fieldset><legend>Customer context <span>(optional)</span></legend><p>Select only related records. The server verifies company ownership and relationship consistency.</p><div class="adhoc-grid adhoc-grid--four"><label>Account<select @bind="account"><option value="">No account</option>@foreach(var x in options!.Accounts){<option value="@x.Id">@x.Label</option>}</select></label><label>Contact<select @bind="contact"><option value="">No contact</option>@foreach(var x in options.Contacts){<option value="@x.Id">@x.Label</option>}</select></label><label>Lead<select @bind="lead"><option value="">No lead</option>@foreach(var x in options.Leads){<option value="@x.Id">@x.Label</option>}</select></label><label>Deal<select @bind="deal"><option value="">No deal</option>@foreach(var x in options.Deals){<option value="@x.Id">@x.Label</option>}</select></label></div></fieldset>
  <fieldset><legend>Run-specific preparation</legend><div class="adhoc-grid"><label>Presenter<select @bind="presenter"><option value="">Preset default</option>@foreach(var x in options!.Presenters){<option value="@x.Id">@x.Label</option>}</select></label><label>Duration<input type="number" min="5" max="480" @bind="duration" /></label><label>Language<input maxlength="20" @bind="language" /></label><label>Control mode<select @bind="control"><option value="manual">Manual</option><option value="assisted">Assisted</option></select></label><label class="adhoc-wide">Goal <span>@Inherited(goal,Version.Goal)</span><textarea @bind="goal"></textarea></label><label class="adhoc-wide">Intended audience <span>@Inherited(audience,Version.Audience)</span><input @bind="audience" /></label><label class="adhoc-wide">Meeting strategy<select disabled><option>Prepare only — no meeting created</option></select></label></div></fieldset>
  <div class="@(HasContext?"adhoc-readiness adhoc-readiness--ready":"adhoc-readiness")"><strong>@(HasContext?"Ready after validation":"Needs review")</strong><p>@(HasContext?"Selected context will be verified and used as evidence.":"No customer context selected. Customer-specific claims will remain unavailable.")</p></div>
  @if(!string.IsNullOrWhiteSpace(error)){<div class="adhoc-error" role="alert">@error</div>}
  <footer><button class="sales-button" disabled="@busy" @onclick="Close">Cancel</button><button class="sales-button sales-button--primary" disabled="@busy" @onclick="Prepare">@(busy?"Preparing…":"Prepare presentation")</button></footer>
 }
</section></div>

@code{
 [Parameter,EditorRequired]public Guid CompanyId{get;set;}[Parameter,EditorRequired]public SalesPresentationPresetViewModel Preset{get;set;}=default!;[Parameter,EditorRequired]public SalesPresentationPresetVersionViewModel Version{get;set;}=default!;[Parameter]public EventCallback OnClose{get;set;}
 private SalesPresentationAdHocOptionsViewModel?options;private IReadOnlyList<SalesPresentationPresetSlideViewModel>slides=[];private SalesPresentationAdHocRunViewModel?run;private string account="",contact="",lead="",deal="",presenter="",goal="",audience="",language="en",control="assisted";private int duration=30;private Guid requestId=Guid.NewGuid();private bool loading=true,busy;private string?error;
 private bool HasContext=>Guid.TryParse(account,out _)||Guid.TryParse(contact,out _)||Guid.TryParse(lead,out _)||Guid.TryParse(deal,out _);
 protected override async Task OnInitializedAsync(){goal=Version.Goal;audience=Version.Audience;duration=Math.Max(5,Version.DurationMinutes);language=Version.Language;control=Version.ControlMode;try{var optionsTask=AdHoc.GetOptionsAsync(CompanyId);var slidesTask=Presets.GetSlidesAsync(CompanyId,Preset.Id,Version.Id);await Task.WhenAll(optionsTask,slidesTask);options=await optionsTask;slides=await slidesTask;}catch(Exception ex){error=ex.Message;}finally{loading=false;}}
 private async Task Prepare(){busy=true;error=null;try{run=await AdHoc.CreateAsync(CompanyId,new(requestId,Version.Id,Id(account),Id(contact),Id(lead),Id(deal),Id(presenter),goal,audience,duration,Version.DemoScenario,language,control,"preparation_only"));}catch(Exception ex){error=ex.Message;requestId=Guid.NewGuid();}finally{busy=false;}}
 private Task Close()=>OnClose.InvokeAsync();private static Guid?Id(string value)=>Guid.TryParse(value,out var id)?id:null;private static string Inherited(string?value,string baseline)=>string.Equals(value?.Trim(),baseline.Trim(),StringComparison.Ordinal)?"Inherited":"Override";private static string Present(string value)=>value.Replace('_',' ');private static string Status(string value)=>value=="ready"?"Ready":value=="needs_review"?"Needs review":"Preparing";
}
