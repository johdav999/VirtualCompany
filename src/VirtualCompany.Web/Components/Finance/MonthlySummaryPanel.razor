@using VirtualCompany.Web.Services

<article class="wizard-card wizard-card--compact finance-supporting-card">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 class="h5 mb-1">@FinanceText["MonthlySummary"]</h2>
            <p class="text-body-secondary small mb-0">@(MonthlySummary.IsAvailable ? MonthlySummary.Period : MonthlySummary.EmptyTitle)</p>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="@MonthlySummary.Href">@MonthlySummary.ActionLabel</a>
    </div>
    @if (MonthlySummary.IsAvailable)
    {
        @if (!string.IsNullOrWhiteSpace(MonthlySummary.CurrencyNote))
        {
            <p class="text-body-secondary small mb-2">@MonthlySummary.CurrencyNote</p>
        }
        <dl class="finance-overview-summary-list mb-0">
            <div>
                <dt>@FinanceText["TotalIncome"]</dt>
                <dd class="finance-overview-tone--positive">@MonthlySummary.TotalIncome</dd>
            </div>
            <div>
                <dt>@FinanceText["TotalExpenses"]</dt>
                <dd class="finance-overview-tone--danger">@MonthlySummary.TotalExpenses</dd>
            </div>
            <div>
                <dt>@FinanceText["NetCashFlow"]</dt>
                <dd class="@NetClass">@MonthlySummary.NetResult</dd>
            </div>
        </dl>
    }
    else
    {
        <div class="finance-overview-empty-state">
            <strong>@MonthlySummary.EmptyTitle</strong>
            <p>@MonthlySummary.EmptyMessage</p>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public FinanceMonthlySummaryOverviewViewModel MonthlySummary { get; set; } = new();

    private string NetClass => MonthlySummary.Tone switch
    {
        FinanceKpiTone.Positive => "finance-overview-tone--positive",
        FinanceKpiTone.Warning => "finance-overview-tone--warning",
        FinanceKpiTone.Danger => "finance-overview-tone--danger",
        _ => "finance-overview-tone--neutral"
    };
}
