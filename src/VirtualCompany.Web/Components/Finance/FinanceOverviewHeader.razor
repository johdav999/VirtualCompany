@using VirtualCompany.Web.Services

<div class="finance-overview-header">
    <div>
        <span class="finance-overview-kicker">@FinanceText["FinanceModule"]</span>
        <h1 id="finance-overview-heading" class="finance-overview-title">@FinanceText["FinanceOverview"]</h1>
        <p class="finance-overview-subtitle">@FinanceText["FinanceOverviewDescription"]</p>
    </div>
    <div class="finance-overview-header__actions">
        <a class="btn finance-overview-button finance-overview-button--primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Home, CompanyId)">@FinanceText["FinanceHome"]</a>
        <a class="btn finance-overview-button finance-overview-button--secondary" href="@DashboardHref">@FinanceText["CompanyDashboard"]</a>
    </div>
</div>

@code {
    [Parameter]
    public Guid? CompanyId { get; set; }

    private string DashboardHref => CompanyId is Guid companyId ? $"/dashboard?companyId={companyId:D}" : "/dashboard";
}
