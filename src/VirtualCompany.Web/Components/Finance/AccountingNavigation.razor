<nav class="accounting-navigation" aria-label="@FinanceText["AccountingNavigation"]">
    <a class="@LinkClass(FinanceRoutes.AccountingCloseWorkspace)" href="@Link(FinanceRoutes.AccountingCloseWorkspace)">@FinanceText["CloseWorkspaceNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingSetup)" href="@Link(FinanceRoutes.AccountingSetup)">@FinanceText["AccountingSetupNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingAccounts)" href="@Link(FinanceRoutes.AccountingAccounts)">@FinanceText["AccountingAccountsNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingPeriods)" href="@Link(FinanceRoutes.AccountingPeriods)">@FinanceText["AccountingPeriodsNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingJournal)" href="@Link(FinanceRoutes.AccountingJournal)">@FinanceText["AccountingJournalNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingReconciliation)" href="@Link(FinanceRoutes.AccountingReconciliation)">@FinanceText["AccountingReconciliationNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingReports)" href="@Link(FinanceRoutes.AccountingReports)">@FinanceText["AccountingReportsNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingComplianceCalendar)" href="@Link(FinanceRoutes.AccountingComplianceCalendar)">Compliance calendar</a>
    <a class="@LinkClass(FinanceRoutes.AccountingAuditPackages)" href="@Link(FinanceRoutes.AccountingAuditPackages)">Audit packages</a>
    <a class="@LinkClass(FinanceRoutes.AccountingReportDefinitions)" href="@Link(FinanceRoutes.AccountingReportDefinitions)">Report designer</a>
    <a class="@LinkClass(FinanceRoutes.AccountingYearEnd)" href="@Link(FinanceRoutes.AccountingYearEnd)">Year-end</a>
    <a class="@AdvancedLinkClass()" href="@Link(FinanceRoutes.AccountingAdvanced)">@FinanceText["AccountingAdvancedNav"]</a>
    <a class="@LinkClass(FinanceRoutes.AccountingConnections)" href="@Link(FinanceRoutes.AccountingConnections)">@FinanceText["AccountingConnectionsNav"]</a>
</nav>

@code {
    [Parameter] public Guid? CompanyId { get; set; }
    [Parameter] public Guid? PeriodId { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string Link(string route) => CompanyId is Guid company ? AccountingJourneyRoutes.Build(
        PeriodId is Guid period ? route + "?periodId=" + period.ToString("D") : route, company, Navigation.Uri) : route;

    private string LinkClass(string route)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return (string.Equals(path, route, StringComparison.OrdinalIgnoreCase) ||
                route == FinanceRoutes.AccountingJournal && path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase))
            ? "accounting-navigation__link active"
            : "accounting-navigation__link";
    }

    private string AdvancedLinkClass()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return path.StartsWith(FinanceRoutes.AccountingAdvanced, StringComparison.OrdinalIgnoreCase) ||
               path is FinanceRoutes.AccountingCurrencyRates or FinanceRoutes.AccountingDimensions or
                   FinanceRoutes.AccountingSchedules or FinanceRoutes.AccountingFixedAssets or FinanceRoutes.AccountingRevaluation
            ? "accounting-navigation__link active"
            : "accounting-navigation__link";
    }
}
