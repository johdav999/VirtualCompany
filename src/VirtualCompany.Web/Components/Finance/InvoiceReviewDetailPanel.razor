@using System.Globalization
@using VirtualCompany.Web.Services

<section class="invoice-review-detail-panel">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert alert-success mb-0" role="status">@StatusMessage</div>
    }

    @if (SelectedItem is null)
    {
        <div class="invoice-review-detail-panel__empty">
            <span class="dashboard-kicker">@FinanceText["ContextPanel"]</span>
            <h2 class="h4 mb-2">@FinanceText["SelectInvoiceReview"]</h2>
            <p class="text-body-secondary mb-3">@FinanceText["SelectInvoiceReviewDescription"]</p>

            <dl class="kv-list mb-0">
                <dt>@FinanceText["VisibleInvoices"]</dt>
                <dd>@VisibleInvoiceCount</dd>
                <dt>@FinanceText["HighRiskItems"]</dt>
                <dd>@HighRiskCount</dd>
                <dt>@FinanceText["NeedsAttention"]</dt>
                <dd>@NeedsAttentionCount</dd>
            </dl>
        </div>
    }
    else if (IsLoading)
    {
        <FinanceLoadingState Title="@FinanceText["LoadingInvoiceReview"]" Message="@FinanceText["LoadingInvoiceReviewDescription"]" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <FinanceErrorState Title="@FinanceText["InvoiceReviewUnavailable"]" Message="@(ErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@OnRetry" />
    }
    else if (Detail is null)
    {
        <FinanceEmptyState Title="@FinanceText["NoReviewResult"]" Message="@FinanceText["NoReviewResultDescription"]" />
    }
    else
    {
        var recommendation = InvoiceWorkflowPresentation.ResolveRecommendationDetails(Detail);
        var workflowHistory = InvoiceWorkflowPresentation.NormalizeWorkflowHistory(Detail.WorkflowHistory);

        <header class="invoice-review-detail-panel__header">
            <div>
                <span class="dashboard-kicker">@FinanceText["SelectedInvoice"]</span>
                <h2 class="h4 mb-1">@Detail.InvoiceNumber</h2>
                <p class="text-body-secondary mb-0">@Detail.SupplierName</p>
            </div>
            <div class="text-end">
                <div class="invoice-review-detail-panel__amount">@FormatCurrency(Detail.Amount, Detail.Currency)</div>
                <div class="small text-body-secondary">@FinanceText["UpdatedAt", FormatDateTime(Detail.LastUpdatedUtc)]</div>
            </div>
        </header>

        <section class="invoice-review-detail-panel__section" aria-label="@FinanceText["Recommendation"]">
            <h3 class="h5">@FinanceText["Recommendation"]</h3>
            <dl class="kv-list mb-0">
                <dt>@FinanceText["RecommendedAction"]</dt>
                <dd>@FormatLabel(recommendation?.RecommendedAction ?? Detail.RecommendedAction)</dd>
                <dt>@FinanceText["RiskLevel"]</dt>
                <dd><span class="@BuildRiskBadgeClass(recommendation?.Risk ?? Detail.RiskLevel)">@FormatLabel(recommendation?.Risk ?? Detail.RiskLevel)</span></dd>
                <dt>@FinanceText["Confidence"]</dt>
                <dd>@FormatConfidence(recommendation?.Confidence ?? Detail.Confidence)</dd>
                <dt>@FinanceText["ReviewStatus"]</dt>
                <dd>@FormatLabel(recommendation?.CurrentWorkflowStatus ?? Detail.RecommendationStatus)</dd>
            </dl>
        </section>

        <section class="invoice-review-detail-panel__section" aria-label="@FinanceText["WhyFlagged"]">
            <h3 class="h5">@FinanceText["WhyFlagged"]</h3>
            <p class="mb-0">@(recommendation?.RationaleSummary ?? Detail.RecommendationSummary)</p>
        </section>

        <section class="invoice-review-detail-panel__section" aria-label="@FinanceText["SupportingContext"]">
            <h3 class="h5">@FinanceText["SupportingContext"]</h3>
            <div class="invoice-review-support-list">
                <div class="invoice-review-support-item">
                    <strong>@FinanceText["SupplierSummary"]</strong>
                    <span>@FinanceText[workflowHistory.Count == 1 ? "SupplierWorkflowEventsOne" : "SupplierWorkflowEventsMany", Detail.SupplierName, workflowHistory.Count]</span>
                </div>
                <div class="invoice-review-support-item">
                    <strong>@FinanceText["RelatedItems"]</strong>
                    <span>
                        @if (Detail.RelatedApprovalId.HasValue)
                        {
                            <text>@FinanceText["ApprovalLinked"]</text>
                        }
                        else
                        {
                            <text>@FinanceText["NoApprovalLinked"]</text>
                        }
                    </span>
                </div>
                <div class="invoice-review-support-item">
                    <strong>@FinanceText["LinkedDocuments"]</strong>
                    <span>
                        @if (!string.IsNullOrWhiteSpace(SourceInvoiceHref))
                        {
                            <text>@FinanceText["SourceInvoiceAvailable"]</text>
                        }
                        else
                        {
                            <text>@FinanceText["NoLinkedRoute"]</text>
                        }
                    </span>
                </div>
            </div>

            @if (workflowHistory.Count > 0)
            {
                <div class="invoice-review-detail-panel__history">
                    @foreach (var entry in workflowHistory.Take(3))
                    {
                        <div class="invoice-review-history-item">
                            <strong>@entry.EventType</strong>
                            <span>@FormatActorOrSource(entry.ActorOrSourceDisplayName)</span>
                            <span>@FormatDateTime(entry.OccurredAtUtc)</span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="invoice-review-detail-panel__section" aria-label="@FinanceText["Actions"]">
            <h3 class="h5">@FinanceText["Actions"]</h3>
            <div class="invoice-review-detail-panel__actions">
                <button class="btn btn-primary" type="button" disabled="@(!Detail.Actions.CanApprove || IsSubmitting)" @onclick="OnApprove">@FinanceText["Approve"]</button>
                <button class="btn btn-outline-secondary" type="button" disabled="@(!Detail.Actions.CanReject || IsSubmitting)" @onclick="OnReject">@FinanceText["Reject"]</button>
                <button class="btn btn-outline-secondary" type="button" disabled="@(!Detail.Actions.CanSendForFollowUp || IsSubmitting)" @onclick="OnSendForFollowUp">@FinanceText["RequestMoreInfo"]</button>
                <a class="btn btn-outline-primary" href="@FullDetailHref">@FinanceText["ViewFullDetails"]</a>
            </div>
        </section>
    }
</section>

@code {
    [Parameter] public FinanceInvoiceReviewListItemResponse? SelectedItem { get; set; }
    [Parameter] public FinanceInvoiceReviewDetailResponse? Detail { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public int VisibleInvoiceCount { get; set; }
    [Parameter] public int HighRiskCount { get; set; }
    [Parameter] public int NeedsAttentionCount { get; set; }
    [Parameter] public string FullDetailHref { get; set; } = "#";
    [Parameter] public string? SourceInvoiceHref { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }
    [Parameter] public EventCallback OnSendForFollowUp { get; set; }

    private string FormatLabel(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? FinanceText["NotAvailable"]
            : FinanceStatusPresenter.Present(value, FinanceText, CommonText);

    private string FormatCurrency(decimal amount, string currency) => LocalMoney.Format(amount, currency);

    private string FormatDateTime(DateTime value) =>
        value == default
            ? FinanceText["UnknownTime"]
            : LocalDateTime.DateTime(value);

    private string FormatConfidence(decimal confidence) => LocalNumber.Percentage(Math.Clamp(confidence, 0m, 1m));

    private string FormatActorOrSource(string? value) =>
        string.IsNullOrWhiteSpace(value) ? FinanceText["SystemActor"] : value.Trim();

    private static string BuildRiskBadgeClass(string? riskLevel) =>
        $"finance-risk-pill {ResolveRiskClass(riskLevel)}";

    private static string ResolveRiskClass(string? riskLevel) =>
        riskLevel?.Trim().ToLowerInvariant() switch
        {
            "critical" => "finance-risk-pill--critical",
            "high" => "finance-risk-pill--high",
            "medium" => "finance-risk-pill--medium",
            "low" => "finance-risk-pill--low",
            _ => "finance-risk-pill--neutral"
        };
}
