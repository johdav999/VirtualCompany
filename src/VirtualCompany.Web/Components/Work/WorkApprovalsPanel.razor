@inject ApprovalApiClient ApprovalApiClient
@implements IDisposable
@inject IStringLocalizer<UiConsolidationResources> UiText

<div class="vc-work-layout">
    <section class="vc-panel vc-work-list" aria-label="@UiText["Approvals"]">
        @if (isLoading)
        {
            <p class="text-body-secondary mb-0">@UiText["LoadingApprovals"]</p>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-0" role="alert">@errorMessage <button type="button" class="btn btn-outline-secondary" @onclick="OnParametersSetAsync">@CommonText["Retry"]</button></div>
        }
        else if (approvals.Count == 0)
        {
            <div class="vc-empty-state">
                <h2>@UiText["NoPendingApprovals"]</h2>
                <p>@UiText["NoPendingApprovalsDescription"]</p>
            </div>
        }
        else
        {
            <div class="vc-list" role="list">
                @foreach (var approval in approvals)
                {
                    <button type="button" class="@ItemClass(approval.Id)" @onclick="() => SelectAsync(approval.Id)">
                        <div>
                            <strong>@Title(approval)</strong>
                            <span>@Reason(approval)</span>
                        </div>
                        <div class="vc-list-meta">
                            @if (!string.IsNullOrWhiteSpace(approval.DisplayAmount))
                            {
                                <span>@approval.DisplayAmount</span>
                            }
                            <span class="vc-status">@approval.DisplayStatus</span>
                        </div>
                    </button>
                }
            </div>
        }
    </section>

    <aside class="vc-panel vc-work-detail" aria-label="@UiText["ApprovalDetails"]">
        @if (decisionRecorded) { <p class="alert alert-info" role="status">@CommonText["PriorityDecisionRecorded"]</p> }
        @if (selected is null)
        {
            <div class="vc-empty-state">
                <h2>@UiText["SelectApproval"]</h2>
                <p>@UiText["SelectApprovalDescription"]</p>
            </div>
        }
        else
        {
            <span class="vc-kicker">@selected.DisplayStatus</span>
            <h2>@Title(selected)</h2>
            <p>@Reason(selected)</p>
            <dl class="vc-detail-list">
                <dt>@UiText["Reference"]</dt><dd>@selected.DisplayReference</dd>
                @if (!string.IsNullOrWhiteSpace(selected.DisplayAmount))
                {
                    <dt>@UiText["Amount"]</dt><dd>@selected.DisplayAmount</dd>
                }
                <dt>@UiText["Requested"]</dt><dd>@LocalDateTime.DateTime(selected.CreatedAt)</dd>
                <dt>@UiText["AffectedData"]</dt><dd>@selected.AffectedDataSummary</dd>
            </dl>
            @if (selected.CurrentStep is not null && IsPending(selected))
            {
                <label class="form-label mt-3" for="work-approval-comment">@UiText["DecisionNote"]</label>
                <textarea id="work-approval-comment" class="form-control" rows="3" @bind="decisionComment"></textarea>
                <div class="dashboard-actions mt-3">
                    <button class="btn btn-primary" type="button" disabled="@isDeciding" @onclick='() => DecideAsync("approve")'>@UiText["Approve"]</button>
                    <button class="btn btn-outline-danger" type="button" disabled="@isDeciding" @onclick='() => DecideAsync("reject")'>@UiText["Reject"]</button>
                </div>
            }
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedIdChanged { get; set; }

    private static bool IsTaskReview(ApprovalRequestViewModel item) => item.TargetEntityType == "task" && !item.ApprovalType.Contains("payment", StringComparison.OrdinalIgnoreCase);
    private string Title(ApprovalRequestViewModel item) => IsTaskReview(item) ? CommonText["PriorityTaskReview"] : item.DisplayTitle;
    private string Reason(ApprovalRequestViewModel item) => IsTaskReview(item)
        ? item.ThresholdContext.TryGetValue("reason", out var reason) && reason is not null ? reason.ToString() : CommonText["PriorityTaskReviewReason"].Value
        : item.DisplayReason;
    private List<ApprovalRequestViewModel> approvals = [];
    private ApprovalRequestViewModel? selected;
    private bool isLoading = true;
    private bool isDeciding;
    private string? decisionComment;
    private string? errorMessage;
    private int loadVersion;
    private bool disposed;
    private bool decisionRecorded;
    private CancellationTokenSource? cancellation;

    protected override async Task OnParametersSetAsync()
    {
        cancellation?.Cancel(); cancellation?.Dispose();
        var token = (cancellation = new CancellationTokenSource()).Token;
        var version = ++loadVersion;
        var company = CompanyId;
        var selectedId = SelectedId;
        bool Current() => !disposed && version == loadVersion && !token.IsCancellationRequested;
        isLoading = true;
        errorMessage = null;
        selected = null; approvals = []; decisionComment = null; decisionRecorded = false;
        try
        {
            var items = ApprovalPresentationFormatter.Format(await ApprovalApiClient.ListAsync(company, "pending", token));
            var detail = selectedId is Guid id
                ? ApprovalPresentationFormatter.Format(await ApprovalApiClient.GetAsync(company, id, token)) : null;
            if (!Current()) return;
            approvals = items;
            if (selectedId.HasValue)
            {
                selected = detail;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (!Current()) return;
            errorMessage = ex.Message;
            approvals = [];
            selected = null;
        }
        finally
        {
            if (Current()) isLoading = false;
        }
    }

    private async Task SelectAsync(Guid id)
    {
        var company = CompanyId; var version = loadVersion;
        try
        {
            var detail = ApprovalPresentationFormatter.Format(await ApprovalApiClient.GetAsync(company, id));
            if (disposed || version != loadVersion || company != CompanyId) return;
            selected = detail; decisionComment = null; errorMessage = null;
            await SelectedIdChanged.InvokeAsync(id);
        }
        catch (Exception ex) { if (!disposed && version == loadVersion) errorMessage = ex.Message; }
    }

    private async Task DecideAsync(string decision)
    {
        if (selected?.CurrentStep is null || isDeciding)
        {
            return;
        }

        isDeciding = true;
        errorMessage = null;
        var company = CompanyId; var version = loadVersion;
        var approval = selected;
        try
        {
            await ApprovalApiClient.DecideAsync(company, approval.Id, new ApprovalDecisionRequest
            {
                ApprovalId = approval.Id,
                StepId = approval.CurrentStep.Id,
                Decision = decision,
                Comment = decisionComment
            });
            var items = ApprovalPresentationFormatter.Format(await ApprovalApiClient.ListAsync(company, "pending"));
            if (disposed || version != loadVersion) return;
            approvals = items;
            selected = null;
            decisionComment = null;
            decisionRecorded = true;
        }
        catch (Exception ex)
        {
            if (!disposed && version == loadVersion) errorMessage = ex.Message;
        }
        finally
        {
            if (!disposed) isDeciding = false;
        }
    }

    private string ItemClass(Guid id) => selected?.Id == id ? "vc-list-item selected" : "vc-list-item";
    private static bool IsPending(ApprovalRequestViewModel approval) =>
        string.Equals(approval.Status, "pending", StringComparison.OrdinalIgnoreCase);
    public void Dispose() { disposed = true; cancellation?.Cancel(); cancellation?.Dispose(); }
}
