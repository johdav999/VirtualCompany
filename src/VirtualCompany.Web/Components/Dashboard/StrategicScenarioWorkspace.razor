@using VirtualCompany.Web.Services
@implements IDisposable
@inject StrategicScenarioApiClient Planning
@inject NavigationManager Navigation
<div class="scenario-workspace" data-testid="strategic-scenarios" data-interactive-ready="@ready.ToString().ToLowerInvariant()">
<header><p class="eyebrow">Company planning · Multi-year</p><h1>Strategic scenarios</h1><p>Compare explicit assumptions against retained annual and Finance baselines.</p></header>
<nav class="workspace-periods" aria-label="Planning period">@foreach(var p in new[]{("today","Today"),("week","Week"),("month","Month"),("quarter","Quarter"),("year","Year"),("multiyear","Multi-year")}){<a class="@(p.Item1=="multiyear"?"active":"")" href="@($"/dashboard?companyId={CompanyId}&period={p.Item1}&lens=company")">@p.Item2</a>}</nav>
@if(error!=null){<p role="alert" class="scenario-error">@error</p>}
@if(loading){<p role="status">Loading authorized scenario sources…</p>}
else if(options!=null){
<div class="scenario-toolbar"><label>Baseline fiscal year<input aria-label="Baseline fiscal year" type="number" min="2000" max="2090" @bind="year" /></label><button class="btn btn-outline-primary" disabled="@busy" @onclick="OpenYear">Open year</button><button class="btn btn-outline-secondary" disabled="@busy" @onclick="Reload">Reload</button></div>
<div class="scenario-layout"><main>
@if(editing){
<section class="scenario-card"><h2>Scenario definition</h2><p>Every value below is an assumption. Blank numeric fields block preview.</p><div class="scenario-fields">
<label>Name<input aria-label="Scenario name" maxlength="64" @bind="name" @bind:after="Dirty" /></label>
<label>Accountable owner<select aria-label="Scenario owner" @bind="owner" @bind:after="Dirty"><option value="@Guid.Empty">Choose active owner</option>@foreach(var o in options.Owners){<option value="@o.Id">@o.Name</option>}</select></label>
<label>Approved annual baseline<select aria-label="Annual baseline" disabled="@(document!=null)" @bind="annual" @bind:after="Dirty"><option value="@Guid.Empty">Choose approved version</option>@foreach(var p in options.AnnualPlans){<option value="@p.Id">FY @p.FiscalYear · version @p.Version</option>}@if(document!=null&&!options.AnnualPlans.Any(p=>p.Id==document.Scenario.Source.AnnualPlanId)){<option value="@document.Scenario.Source.AnnualPlanId">Retained FY @document.Summary.FiscalYear · version @document.Scenario.Source.AnnualVersion</option>}</select></label>
<label>Retained Finance forecast (20 latest)<select aria-label="Finance baseline" disabled="@(document!=null)" @bind="forecast" @bind:after="Dirty"><option value="@Guid.Empty">Choose saved forecast</option>@foreach(var f in options.Forecasts){<option value="@f.Id">@f.Name · @f.SavedUtc.ToString("yyyy-MM-dd")</option>}@if(document!=null&&!options.Forecasts.Any(p=>p.Id==document.Scenario.Source.ForecastRevisionId)){<option value="@document.Scenario.Source.ForecastRevisionId">@document.Scenario.Source.ForecastName · retained source</option>}</select></label>
<label>Currency<input aria-label="Scenario currency" maxlength="3" @bind="currency" @bind:after="Dirty" /></label>
<label>Years (3–10)<input aria-label="Scenario years" type="number" min="3" max="10" @bind="years" @bind:after="ResizeYears" /></label>
<label>Capacity unit<input aria-label="Capacity unit" maxlength="32" @bind="unit" @bind:after="Dirty" /></label>
</div></section>
<section class="scenario-card"><h2>Revenue, cost and capacity assumptions</h2><p>Growth is annual %. Shares run from 0 to 1. Source scaling is a multiplier, explicitly chosen for the displayed native month coverage.</p><div class="scenario-fields">@foreach(var f in drivers.Take(8)){<label>@f.Label<input aria-label="@f.Label" type="number" step="any" @bind="f.Value" @bind:after="Dirty" /></label>}</div></section>
<section class="scenario-card"><h2>Cash timing and floor</h2><p>Uncollected revenue and unpaid costs settle completely in the following year. Opening balances are explicit @currency assumptions.</p><div class="scenario-fields">@foreach(var f in drivers.Skip(8)){<label>@f.Label<input aria-label="@f.Label" type="number" step="any" @bind="f.Value" @bind:after="Dirty" /></label>}</div></section>
<section class="scenario-card"><h2>Incremental investment and assumed funding</h2><p>Cash amounts in @currency, in addition to baseline operating costs. Funding is an assumption, not an approval.</p>@foreach(var f in flows){<article class="scenario-flow"><h3>Year @f.Year</h3><div class="scenario-fields"><label>Additional investment<input aria-label="@($"Year {f.Year} investment")" type="number" min="0" step="0.01" @bind="f.Investment" @bind:after="Dirty" /></label><label>Assumed funding<input aria-label="@($"Year {f.Year} funding")" type="number" min="0" step="0.01" @bind="f.Funding" @bind:after="Dirty" /></label><label>Source and rationale<input aria-label="@($"Year {f.Year} rationale")" maxlength="1000" @bind="f.Rationale" @bind:after="Dirty" /></label></div></article>}</section>
<section class="scenario-card"><h2>Strategic checkpoints</h2><p>Preview first to load native initiatives from the selected annual baseline.</p>@if(preview!=null||document!=null){<button class="btn btn-outline-primary" @onclick="AddCheckpoint">Add checkpoint</button>}
@foreach(var p in checkpoints){<div class="scenario-flow scenario-fields"><label>Year<input aria-label="Checkpoint year" type="number" min="1" max="@years" @bind="p.Year" @bind:after="Dirty" /></label><label>Checkpoint<input aria-label="Checkpoint title" maxlength="200" @bind="p.Title" @bind:after="Dirty" /></label><label>Owner<select aria-label="Checkpoint owner" @bind="p.Owner" @bind:after="Dirty"><option value="@Guid.Empty">Choose owner</option>@foreach(var o in options.Owners){<option value="@o.Id">@o.Name</option>}</select></label><label>Native dependency<select aria-label="Checkpoint initiative" @bind="p.Initiative" @bind:after="Dirty"><option value="@Guid.Empty">Choose initiative</option>@foreach(var i in dependencies){<option value="@i.Id">@i.Title</option>}</select></label><button class="btn btn-outline-danger" @onclick="()=>Remove(p)">Remove checkpoint</button></div>}</section>
}
@if((preview??document?.Scenario) is {} result){
<section class="scenario-card"><h2>Scenario consequences</h2><p>@result.Input.Name · @result.Owner · FY @result.Source.FiscalYear to @(result.Source.FiscalYear+result.Input.Drivers.Years-1) · @result.Source.Currency</p>
<div class="scenario-kpis"><div><small>Final closing cash</small><strong>@Money(result.Years.Last().ClosingCash)</strong></div><div><small>Lowest closing cash</small><strong>@Money(result.Years.Min(x=>x.ClosingCash))</strong></div><div><small>Largest funding gap</small><strong>@Money(result.Years.Max(x=>x.FundingGap))</strong></div><div><small>Capacity shortfall</small><strong>@result.Years.Sum(x=>x.CapacityShortfall).ToString("0.####") @result.Input.Drivers.CapacityUnit</strong></div></div>
@foreach(var w in result.Warnings){<p class="scenario-warning">@w</p>}
<div class="scenario-table" tabindex="0" aria-label="Annual scenario results"><table><thead><tr><th>FY</th><th>Demand / capacity</th><th>Revenue</th><th>Operating cost</th><th>Opening cash</th><th>Collections / payments</th><th>Investment / funding</th><th>Closing cash</th><th>AR / AP</th><th>Funding gap</th></tr></thead><tbody>@foreach(var r in result.Years){<tr><th>@(result.Source.FiscalYear+r.Year-1)</th><td>@r.Demand.ToString("0.####") / @r.Capacity.ToString("0.####")</td><td>@Money(r.Revenue)</td><td>@Money(r.OperatingCost)</td><td>@Money(r.OpeningCash)</td><td>@Money(r.Collections) / @Money(r.Payments)</td><td>@Money(r.Investment) / @Money(r.Funding)</td><td class="@(r.ClosingCash<0?"negative":"")">@Money(r.ClosingCash)</td><td>@Money(r.Receivables) / @Money(r.Payables)</td><td>@Money(r.FundingGap)</td></tr>}</tbody></table></div></section>
<section class="scenario-card"><h2>Source versions and dependencies</h2><p>Annual version @result.Source.AnnualVersion · Finance @result.Source.ForecastName · source captured @result.Source.SourceAsOfUtc.ToString("u") · @result.Source.Timezone.</p><p><a href="@($"/dashboard?companyId={CompanyId}&period=year&year={result.Source.FiscalYear}&plan={result.Source.AnnualPlanId}&lens=company")">Open retained annual baseline</a> · <a href="@($"/finance/reports/rolling-forecast?companyId={CompanyId}&version={result.Source.ForecastRevisionId}")">Open retained Finance forecast</a></p>
@foreach(var d in result.Source.Dependencies){<p><strong>@d.Title</strong> · @d.Status · @d.DependsOn.Count native dependencies</p>}
@foreach(var p in result.Checkpoints){<p>FY @(result.Source.FiscalYear+p.Year-1) · @p.Title · @p.Owner · @result.Source.Dependencies.First(x=>x.Id==p.InitiativeId).Title</p>}
<details><summary>Captured source provenance</summary><ul>@foreach(var p in result.Source.Provenance){<li>@p</li>}</ul><p class="checksum">Forecast checksum @result.Source.ForecastChecksum · Scenario @result.Fingerprint</p></details>
<details><summary>Formulas and limitations · @result.CalculationVersion</summary><p>@result.Formulas</p><p>@result.Limitations</p></details></section>
}
@if(comparison is {} cmp){<section class="scenario-card"><h2>Baseline and alternative comparison</h2><p>@cmp.Baseline.Summary.Name (revision @cmp.Baseline.Summary.Revision) → @cmp.Alternative.Summary.Name (revision @cmp.Alternative.Summary.Revision). Values are alternative minus baseline, in @cmp.Baseline.Summary.Currency.</p>
<ul>@foreach(var c in cmp.AssumptionChanges){<li>@c</li>}</ul>
<div class="cash-chart"><p><strong>Closing cash trajectory</strong> · @cmp.Baseline.Summary.Currency · FY @cmp.Baseline.Summary.FiscalYear–@(cmp.Baseline.Summary.FiscalYear+cmp.Deltas.Count-1)</p><p><span class="baseline-key">Baseline</span> · <span class="alternative-key">Alternative</span> · range @Money(ChartMin(cmp)) to @Money(ChartMax(cmp))</p><svg viewBox="0 0 600 220" role="img" aria-label="Baseline and alternative closing cash by fiscal year"><title>Closing cash from saved scenario outputs; exact values follow in the table.</title><line x1="24" x2="576" y1="@ChartY(cmp,0)" y2="@ChartY(cmp,0)" stroke="#b8c5d6" stroke-dasharray="4 4" /><polyline points="@ChartPoints(cmp.Baseline.Scenario.Years,cmp)" fill="none" stroke="#2563eb" stroke-width="3" /><polyline points="@ChartPoints(cmp.Alternative.Scenario.Years,cmp)" fill="none" stroke="#08918e" stroke-width="3" /></svg><small>Dashed line: zero cash. Lines connect annual modeled closing balances.</small></div>
<div class="scenario-table" tabindex="0" aria-label="Scenario cash comparison"><table><thead><tr><th>FY</th><th>Baseline cash</th><th>Alternative cash</th><th>Cash change</th><th>Revenue change</th><th>Cost change</th><th>Funding gap change</th><th>Shortfall change</th></tr></thead><tbody>@foreach(var d in cmp.Deltas){<tr><th>@(cmp.Baseline.Summary.FiscalYear+d.Year-1)</th><td>@Money(cmp.Baseline.Scenario.Years[d.Year-1].ClosingCash)</td><td>@Money(cmp.Alternative.Scenario.Years[d.Year-1].ClosingCash)</td><td>@Money(d.ClosingCash)</td><td>@Money(d.Revenue)</td><td>@Money(d.Cost)</td><td>@Money(d.FundingGap)</td><td>@d.CapacityShortfall.ToString("0.####")</td></tr>}</tbody></table></div>
</section>}
</main><aside><section class="scenario-card"><h2>Save and compare</h2>@if(document != null && !editing){@for(var n=0;n<document.Scenario.Checkpoints.Count;n++){var checkpoint=document.Scenario.Checkpoints[n];<p><a href="@DecisionWorkRoutes.Create(CompanyId,"scenario",document.Summary.Id,n.ToString(System.Globalization.CultureInfo.InvariantCulture))">Create work: @checkpoint.Title</a></p>}}<p>Saved scenarios reproduce their captured inputs. Live actuals and approved plans remain owned by their native services.</p>
@if(editing){<label>Scenario rationale<textarea aria-label="Scenario rationale" maxlength="2000" @bind="notes" @bind:after="Dirty"></textarea></label><button class="btn btn-outline-primary" disabled="@busy" @onclick="Preview">Preview consequences</button><button class="btn btn-primary" disabled="@(busy||preview==null)" @onclick="Save">Save scenario version</button>}
else if(document!=null){<p>Revision @document.Summary.Revision · @document.Summary.Owner · @document.Summary.SavedUtc.ToString("u")</p><button class="btn btn-outline-primary" disabled="@busy" @onclick="Edit">Edit assumptions</button><label>Alternative name<input aria-label="Alternative name" maxlength="64" @bind="duplicateName" /></label><button class="btn btn-primary" disabled="@busy" @onclick="Duplicate">Duplicate scenario</button>}
else{<button class="btn btn-primary" @onclick="Create">Prepare scenario</button>}
<label>Baseline scenario<select aria-label="Compare baseline" @bind="baseline"><option value="@Guid.Empty">Choose saved version</option>@foreach(var h in CompareChoices){<option value="@h.Id">@h.Name · revision @h.Revision</option>}</select></label><label>Alternative scenario<select aria-label="Compare alternative" @bind="alternative"><option value="@Guid.Empty">Choose saved version</option>@foreach(var h in CompareChoices){<option value="@h.Id">@h.Name · revision @h.Revision</option>}</select></label><button class="btn btn-outline-primary" disabled="@(busy||baseline==Guid.Empty||alternative==Guid.Empty)" @onclick="Compare">Compare scenarios</button>
</section><section class="scenario-card"><h2>Scenario history</h2><p>20 saved records per page; retained source access controls visibility.</p>@foreach(var h in history){<p><a href="@Path(h.Id)">@h.Name · revision @h.Revision</a><small>@h.Owner · FY @h.FiscalYear · @h.Currency</small></p>}<button class="btn btn-outline-secondary" disabled="@(busy||skip==0)" @onclick="PreviousPage">Previous</button><button class="btn btn-outline-secondary" disabled="@(busy||!hasMore)" @onclick="NextPage">Next</button></section></aside></div>
}
</div>
@code {
 [Parameter]public Guid CompanyId{get;set;}[Parameter]public int? FiscalYear{get;set;}[Parameter]public Guid? ScenarioId{get;set;}[Parameter]public Guid? CompareId{get;set;}
 private StrategicScenarioOptions? options;private StrategicScenarioDocument? document;private StrategicScenarioPreview? preview;private StrategicScenarioComparison? comparison;
 private IReadOnlyList<StrategicScenarioSummary> history=[];private IReadOnlyList<PlanningInitiative> dependencies=[];private CancellationTokenSource? load;
 private bool loading,busy,disposed,ready,editing,hasMore;private string? error;private int year,years=3,skip;private Guid annual,forecast,owner,baseline,alternative,request=Guid.NewGuid(),duplicateRequest=Guid.NewGuid();
 private string name="",currency="",unit="",notes="",duplicateName="";private readonly List<NumberField> drivers=new(){new("Source-to-annual multiplier"),new("Base demand units"),new("Base capacity units"),new("Demand growth %"),new("Price growth %"),new("Cost growth %"),new("Capacity growth %"),new("Variable cost share"),new("Opening cash"),new("Opening receivables"),new("Opening payables"),new("Collection share"),new("Payment share"),new("Cash floor")};
 private List<Flow> flows=[];private List<Checkpoint> checkpoints=[];
 protected override async Task OnParametersSetAsync(){year=FiscalYear??DateTime.UtcNow.Year;skip=0;await Reload();}
 protected override Task OnAfterRenderAsync(bool first){if(first){ready=true;StateHasChanged();}return Task.CompletedTask;}
 private IEnumerable<StrategicScenarioSummary> CompareChoices => history.Concat(document is null?[]:new[]{document.Summary}).Concat(comparison is null?[]:new[]{comparison.Baseline.Summary,comparison.Alternative.Summary}).DistinctBy(x=>x.Id);
 private string Path(Guid? id=null,Guid? compare=null)=>$"/dashboard?companyId={CompanyId}&period=multiyear&year={year}&lens=company"+(id.HasValue?$"&scenario={id}":"")+(compare.HasValue?$"&compare={compare}":"");
 private void OpenYear()=>Navigation.NavigateTo(Path());
 private async Task Reload(){load?.Cancel();load?.Dispose();var current=load=new();loading=true;busy=false;error=null;options=null;document=null;preview=null;comparison=null;editing=false;dependencies=[];history=[];hasMore=false;Clear();try{var o=await Planning.Options(CompanyId,year,current.Token);var h=await Planning.History(CompanyId,skip,current.Token);var d=ScenarioId.HasValue?await Planning.Open(CompanyId,ScenarioId.Value,current.Token):null;var c=d!=null&&CompareId.HasValue?await Planning.Compare(CompanyId,CompareId.Value,d.Summary.Id,current.Token):null;if(current==load&&!disposed){options=o;history=h.Items;hasMore=h.HasMore;document=d;comparison=c;if(d!=null){dependencies=d.Scenario.Source.Dependencies;duplicateName=d.Summary.Name+" alternative";baseline=CompareId??d.Summary.DerivedFromId??Guid.Empty;alternative=d.Summary.Id;}}}catch(OperationCanceledException){}catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or TodayWorkspaceAccessException){if(current==load&&!disposed)error=e is TodayWorkspaceAccessException?"Strategic scenarios are unavailable for the current membership and retained source access.":e.Message;}finally{if(current==load&&!disposed)loading=false;}}
 private void Clear(){name=currency=unit=notes=duplicateName="";annual=forecast=owner=baseline=alternative=Guid.Empty;flows=[];checkpoints=[];foreach(var f in drivers)f.Value=null;}
 private void Create(){Clear();editing=true;years=3;ResizeYears();}
 private void Dirty(){preview=null;comparison=null;request=Guid.NewGuid();}
 private void ResizeYears(){if(years is >=3 and <=10){flows=Enumerable.Range(1,years).Select(y=>flows.FirstOrDefault(f=>f.Year==y)??new Flow{Year=y}).ToList();checkpoints.RemoveAll(x=>x.Year>years);}Dirty();}
 private decimal Number(int index)=>drivers[index].Value??throw new InvalidOperationException($"Enter {drivers[index].Label}.");
 private StrategicScenarioInput Input()=>new(name,owner,annual,forecast,currency,new(years,unit,Number(0),Number(1),Number(2),Number(3),Number(4),Number(5),Number(6),Number(7),Number(8),Number(9),Number(10),Number(11),Number(12),Number(13)),flows.Select(f=>new ScenarioCashInput(f.Year,f.Investment??throw new InvalidOperationException("Enter every investment, including zero."),f.Funding??throw new InvalidOperationException("Enter every funding input, including zero."),f.Rationale)).ToArray(),checkpoints.Select(p=>new ScenarioCheckpointInput(p.Year,p.Title,p.Owner,p.Initiative)).ToArray(),notes);
 private async Task Run(Func<CancellationToken,Task> action){if(load==null||busy)return;var current=load;busy=true;error=null;try{await action(current.Token);}catch(OperationCanceledException){}catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or TodayWorkspaceAccessException or ArgumentException){if(current==load&&!disposed)error=e is TodayWorkspaceAccessException?"Current scenario and source access are required.":e.Message;}finally{if(current==load&&!disposed)busy=false;}}
 private Task Preview()=>Run(async ct=>{var input=Input();var revision=request;var p=await Planning.Preview(CompanyId,input,ct);if(!disposed&&!ct.IsCancellationRequested&&request==revision){preview=p;dependencies=p.Source.Dependencies;}});
 private Task Save()=>Run(async ct=>{var p=preview??throw new InvalidOperationException("Preview first.");var d=await Planning.Save(CompanyId,new(request,Input(),p.Fingerprint,document?.Summary.Id,document?.Summary.Revision??0),ct);if(!disposed&&!ct.IsCancellationRequested)Navigation.NavigateTo(Path(d.Summary.Id,baseline==Guid.Empty?null:baseline));});
 private Task Duplicate()=>Run(async ct=>{var d=await Planning.Duplicate(CompanyId,document!.Summary.Id,new(duplicateRequest,duplicateName),ct);if(!disposed&&!ct.IsCancellationRequested)Navigation.NavigateTo(Path(d.Summary.Id,document.Summary.Id));});
 private Task Compare()=>Run(async ct=>{var c=await Planning.Compare(CompanyId,baseline,alternative,ct);if(!disposed&&!ct.IsCancellationRequested){comparison=c;Navigation.NavigateTo(Path(alternative,baseline));}});
 private void Edit(){var i=document!.Scenario.Input;name=i.Name;owner=i.OwnerId;annual=i.AnnualPlanId;forecast=i.ForecastRevisionId;currency=i.Currency;unit=i.Drivers.CapacityUnit;years=i.Drivers.Years;notes=i.Notes;var d=i.Drivers;var v=new[]{d.SourceToAnnualScale,d.DemandUnits,d.CapacityUnits,d.DemandGrowthPercent,d.PriceGrowthPercent,d.CostGrowthPercent,d.CapacityGrowthPercent,d.VariableCostShare,d.OpeningCash,d.OpeningReceivables,d.OpeningPayables,d.CollectionShare,d.PaymentShare,d.CashFloor};for(var n=0;n<v.Length;n++)drivers[n].Value=v[n];flows=i.Cash.Select(x=>new Flow{Year=x.Year,Investment=x.Investment,Funding=x.Funding,Rationale=x.Rationale}).ToList();checkpoints=i.Checkpoints.Select(x=>new Checkpoint{Year=x.Year,Title=x.Title,Owner=x.OwnerId,Initiative=x.InitiativeId}).ToList();editing=true;Dirty();}
 private void AddCheckpoint(){checkpoints.Add(new());Dirty();}private void Remove(Checkpoint p){checkpoints.Remove(p);Dirty();}
 private string Owner(Guid id)=>options?.Owners.FirstOrDefault(x=>x.Id==id)?.Name??"Retained member";
 private static string Money(decimal v)=>v.ToString("N2",System.Globalization.CultureInfo.InvariantCulture);
 private static decimal ChartMin(StrategicScenarioComparison c)=>Math.Min(0,c.Baseline.Scenario.Years.Concat(c.Alternative.Scenario.Years).Min(x=>x.ClosingCash));
 private static decimal ChartMax(StrategicScenarioComparison c)=>Math.Max(0,c.Baseline.Scenario.Years.Concat(c.Alternative.Scenario.Years).Max(x=>x.ClosingCash));
 private static string ChartY(StrategicScenarioComparison c,decimal cash)=>(196-172*(cash-ChartMin(c))/Math.Max(1,ChartMax(c)-ChartMin(c))).ToString("0.###",System.Globalization.CultureInfo.InvariantCulture);
 private static string ChartPoints(IReadOnlyList<ScenarioYearResult> rows,StrategicScenarioComparison c)=>string.Join(" ",rows.Select((r,i)=>(24+552m*i/(rows.Count-1)).ToString("0.###",System.Globalization.CultureInfo.InvariantCulture)+","+ChartY(c,r.ClosingCash)));
 private Task NextPage(){skip+=20;return PageHistory();}private Task PreviousPage(){skip=Math.Max(0,skip-20);return PageHistory();}private Task PageHistory()=>Run(async ct=>{var h=await Planning.History(CompanyId,skip,ct);if(!disposed&&!ct.IsCancellationRequested){history=h.Items;hasMore=h.HasMore;}});
 public void Dispose(){disposed=true;load?.Cancel();load?.Dispose();}
 private sealed class NumberField(string label){public string Label=label;public decimal? Value;}
 private sealed class Flow{public int Year;public decimal? Investment,Funding;public string Rationale="";}
 private sealed class Checkpoint{public int Year=1;public string Title="";public Guid Owner,Initiative;}
}
