@using System.Globalization

@if (IsLoading)
{
    <section class="monthly-state" data-testid="monthly-loading" role="status" aria-busy="true">
        <span class="monthly-spinner" aria-hidden="true"></span>
        <h1>@CommonText["MonthlyWorkspaceTitle"]</h1>
        <p>@CommonText["MonthlyLoadingDescription"]</p>
    </section>
}
else if (IsUnauthorized)
{
    <section class="monthly-state" data-testid="monthly-unauthorized" role="alert"><h1>@CommonText["TodayAccessRestricted"]</h1><p>@CommonText["TodayAccessRestrictedDescription"]</p></section>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <section class="monthly-state" data-testid="monthly-error" role="alert"><h1>@CommonText["MonthlyErrorTitle"]</h1><p>@ErrorMessage</p><button @onclick="RetryRequested">@CommonText["Retry"]</button></section>
}
else if (Workspace is null)
{
    <section class="monthly-state" data-testid="monthly-empty" role="status"><h1>@CommonText["MonthlyEmptyTitle"]</h1><p>@CommonText["MonthlyEmptyDescription"]</p></section>
}
else
{
    <div class="monthly-workspace" data-testid="monthly-workspace">
        <header class="monthly-header">
            <div class="monthly-header__title">
                <h1>@CommonText["MonthlyWorkspaceTitle"]</h1>
                <div class="monthly-header__meta">
                    <strong>@Workspace.Header.CompanyName</strong><span aria-hidden="true"></span>
                    <MonthlyWorkspaceIcon Kind="calendar" Size="14" /><span>@Workspace.Period.Label</span><span aria-hidden="true"></span>
                    <span>@CommonText["MonthlyComparison", Workspace.Period.ComparisonLabel]</span>
                </div>
            </div>
            <div class="monthly-header__tools">
                <div class="monthly-freshness">
                    <span><i aria-hidden="true"></i>@GeneratedLabel(Workspace.GeneratedAtUtc)</span>
                    <small>@Workspace.ManagementSummary.CoverageSummary</small>
                </div>
                <div class="monthly-month-nav" aria-label="@CommonText["MonthlyPeriodNavigation"]">
                    <button type="button" aria-label="@CommonText["MonthlyPrevious"]" @onclick="() => ShiftMonth(-1)"><MonthlyWorkspaceIcon Kind="chevron-left" Size="15" /><span>@CommonText["MonthlyPrevious"]</span></button>
                    <button type="button" aria-label="@CommonText["MonthlyNext"]" @onclick="() => ShiftMonth(1)"><span>@CommonText["MonthlyNext"]</span><MonthlyWorkspaceIcon Kind="chevron-right" Size="15" /></button>
                </div>
            </div>
        </header>

        <div class="monthly-dashboard-grid">
            <main class="monthly-primary">
                <div class="monthly-controls">
                    <div class="workspace-periods" role="group" aria-label="@CommonText["WorkspacePeriodLabel"]" data-testid="workspace-period-picker">
                        <button type="button" aria-pressed="false" @onclick='() => PeriodChanged.InvokeAsync("today")'>@CommonText["WorkspacePeriodToday"]</button>
                        <button type="button" class="workspace-periods__active" aria-pressed="true">@CommonText["WorkspacePeriodMonthly"]</button>
                    </div>
                    @if (Workspace.AvailableLenses.Count > 1)
                    {
                        <div class="monthly-lenses" role="group" aria-label="@CommonText["TodayLensPickerLabel"]" data-testid="monthly-lens-picker">
                            @foreach (var lens in Workspace.AvailableLenses)
                            {
                                var active = string.Equals(lens.Value, Workspace.ActiveLens, StringComparison.OrdinalIgnoreCase);
                                <button type="button" class="@(active ? "active" : null)" aria-pressed="@active.ToString().ToLowerInvariant()" title="@lens.AvailabilityReason" @onclick="() => LensChanged.InvokeAsync(lens.Value)">@LensLabel(lens.Value)</button>
                            }
                        </div>
                    }
                </div>

                @if (Workspace.ResponsibilitySetup is { IsConfigured: false } setup)
                {
                    <section class="monthly-notice" data-testid="monthly-responsibility-setup">
                        <div><strong>@CommonText["TodaySetupTitle"]</strong><p>@setup.Message</p></div>
                        @if (setup.CanManage) { <a href="@Resolve(setup.SettingsDeepLink)">@CommonText["TodaySetupAction"]</a> }
                    </section>
                }

                <section class="monthly-summary" data-testid="@(Workspace.IsPartial ? "monthly-partial" : null)" role="@(Workspace.IsPartial ? "status" : null)" aria-labelledby="monthly-summary-title">
                    <span class="monthly-summary__icon"><MonthlyWorkspaceIcon Kind="sparkles" Size="19" /></span>
                    <div><h2 id="monthly-summary-title">@Workspace.ManagementSummary.Headline</h2><p>@Workspace.ManagementSummary.Summary</p><small><i aria-hidden="true"></i>@Workspace.ManagementSummary.CoverageSummary</small></div>
                </section>

                <section class="monthly-results" aria-label="@CommonText["MonthlyResultsLabel"]">
                    @if (Workspace.Results.Count == 0) { <div class="monthly-inline-empty"><strong>@CommonText["MonthlyResultsEmpty"]</strong></div> }
                    @foreach (var result in Workspace.Results.Take(4))
                    {
                        var comparison = MetricComparison(result);
                        <a class="monthly-result monthly-result--@Tone(result.Status)" href="@Resolve(result.DeepLink)" @onclick='() => Record("result", result.DeepLink, result.Key, result.EvidenceSourceType, result.Label)'>
                            <div class="monthly-result__label"><span class="monthly-result__icon monthly-result__icon--@MetricTone(result)"><MonthlyWorkspaceIcon Kind="@MetricIcon(result)" Size="22" /></span><span>@result.Label</span></div>
                            <strong>@result.DisplayValue</strong>
                            @if (result.IsAvailable)
                            {
                                <small class="monthly-result__trend monthly-result__trend--@comparison.Tone">@if (comparison.Direction != 0) { <MonthlyWorkspaceIcon Kind="arrow-up" Size="13" /> }<b>@comparison.Change</b><span>@CommonText["MonthlyComparedWith", result.ComparisonDisplayValue]</span></small>
                                <small class="monthly-result__source">@Workspace.ManagementSummary.CoverageSummary</small>
                            }
                            else { <small class="monthly-result__unavailable" title="@(result.UnavailableReason ?? CommonText["MonthlyUnavailable"])">@(result.UnavailableReason ?? CommonText["MonthlyUnavailable"])</small> }
                        </a>
                    }
                </section>

                <section aria-labelledby="monthly-priorities-title">
                    <div class="monthly-heading"><h2 id="monthly-priorities-title">@CommonText["MonthlyPrioritiesTitle"]</h2><span>@Workspace.Priorities.Count</span></div>
                    @if (Workspace.Priorities.Count == 0)
                    {
                        <div class="monthly-inline-empty" data-testid="monthly-priorities-empty"><strong>@CommonText["MonthlyPrioritiesEmpty"]</strong><p>@CommonText["MonthlyPrioritiesEmptyDescription"]</p></div>
                    }
                    else
                    {
                        <div class="monthly-priorities">
                            @foreach (var priority in Workspace.Priorities.Take(5))
                            {
                                <article class="monthly-priority">
                                    <b class="monthly-priority__rank" aria-label="@CommonText["TodayPriorityRank", priority.Rank]">@priority.Rank</b>
                                    <span class="monthly-priority__icon monthly-feature-icon--@Tone(priority.Freshness)"><MonthlyWorkspaceIcon Kind="@LensIcon(priority.Lens)" Size="21" /></span>
                                    <div class="monthly-priority__copy"><h3>@priority.WhatHappened</h3><p>@priority.WhyItMatters</p></div>
                                    <div class="monthly-priority__person"><small>@CommonText["TodayOwnerLabel"]</small><strong>@priority.ResponsiblePerson</strong></div>
                                    @if (!string.IsNullOrWhiteSpace(priority.WorkingAgent))
                                    {
                                        <div class="monthly-priority__agent"><small>@CommonText["TodayAgentLabel"]</small><span><img src="@AgentPortrait(priority.WorkingAgent)" alt="" /><strong>@priority.WorkingAgent</strong></span></div>
                                    }
                                    <a href="@Resolve(priority.DeepLink)" @onclick='() => Record("priority", priority.DeepLink, priority.Key, priority.EvidenceSourceType, priority.WhatHappened, priority.Rank)'>@CommonText["TodayOpenWorkspace"]</a>
                                    <MonthlyWorkspaceIcon Kind="chevron-right" Size="17" />
                                </article>
                            }
                        </div>
                    }
                </section>

                <section aria-labelledby="monthly-features-title">
                    <div class="monthly-heading"><h2 id="monthly-features-title">@CommonText["MonthlyFeatureReviewTitle"]</h2></div>
                    <div class="monthly-sections">
                        @foreach (var section in Workspace.Sections)
                        {
                            <article class="monthly-section monthly-section--@Tone(section.Status)">
                                <div class="monthly-section__intro"><span class="monthly-section__icon monthly-feature-icon--@Tone(section.Status)"><MonthlyWorkspaceIcon Kind="@LensIcon(section.Lens)" Size="21" /></span><div><h3>@section.Title</h3><p>@section.Summary</p></div></div>
                                <div class="monthly-section__facts">
                                    @foreach (var fact in section.Facts.Take(4)) { <span class="monthly-fact--@Tone(fact.Status)"><i aria-hidden="true"></i><small>@fact.Label</small><strong>@fact.Value</strong></span> }
                                </div>
                                <div class="monthly-section__action"><small class="monthly-coverage monthly-coverage--@Tone(section.Status)"><i aria-hidden="true"></i>@section.CoverageSummary</small><a href="@Resolve(section.SetupDeepLink ?? section.DeepLink)" @onclick='() => Record("section", section.SetupDeepLink ?? section.DeepLink, section.Lens, "monthly_section", section.Title)'>@(section.SetupDeepLink is null ? CommonText["TodayOpenWorkspace"] : CommonText["MonthlySetUpSource"])</a><MonthlyWorkspaceIcon Kind="chevron-right" Size="16" /></div>
                            </article>
                        }
                    </div>
                </section>
            </main>

            <aside class="monthly-rail">
                <section class="monthly-rail-card" data-testid="monthly-decisions">
                    <header><MonthlyWorkspaceIcon Kind="decisions" Size="20" /><h2>@CommonText["MonthlyDecisionsTitle"]</h2><button type="button" aria-label="@CommonText["MonthlyDecisionsTitle"]" aria-expanded="@ShowMobileDecisions" @onclick="ToggleMobileDecisions"><span>@Workspace.Decisions.Count</span><MonthlyWorkspaceIcon Kind="chevron-right" Size="15" /></button></header>
                    <div class="monthly-rail-card__body @(ShowMobileDecisions ? "monthly-rail-card__body--open" : null)">
                        @if (Workspace.Decisions.Count == 0) { <p class="monthly-rail-empty">@CommonText["TodayDecisionsEmpty"]</p> }
                        else
                        {
                            @foreach (var decision in Workspace.Decisions.Take(5))
                            {
                                <a class="monthly-decision" href="@Resolve(decision.DeepLink)" @onclick='() => Record("decision", decision.DeepLink, decision.Key, "decision", decision.Title)'><span class="monthly-decision__icon"><MonthlyWorkspaceIcon Kind="company" Size="16" /></span><div><h3>@decision.Title</h3><p>@decision.Summary</p></div><div><span>@CommonText["TodayReviewAction"]</span><small>@decision.ObservedAtUtc.ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</small></div></a>
                            }
                        }
                    </div>
                    <a class="monthly-rail-footer" href="@DashboardRoutes.BuildApprovalsPath(CompanyId)">@CommonText["TodayViewAllDecisions"] <MonthlyWorkspaceIcon Kind="chevron-right" Size="14" /></a>
                </section>

                <section class="monthly-rail-card" data-testid="monthly-agent-outcomes">
                    <header><MonthlyWorkspaceIcon Kind="agents" Size="20" /><h2>@CommonText["MonthlyAgentOutcomesTitle"]</h2><button type="button" aria-label="@CommonText["MonthlyAgentOutcomesTitle"]" aria-expanded="@ShowMobileOutcomes" @onclick="ToggleMobileOutcomes"><span>@Workspace.AgentOutcomes.Count</span><MonthlyWorkspaceIcon Kind="chevron-right" Size="15" /></button></header>
                    <div class="monthly-rail-card__body @(ShowMobileOutcomes ? "monthly-rail-card__body--open" : null)">
                        @if (Workspace.AgentOutcomes.Count == 0) { <p class="monthly-rail-empty">@CommonText["MonthlyAgentOutcomesEmpty"]</p> }
                        else
                        {
                            @foreach (var group in OutcomeGroups())
                            {
                                <div class="monthly-outcome-group monthly-outcome-group--@group.Tone">
                                    <div class="monthly-outcome-group__header"><span>@group.Label</span><b>@group.Items.Count</b></div>
                                    @foreach (var outcome in group.Items)
                                    {
                                        <article class="monthly-outcome">
                                            @if (!string.IsNullOrWhiteSpace(outcome.DeepLink)) { <a class="monthly-outcome__overlay" aria-label="@outcome.Title" href="@Resolve(outcome.DeepLink)" @onclick='() => Record("agent", outcome.DeepLink!, outcome.Key, outcome.EvidenceSourceType, outcome.Title)'></a> }
                                            <img class="monthly-outcome__avatar" src="@AgentPortrait(outcome.WorkingAgent, outcome.AgentRole)" alt="" /><div><h3>@(outcome.WorkingAgent ?? outcome.Title)</h3><p>@outcome.Summary</p></div><span class="monthly-outcome__state"><MonthlyWorkspaceIcon Kind="@(group.Tone == "danger" ? "warning" : group.Tone == "positive" ? "check" : "arrow-right")" Size="15" /><small>@OutcomeTime(outcome)</small></span>
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </div>
                </section>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public MonthlyWorkspaceViewModel? Workspace { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsUnauthorized { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public EventCallback<string> PeriodChanged { get; set; }
    [Parameter] public EventCallback<string> LensChanged { get; set; }
    [Parameter] public EventCallback<(int Year, int Month)> MonthChanged { get; set; }
    [Parameter] public EventCallback<DashboardActionTelemetryContext> ActionSelected { get; set; }

    private bool ShowMobileDecisions { get; set; }
    private bool ShowMobileOutcomes { get; set; }
    private void ToggleMobileDecisions() => ShowMobileDecisions = !ShowMobileDecisions;
    private void ToggleMobileOutcomes() => ShowMobileOutcomes = !ShowMobileOutcomes;

    private Task ShiftMonth(int offset) { var date = new DateTime(Workspace!.Period.Year, Workspace.Period.Month, 1).AddMonths(offset); return MonthChanged.InvokeAsync((date.Year, date.Month)); }
    private string Resolve(string? route) => DashboardRoutes.EnsureCompanyContext(route, CompanyId, DashboardRoutes.BuildMonthlyPath(CompanyId, Workspace?.ActiveLens, Workspace?.Period.Year, Workspace?.Period.Month));
    private Task Record(string area, string target, string? id, string? source, string? label, int? position = null) => ActionSelected.InvokeAsync(new(area, "open-" + area, Resolve(target), id, source, label, position));
    private string LensLabel(string? lens) => TodayWorkspaceLensValues.Normalize(lens) switch { "finance" => CommonText["TodayFinance"], "sales" => CommonText["TodaySales"], "marketing" => CommonText["TodayMarketing"], "customers" => CommonText["TodayCustomers"], _ => CommonText["TodayCompany"] };
    private static string Tone(string? status) => status?.Trim().ToLowerInvariant() switch { "critical" or "blocked" or "failed" => "danger", "attention" or "unavailable" or "needs_user" => "attention", "positive" or "healthy" or "completed" => "positive", "recommended" => "recommended", _ => "current" };
    private string AgentState(string? state) => state?.Trim().ToLowerInvariant() switch { "blocked" => CommonText["TodayAgentStateBlocked"], "needs_user" => CommonText["TodayAgentStateNeedsUser"], "recommended" => CommonText["TodayAgentStateRecommended"], "completed" => CommonText["TodayAgentStateCompleted"], "working" => CommonText["TodayAgentStateWorking"], _ => CommonText["TodayAgentStateMonitoring"] };

    private string GeneratedLabel(DateTime generatedAtUtc)
    {
        var elapsed = DateTime.UtcNow - generatedAtUtc;
        if (elapsed.TotalMinutes < 1) return CommonText["MonthlyGeneratedNow"];
        if (elapsed.TotalHours < 1) return CommonText["MonthlyGeneratedMinutesAgo", Math.Max(1, (int)elapsed.TotalMinutes)];
        if (elapsed.TotalDays < 1) return CommonText["MonthlyGeneratedHoursAgo", Math.Max(1, (int)elapsed.TotalHours)];
        return CommonText["MonthlyGeneratedDaysAgo", Math.Max(1, (int)elapsed.TotalDays)];
    }

    private static string MetricIcon(MonthlyWorkspaceMetricViewModel metric)
    {
        var value = $"{metric.Key} {metric.Label}".ToLowerInvariant();
        if (value.Contains("revenue")) return "revenue";
        if (value.Contains("pipeline") || value.Contains("sales")) return "sales";
        if (value.Contains("sla") || value.Contains("support")) return "support";
        return "finance";
    }

    private static string MetricTone(MonthlyWorkspaceMetricViewModel metric) => MetricIcon(metric) switch { "sales" => "blue", "support" => "purple", _ => "green" };
    private static string LensIcon(string? lens) => TodayWorkspaceLensValues.Normalize(lens) switch { "finance" => "finance", "sales" => "sales", "marketing" => "marketing", "customers" => "support", _ => "company" };

    private static MetricComparisonView MetricComparison(MonthlyWorkspaceMetricViewModel metric)
    {
        if (!metric.IsAvailable || metric.Value is null || metric.ComparisonValue is null) return new("", "current", 0);
        var difference = metric.Value.Value - metric.ComparisonValue.Value;
        if (difference == 0) return new("0%", "current", 0);
        var points = string.Equals(metric.Unit, "%", StringComparison.OrdinalIgnoreCase) || metric.Label.Contains("SLA", StringComparison.OrdinalIgnoreCase);
        var amount = points ? Math.Abs(difference) : metric.ComparisonValue.Value == 0 ? 100 : Math.Abs(difference / metric.ComparisonValue.Value * 100);
        var direction = difference > 0 ? 1 : -1;
        return new($"{amount:0.#}{(points ? "pp" : "%")}", direction > 0 ? "positive" : "negative", direction);
    }

    private IReadOnlyList<OutcomeGroupView> OutcomeGroups()
    {
        if (Workspace is null) return [];
        var order = new[] { "completed", "blocked", "needs_user", "recommended", "working", "monitoring" };
        return Workspace.AgentOutcomes.Take(8).GroupBy(x => NormalizeAgentState(x.AgentState)).OrderBy(x => Array.IndexOf(order, x.Key)).Select(x => new OutcomeGroupView(AgentState(x.Key), Tone(x.Key), x.ToList())).ToList();
    }

    private static string NormalizeAgentState(string? state) => string.IsNullOrWhiteSpace(state) ? "monitoring" : state.Trim().ToLowerInvariant();
    private static string OutcomeTime(TodayWorkspaceAgentUpdateViewModel outcome) => (outcome.UpdatedUtc ?? outcome.ObservedAtUtc).ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture);
    private static string AgentPortrait(string? agentName, string? agentRole = null)
    {
        var value = $"{agentName} {agentRole}".ToLowerInvariant();
        if (value.Contains("laura") || value.Contains("finance")) return "/images/laura.png";
        if (value.Contains("maya") || value.Contains("marketing")) return "/images/agents/maya-marketing.png";
        if (value.Contains("riley") || value.Contains("support")) return "/images/agents/riley-support.png";
        return "/images/agents/alex-sales.png";
    }

    private sealed record MetricComparisonView(string Change, string Tone, int Direction);
    private sealed record OutcomeGroupView(string Label, string Tone, IReadOnlyList<TodayWorkspaceAgentUpdateViewModel> Items);
}
