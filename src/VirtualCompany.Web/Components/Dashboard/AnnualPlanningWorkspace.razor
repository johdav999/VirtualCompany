@using VirtualCompany.Web.Services
@inject AnnualPlanningApiClient Planning
@inject NavigationManager Navigation
@implements IDisposable
<div class="annual-workspace" data-testid="annual-planning" data-interactive-ready="@interactive.ToString().ToLowerInvariant()">
 <header><span class="planning-kicker">Company planning · Year</span><h1>Annual operating plan</h1><p>Versioned objectives, quarterly checkpoints and referenced expense budgets.</p></header>
 <nav class="workspace-periods" aria-label="Overview period"><a href="@DashboardRoutes.BuildTodayPath(CompanyId,"company")">Today</a><a href="@DashboardRoutes.BuildWeeklyPath(CompanyId,"company")">Week</a><a href="@DashboardRoutes.BuildMonthlyPath(CompanyId,"company")">Month</a><a href="@DashboardRoutes.BuildQuarterlyPath(CompanyId)">Quarter</a><a class="workspace-periods__active" aria-current="page" href="@Path()">Year</a><a href="@($"/dashboard?companyId={CompanyId}&period=multiyear&year={year}&lens=company")">Multi-year</a></nav>
 <div class="annual-fields"><label>Fiscal year<input aria-label="Fiscal year" type="number" min="2000" max="2099" @bind="year" /></label><button class="btn btn-outline-primary" disabled="@busy" @onclick="SelectYear">Open year</button><button class="btn btn-outline-secondary" disabled="@busy" @onclick="Reload">Reload</button></div>
 @if(busy){<p role="status">Loading annual planning…</p>}@if(error!=null){<div role="alert" class="alert alert-danger">@error</div>}
 @if(options!=null){<p class="planning-context">FY @options.Period.FiscalYear · @LocalDate(options.Period.StartUtc) to @LocalDate(options.Period.EndUtc) (end exclusive) · @options.Period.Timezone · @options.Period.Currency</p>
 <div class="annual-layout"><main>
 @if(!editing && document==null){<section class="annual-card"><h2>No annual versions yet</h2><p>Bind objectives to retained quarter actuals and native expense budgets.</p><button class="btn btn-primary" @onclick="New">Prepare annual plan</button></section>}
 @if(editing){<section class="annual-card"><h2>Strategic objectives</h2><label>Add annual objective<select aria-label="Add annual objective" @bind="goal"><option value="@Guid.Empty">Choose native objective</option>@foreach(var g in options.Goals){<option value="@g.Id">@g.Name</option>}</select></label><button class="btn btn-outline-primary" @onclick="AddObjective">Add objective</button>
 @foreach(var r in rows){<article @key="r" class="annual-objective"><h3>@r.Name</h3><p>@r.Key · @r.Unit. Baseline is the native objective's recorded baseline. The selected quarter supplies partial progress evidence; it is not a complete annual actual.</p><div class="annual-fields"><label>Accountable owner<select aria-label="Annual accountable owner" @bind="r.Owner" @bind:after="Dirty"><option value="@Guid.Empty">Choose owner</option>@foreach(var o in options.Owners){<option value="@o.Id">@o.Name</option>}</select></label><label>Baseline quarter review<select aria-label="Baseline quarter review" @bind="r.Source" @bind:after="Dirty"><option value="@Guid.Empty">Choose retained quarter</option>@foreach(var q in options.QuarterReviews){<option value="@q.Id">Q@(q.Quarter) · revision @q.Revision</option>}</select></label><label>Annual target (@r.Unit)<input aria-label="Annual target" type="number" step="0.0001" @bind="r.Target" @bind:after="Dirty" /></label></div>
 <div class="annual-milestones">@foreach(var m in r.Milestones){<div><strong>Q@(m.Quarter)</strong><label>Milestone title<input aria-label="@($"Q{m.Quarter} milestone title")" @bind="m.Title" @bind:after="Dirty" maxlength="200" /></label><label>Due date (@options.Period.Timezone)<input aria-label="@($"Q{m.Quarter} milestone due date")" type="date" @bind="m.Due" @bind:after="Dirty" /></label></div>}</div>
 @foreach(var i in options.Initiatives.Where(i=>i.GoalId==r.Goal)){<label class="annual-check"><input type="checkbox" aria-label="@i.Title" checked="@r.Initiatives.Contains(i.Id)" @onchange="e=>Toggle(r.Initiatives,i.Id,e)" />@i.Title · @i.DependsOn.Count native dependencies</label>}<button class="btn btn-outline-danger btn-sm" @onclick="()=>Remove(r)">Remove objective</button></article>}</section>
 <section class="annual-card"><h2>Finance budget references</h2><p>Select one version per month/account/dimension. Only nonnegative expense budgets in @options.Period.Currency are eligible. Native Finance month labels retain their UTC month convention.</p>@if(options.Budgets.Count==0){<p>No expense budgets in this fiscal year. Create the budget in Finance before planning.</p>}
 @foreach(var b in options.Budgets){<label class="annual-check"><input aria-label="@($"Budget {b.Account} {b.MonthUtc:yyyy-MM} {b.Version}")" type="checkbox" checked="@budgets.Contains(b.Id)" @onchange="e=>Toggle(budgets,b.Id,e)" />@b.Account · @b.MonthUtc.ToString("yyyy-MM") · @b.Version · @b.Amount @b.Currency</label>}</section>
 <section class="annual-card"><h2>Objective, investment and reserve allocations</h2><p>Allocate each referenced expense budget exactly before review. A named reserve keeps unused capacity explicit.</p>@foreach(var a in allocations){<article class="annual-objective" @key="a"><div class="annual-fields"><label>Budget<select aria-label="Allocation budget" @bind="a.Budget" @bind:after="Dirty"><option value="@Guid.Empty">Choose referenced budget</option>@foreach(var b in options.Budgets.Where(b=>budgets.Contains(b.Id))){<option value="@b.Id">@b.Account · @b.MonthUtc.ToString("yyyy-MM") · @b.Version</option>}</select></label><label>Owner<select aria-label="Allocation owner" @bind="a.Owner" @bind:after="Dirty"><option value="@Guid.Empty">Choose owner</option>@foreach(var o in options.Owners){<option value="@o.Id">@o.Name</option>}</select></label><label>Kind<select aria-label="Allocation kind" @bind="a.Kind" @bind:after="Dirty"><option value="investment">Proposed investment</option><option value="objective">Objective</option><option value="reserve">Explicit reserve</option></select></label><label>Objective<select aria-label="Allocation objective" @bind="a.Goal" @bind:after="Dirty"><option value="@Guid.Empty">No objective (investment/reserve)</option>@foreach(var o in rows){<option value="@o.Goal">@o.Name</option>}</select></label><label>Title<input aria-label="Allocation title" @bind="a.Title" @bind:after="Dirty" maxlength="200" /></label><label>Amount (@options.Period.Currency)<input aria-label="Allocation amount" type="number" min="0" step="0.01" @bind="a.Amount" @bind:after="Dirty" /></label><label>Fiscal quarter<select aria-label="Allocation quarter" @bind="a.Quarter" @bind:after="Dirty">@for(int q=1;q<=4;q++){<option value="@q">Q@(q)</option>}</select></label></div><button class="btn btn-outline-secondary btn-sm" @onclick="()=>Remove(a)">Remove allocation</button></article>}<button class="btn btn-outline-primary" @onclick="AddAllocation">Add allocation</button></section>}
 @if(View is {} v){<section class="annual-card"><h2>Annual objectives and progress</h2><div class="annual-kpis"><div><small>Objectives</small><strong>@v.Objectives.Count</strong></div><div><small>Expense budget</small><strong>@v.BudgetTotal @v.Period.Currency</strong></div><div><small>Allocated</small><strong>@v.AllocationTotal @v.Period.Currency</strong></div><div><small>Review blocks</small><strong>@v.ReviewBlocks.Count</strong></div></div>@foreach(var o in v.Objectives){<article class="annual-objective"><h3>@o.Name</h3><p>@o.Owner · baseline @o.Baseline → target @o.Input.Target @o.Input.Unit</p><p>Retained quarter progress: @(o.ProgressPercent?.ToString("0.##")??"unavailable")%. @o.EvidenceState</p><a href="@o.SourceLink">Open retained quarter evidence</a>@if(document != null && preview == null){<p><a href="@DecisionWorkRoutes.Create(CompanyId,"annual",document.Summary.Id,o.Input.GoalId.ToString("D"))">Create work from objective</a></p>}<div class="annual-milestones">@foreach(var m in o.Input.Milestones){<p>Q@(m.Quarter) · @m.Title<br/>@m.DueUtc.ToString("yyyy-MM-dd") UTC</p>}</div>@foreach(var d in o.Dependencies){<p class="alert alert-warning">@d</p>}</article>}</section><section class="annual-card"><h2>Budget reconciliation and proposed investments</h2>@foreach(var b in v.Budgets){<p>@b.Account · @b.MonthUtc.ToString("yyyy-MM") · @b.Version · @b.Amount @b.Currency</p>}@foreach(var a in v.Input.Allocations){<p>@a.Title · @a.Kind · @a.Amount @v.Period.Currency · Q@(a.Quarter) · @Owner(a.OwnerUserId)</p>}@foreach(var block in v.ReviewBlocks){<p class="alert alert-warning">@block</p>}</section>}
 @if(document!=null){<section class="annual-card"><h2>Version comparison</h2><p><a href="@DecisionWorkRoutes.Create(CompanyId,"annual",document.Summary.Id,"decision")">Create work from annual decision</a></p><p>Version @document.Summary.Version · @document.Summary.Status · predecessor @(before?.Summary.Version.ToString()??"none"). The prior version remains readable.</p><ul>@foreach(var change in document.Changes){<li>@change</li>}</ul>@if(before!=null){<a href="@Path(before.Summary.Id)">Open prior version @before.Summary.Version · @before.Summary.Status</a><div class="annual-comparison"><div><h3>Original · @before.Summary.Status</h3>@foreach(var o in before.Plan.Objectives){<p>@o.Name · @o.Owner · @o.Input.Target @o.Input.Unit</p>@foreach(var m in o.Input.Milestones){<p>Q@(m.Quarter) @m.Title</p>}}@foreach(var a in before.Plan.Input.Allocations){<p>@a.Title · @a.Amount @before.Plan.Period.Currency</p>}</div><div><h3>Proposed · @document.Summary.Status</h3>@foreach(var o in document.Plan.Objectives){<p>@o.Name · @o.Owner · @o.Input.Target @o.Input.Unit</p>@foreach(var m in o.Input.Milestones){<p>Q@(m.Quarter) @m.Title</p>}}@foreach(var a in document.Plan.Input.Allocations){<p>@a.Title · @a.Amount @document.Plan.Period.Currency</p>}</div></div>}</section>}
 </main><aside><section class="annual-card"><h2>Proposal and review</h2><p>Draft → Reviewed → Approved</p><p>Approval records intent and budget governance. It does not authorize a payment, posting, publication or customer commitment.</p>@if(editing){<label>Proposal rationale<textarea aria-label="Annual rationale" @bind="notes" @bind:after="Dirty" maxlength="4000"></textarea></label><button class="btn btn-outline-primary" disabled="@busy" @onclick="Preview">Preview validation</button><button class="btn btn-primary" disabled="@(busy||preview==null)" @onclick="Save">Save draft revision</button>}else if(document!=null){<p>Version @document.Summary.Version · <strong>@document.Summary.Status</strong> · state revision @document.Summary.StateRevision</p><p>@document.Plan.Input.Notes</p><button class="btn btn-outline-primary" disabled="@busy" @onclick="Revise">Propose annual revision</button>@if(document.CanReview){<button class="btn btn-primary" disabled="@busy" @onclick="Review">Mark reviewed and request approval</button>}@if(document.Summary.ApprovalId is Guid a){<a class="btn btn-outline-primary" href="@($"/work?companyId={CompanyId}&tab=approvals&itemId={a}")">Open canonical approval</a>}}</section><section class="annual-card"><h2>Annual version history</h2><p>Latest 50 retained versions. Approved versions remain readable.</p>@foreach(var h in history){<p><a href="@Path(h.Id)">Version @h.Version · @h.Status</a><br/><small>@h.SavedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @Owner(h.AuthorUserId)</small></p>}</section></aside></div>}
</div>
@code{
 [Parameter]public Guid CompanyId{get;set;}[Parameter]public int? FiscalYear{get;set;}[Parameter]public Guid? PlanId{get;set;}
 private AnnualPlanningOptions? options;private AnnualPlanDocument? document,before;private AnnualPlanPreview? preview;private IReadOnlyList<AnnualPlanSummary> history=[];private bool busy,editing,interactive,disposed;private string? error;private int year;private Guid goal,request=Guid.NewGuid();private string notes="";private readonly List<Row> rows=[];private readonly HashSet<Guid> budgets=[];private readonly List<Allocation> allocations=[];private CancellationTokenSource? load;
 private AnnualPlanPreview? View=>preview??(!editing?document?.Plan:null);
 protected override async Task OnParametersSetAsync()=>await Reload();protected override void OnAfterRender(bool first){if(first){interactive=true;StateHasChanged();}}
 private string Path(Guid? id=null)=>$"/dashboard/planning/year?companyId={CompanyId}&year={year}"+(id.HasValue?$"&plan={id}":"");
 private async Task Reload(){load?.Cancel();load?.Dispose();var current=new CancellationTokenSource();load=current;busy=true;error=null;options=null;document=null;before=null;preview=null;history=[];rows.Clear();allocations.Clear();budgets.Clear();editing=false;year=FiscalYear??DateTime.UtcNow.Year;try{var o=await Planning.Options(CompanyId,year,current.Token);var hs=await Planning.History(CompanyId,year,current.Token);var id=PlanId??hs.FirstOrDefault()?.Id;var d=id.HasValue?await Planning.Open(CompanyId,id.Value,current.Token):null;var b=d?.Summary.PreviousId is Guid p?await Planning.Open(CompanyId,p,current.Token):null;if(current!=load||disposed)return;if(o.Period.FiscalYear!=year||hs.Any(x=>x.FiscalYear!=year)||d!=null&&(d.Summary.Id!=id||d.Summary.FiscalYear!=year))throw new InvalidDataException("Annual period/version response differs from this link.");options=o;history=hs;document=d;before=b;}catch(OperationCanceledException){}catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or TodayWorkspaceAccessException){if(current==load&&!disposed)error=e is TodayWorkspaceAccessException?"Annual planning is unavailable for the current membership and source access.":e.Message;}finally{if(current==load&&!disposed)busy=false;}}
 private void SelectYear()=>Navigation.NavigateTo(Path());private void Dirty(){preview=null;request=Guid.NewGuid();}private void New(){editing=true;document=null;before=null;rows.Clear();budgets.Clear();allocations.Clear();notes="";Dirty();}
 private void AddObjective(){if(options==null||rows.Any(x=>x.Goal==goal))return;var g=options.Goals.SingleOrDefault(x=>x.Id==goal);if(g==null)return;var z=TimeZoneInfo.FindSystemTimeZoneById(options.Period.Timezone);var start=TimeZoneInfo.ConvertTimeFromUtc(options.Period.StartUtc,z);rows.Add(new(){Goal=g.Id,Version=g.Version,Name=g.Name,Key=g.MetricKey??"",Unit=g.MetricUnit??"",Owner=g.OwnerUserId??Guid.Empty,Target=g.TargetValue??0,Milestones=Enumerable.Range(1,4).Select(q=>new Milestone{Quarter=q,Due=start.AddMonths(q*3).AddDays(-1).Date}).ToList()});Dirty();}
 private void AddAllocation(){allocations.Add(new());Dirty();}private void Remove(Row r){rows.Remove(r);Dirty();}private void Remove(Allocation a){allocations.Remove(a);Dirty();}private void Toggle(HashSet<Guid> values,Guid id,ChangeEventArgs e){if(e.Value is true)values.Add(id);else values.Remove(id);Dirty();}
 private AnnualPlanInput Input()=>new(year,rows.Select(r=>new AnnualObjectiveInput(r.Goal,r.Version,r.Owner,r.Source,r.Target,r.Unit,r.Milestones.Select(m=>new AnnualMilestoneInput(m.Quarter,m.Title,m.OriginalUtc is {} original&&TimeZoneInfo.ConvertTimeFromUtc(original,TimeZoneInfo.FindSystemTimeZoneById(options!.Period.Timezone)).Date==m.Due.Date?original:TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(m.Due.Date,DateTimeKind.Unspecified),TimeZoneInfo.FindSystemTimeZoneById(options!.Period.Timezone)))).ToArray(),r.Initiatives.Order().ToArray())).ToArray(),budgets.Order().ToArray(),allocations.Select(a=>new AnnualAllocationInput(a.Budget,a.Owner,a.Goal==Guid.Empty?null:a.Goal,a.Kind,a.Title,a.Amount,a.Quarter)).ToArray(),notes);
 private async Task Run(Func<CancellationToken,Task> action){if(load==null||busy)return;var current=load;busy=true;error=null;try{await action(current.Token);}catch(OperationCanceledException){}catch(Exception e)when(e is HttpRequestException or InvalidOperationException or InvalidDataException or TodayWorkspaceAccessException or ArgumentException){if(current==load&&!disposed)error=e is TodayWorkspaceAccessException?"Annual planning is unavailable for the current membership and source access.":e.Message;}finally{if(current==load&&!disposed)busy=false;}}
 private Task Preview()=>Run(async ct=>{var i=Input();var p=await Planning.Preview(CompanyId,i,ct);if(!disposed&&!ct.IsCancellationRequested){if(System.Text.Json.JsonSerializer.Serialize(p.Input)!=System.Text.Json.JsonSerializer.Serialize(i))throw new InvalidDataException("Preview differs from current annual inputs.");preview=p;}});
 private Task Save()=>Run(async ct=>{var last=document?.Summary??history.FirstOrDefault();var p=preview??throw new InvalidOperationException("Preview this draft first.");var d=await Planning.Save(CompanyId,new(Input(),last?.Id,last?.Version??0,request,p.Fingerprint),ct);if(!disposed&&!ct.IsCancellationRequested)Navigation.NavigateTo(Path(d.Summary.Id));});
 private Task Review()=>Run(async ct=>{var d=document??throw new InvalidOperationException();var r=await Planning.Review(CompanyId,d.Summary.Id,new(d.Summary.StateRevision,d.Plan.Fingerprint),ct);if(!disposed&&!ct.IsCancellationRequested){document=r;history=await Planning.History(CompanyId,year,ct);}});
 private void Revise(){if(document==null||options==null)return;editing=true;notes=document.Plan.Input.Notes;rows.Clear();budgets.Clear();allocations.Clear();foreach(var x in document.Plan.Input.Objectives){var view=document.Plan.Objectives.Single(v=>v.Input.GoalId==x.GoalId);rows.Add(new(){Goal=x.GoalId,Version=x.GoalVersion,Name=view.Name,Key=view.MetricKey,Unit=x.Unit,Owner=x.OwnerUserId,Source=x.BaselineReviewId,Target=x.Target,Initiatives=x.InitiativeIds.ToHashSet(),Milestones=x.Milestones.Select(m=>new Milestone{Quarter=m.Quarter,Title=m.Title,Due=TimeZoneInfo.ConvertTimeFromUtc(m.DueUtc,TimeZoneInfo.FindSystemTimeZoneById(options.Period.Timezone)).Date,OriginalUtc=m.DueUtc}).ToList()});}foreach(var id in document.Plan.Input.BudgetIds)budgets.Add(id);foreach(var a in document.Plan.Input.Allocations)allocations.Add(new(){Budget=a.BudgetId,Owner=a.OwnerUserId,Goal=a.GoalId??Guid.Empty,Kind=a.Kind,Title=a.Title,Amount=a.Amount,Quarter=a.Quarter});Dirty();}
 private string LocalDate(DateTime utc)=>TimeZoneInfo.ConvertTimeFromUtc(utc,TimeZoneInfo.FindSystemTimeZoneById(options!.Period.Timezone)).ToString("yyyy-MM-dd");
 private string Owner(Guid id)=>options?.Owners.SingleOrDefault(x=>x.Id==id)?.Name??"Retained member";public void Dispose(){disposed=true;load?.Cancel();load?.Dispose();}
 private sealed class Row{public Guid Goal,Owner,Source;public int Version;public string Name="",Key="",Unit="";public decimal Target;public List<Milestone> Milestones=[];public HashSet<Guid> Initiatives=[];}
 private sealed class Milestone{public int Quarter;public string Title="";public DateTime Due;public DateTime? OriginalUtc;}
 private sealed class Allocation{public Guid Budget,Owner,Goal;public string Kind="investment",Title="";public decimal Amount;public int Quarter=1;}
}
