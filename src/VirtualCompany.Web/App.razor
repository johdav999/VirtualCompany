@using System.Globalization
@inject IStringLocalizer<CommonResources> CommonText
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css?v=20260825-swedish-statutory-reporting" />
    <link rel="stylesheet" href="css/guided-documents.css?v=20260814-collapsible-documents" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="@Assets["VirtualCompany.Web.styles.css"]?v=20260828-statement-import-center-r2" />
    <HeadOutlet />
</head>
<body>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@CommonText["NotFoundPageTitle"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">@CommonText["NotFoundMessage"]</p>
            </LayoutView>
        </NotFound>
    </Router>
    <div id="components-reconnect-modal" class="components-reconnect-hide" role="status" aria-live="assertive" aria-atomic="true">
        <section class="vc-reconnect-card" aria-label="@CommonText["ConnectionStatus"]">
            <span class="vc-reconnect-spinner" aria-hidden="true"></span>
            <div class="vc-reconnect-copy vc-reconnect-copy--connecting">
                <strong>@CommonText["Reconnecting"]</strong>
                <p>@CommonText["ReconnectInProgress"]</p>
                <small>@CommonText["ReconnectAttempt"] <span id="components-reconnect-current-attempt"></span> @CommonText["Of"] <span id="components-reconnect-max-retries"></span></small>
            </div>
            <div class="vc-reconnect-copy vc-reconnect-copy--failed">
                <strong>@CommonText["ConnectionLost"]</strong>
                <p>@CommonText["ReconnectFailedHelp"]</p>
                <button class="btn btn-primary" type="button" onclick="window.location.reload()">@CommonText["ReloadPage"]</button>
            </div>
            <div class="vc-reconnect-copy vc-reconnect-copy--paused">
                <strong>@CommonText["ConnectionPaused"]</strong>
                <p>@CommonText["ConnectionPausedHelp"]</p>
            </div>
        </section>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/localization.js"></script>
    <script src="js/appShell.js"></script>
</body>
</html>
