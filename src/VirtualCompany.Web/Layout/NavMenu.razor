@inject OnboardingApiClient ApiClient
@inject FinanceAccessResolver FinanceAccessResolver
@inject AgentApiClient AgentApiClient
@inject FinanceIntegrationApplicationApiClient FinanceProviderAdminApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<NavigationResources> NavigationText
@implements IDisposable

@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using VirtualCompany.Web.Localization
@using VirtualCompany.Shared

<div class="top-row navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="@dashboardHref">Virtual Company</a>
        <button @ref="menuButton"
                type="button"
                title="@NavigationText["NavigationMenu"]"
                aria-label="@NavigationText["NavigationMenu"]"
                aria-expanded="@(!collapseNavMenu)"
                aria-controls="vc-primary-navigation"
                class="navbar-toggler"
                @onclick="ToggleNavMenuAsync">
            <span class="nav-menu-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

@if (!collapseNavMenu)
{
    <button type="button"
            class="nav-drawer-backdrop"
            aria-label="@NavigationText["CloseNavigation"]"
            @onclick="CloseNavMenuAsync"></button>
}

<div id="vc-primary-navigation"
     @ref="menuPanel"
     class="@NavMenuCssClass nav-scrollable"
     role="dialog"
     aria-modal="@(!collapseNavMenu)"
     aria-label="@NavigationText["NavigationMenu"]">
    <div class="nav-menu-shell">
        <div class="nav-drawer-heading">
            <span>@NavigationText["NavigationMenu"]</span>
            <button type="button"
                    class="nav-drawer-close"
                    aria-label="@NavigationText["CloseNavigation"]"
                    @onclick="CloseNavMenuAsync">
                <span class="bi bi-x-lg" aria-hidden="true"></span>
            </button>
        </div>

        <nav class="nav flex-column nav-menu-primary" aria-label="@NavigationText["PrimaryNavigation"]">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@dashboardHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-overview" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </span>
                    <span>@NavigationText["Overview"]</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@agentStaffHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-agents" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <circle cx="12" cy="7" r="3"></circle>
                            <circle cx="5.5" cy="9" r="2.25"></circle>
                            <circle cx="18.5" cy="9" r="2.25"></circle>
                            <path d="M7 20v-1.5A4.5 4.5 0 0 1 11.5 14h1a4.5 4.5 0 0 1 4.5 4.5V20"></path>
                            <path d="M2 19v-1a3.5 3.5 0 0 1 3.5-3.5H7"></path>
                            <path d="M22 19v-1a3.5 3.5 0 0 0-3.5-3.5H17"></path>
                        </svg>
                    </span>
                    <span>@NavigationText["AgentTeam"]</span>
                </NavLink>
            </div>
            @if (!string.IsNullOrWhiteSpace(financeHref))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@financeHref" @onclick="CloseNavMenuAsync">
                        <span class="nav-icon nav-icon-finance" aria-hidden="true"></span>
                        <span>@NavigationText["Finance"]</span>
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@salesHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-sales" aria-hidden="true"></span>
                    <span>@NavigationText["Sales"]</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@marketingHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-marketing" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 10v4a2 2 0 0 0 2 2h2l8 4V4L8 8H6a2 2 0 0 0-2 2Z"></path>
                            <path d="M8 16l1.5 4"></path>
                            <path d="M19 8.5a4.5 4.5 0 0 1 0 7"></path>
                        </svg>
                    </span>
                    <span>@NavigationText["Marketing"]</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@supportHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-support" aria-hidden="true"></span>
                    <span>@NavigationText["Support"]</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@workHref" @onclick="CloseNavMenuAsync">
                    <span class="nav-icon nav-icon-work" aria-hidden="true"></span>
                    <span>@NavigationText["Work"]</span>
                </NavLink>
            </div>
        </nav>

        <div class="nav-menu-bottom">
            <ContextualAgentSidebarCard
                AgentName="@sidebarAgent.AgentName"
                AgentRole="@sidebarAgent.AgentRole"
                AvatarUrl="@sidebarAgent.AvatarUrl"
                Message="@sidebarAgent.Message"
                ButtonText="@sidebarAgent.ButtonText"
                ButtonRoute="@sidebarAgent.ButtonRoute"
                ModuleKey="@sidebarAgent.ModuleKey" />

            @if (!string.IsNullOrWhiteSpace(simulationLabHref) || !string.IsNullOrWhiteSpace(systemAdminHref))
            {
                <nav class="nav flex-column nav-menu-restricted" aria-label="@NavigationText["RestrictedNavigation"]">
                    <div class="nav-section-label">@NavigationText["RestrictedTools"]</div>
                    @if (!string.IsNullOrWhiteSpace(simulationLabHref))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@simulationLabHref" @onclick="CloseNavMenuAsync">
                                <span class="nav-icon nav-icon-simulation" aria-hidden="true"></span>
                                <span>@NavigationText["SimulationLab"]</span>
                            </NavLink>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(systemAdminHref))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@systemAdminHref" @onclick="CloseNavMenuAsync">
                                <span class="nav-icon nav-icon-admin" aria-hidden="true"></span>
                                <span>@NavigationText["SystemAdmin"]</span>
                            </NavLink>
                        </div>
                    }
                </nav>
            }

            <nav class="nav flex-column nav-menu-settings" aria-label="@NavigationText["SettingsNavigation"]">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@historyHref" @onclick="CloseNavMenuAsync">
                        <span class="nav-icon nav-icon-history" aria-hidden="true"></span>
                        <span>@NavigationText["History"]</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@settingsHref" @onclick="CloseNavMenuAsync">
                        <span class="nav-icon nav-icon-settings" aria-hidden="true"></span>
                        <span>@NavigationText["Settings"]</span>
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>
</div>

<form id="vc-culture-sync-nav" method="post" action="/localization/apply" class="visually-hidden" aria-hidden="true">
    <AntiforgeryToken />
    <input type="hidden" name="culture" value="@pendingCulture" />
    <input type="hidden" name="returnUrl" value="@pendingReturnUrl" />
</form>

@code {
    private bool collapseNavMenu = true;
    private string? financeHref;
    private string? simulationLabHref;
    private string? systemAdminHref;
    private Guid? currentCompanyId;
    private CurrentUserContextViewModel? currentUser;
    private string dashboardHref = "/dashboard";
    private string salesHref = "/app/sales";
    private string marketingHref = "/marketing";
    private string supportHref = "/support";
    private string agentStaffHref = "/agents/staff";
    private string agentsHref = "/agents";
    private string workHref = "/work";
    private string historyHref = "/history";
    private string settingsHref = "/settings";
    private ElementReference menuButton;
    private ElementReference menuPanel;
    private SidebarAgentContext sidebarAgent = SidebarAgentContext.Default("/agents");
    private int sidebarAgentRefreshVersion;
    private int navigationRefreshVersion;
    private string? pendingCulture;
    private string pendingReturnUrl = "/";
    private bool cultureSyncSubmitted;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await RefreshNavigationContextAsync(reloadCurrentUser: true);
    }

    private async Task ToggleNavMenuAsync()
    {
        collapseNavMenu = !collapseNavMenu;
        await JS.InvokeVoidAsync("virtualCompanyShell.setDrawerState", !collapseNavMenu, menuButton, menuPanel);
    }

    private async Task CloseNavMenuAsync()
    {
        if (collapseNavMenu)
        {
            return;
        }

        collapseNavMenu = true;
        await JS.InvokeVoidAsync("virtualCompanyShell.setDrawerState", false, menuButton, menuPanel);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = RefreshNavigationContextAsync(reloadCurrentUser: true);
    }

    private async Task RefreshNavigationContextAsync(bool reloadCurrentUser)
    {
        var refreshVersion = ++navigationRefreshVersion;

        try
        {
            if (reloadCurrentUser || currentUser is null)
            {
                currentUser = await ApiClient.GetCurrentUserContextAsync();
                QueuePersistedCultureSync();
            }
        }
        catch (OnboardingApiException)
        {
            if (currentUser is null)
            {
                financeHref = null;
                simulationLabHref = null;
                systemAdminHref = null;
                sidebarAgent = SidebarAgentContext.Default("/agents");
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        if (refreshVersion != navigationRefreshVersion)
        {
            return;
        }

        await RefreshFinanceHrefAsync();
        await RefreshContextualAgentAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFinanceHrefAsync()
    {
        currentCompanyId = TryGetCompanyIdFromUri(Navigation.Uri) ?? currentUser?.ActiveCompany?.CompanyId;
        financeHref = FinanceAccessResolver.BuildNavigationHref(currentUser, currentCompanyId);
        simulationLabHref = BuildRestrictedAreaHref(FinanceRoutes.SandboxAdmin);
        systemAdminHref = await ResolveSystemAdminHrefAsync();
        dashboardHref = DashboardRoutes.EnsureCompanyContext("/dashboard", currentCompanyId, "/dashboard");
        salesHref = currentCompanyId is Guid salesCompanyId ? $"/app/sales?companyId={salesCompanyId:D}" : "/app/sales";
        marketingHref = DashboardRoutes.EnsureCompanyContext("/marketing", currentCompanyId, "/marketing");
        supportHref = currentCompanyId is Guid supportCompanyId ? $"/support?companyId={supportCompanyId:D}" : "/support";
        agentStaffHref = DashboardRoutes.EnsureCompanyContext("/agents/staff", currentCompanyId, "/agents/staff");
        agentsHref = DashboardRoutes.EnsureCompanyContext("/agents", currentCompanyId, "/agents");
        workHref = DashboardRoutes.EnsureCompanyContext("/work", currentCompanyId, "/work");
        historyHref = DashboardRoutes.EnsureCompanyContext("/history", currentCompanyId, "/history");
        settingsHref = DashboardRoutes.EnsureCompanyContext("/settings", currentCompanyId, "/settings");
    }

    private async Task<string?> ResolveSystemAdminHrefAsync()
    {
        try
        {
            await FinanceProviderAdminApiClient.GetAllAsync();
            return FinanceRoutes.FinanceProviderManagement;
        }
        catch (FinanceIntegrationApplicationApiException)
        {
            return BuildRestrictedAreaHref(FinanceRoutes.EmailProviderSettings);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cultureSyncSubmitted || string.IsNullOrWhiteSpace(pendingCulture))
        {
            return;
        }

        cultureSyncSubmitted = true;
        await JS.InvokeVoidAsync("virtualCompanyLocalization.submit", "vc-culture-sync-nav");
    }

    private void QueuePersistedCultureSync()
    {
        var savedCulture = currentUser?.User.UiCulture;
        if (!LocalizationRequestPolicy.ShouldSynchronize(savedCulture, CultureInfo.CurrentUICulture.Name) ||
            !SupportedWebCultures.TryNormalize(savedCulture, out var normalized))
        {
            pendingCulture = null;
            return;
        }

        pendingCulture = normalized;
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        pendingReturnUrl = string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
    }

    private async Task RefreshContextualAgentAsync()
    {
        var refreshVersion = ++sidebarAgentRefreshVersion;
        var moduleKey = ResolveModuleKey();
        var fallback = BuildFallbackSidebarAgent(moduleKey);
        sidebarAgent = fallback;

        if (currentCompanyId is not Guid companyId)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var roster = await AgentApiClient.GetRosterAsync(companyId);
            var agent = FindContextualAgent(roster, moduleKey);
            if (agent is null || refreshVersion != sidebarAgentRefreshVersion)
            {
                return;
            }

            sidebarAgent = fallback with
            {
                AgentRole = IsFixedDisplayName(moduleKey) || string.IsNullOrWhiteSpace(agent.RoleName) ? fallback.AgentRole : agent.RoleName,
                AvatarUrl = ResolveSidebarAvatarUrl(agent.AvatarUrl, fallback.AvatarUrl),
                ButtonRoute = IsDirectChatEligible(agent.Status) ? BuildChatUri(companyId, agent.Id) : agentsHref
            };

            if (!IsFixedDisplayName(moduleKey) && !string.IsNullOrWhiteSpace(agent.DisplayName))
            {
                sidebarAgent = sidebarAgent with
                {
                    AgentName = agent.DisplayName,
                    ButtonText = $"Message {agent.DisplayName}"
                };
            }
        }
        catch (OnboardingApiException)
        {
            sidebarAgent = fallback;
        }

        await InvokeAsync(StateHasChanged);
    }

    private SidebarAgentContext BuildFallbackSidebarAgent(string moduleKey)
    {
        var route = agentsHref;
        return moduleKey switch
        {
            "finance" => new SidebarAgentContext(
                "finance",
                "Laura",
                "Finance Manager",
                "/images/laura.png",
                "I'm here to watch your finances and let you know what needs attention.",
                "Message Laura",
                route),
            "sales" => new SidebarAgentContext(
                "sales",
                "Alex",
                "Sales Manager",
                "/images/paul.png",
                "I'm watching your pipeline and surfacing the follow-ups that need attention.",
                "Message sales",
                route),
            "marketing" => new SidebarAgentContext(
                "marketing",
                "Maya",
                "Marketing Manager",
                null,
                "I'm coordinating campaigns, content, audiences, and measurable marketing outcomes.",
                "Message Maya",
                route),
            "support" => new SidebarAgentContext(
                "support",
                "Support agent",
                "Customer Support Manager",
                null,
                "I'm tracking customer conversations and highlighting issues that need a response.",
                "Message support",
                route),
            _ => SidebarAgentContext.Default(route)
        };
    }

    private static CompanyAgentSummaryViewModel? FindContextualAgent(IEnumerable<CompanyAgentSummaryViewModel> roster, string moduleKey)
    {
        var expectedDepartment = moduleKey switch
        {
            "finance" => "Finance",
            "sales" => "Sales",
            "marketing" => "Marketing",
            "support" => "Support",
            _ => "Executive"
        };

        return roster
            .Where(agent => !string.Equals(agent.Status, "archived", StringComparison.OrdinalIgnoreCase))
            .FirstOrDefault(agent => string.Equals(agent.Department, expectedDepartment, StringComparison.OrdinalIgnoreCase))
            ?? roster.FirstOrDefault(agent => string.Equals(agent.TemplateId, moduleKey, StringComparison.OrdinalIgnoreCase));
    }

    private string ResolveModuleKey()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativePath.Split('?', '#')[0].Trim('/').ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(path) || path.StartsWith("dashboard", StringComparison.Ordinal))
        {
            return "dashboard";
        }

        if (path.StartsWith("finance", StringComparison.Ordinal))
        {
            return "finance";
        }

        if (path.StartsWith("sales", StringComparison.Ordinal) || path.StartsWith("app/sales", StringComparison.Ordinal))
        {
            return "sales";
        }

        if (path.StartsWith("marketing", StringComparison.Ordinal))
        {
            return "marketing";
        }

        if (path.StartsWith("support", StringComparison.Ordinal))
        {
            return "support";
        }

        return "dashboard";
    }

    private static bool IsFixedDisplayName(string moduleKey) =>
        string.Equals(moduleKey, "finance", StringComparison.OrdinalIgnoreCase);

    private static bool IsDirectChatEligible(string? status) =>
        !string.Equals(status, "paused", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(status, "archived", StringComparison.OrdinalIgnoreCase);

    private static string? ResolveSidebarAvatarUrl(string? avatarUrl, string? fallbackAvatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
        {
            return fallbackAvatarUrl;
        }

        return avatarUrl.Trim() switch
        {
            "/avatars/agents/finance-manager.png" => "/images/laura.png",
            "/avatars/agents/laura-finance.png" => "/images/laura.png",
            var value => value
        };
    }

    private static string BuildChatUri(Guid companyId, Guid agentId) =>
        $"/agents/{agentId}/chat?companyId={companyId:D}";

    private string? BuildRestrictedAreaHref(string path)
    {
        if (financeHref is null || currentCompanyId is not Guid companyId)
        {
            return null;
        }

        var state = FinanceAccessResolver.Resolve(currentUser, companyId);
        return state.IsAllowed && FinanceAccess.CanAccessSandboxAdmin(state.MembershipRole)
            ? FinanceRoutes.WithCompanyContext(path, companyId)
            : null;
    }

    private static Guid? TryGetCompanyIdFromUri(string uri)
    {
        var absoluteUri = new Uri(uri, UriKind.Absolute);
        if (!QueryHelpers.ParseQuery(absoluteUri.Query).TryGetValue(FinanceRoutes.CompanyIdQueryKey, out var values))
        {
            return null;
        }

        return Guid.TryParse(values.FirstOrDefault(), out var companyId) ? companyId : null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private sealed record SidebarAgentContext(
        string ModuleKey,
        string AgentName,
        string AgentRole,
        string? AvatarUrl,
        string Message,
        string ButtonText,
        string? ButtonRoute)
    {
        public static SidebarAgentContext Default(string? buttonRoute) =>
            new(
                "dashboard",
                "Company Assistant",
                "Primary Agent",
                null,
                "I'm keeping an eye on company activity and surfacing what needs attention.",
                "Message assistant",
                buttonRoute);
    }
}
