@page "/dashboard"
@inject TodayPriorityChanges PriorityChanges
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject OnboardingApiClient ApiClient
@inject ITodayWorkspaceApiClient TodayWorkspaceApiClient
@inject IMonthlyWorkspaceApiClient MonthlyWorkspaceApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDashboardInteractionService DashboardInteractionService
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using VirtualCompany.Web.Services

<PageTitle>@(IsMonthly ? CommonText["MonthlyPageTitle"] : CommonText["TodayPageTitle"])</PageTitle>

@if (!isLoading && CompanyId is null)
{
    <section class="py-4 dashboard-hero">
        <div class="dashboard-shell">
            <div class="wizard-card dashboard-summary">
                <span class="dashboard-kicker">@CommonText["DashboardChooseCompanyKicker"]</span>
                <h1>@CommonText["DashboardChooseCompany"]</h1>
                <p class="lead mb-3">@CommonText["DashboardChooseCompanyDescription"]</p>
                <div class="dashboard-actions">
                    <a class="btn btn-primary" href="onboarding">@CommonText["DashboardResumeOnboarding"]</a>
                </div>

                @if (ActiveMemberships.Count > 0)
                {
                    <div class="template-grid mt-4">
                        @foreach (var membership in ActiveMemberships)
                        {
                            <a class="template-card text-decoration-none text-reset" href="@DashboardRoutes.BuildTodayPath(membership.CompanyId)">
                                <strong>@membership.CompanyName</strong>
                                <div class="text-body-secondary mt-2">@CommonText["DashboardMembership", FormatMembershipRole(membership.MembershipRole), FormatMembershipStatus(membership.Status)]</div>
                                <div class="text-body-secondary mt-1">@DescribeCompany(membership)</div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-body-secondary mt-4 mb-0">@CommonText["DashboardNoMembership"]</p>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger mt-4 mb-0" role="alert">@errorMessage</div>
                }
            </div>

            <div class="wizard-card wizard-card--compact">
                <h2 class="h5">@CommonText["DashboardHandoff"]</h2>
                <ul class="mb-0">
                    <li>@CommonText["DashboardHandoffIncomplete"]</li>
                    <li>@CommonText["DashboardHandoffComplete"]</li>
                </ul>
            </div>
        </div>
    </section>
}
else
{
    <section class="dashboard-hero today-dashboard-page @(IsMonthly ? "today-dashboard-page--monthly" : "today-dashboard-page--today")">
        @if (IsMonthly)
        {
            <MonthlyWorkspace CompanyId="@(CompanyId ?? Guid.Empty)"
                              Workspace="monthlyWorkspace"
                              IsLoading="isLoading"
                              IsUnauthorized="isUnauthorized"
                              ErrorMessage="@errorMessage"
                              RetryRequested="ReloadAsync"
                              PeriodChanged="ChangePeriodAsync"
                              LensChanged="ChangeLensAsync"
                              MonthChanged="ChangeMonthAsync"
                              ActionSelected="HandleWorkspaceActionAsync" />
        }
        else
        {
            <TodayWorkspace CompanyId="@(CompanyId ?? Guid.Empty)"
                            Workspace="todayWorkspace"
                            IsLoading="isLoading"
                            IsUnauthorized="isUnauthorized"
                            ErrorMessage="@errorMessage"
                            RetryRequested="ReloadAsync"
                            PeriodChanged="ChangePeriodAsync"
                            LensChanged="ChangeLensAsync"
                            ReviewRequested="RequestReviewAsync"
                            ChangedCount="priorityChanges.Changed" RemovedCount="priorityChanges.Removed" PreviousCheck="priorityChanges.PreviousCheck"
                            ActionSelected="HandleWorkspaceActionAsync" />
        }
    </section>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "lens")]
    public string? Lens { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "period")]
    public string? Period { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "year")]
    public int? Year { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "month")]
    public int? Month { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "welcome")]
    public string? Welcome { get; set; }

    private bool isLoading = true;
    private bool isUnauthorized;
    private CurrentUserContextViewModel? currentUser;
    private OnboardingProgressViewModel? onboardingProgress;
    private CompanyAccessViewModel? companyAccess;
    private CompanyDashboardEntryViewModel? dashboardEntry;
    private TodayWorkspaceViewModel? todayWorkspace;
    private MonthlyWorkspaceViewModel? monthlyWorkspace;
    private (int Changed, int Removed, DateTime? PreviousCheck) priorityChanges;
    private string? errorMessage;
    private IJSObjectReference? telemetryModule;
    private DotNetObjectReference<Dashboard>? dotNetReference;
    private string? scrollTrackerId;
    private Guid? trackedInteractionCompanyId;

    private IReadOnlyList<CompanyMembershipViewModel> ActiveMemberships =>
        currentUser?.Memberships
            .Where(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase))
            .ToList()
        ?? [];

    private bool IsMonthly => string.Equals(Period, "month", StringComparison.OrdinalIgnoreCase);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private CancellationTokenSource? loadCancellation;
    private int loadVersion;
    private bool disposed;
    private bool IsDashboardLocation => string.Equals(new Uri(Navigation.Uri).AbsolutePath, "/dashboard", StringComparison.OrdinalIgnoreCase);

    private Task LoadAsync() => LoadWorkspaceAsync(false);
    private async Task LoadWorkspaceAsync(bool refresh)
    {
        // Query subscriptions can update the departing component before the router disposes it.
        // Never canonicalize the Overview over a business-record navigation.
        if (!IsDashboardLocation)
        {
            loadVersion++;
            loadCancellation?.Cancel();
            return;
        }
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        var cancellation = loadCancellation = new CancellationTokenSource();
        var token = cancellation.Token;
        var version = ++loadVersion;
        var requestedCompany = CompanyId;
        var requestedLens = TodayWorkspaceLensValues.Normalize(Lens);
        var requestedMonthly = IsMonthly;
        var requestedYear = Year;
        var requestedMonth = Month;
        bool IsCurrent() => !disposed && IsDashboardLocation && version == loadVersion && !token.IsCancellationRequested;

        isLoading = true;
        isUnauthorized = false;
        errorMessage = null;
        todayWorkspace = null;
        monthlyWorkspace = null;
        companyAccess = null;
        dashboardEntry = null;
        onboardingProgress = null;

        try
        {
            var user = await ApiClient.GetCurrentUserContextAsync(requestedCompany, token);
            if (!IsCurrent()) return;
            currentUser = user;

            if (requestedCompany is Guid selected &&
                (selected == Guid.Empty || !ActiveMemberships.Any(x => x.CompanyId == selected)))
            {
                isUnauthorized = true;
                return;
            }

            var progress = requestedCompany is Guid scopedCompanyId
                ? await ApiClient.GetProgressAsync(scopedCompanyId, token)
                : user?.ActiveCompany is { } activeCompany
                    ? await ApiClient.GetProgressAsync(activeCompany.CompanyId, token)
                    : null;
            if (!IsCurrent()) return;
            onboardingProgress = progress;

            if (requestedCompany is not Guid companyId)
            {
                if (progress?.CanResume == true || string.Equals(progress?.Status, "in_progress", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/onboarding", replace: true);
                    return;
                }
                if (user?.ActiveCompany is { } active && ActiveMemberships.Any(x => x.CompanyId == active.CompanyId))
                    Navigation.NavigateTo(DashboardRoutes.BuildTodayPath(active.CompanyId), replace: true);
                return;
            }

            var access = await ApiClient.GetCompanyAccessAsync(companyId, token);
            if (!IsCurrent()) return;
            companyAccess = access;
            if (access is null)
            {
                isUnauthorized = true;
                return;
            }

            var entry = await ApiClient.GetDashboardEntryAsync(companyId, token);
            if (!IsCurrent()) return;
            dashboardEntry = entry;
            if (entry is null)
            {
                isUnauthorized = true;
                return;
            }
            if (entry.RequiresOnboarding)
            {
                Navigation.NavigateTo("/onboarding", replace: true);
                return;
            }

            var supportedLens = TodayWorkspaceLensValues.All.Contains(requestedLens) ? requestedLens : null;
            if (requestedMonthly)
            {
                if (IsInvalidMonthlyPeriod(requestedYear, requestedMonth))
                {
                    errorMessage = CommonText["MonthlyInvalidPeriod"];
                    return;
                }
                var workspace = await MonthlyWorkspaceApiClient.GetAsync(companyId, supportedLens, requestedYear, requestedMonth, token);
                if (!IsCurrent()) return;
                if (workspace is null)
                {
                    errorMessage = CommonText["MonthlyEmptyDescription"];
                    return;
                }
                monthlyWorkspace = workspace;
                if (!string.Equals(requestedLens, workspace.ActiveLens, StringComparison.OrdinalIgnoreCase) ||
                    requestedYear != workspace.Period.Year || requestedMonth != workspace.Period.Month)
                    Navigation.NavigateTo(DashboardRoutes.BuildMonthlyPath(companyId, workspace.ActiveLens,
                        workspace.Period.Year, workspace.Period.Month), replace: true);
            }
            else
            {
                var workspace = refresh || PriorityChanges.HasSeen(companyId, supportedLens)
                    ? await TodayWorkspaceApiClient.RefreshAsync(companyId, supportedLens, token)
                    : await TodayWorkspaceApiClient.GetAsync(companyId, supportedLens, token);
                if (!IsCurrent()) return;
                if (workspace is null)
                {
                    errorMessage = CommonText["TodayEmptyDescription"];
                    return;
                }
                todayWorkspace = workspace;
                priorityChanges = PriorityChanges.Observe(workspace);
                if (!string.Equals(requestedLens, workspace.ActiveLens, StringComparison.OrdinalIgnoreCase))
                    Navigation.NavigateTo(DashboardRoutes.BuildTodayPath(companyId, workspace.ActiveLens), replace: true);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (TodayWorkspaceAccessException)
        {
            if (IsCurrent()) isUnauthorized = true;
        }
        catch (OnboardingApiException ex)
        {
            if (IsCurrent()) errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            if (IsCurrent()) errorMessage = requestedMonthly ? CommonText["MonthlyErrorDescription"] : CommonText["TodayErrorDescription"];
        }
        finally
        {
            if (IsCurrent()) isLoading = false;
        }
    }

    private static bool IsInvalidMonthlyPeriod(int? year, int? month) =>
        year.HasValue != month.HasValue || month is < 1 or > 12 || year is < 1 or > 9999;

    private Task ReloadAsync()
    {
        if (IsMonthly && IsInvalidMonthlyPeriod(Year, Month) && CompanyId is Guid companyId)
        {
            Navigation.NavigateTo(DashboardRoutes.BuildMonthlyPath(companyId, Lens), replace: true);
            return Task.CompletedTask;
        }
        return LoadWorkspaceAsync(true);
    }

    private Task ChangeLensAsync(string lens)
    {
        if (CompanyId is not Guid companyId) return Task.CompletedTask;
        var available = monthlyWorkspace?.AvailableLenses ?? todayWorkspace?.AvailableLenses;
        if (available is null || !available.Any(x => string.Equals(x.Value, lens, StringComparison.OrdinalIgnoreCase)))
            return Task.CompletedTask;
        var path = IsMonthly
            ? DashboardRoutes.BuildMonthlyPath(companyId, lens, monthlyWorkspace?.Period.Year ?? Year, monthlyWorkspace?.Period.Month ?? Month)
            : DashboardRoutes.BuildTodayPath(companyId, lens);
        DashboardInteractionService.RecordAction(new(
            "lens", "change-lens", path, SourceType: "today-lens", Label: lens));
        Navigation.NavigateTo(path);
        return Task.CompletedTask;
    }

    private Task ChangePeriodAsync(string period)
    {
        if (CompanyId is not Guid companyId) return Task.CompletedTask;
        var lens = monthlyWorkspace?.ActiveLens ?? todayWorkspace?.ActiveLens ?? Lens;
        var path = string.Equals(period, "month", StringComparison.OrdinalIgnoreCase)
            ? DashboardRoutes.BuildMonthlyPath(companyId, lens)
            : DashboardRoutes.BuildTodayPath(companyId, lens);
        DashboardInteractionService.RecordAction(new("period", "change-period", path, SourceType: "overview-period", Label: period));
        Navigation.NavigateTo(path);
        return Task.CompletedTask;
    }

    private Task ChangeMonthAsync((int Year, int Month) period)
    {
        if (CompanyId is not Guid companyId) return Task.CompletedTask;
        var path = DashboardRoutes.BuildMonthlyPath(companyId, monthlyWorkspace?.ActiveLens ?? Lens, period.Year, period.Month);
        DashboardInteractionService.RecordAction(new("period", "change-month", path, SourceType: "monthly-period", Label: $"{period.Year:D4}-{period.Month:D2}"));
        Navigation.NavigateTo(path);
        return Task.CompletedTask;
    }

    private async Task RequestReviewAsync()
    {
        if (CompanyId is not Guid companyId || todayWorkspace is null) return;
        var version = loadVersion;
        try
        {
            var review = await TodayWorkspaceApiClient.RequestReviewAsync(companyId);
            if (disposed || version != loadVersion || todayWorkspace?.CompanyId != companyId) return;
            todayWorkspace = todayWorkspace with { ManualReview = review };
            DashboardInteractionService.RecordAction(new(
                "review", "request-company-review", "/company-operation", review.RequestId?.ToString("D"),
                "operating_cycle_request", review.State));
        }
        catch (TodayWorkspaceAccessException)
        {
            if (disposed || version != loadVersion) return;
            isUnauthorized = true;
        }
        catch (HttpRequestException)
        {
            if (disposed || version != loadVersion) return;
            todayWorkspace = todayWorkspace with
            {
                ManualReview = todayWorkspace.ManualReview is { } existing
                    ? existing with { State = "failed", StatusMessage = CommonText["TodayManualReviewRequestFailed"] }
                    : null
            };
        }
    }

    private Task HandleWorkspaceActionAsync(DashboardActionTelemetryContext context)
    {
        DashboardInteractionService.RecordAction(context);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (CompanyId is not Guid selectedCompanyId)
        {
            if (!string.IsNullOrWhiteSpace(scrollTrackerId)) await DisposeScrollTrackerAsync();
            trackedInteractionCompanyId = null;
            DashboardInteractionService.EndSession();
            return;
        }

        if (trackedInteractionCompanyId != selectedCompanyId)
        {
            await DisposeScrollTrackerAsync();
            trackedInteractionCompanyId = selectedCompanyId;
            DashboardInteractionService.StartSession("dashboard", selectedCompanyId);
        }

        if (!string.IsNullOrWhiteSpace(scrollTrackerId)) return;
        try
        {
            telemetryModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboardTelemetry.js");
            dotNetReference ??= DotNetObjectReference.Create(this);
            scrollTrackerId = await telemetryModule.InvokeAsync<string>("registerDashboardScrollTracker", dotNetReference);
        }
        catch
        {
            // Telemetry must not block the workspace during prerendering or tests.
        }
    }

    [JSInvokable]
    public Task OnDashboardScrollDepthChanged(double depthPercentage)
    {
        DashboardInteractionService.RecordScrollDepth(depthPercentage);
        return Task.CompletedTask;
    }

    private async Task DisposeScrollTrackerAsync()
    {
        if (telemetryModule is null || string.IsNullOrWhiteSpace(scrollTrackerId))
        {
            scrollTrackerId = null;
            return;
        }

        try { await telemetryModule.InvokeVoidAsync("disposeDashboardScrollTracker", scrollTrackerId); }
        catch { }
        scrollTrackerId = null;
    }

    private string FormatMembershipRole(string? role) => role?.Trim().ToLowerInvariant() switch
    {
        "owner" => CommonText["MembershipOwner"],
        "admin" or "administrator" => CommonText["MembershipAdmin"],
        _ => role ?? CommonText["MembershipMember"]
    };

    private string FormatMembershipStatus(string? status) =>
        string.Equals(status, "active", StringComparison.OrdinalIgnoreCase)
            ? CommonText["MembershipActive"]
            : CommonText["MembershipInactive"];

    private string DescribeCompany(CompanyMembershipViewModel membership)
    {
        var setup = string.Equals(membership.OnboardingStatus, "completed", StringComparison.OrdinalIgnoreCase)
            ? CommonText["CompanySetupComplete"]
            : string.Equals(membership.OnboardingStatus, "in_progress", StringComparison.OrdinalIgnoreCase)
                ? CommonText["CompanySetupInProgress"]
                : CommonText["CompanySetupNotStarted"];
        return membership.CompanyCreatedUtc is DateTime createdUtc
            ? CommonText["CompanyCreatedDescription", LocalDateTime.DateTime(createdUtc), setup, membership.CompanyId.ToString("N")[..8]]
            : setup;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        await DisposeScrollTrackerAsync();
        dotNetReference?.Dispose();
        dotNetReference = null;
        if (telemetryModule is not null)
        {
            try { await telemetryModule.DisposeAsync(); }
            catch { }
            telemetryModule = null;
        }
        DashboardInteractionService.EndSession();
    }
}
