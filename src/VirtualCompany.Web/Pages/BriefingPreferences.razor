@page "/briefing-preferences"
@page "/briefings"
@rendermode InteractiveServer
@inject OnboardingApiClient Onboarding
@inject NavigationManager Navigation
<PageTitle>Briefings</PageTitle>
@if (company is Guid id) { <BriefingCadencePanel @key="@($"{id}:{DeliveryId}")" CompanyId="id" DeliveryId="DeliveryId" /> }
else { <p role="status">@message</p> }
@code {
    [SupplyParameterFromQuery] public Guid? CompanyId { get; set; }
    [SupplyParameterFromQuery] public Guid? DeliveryId { get; set; }
    private Guid? company; private string message = "Loading company…";
    protected override async Task OnParametersSetAsync()
    {
        company = null; var requested = CompanyId; var location = Navigation.Uri;
        try { var user = await Onboarding.GetCurrentUserContextAsync(requested); if (location != Navigation.Uri) return;
            var selected = requested ?? user?.ActiveCompany?.CompanyId;
            if (selected.HasValue && user?.Memberships.Any(x => x.CompanyId == selected && x.Status == "active") == true) company = selected;
            else message = "Choose an authorized company before managing briefings."; }
        catch (Exception ex) when (ex is OnboardingApiException or HttpRequestException) { if (location == Navigation.Uri) message = ex.Message; }
    }
}
