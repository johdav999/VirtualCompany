    private string? GetEffectiveTemplateId() =>
        !string.IsNullOrWhiteSpace(model.SelectedTemplateId)
            ? model.SelectedTemplateId
            : recommendedTemplate?.TemplateId;

    private static IReadOnlyList<string> BuildOptionList(
        IEnumerable<string?> templateValues,
        string? currentValue,
        IReadOnlyCollection<string> fallbackValues)
    {
        var options = templateValues
            .Concat(fallbackValues)
            .Append(currentValue)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .ToList();

        return options;
    }

    private static IReadOnlyList<SelectOption> BuildLanguageOptionList(IEnumerable<string?> templateValues, string? currentValue)
    {
        var currentOptions = templateValues
            .Append(currentValue)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Where(value => !SystemLanguageOptions.Any(option => string.Equals(option.Value, value, StringComparison.OrdinalIgnoreCase)))
            .Select(value => new SelectOption(value, value));

        return SystemLanguageOptions
            .Concat(currentOptions)
            .DistinctBy(option => option.Value, StringComparer.OrdinalIgnoreCase)
            .OrderBy(option => option.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static RegionInfo? CreateRegionInfo(CultureInfo culture)
    {
        try
        {
            return new RegionInfo(culture.Name);
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    private sealed record SelectOption(string Value, string Label);

    private RenderFragment RenderError(string field) => builder =>
    {
        if (validationErrors.TryGetValue(field, out var message))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "validation-message");
            builder.AddContent(2, message);
            builder.CloseElement();
        }
    };

