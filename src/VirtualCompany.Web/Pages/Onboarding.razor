@page "/onboarding"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text.Json
@inject OnboardingApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>@CommonText["OnboardingPageTitle"]</PageTitle>

@if (isLoading)
{
    <section class="onboarding-page onboarding-page--loading" aria-busy="true">
        <div class="onboarding-loading-card">
            <span class="onboarding-eyebrow">@CommonText["OnboardingEyebrow"]</span>
            <h1>@CommonText["OnboardingHeroTitle"]</h1>
            <p>@CommonText["OnboardingLoading"]</p>
            <div class="onboarding-loading-line"></div>
            <div class="onboarding-loading-line onboarding-loading-line--short"></div>
        </div>
    </section>
}
else
{
    <section class="onboarding-page">
        <header class="onboarding-hero">
            <div class="onboarding-hero__copy">
                <span class="onboarding-eyebrow">@CommonText["OnboardingEyebrow"]</span>
                <h1>@CommonText["OnboardingHeroTitle"]</h1>
                <p>@CommonText["OnboardingIntro"]</p>
            </div>
            <div class="onboarding-save-state" aria-live="polite">
                <span class="onboarding-save-state__icon" aria-hidden="true">✓</span>
                <span>
                    <strong>@CommonText["OnboardingProgressSaved"]</strong>
                    <small>@(lastSavedLabel is null ? CommonText["OnboardingAutosave"] : CommonText["OnboardingLastSaved", lastSavedLabel])</small>
                </span>
            </div>
        </header>

        @if (requiresCompanyChoice)
        {
            <section class="wizard-card onboarding-company-choice" aria-labelledby="onboarding-company-choice-title">
                <span class="onboarding-eyebrow">@CommonText["CompanyChoiceKicker"]</span>
                <h2 id="onboarding-company-choice-title">@CommonText["CompanyChoiceTitle"]</h2>
                <p class="text-body-secondary">@CommonText["CompanyChoiceDescription"]</p>
                <div class="template-grid mt-4">
                    @foreach (var membership in ActiveMemberships)
                    {
                        <button type="button"
                                class="template-card text-start"
                                disabled="@isSubmitting"
                                @onclick="() => SelectCompanyAsync(membership.CompanyId)">
                            <strong>@membership.CompanyName</strong>
                            <span class="text-body-secondary mt-2">@DescribeCompany(membership)</span>
                        </button>
                    }
                </div>
                <div class="mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-primary" disabled="@isSubmitting" @onclick="StartAnotherWorkspace">
                        @CommonText["CreateAnotherCompany"]
                    </button>
                </div>
            </section>
        }
        else
        {

        <ol class="onboarding-stepper" aria-label="@CommonText["OnboardingProgress"]">
            @for (var wizardStep = 1; wizardStep <= StepCount; wizardStep++)
            {
                <li class="onboarding-step @GetStepClass(wizardStep)" aria-current="@(wizardStep == currentStep ? "step" : null)">
                    <span class="onboarding-step__number" aria-hidden="true">@(wizardStep < currentStep ? "✓" : wizardStep)</span>
                    <span class="onboarding-step__copy">
                        <small>@CommonText["OnboardingStepNumber", wizardStep]</small>
                        <strong>@GetStepTitle(wizardStep)</strong>
                    </span>
                </li>
            }
        </ol>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="onboarding-notice onboarding-notice--success" role="status">
                <span aria-hidden="true">✓</span>
                <span>@statusMessage</span>
            </div>
        }

        @if (currentUser?.ActiveCompany is not null && !model.CompanyId.HasValue && !showCompletedState)
        {
            <div class="onboarding-notice" role="status">
                <span aria-hidden="true">i</span>
                <span>
                    @CommonText["OnboardingActiveCompany", currentUser.ActiveCompany.CompanyName]
                    @CommonText["OnboardingCreateAnother"] <a href="@($"/dashboard?companyId={currentUser.ActiveCompany.CompanyId}")">@CommonText["OnboardingReturnDashboard"]</a>.
                </span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="onboarding-notice onboarding-notice--error" role="alert">
                <span aria-hidden="true">!</span>
                <span>@errorMessage</span>
            </div>
        }

        <div class="onboarding-layout">
            <main class="onboarding-task-card">
                <div class="onboarding-task-card__header">
                    <span class="onboarding-current-step">@CommonText["OnboardingStepLabel", currentStep, StepCount]</span>
                    <h2>@GetStepTitle(currentStep)</h2>
                    <p>@GetStepDescription(currentStep)</p>
                </div>

                @if (showCompletedState)
                {
                    <div class="onboarding-complete-banner">
                        <div>
                            <strong>@CommonText["OnboardingAlreadyCompleted"]</strong>
                            <p>@CommonText["OnboardingCompletedDescription"]</p>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-primary" @onclick="GoToDashboard" disabled="@string.IsNullOrWhiteSpace(completedDashboardPath)">@CommonText["OnboardingOpenDashboard"]</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="StartAnotherWorkspace">@CommonText["CreateAnotherCompany"]</button>
                        </div>
                    </div>
                }

                <div class="onboarding-task-card__body">
                    @if (currentStep == 1)
                    {
                        <div class="onboarding-form-grid">
                            <div class="onboarding-field onboarding-field--wide">
                                <label class="form-label">@CommonText["OnboardingStartingTemplate"]</label>
                                <select class="form-select" value="@model.SelectedTemplateId" @onchange="OnTemplateChanged">
                                    <option value="">@CommonText["OnboardingNoTemplate"]</option>
                                    @foreach (var template in templates)
                                    {
                                        <option value="@template.TemplateId">@template.Name</option>
                                    }
                                </select>
                                <div class="form-text">@CommonText["OnboardingTemplateHelp"]</div>
                                @RenderError(nameof(model.SelectedTemplateId))
                            </div>

                            <div class="onboarding-field onboarding-field--wide">
                                <label class="form-label">@CommonText["OnboardingCompanyName"]</label>
                                <input class="form-control" @bind="model.Name" @bind:after="ClearMessages" />
                                @RenderError(nameof(model.Name))
                            </div>

                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingIndustry"]</label>
                                <select class="form-select" value="@model.Industry" @onchange="OnIndustryChangedAsync">
                                    <option value="">@CommonText["OnboardingSelectIndustry"]</option>
                                    @foreach (var industry in IndustryOptions)
                                    {
                                        <option value="@industry">@DisplayOption(industry)</option>
                                    }
                                </select>
                                @RenderError(nameof(model.Industry))
                            </div>

                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingBusinessType"]</label>
                                <select class="form-select" value="@model.BusinessType" @onchange="OnBusinessTypeChangedAsync">
                                    <option value="">@CommonText["OnboardingSelectBusinessType"]</option>
                                    @foreach (var businessType in BusinessTypeOptions)
                                    {
                                        <option value="@businessType">@DisplayOption(businessType)</option>
                                    }
                                </select>
                                @RenderError(nameof(model.BusinessType))
                            </div>

                            @if (recommendedTemplate is not null && SelectedTemplate is null)
                            {
                                <div class="onboarding-inline-recommendation onboarding-field--wide">
                                    <span aria-hidden="true">✦</span>
                                    <span>@CommonText["OnboardingRecommendedDefaults", recommendedTemplate.Name, DescribeRecommendationMatch(recommendedTemplate.MatchKind)]</span>
                                </div>
                            }
                        </div>
                    }
                    else if (currentStep == 2)
                    {
                        <div class="onboarding-form-grid">
                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingTimezone"]</label>
                                <select class="form-select" value="@model.Timezone" @onchange="OnTimezoneChanged">
                                    <option value="">@CommonText["OnboardingSelectTimezone"]</option>
                                    @foreach (var timezone in TimezoneOptions)
                                    {
                                        <option value="@timezone">@timezone</option>
                                    }
                                </select>
                                @RenderError(nameof(model.Timezone))
                            </div>

                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingCurrency"]</label>
                                <select class="form-select" value="@model.Currency" @onchange="OnCurrencyChanged">
                                    <option value="">@CommonText["OnboardingSelectCurrency"]</option>
                                    @foreach (var currency in CurrencyOptions)
                                    {
                                        <option value="@currency">@currency</option>
                                    }
                                </select>
                                @RenderError(nameof(model.Currency))
                            </div>

                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingLanguage"]</label>
                                <select class="form-select" value="@model.Language" @onchange="OnLanguageChanged">
                                    <option value="">@CommonText["OnboardingSelectLanguage"]</option>
                                    @foreach (var language in LanguageOptions)
                                    {
                                        <option value="@language.Value">@language.Label</option>
                                    }
                                </select>
                                @RenderError(nameof(model.Language))
                            </div>

                            <div class="onboarding-field">
                                <label class="form-label">@CommonText["OnboardingComplianceRegion"]</label>
                                <select class="form-select" value="@model.ComplianceRegion" @onchange="OnComplianceRegionChanged">
                                    <option value="">@CommonText["OnboardingSelectComplianceRegion"]</option>
                                    @foreach (var region in ComplianceRegionOptions)
                                    {
                                        <option value="@region">@DisplayOption(region)</option>
                                    }
                                </select>
                                @RenderError(nameof(model.ComplianceRegion))
                            </div>
                        </div>
                    }
                    else
                    {
                        <dl class="onboarding-review-list">
                            <div><dt>@CommonText["OnboardingCompany"]</dt><dd>@model.Name</dd></div>
                            <div><dt>@CommonText["OnboardingIndustry"]</dt><dd>@DisplayOptionValue(model.Industry)</dd></div>
                            <div><dt>@CommonText["OnboardingBusinessType"]</dt><dd>@DisplayOptionValue(model.BusinessType)</dd></div>
                            <div><dt>@CommonText["OnboardingTimezone"]</dt><dd>@DisplayValue(model.Timezone)</dd></div>
                            <div><dt>@CommonText["OnboardingCurrency"]</dt><dd>@DisplayValue(model.Currency)</dd></div>
                            <div><dt>@CommonText["OnboardingLanguage"]</dt><dd>@DisplayValue(model.Language)</dd></div>
                            <div><dt>@CommonText["OnboardingCompliance"]</dt><dd>@DisplayOptionValue(model.ComplianceRegion)</dd></div>
                        </dl>
                    }
                </div>

                <div class="onboarding-task-card__footer">
                    <div class="onboarding-secondary-actions">
                        @if (currentStep > 1)
                        {
                            <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="GoBack">@CommonText["OnboardingBack"]</button>
                        }
                        @if (!showCompletedState)
                        {
                            <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting" @onclick="SaveAndExitAsync">
                                @(isSubmitting ? CommonText["OnboardingSaving"] : CommonText["OnboardingSaveExit"])
                            </button>
                        }
                        @if (model.CompanyId.HasValue && !showCompletedState)
                        {
                            <button type="button" class="btn onboarding-discard-button" disabled="@isSubmitting" @onclick="DiscardAsync">@CommonText["OnboardingDiscard"]</button>
                        }
                    </div>

                    @if (currentStep < StepCount)
                    {
                        <button type="button" class="btn btn-primary onboarding-primary-action" disabled="@isSubmitting" @onclick="ContinueAsync">
                            @(isSubmitting ? CommonText["OnboardingSaving"] : CommonText["OnboardingContinue"])
                            <span aria-hidden="true">→</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary onboarding-primary-action" disabled="@isSubmitting" @onclick="CompleteAsync">
                            @(isSubmitting ? CommonText["OnboardingSaving"] : CommonText[showCompletedState ? "OnboardingSaveChanges" : "OnboardingComplete"])
                        </button>
                    }
                </div>
            </main>

            <aside class="onboarding-eva-card">
                <div class="onboarding-eva-card__identity">
                    <span class="onboarding-eva-avatar" aria-hidden="true">E</span>
                    <span>
                        <strong>Eva</strong>
                        <small>@CommonText["OnboardingEvaRole"]</small>
                    </span>
                </div>
                <h2>@CommonText["OnboardingWorkshopTitle"]</h2>
                <p class="onboarding-eva-intro">@CommonText["OnboardingWorkshopDescription"]</p>

                <div class="onboarding-recommendation">
                    <span class="onboarding-recommendation__icon" aria-hidden="true">✦</span>
                    <div>
                        <strong>@CommonText["OnboardingRecommendation"]</strong>
                        <p>@GetStepRecommendation(currentStep)</p>
                    </div>
                </div>

                <div class="onboarding-next-steps">
                    <h3>@CommonText["OnboardingNextSteps"]</h3>
                    <ul>
                        @foreach (var item in Guidance.Take(3))
                        {
                            <li><span aria-hidden="true">✓</span><span>@item</span></li>
                        }
                    </ul>
                </div>

                <button type="button" class="btn btn-outline-primary onboarding-workshop-action" disabled="@isSubmitting" @onclick="StartWorkshopAsync">
                    @CommonText[showCompletedState ? "OnboardingWorkshopResume" : "OnboardingWorkshopStart"]
                </button>

                <div class="onboarding-eva-card__footer">
                    <span aria-hidden="true">✓</span>
                    <span>@CommonText["OnboardingAutosave"]</span>
                </div>
            </aside>
        </div>
        }
    </section>
}

@code {
    private const int StepCount = 3;
    private static readonly string[] FallbackIndustryOptions =
    [
        "Services",
        "Retail",
        "Manufacturing",
        "Software",
        "Consulting"
    ];
    private static readonly string[] FallbackBusinessTypeOptions =
    [
        "Agency",
        "E-commerce",
        "SaaS",
        "Consultancy",
        "Distributor"
    ];
    private static readonly string[] CommonCurrencyOptions =
    [
        "SEK",
        "EUR",
        "USD",
        "GBP",
        "NOK",
        "DKK"
    ];
    private static readonly string[] ComplianceRegionBaseOptions =
    [
        "EU",
        "Sweden",
        "Norway",
        "Denmark",
        "Finland",
        "United Kingdom",
        "United States",
        "Canada",
        "Australia",
        "Global"
    ];
    private static readonly IReadOnlyList<string> SystemTimezoneOptions = TimeZoneInfo.GetSystemTimeZones()
        .Select(timezone => timezone.Id)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private static readonly IReadOnlyList<string> SystemCurrencyOptions = CultureInfo.GetCultures(CultureTypes.SpecificCultures)
        .Select(CreateRegionInfo)
        .Where(region => region is not null)
        .Select(region => region!.ISOCurrencySymbol)
        .Concat(CommonCurrencyOptions)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private static readonly IReadOnlyList<SelectOption> SystemLanguageOptions = CultureInfo.GetCultures(CultureTypes.NeutralCultures)
        .Where(culture => !string.IsNullOrWhiteSpace(culture.Name))
        .Select(culture => new SelectOption(culture.Name, $"{culture.NativeName} ({culture.Name})"))
        .DistinctBy(option => option.Value, StringComparer.OrdinalIgnoreCase)
        .OrderBy(option => option.Label, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private readonly Dictionary<string, string> validationErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly OnboardingFormModel model = new();
    private readonly HashSet<string> manuallyEditedFields = new(StringComparer.OrdinalIgnoreCase);
    private CurrentUserContextViewModel? currentUser;
    private List<OnboardingTemplateViewModel> templates = [];
    private OnboardingTemplateRecommendationViewModel? recommendedTemplate;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool explicitNewCompany;
    private string? statusMessage;
    private string? errorMessage;
    private string sessionStatus = "not_started";

    private int currentStep = 1;
    private List<string> savedGuidance = [];
    private string? completedDashboardPath;
    private string? lastSavedLabel;

    private IReadOnlyList<CompanyMembershipViewModel> ActiveMemberships =>
        currentUser?.Memberships
            .Where(item => string.Equals(item.Status, "active", StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.CompanyName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.CompanyCreatedUtc)
            .ToList()
        ?? [];

    private bool requiresCompanyChoice =>
        currentUser?.CompanySelectionRequired == true &&
        !explicitNewCompany &&
        !model.CompanyId.HasValue;

    private OnboardingTemplateViewModel? SelectedTemplate => templates.FirstOrDefault(x => x.TemplateId == model.SelectedTemplateId);
    private IReadOnlyList<string> IndustryOptions => BuildOptionList(
        templates.Select(x => x.Industry),
        model.Industry,
        FallbackIndustryOptions);
    private IReadOnlyList<string> BusinessTypeOptions => BuildOptionList(
        templates.Select(x => x.BusinessType),
        model.BusinessType,
        FallbackBusinessTypeOptions);
    private IReadOnlyList<string> TimezoneOptions => BuildOptionList(
        templates.Select(x => GetTemplateDefault(x.Defaults, "timezone")),
        model.Timezone,
        SystemTimezoneOptions);
    private IReadOnlyList<string> CurrencyOptions => BuildOptionList(
        templates.Select(x => GetTemplateDefault(x.Defaults, "currency")),
        model.Currency,
        SystemCurrencyOptions);
    private IReadOnlyList<SelectOption> LanguageOptions => BuildLanguageOptionList(
        templates.Select(x => GetTemplateDefault(x.Defaults, "language")),
        model.Language);
    private IReadOnlyList<string> ComplianceRegionOptions => BuildOptionList(
        templates.Select(x => GetTemplateDefault(x.Defaults, "complianceRegion")),
        model.ComplianceRegion,
        ComplianceRegionBaseOptions);
    private IReadOnlyList<string> Guidance => SelectedTemplate?.StarterGuidance?.Count > 0
        ? SelectedTemplate.StarterGuidance
        : recommendedTemplate?.StarterGuidance?.Count > 0
            ? recommendedTemplate.StarterGuidance
        : savedGuidance.Count > 0
            ? savedGuidance
        :
        [
            CommonText["OnboardingGuidanceInvite"],
            CommonText["OnboardingGuidanceOwner"],
            CommonText["OnboardingGuidanceDocuments"]
        ];

    private async Task StartWorkshopAsync()
    {
        validationErrors.Clear();errorMessage=null;statusMessage=null;
        if(string.IsNullOrWhiteSpace(model.Name)){validationErrors[nameof(model.Name)]=CommonText["OnboardingNameRequiredSave"];errorMessage=CommonText["OnboardingWorkshopNameFirst"];return;}
        isSubmitting=true;
        try
        {
            var request=new SaveOnboardingRequest{CompanyId=model.CompanyId,Name=model.Name,Industry=model.Industry,BusinessType=model.BusinessType,
                Timezone=model.Timezone,Currency=model.Currency,Language=model.Language,ComplianceRegion=model.ComplianceRegion,CurrentStep=Math.Max(1,currentStep),SelectedTemplateId=GetEffectiveTemplateId(),ExplicitNewCompany=explicitNewCompany};
            var result=await ApiClient.StartWorkshopAsync(request);
            Navigation.NavigateTo(result.Route, forceLoad: true);
        }
        catch(Exception ex){errorMessage=ex.Message;}
        finally{isSubmitting=false;}
    }
    private bool showCompletedState => string.Equals(sessionStatus, "completed", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await ApiClient.GetCurrentUserContextAsync();
            templates = (await ApiClient.GetTemplatesAsync()).ToList();
            var progress = currentUser?.ActiveCompany is { } activeCompany
                ? await ApiClient.GetProgressAsync(activeCompany.CompanyId)
                : currentUser?.CompanySelectionRequired == true
                    ? null
                    : await ApiClient.GetProgressAsync();

            if (progress is null)
            {
                return;
            }

            ApplyProgress(progress);
            await RefreshRecommendationsAsync(applyDefaults: false);
        }
        catch (OnboardingApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ContinueAsync()
    {
        if (!ValidateStep(currentStep))
        {
            return;
        }

        try
        {
            isSubmitting = true;
            ClearMessages();
            var progress = await PersistProgressAsync(Math.Min(StepCount, currentStep + 1));
            ApplyProgress(progress);
            statusMessage = CommonText["OnboardingSaved"];
        }
        catch (OnboardingApiException ex)
        {
            ApplyApiErrors(ex.Errors);
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SaveAndExitAsync()
    {
        if (!ValidateDraftForSave())
        {
            return;
        }

        try
        {
            isSubmitting = true;
            ClearMessages();
            var progress = await PersistProgressAsync(currentStep);
            ApplyProgress(progress);
            statusMessage = CommonText["OnboardingSavedResume"];
        }
        catch (OnboardingApiException ex)
        {
            ApplyApiErrors(ex.Errors);
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (!ValidateAllSteps())
        {
            return;
        }

        var wasAlreadyCompleted = showCompletedState;
        try
        {
            isSubmitting = true;
            ClearMessages();

            if (!model.CompanyId.HasValue)
            {
                var progress = await PersistProgressAsync(StepCount);
                ApplyProgress(progress);
            }

            var result = await ApiClient.CompleteAsync(new CompleteOnboardingRequest
            {
                CompanyId = model.CompanyId!.Value,
                Name = model.Name,
                Industry = model.Industry,
                BusinessType = model.BusinessType,
                Timezone = model.Timezone,
                Currency = model.Currency,
                Language = model.Language,
                ComplianceRegion = model.ComplianceRegion,
                SelectedTemplateId = GetEffectiveTemplateId()
            });

            completedDashboardPath = result.DashboardPath;
            sessionStatus = "completed";
            savedGuidance = result.StarterGuidance;
            if (wasAlreadyCompleted)
            {
                statusMessage = CommonText["OnboardingChangesSaved"];
            }
            else
            {
                Navigation.NavigateTo(result.DashboardPath, replace: true);
                statusMessage = CommonText["OnboardingCompleteMessage"];
            }
        }
        catch (OnboardingApiException ex)
        {
            ApplyApiErrors(ex.Errors);
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DiscardAsync()
    {
        if (!model.CompanyId.HasValue)
        {
            StartAnotherWorkspace();
            return;
        }

        try
        {
            isSubmitting = true;
            ClearMessages();
            var progress = await ApiClient.AbandonAsync(model.CompanyId.Value);
            ApplyProgress(progress, startFresh: true);
            statusMessage = CommonText["OnboardingDiscardedMessage"];
        }
        catch (OnboardingApiException ex)
        {
            ApplyApiErrors(ex.Errors);
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBack()
    {
        if (currentStep > 1)
        {
            currentStep--;
            ClearMessages();
        }
    }

    private void GoToDashboard()
    {
        if (!string.IsNullOrWhiteSpace(completedDashboardPath))
        {
            Navigation.NavigateTo(completedDashboardPath);
        }
    }

    private void StartAnotherWorkspace()
    {
        explicitNewCompany = true;
        model.CompanyId = null;
        model.Name = string.Empty;
        model.Industry = string.Empty;
        model.BusinessType = string.Empty;
        model.Timezone = string.Empty;
        model.Currency = string.Empty;
        model.Language = string.Empty;
        model.ComplianceRegion = string.Empty;
        model.SelectedTemplateId = null;
        currentStep = 1;
        sessionStatus = "not_started";
        manuallyEditedFields.Clear();
        completedDashboardPath = null;
        lastSavedLabel = null;
        ClearMessages();
        statusMessage = CommonText["OnboardingStartingNew"];
    }

    private async Task SelectCompanyAsync(Guid companyId)
    {
        isSubmitting = true;
        ClearMessages();
        try
        {
            await ApiClient.SelectCompanyAsync(companyId);
            Navigation.NavigateTo("/onboarding", forceLoad: true);
        }
        catch (OnboardingApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string DescribeCompany(CompanyMembershipViewModel membership)
    {
        var setup = string.Equals(membership.OnboardingStatus, "completed", StringComparison.OrdinalIgnoreCase)
            ? CommonText["CompanySetupComplete"]
            : string.Equals(membership.OnboardingStatus, "in_progress", StringComparison.OrdinalIgnoreCase)
                ? CommonText["CompanySetupInProgress"]
                : CommonText["CompanySetupNotStarted"];
        return membership.CompanyCreatedUtc is DateTime createdUtc
            ? CommonText["CompanyCreatedDescription", LocalDateTime.DateTime(createdUtc), setup, membership.CompanyId.ToString("N")[..8]]
            : setup;
    }

    private void OnTemplateChanged(ChangeEventArgs args)
    {
        model.SelectedTemplateId = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value?.ToString();
        ApplySelectedTemplate();
        ClearMessages();
    }

    private async Task OnIndustryChangedAsync(ChangeEventArgs args)
    {
        model.Industry = args.Value?.ToString() ?? string.Empty;
        ClearMessages();
        await RefreshRecommendationsAsync();
    }

    private async Task OnBusinessTypeChangedAsync(ChangeEventArgs args)
    {
        model.BusinessType = args.Value?.ToString() ?? string.Empty;
        ClearMessages();
        await RefreshRecommendationsAsync();
    }

    private void OnTimezoneChanged(ChangeEventArgs args) => SetManualField(nameof(model.Timezone), args.Value?.ToString(), value => model.Timezone = value);
    private void OnCurrencyChanged(ChangeEventArgs args) => SetManualField(nameof(model.Currency), args.Value?.ToString(), value => model.Currency = value);
    private void OnLanguageChanged(ChangeEventArgs args) => SetManualField(nameof(model.Language), args.Value?.ToString(), value => model.Language = value);
    private void OnComplianceRegionChanged(ChangeEventArgs args) => SetManualField(nameof(model.ComplianceRegion), args.Value?.ToString(), value => model.ComplianceRegion = value);

    private void SetManualField(string fieldName, string? value, Action<string> assign)
    {
        manuallyEditedFields.Add(fieldName);
        assign(value ?? string.Empty);
        ClearMessages();
    }

    private async Task RefreshRecommendationsAsync(bool applyDefaults = true)
    {
        if (string.IsNullOrWhiteSpace(model.Industry) && string.IsNullOrWhiteSpace(model.BusinessType))
        {
            recommendedTemplate = null;
            return;
        }

        try
        {
            recommendedTemplate = await ApiClient.GetRecommendedDefaultsAsync(model.Industry, model.BusinessType);
            if (applyDefaults)
            {
                ApplyRecommendedDefaults();
            }
        }
        catch (OnboardingApiException ex)
        {
            recommendedTemplate = null;
            errorMessage = ex.Message;
        }
    }

    private void ApplyRecommendedDefaults()
    {
        if (recommendedTemplate is null || recommendedTemplate.Defaults.Count == 0)
        {
            return;
        }

        ApplyTemplateDefaults(recommendedTemplate.Defaults);
    }

    private void ApplyRecommendedField(string fieldName, string? value, Action<string> assign)
    {
        if (string.IsNullOrWhiteSpace(value) || manuallyEditedFields.Contains(fieldName))
        {
            return;
        }

        assign(value);
    }

    private void ApplySelectedTemplate()
    {
        var selectedTemplate = SelectedTemplate;
        if (selectedTemplate is null)
        {
            return;
        }

        ApplyTemplateDefaults(selectedTemplate.Defaults);
        model.Industry = string.IsNullOrWhiteSpace(model.Industry) ? selectedTemplate.Industry ?? string.Empty : model.Industry;
        model.BusinessType = string.IsNullOrWhiteSpace(model.BusinessType) ? selectedTemplate.BusinessType ?? string.Empty : model.BusinessType;
    }

    private void ApplyProgress(OnboardingProgressViewModel progress, bool startFresh = false)
    {
        explicitNewCompany = false;
        model.CompanyId = startFresh ? null : progress.CompanyId;
        model.Name = progress.Name;
        model.Industry = progress.Industry;
        model.BusinessType = progress.BusinessType;
        model.Timezone = progress.Timezone;
        model.Currency = progress.Currency;
        model.Language = progress.Language;
        model.ComplianceRegion = progress.ComplianceRegion;
        model.SelectedTemplateId = progress.SelectedTemplateId;
        MarkExistingDefaultsAsManual();
        savedGuidance = progress.StarterGuidance;
        completedDashboardPath = progress.DashboardPath;
        sessionStatus = progress.Status;
        lastSavedLabel = progress.LastSavedUtc?.ToLocalTime().ToString("g");

        if (progress.CanResume && !startFresh)
        {
            currentStep = Math.Clamp(progress.CurrentStep, 1, StepCount);
            statusMessage = CommonText["OnboardingRestored"];
            return;
        }

        if (string.Equals(progress.Status, "completed", StringComparison.OrdinalIgnoreCase) && !startFresh)
        {
            currentStep = StepCount;
            statusMessage = CommonText["OnboardingAlreadyCompleteMessage"];
            return;
        }

        currentStep = 1;
    }

    private void MarkExistingDefaultsAsManual()
    {
        manuallyEditedFields.Clear();
        MarkManualIfSet(nameof(model.Timezone), model.Timezone);
        MarkManualIfSet(nameof(model.Currency), model.Currency);
        MarkManualIfSet(nameof(model.Language), model.Language);
        MarkManualIfSet(nameof(model.ComplianceRegion), model.ComplianceRegion);
    }

    private void MarkManualIfSet(string fieldName, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            manuallyEditedFields.Add(fieldName);
        }
    }

    private async Task<OnboardingProgressViewModel> PersistProgressAsync(int step)
    {
        var request = new SaveOnboardingRequest
        {
            CompanyId = model.CompanyId,
            Name = model.Name,
            Industry = model.Industry,
            BusinessType = model.BusinessType,
            Timezone = model.Timezone,
            Currency = model.Currency,
            Language = model.Language,
            ComplianceRegion = model.ComplianceRegion,
            CurrentStep = step,
            SelectedTemplateId = GetEffectiveTemplateId(),
            ExplicitNewCompany = explicitNewCompany
        };

        return model.CompanyId.HasValue
            ? await ApiClient.SaveProgressAsync(request)
            : await ApiClient.CreateWorkspaceAsync(request);
    }

    private void ApplyTemplateDefaults(IReadOnlyDictionary<string, JsonElement> defaults)
    {
        ApplyRecommendedField(nameof(model.Timezone), GetTemplateDefault(defaults, "timezone"), value => model.Timezone = value);
        ApplyRecommendedField(nameof(model.Currency), GetTemplateDefault(defaults, "currency"), value => model.Currency = value);
        ApplyRecommendedField(nameof(model.Language), GetTemplateDefault(defaults, "language"), value => model.Language = value);
        ApplyRecommendedField(nameof(model.ComplianceRegion), GetTemplateDefault(defaults, "complianceRegion"), value => model.ComplianceRegion = value);
    }

    private static string? GetTemplateDefault(IReadOnlyDictionary<string, JsonElement> defaults, string key)
    {
        if (!defaults.TryGetValue(key, out var value))
        {
            return null;
        }

        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString(),
            JsonValueKind.Null => null,
            JsonValueKind.Undefined => null,
            _ => value.ToString()
        };
    }

    private bool ValidateDraftForSave()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            validationErrors[nameof(model.Name)] = CommonText["OnboardingNameRequiredSave"];
        }

        errorMessage = validationErrors.Count > 0 ? CommonText["OnboardingFixBeforeSaving"].Value : null;
        return validationErrors.Count == 0;
    }

    private bool ValidateStep(int step)
    {
        validationErrors.Clear();

        if (step >= 1)
        {
            if (string.IsNullOrWhiteSpace(model.Name)) validationErrors[nameof(model.Name)] = Required("OnboardingCompanyName");
            if (string.IsNullOrWhiteSpace(model.Industry)) validationErrors[nameof(model.Industry)] = Required("OnboardingIndustry");
            if (string.IsNullOrWhiteSpace(model.BusinessType)) validationErrors[nameof(model.BusinessType)] = Required("OnboardingBusinessType");
        }

        if (step >= 2 || currentStep >= 2)
        {
            if (string.IsNullOrWhiteSpace(model.Timezone)) validationErrors[nameof(model.Timezone)] = Required("OnboardingTimezone");
            if (string.IsNullOrWhiteSpace(model.Currency)) validationErrors[nameof(model.Currency)] = Required("OnboardingCurrency");
            if (string.IsNullOrWhiteSpace(model.Language)) validationErrors[nameof(model.Language)] = Required("OnboardingLanguage");
            if (string.IsNullOrWhiteSpace(model.ComplianceRegion)) validationErrors[nameof(model.ComplianceRegion)] = Required("OnboardingComplianceRegion");
        }

        errorMessage = validationErrors.Count > 0 ? CommonText["OnboardingFixBeforeContinuing"].Value : null;
        return validationErrors.Count == 0;
    }

    private bool ValidateAllSteps() => ValidateStep(StepCount);

    private void ClearMessages()
    {
        statusMessage = null;
        errorMessage = null;
    }

    private void ApplyApiErrors(IReadOnlyDictionary<string, string[]> errors)
    {
        validationErrors.Clear();
        foreach (var error in errors)
        {
            validationErrors[error.Key] = error.Value.FirstOrDefault() ?? CommonText["OnboardingInvalidValue"];
        }
    }

    private string GetStepClass(int wizardStep)
    {
        if (wizardStep == currentStep)
        {
            return "is-active";
        }

        return wizardStep < currentStep ? "is-complete" : string.Empty;
    }

