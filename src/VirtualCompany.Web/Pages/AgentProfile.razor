@page "/agents/{AgentId:guid}"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components
@using VirtualCompany.Web.Services
@inject OnboardingApiClient OnboardingApiClient
@inject AgentApiClient AgentApiClient
@inject NavigationManager Navigation
@inject IStringLocalizer<AgentsResources> AgentText
@inject IStringLocalizer<CommonResources> CommonText

<PageTitle>@(profile is null ? AgentText["AgentProfile"] : $"{profile.DisplayName} | {AgentText["AgentProfile"]}")</PageTitle>

@if (isLoading)
{
    <section class="agent-profile-state" aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <div>
            <h1>@AgentText["LoadingAgentProfile"]</h1>
            <p>@AgentText["LoadingAgentProfileDetail"]</p>
        </div>
    </section>
}
else if (CompanyId is null)
{
    <section class="agent-profile-state">
        <span class="bi bi-building" aria-hidden="true"></span>
        <div>
            <h1>@AgentText["SelectCompany"]</h1>
            <p>@AgentText["ProfileRequiresCompany"]</p>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(errorMessage) || profile is null)
{
    <section class="agent-profile-state agent-profile-state--error" role="alert">
        <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
        <div>
            <h1>@AgentText["ProfileUnavailable"]</h1>
            <p>@(string.IsNullOrWhiteSpace(errorMessage) ? AgentText["ProfileCouldNotLoad"] : errorMessage)</p>
        </div>
    </section>
}
else
{
    var currentProfile = profile;
    var initials = GetInitials(currentProfile.DisplayName);
    var completedCount = currentProfile.WorkloadSummary.ExecutedCount;
    var activeAlertCount = statusDetail?.ActiveAlertsCount ?? 0;
    var openWorkCount = statusDetail is null
        ? currentProfile.WorkloadSummary.OpenItemsCount
        : statusDetail.Workload.ActiveTaskCount + statusDetail.Workload.ActiveWorkflowCount;

    <main class="agent-profile-page">
        <header class="agent-profile-commandbar">
            <div class="agent-profile-commandbar__identity">
                <span class="agent-profile-avatar agent-profile-avatar--placeholder" aria-hidden="true">
                    @initials
                    @if (!string.IsNullOrWhiteSpace(currentProfile.AvatarUrl))
                    {
                        <img src="@currentProfile.AvatarUrl" alt="" onerror="this.style.display='none'" />
                    }
                </span>

                <div class="agent-profile-commandbar__title">
                    <div class="agent-profile-commandbar__name-row">
                        <h1>@currentProfile.DisplayName</h1>
                        <span class="agent-profile-status agent-profile-status--active">
                            <span aria-hidden="true"></span>@SharedStatusPresenter.Format(currentProfile.Status, CommonText)
                        </span>
                        <span class="agent-profile-status @GetHealthBadgeCss(currentProfile.WorkloadSummary.HealthSummary.Status)">
                            <span class="bi bi-shield-check" aria-hidden="true"></span>@GetHealthLabel(currentProfile.WorkloadSummary.HealthSummary.Status)
                        </span>
                    </div>
                    <p>@currentProfile.RoleName <span aria-hidden="true">·</span> @currentProfile.Department</p>
                </div>

                <div class="agent-profile-commandbar__meta">
                    <span>@AgentText["LastActive"]</span>
                    <strong>@FormatRelativeDate(currentProfile.WorkloadSummary.LastActivityUtc)</strong>
                </div>
            </div>

            <div class="agent-profile-commandbar__actions">
                <a class="btn btn-outline-secondary" href="@(CanViewDirectory ? $"/agents?companyId={CompanyId}" : $"/dashboard?companyId={CompanyId}")">
                    <span class="bi bi-arrow-left" aria-hidden="true"></span>
                    <span>@AgentText["Back"]</span>
                </a>
                @if (currentProfile.Visibility.CanEditAgent)
                {
                    <a class="btn btn-outline-primary" href="@($"/agents/{currentProfile.Id}/chat?companyId={CompanyId}")">
                        <span class="bi bi-chat-left-text" aria-hidden="true"></span>
                        <span>@AgentText["Chat"]</span>
                    </a>
                    <a class="btn btn-primary" href="@($"/agents/manage?companyId={CompanyId}&agentId={currentProfile.Id}")">
                        <span class="bi bi-pencil" aria-hidden="true"></span>
                        <span>@AgentText["EditProfile"]</span>
                    </a>
                }
            </div>
        </header>

        <section class="agent-profile-kpis" aria-label="@AgentText["ProfileDetails"]">
            <article class="agent-profile-kpi">
                <span class="agent-profile-kpi__icon agent-profile-kpi__icon--blue" aria-hidden="true">→</span>
                <div><span>@AgentText["OpenWork"]</span><strong>@openWorkCount</strong><small>@AgentText["TasksAndWorkflows"]</small></div>
            </article>
            <article class="agent-profile-kpi">
                <span class="agent-profile-kpi__icon agent-profile-kpi__icon--amber" aria-hidden="true">…</span>
                <div><span>@CommonText["StatusPendingReview"]</span><strong>@currentProfile.WorkloadSummary.AwaitingApprovalCount</strong><small>@AgentText["ItemsNeedReview"]</small></div>
            </article>
            <article class="agent-profile-kpi">
                <span class="agent-profile-kpi__icon agent-profile-kpi__icon--green" aria-hidden="true">✓</span>
                <div><span>@AgentText["Completed"]</span><strong>@completedCount</strong><small>@AgentText["SuccessfulOutcomes"]</small></div>
            </article>
            <article class="agent-profile-kpi">
                <span class="agent-profile-kpi__icon agent-profile-kpi__icon--red" aria-hidden="true">!</span>
                <div><span>@AgentText["ActiveAlerts"]</span><strong>@activeAlertCount</strong><small>@AgentText[activeAlertCount == 1 ? "AlertNeedsAttentionOne" : "AlertsNeedAttentionMany"]</small></div>
            </article>
        </section>

        <section class="agent-profile-operations" aria-label="Current agent operations">
            <article class="agent-profile-panel agent-profile-work-panel">
                <header class="agent-profile-panel__header">
                    <div><span class="bi bi-list-task" aria-hidden="true"></span><h2>@AgentText["CurrentWork"]</h2></div>
                    @if (statusDetail is not null)
                    {
                        <small>@AgentText["UpdatedAt", FormatRelativeDate(statusDetail.GeneratedUtc)]</small>
                    }
                </header>

                @if (statusDetail is null || (statusDetail.ActiveTasks.Count == 0 && statusDetail.ActiveWorkflows.Count == 0))
                {
                    <div class="agent-profile-empty">
                        <span class="bi bi-check2" aria-hidden="true"></span>
                        <strong>@AgentText["AllCaughtUp"]</strong>
                        <p>@AgentText["NoActiveTasks"]</p>
                    </div>
                }
                else
                {
                    <div class="agent-profile-work-list">
                        @foreach (var task in statusDetail.ActiveTasks.Take(3))
                        {
                            <div class="agent-profile-work-item">
                                <span class="agent-profile-work-item__icon bi bi-check2-square" aria-hidden="true"></span>
                                <div><strong>@task.Title</strong><small>@Humanize(task.Type) · @Humanize(task.Priority) priority · @FormatRelativeDate(task.UpdatedUtc)</small></div>
                                <span class="agent-profile-tag">@Humanize(task.Status)</span>
                            </div>
                        }
                        @foreach (var workflow in statusDetail.ActiveWorkflows.Take(3))
                        {
                            <div class="agent-profile-work-item">
                                <span class="agent-profile-work-item__icon bi bi-diagram-3" aria-hidden="true"></span>
                                <div><strong>@workflow.DefinitionName</strong><small>@GetOptionalText(workflow.CurrentStep) · @FormatRelativeDate(workflow.UpdatedUtc)</small></div>
                                <span class="agent-profile-tag">@Humanize(workflow.State)</span>
                            </div>
                        }
                    </div>
                }

                <div class="agent-profile-recent">
                    <div class="agent-profile-subheading"><span class="bi bi-clock-history" aria-hidden="true"></span><h3>@AgentText["RecentActivity"]</h3></div>
                    @if (GetRecentActivity(currentProfile).Count == 0)
                    {
                        <p class="agent-profile-empty-copy">@AgentText["NoRecentActivityRecorded"]</p>
                    }
                    else
                    {
                        <div class="agent-profile-timeline">
                            @foreach (var activity in GetRecentActivity(currentProfile).Take(3))
                            {
                                <div class="agent-profile-timeline__item">
                                    <span aria-hidden="true"></span>
                                    <div><strong>@activity.Title</strong><small>@Humanize(activity.ActivityType) · @FormatRelativeDate(activity.OccurredUtc)</small></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </article>

            <div class="agent-profile-operations__side">
                <article class="agent-profile-panel agent-profile-alert-panel @(activeAlertCount > 0 ? "has-alert" : null)">
                    <header class="agent-profile-panel__header">
                        <div><span class="bi @(activeAlertCount > 0 ? "bi-exclamation-triangle" : "bi-shield-check")" aria-hidden="true"></span><h2>@AgentText[activeAlertCount > 0 ? "AttentionRequired" : "NoActiveAlerts"]</h2></div>
                    </header>
                    @if (statusDetail?.ActiveAlerts.FirstOrDefault() is { } primaryAlert)
                    {
                        <div class="agent-profile-alert">
                            <div class="agent-profile-alert__title"><strong>@primaryAlert.Title</strong><span class="agent-profile-severity @GetSeverityCss(primaryAlert.Severity)">@Humanize(primaryAlert.Severity)</span></div>
                            <p>@primaryAlert.Summary</p>
                            <small>@Humanize(primaryAlert.Type) · @Humanize(primaryAlert.Status) · @FormatDate(primaryAlert.UpdatedUtc)</small>
                        </div>
                    }
                    else
                    {
                        <div class="agent-profile-clear-state"><span class="bi bi-check-circle" aria-hidden="true"></span><p>@AgentText["NoAlertsLinked"]</p></div>
                    }
                </article>

                <article class="agent-profile-panel agent-profile-health-panel">
                    <header class="agent-profile-panel__header">
                        <div><span class="bi bi-activity" aria-hidden="true"></span><h2>@AgentText["OperatingStatus"]</h2></div>
                    </header>
                    <dl class="agent-profile-health-grid">
                        <div><dt>@AgentText["Health"]</dt><dd class="@GetHealthCss(statusDetail?.Health.Status ?? currentProfile.WorkloadSummary.HealthSummary.Status)">@GetHealthLabel(statusDetail?.Health.Status ?? currentProfile.WorkloadSummary.HealthSummary.Status)</dd></div>
                        <div><dt>@AgentText["Workload"]</dt><dd>@GetHealthLabel(statusDetail?.Workload.WorkloadLevel ?? "inactive")</dd></div>
                        <div><dt>@AgentText["FailedRuns"]</dt><dd>@(statusDetail?.Health.Metrics.FailedRunCount ?? currentProfile.WorkloadSummary.FailedCount)</dd></div>
                        <div><dt>@AgentText["StalledWork"]</dt><dd>@(statusDetail?.Health.Metrics.StalledWorkCount ?? 0)</dd></div>
                        <div><dt>@AgentText["PolicyViolations"]</dt><dd>@(statusDetail?.Health.Metrics.PolicyViolationCount ?? 0)</dd></div>
                        <div><dt>@AgentText["Autonomy"]</dt><dd>@GetAutonomyLabel(currentProfile.AutonomyLevel)</dd></div>
                    </dl>
                </article>
            </div>
        </section>

        <section class="agent-profile-details">
            <nav class="agent-profile-tabs" aria-label="@AgentText["ProfileDetails"]">
                @foreach (var tab in DetailTabs)
                {
                    <button type="button" class="agent-profile-tab @(selectedTab == tab.Key ? "is-active" : null)" aria-selected="@(selectedTab == tab.Key)" @onclick="@(() => selectedTab = tab.Key)">
                        <span class="bi @tab.Icon" aria-hidden="true"></span>@AgentText[tab.ResourceKey]
                    </button>
                }
            </nav>

            <div class="agent-profile-tab-content">
                @switch (selectedTab)
                {
                    case "access":
                        <div class="agent-profile-detail-columns">
                            @RenderDetailGroup(AgentText["DetailToolPermissions"], "bi-tools", currentProfile.ToolPermissions, currentProfile.Visibility.CanViewPermissions)
                            @RenderDetailGroup(AgentText["DetailDataAccess"], "bi-database-check", currentProfile.DataScopes, currentProfile.Visibility.CanViewPermissions)
                        </div>
                        break;
                    case "guardrails":
                        <div class="agent-profile-detail-columns">
                            @RenderDetailGroup(AgentText["DetailApprovalThresholds"], "bi-check2-square", currentProfile.ApprovalThresholds, currentProfile.Visibility.CanViewThresholds)
                            @RenderDetailGroup(AgentText["DetailEscalationRules"], "bi-signpost-split", currentProfile.EscalationRules, currentProfile.Visibility.CanViewThresholds)
                        </div>
                        break;
                    case "schedule":
                        @RenderDetailGroup(AgentText["DetailWorkingHours"], "bi-calendar3", currentProfile.WorkingHours, currentProfile.Visibility.CanViewWorkingHours)
                        break;
                    case "activity":
                        <div class="agent-profile-full-activity">
                            @if (currentProfile.RecentActivity.Count == 0)
                            {
                                <p class="agent-profile-empty-copy">@AgentText["NoRecentActivityRecorded"]</p>
                            }
                            else
                            {
                                @foreach (var activity in currentProfile.RecentActivity)
                                {
                                    <article><span class="bi bi-check-circle" aria-hidden="true"></span><div><strong>@activity.Title</strong><p>@GetOptionalText(activity.Detail)</p><small>@Humanize(activity.ActivityType) · @Humanize(activity.Status) · @FormatDate(activity.OccurredUtc)</small></div></article>
                                }
                            }
                        </div>
                        break;
                    default:
                        <div class="agent-profile-responsibilities">
                            <div>
                                <div class="agent-profile-detail-heading"><span class="bi bi-bullseye" aria-hidden="true"></span><h2>@AgentText["Objectives"]</h2></div>
                                <p class="agent-profile-role-brief">@GetOptionalText(currentProfile.RoleBrief)</p>
                                <div class="agent-profile-objectives">
                                    @foreach (var objective in GetDetailItems(currentProfile.Objectives))
                                    {
                                    <article><span aria-hidden="true">✓</span><div><strong>@objective.Label</strong><p>@objective.Value</p></div></article>
                                    }
                                </div>
                            </div>
                            <div>
                                <div class="agent-profile-detail-heading"><span class="bi bi-stars" aria-hidden="true"></span><h2>@AgentText[IsFinanceProfile(currentProfile) ? "FinanceCapabilities" : "RoleCapabilities"]</h2></div>
                                <div class="agent-profile-capabilities">
                                    @foreach (var capability in GetCapabilitySummaries(currentProfile))
                                    {
                                        <span><span class="agent-profile-capability-check" aria-hidden="true">✓</span>@capability</span>
                                    }
                                </div>
                            </div>
                        </div>
                        break;
                }
            </div>
        </section>
    </main>
}

@code {
    [Parameter]
    public Guid AgentId { get; set; }

    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    private static readonly IReadOnlyList<AgentProfileTab> DetailTabs =
    [
        new("responsibilities", "TabResponsibilities", "bi-bullseye"),
        new("access", "TabAccess", "bi-key"),
        new("guardrails", "TabGuardrails", "bi-shield-check"),
        new("schedule", "TabSchedule", "bi-calendar3"),
        new("activity", "TabActivity", "bi-clock-history")
    ];

    private CurrentUserContextViewModel? currentUser;
    private bool isLoading = true;
    private string? errorMessage;
    private string selectedTab = "responsibilities";
    private AgentProfileViewModel? profile;
    private AgentStatusDetailViewModel? statusDetail;

    private CompanyMembershipViewModel? ActiveMembership =>
        CompanyId is Guid companyId
            ? currentUser?.Memberships.FirstOrDefault(x =>
                x.CompanyId == companyId &&
                string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase))
            : null;

    private bool CanViewDirectory =>
        string.Equals(ActiveMembership?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(ActiveMembership?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(ActiveMembership?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        profile = null;
        currentUser = null;
        statusDetail = null;

        try
        {
            currentUser = await OnboardingApiClient.GetCurrentUserContextAsync();

            if (CompanyId is null && currentUser?.ActiveCompany is not null)
            {
                Navigation.NavigateTo($"/agents/{AgentId}?companyId={currentUser.ActiveCompany.CompanyId}", replace: true);
                return;
            }

            if (CompanyId is Guid && ActiveMembership is null)
            {
                errorMessage = AgentText["NoCompanyAccess"];
                return;
            }

            if (CompanyId is Guid activeCompanyId &&
                currentUser?.ActiveCompany is not null &&
                currentUser.ActiveCompany.CompanyId != activeCompanyId)
            {
                Navigation.NavigateTo($"/agents/{AgentId}?companyId={currentUser.ActiveCompany.CompanyId}", replace: true);
                return;
            }

            if (CompanyId is Guid companyId)
            {
                profile = await AgentApiClient.GetProfileViewAsync(companyId, AgentId);
                statusDetail = await AgentApiClient.GetStatusDetailAsync(companyId, AgentId);
            }
        }
        catch (InvalidOperationException)
        {
            errorMessage = AgentText["NoCompanyAccess"];
            profile = null;
        }
        catch (OnboardingApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static IReadOnlyList<AgentRecentActivityViewModel> GetRecentActivity(AgentProfileViewModel currentProfile) =>
        currentProfile.RecentActivity.OrderByDescending(item => item.OccurredUtc).ToArray();

    private IReadOnlyList<string> GetCapabilitySummaries(AgentProfileViewModel currentProfile)
    {
        if (IsFinanceProfile(currentProfile))
        {
            return AgentFinancePresentation.GetCapabilitySummaries(currentProfile);
        }

        var capabilities = TryReadStringArray(currentProfile.ToolPermissions, "allowed")
            .Concat(TryReadStringArray(currentProfile.ToolPermissions, "actions"))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(Humanize)
            .Take(10)
            .ToArray();

        return capabilities.Length == 0
            ? [AgentText["ReviewAssignedWork"], AgentText["RecommendedNextActions"]]
            : capabilities;
    }

    private RenderFragment RenderDetailGroup(
        string title,
        string icon,
        IReadOnlyDictionary<string, JsonNode?> values,
        bool canView) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "section");
        builder.AddAttribute(sequence++, "class", "agent-profile-detail-group");
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "agent-profile-detail-heading");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", $"bi {icon}");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.OpenElement(sequence++, "h2");
        builder.AddContent(sequence++, title);
        builder.CloseElement();
        builder.CloseElement();

        if (!canView)
        {
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "agent-profile-empty-copy");
            builder.AddContent(sequence++, AgentText["HiddenForMembershipRole"]);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "dl");
            builder.AddAttribute(sequence++, "class", "agent-profile-detail-list");
            foreach (var item in GetDetailItems(values))
            {
                builder.OpenElement(sequence++, "div");
                builder.OpenElement(sequence++, "dt");
                builder.AddContent(sequence++, item.Label);
                builder.CloseElement();
                builder.OpenElement(sequence++, "dd");
                builder.AddContent(sequence++, item.Value);
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private IReadOnlyList<AgentProfileDetailItem> GetDetailItems(IReadOnlyDictionary<string, JsonNode?> values) =>
        values.Count == 0
            ? [new(AgentText["NoConfiguration"], AgentText["NoConfigurationDetails"])]
            : values
                .OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
                .Select(item => new AgentProfileDetailItem(Humanize(item.Key), FormatEntryValue(item.Value)))
                .ToArray();

    private static IReadOnlyList<string> TryReadStringArray(IReadOnlyDictionary<string, JsonNode?> payload, string key) =>
        payload.TryGetValue(key, out var node) && node is JsonArray array
            ? array
                .Select(item => item is JsonValue value && value.TryGetValue<string>(out var text) ? text : null)
                .Where(text => !string.IsNullOrWhiteSpace(text))
                .Select(text => text!)
                .ToArray()
            : [];

    private string FormatEntryValue(JsonNode? value)
    {
        if (value is null)
        {
            return AgentText["NotConfigured"];
        }

        if (value is JsonObject jsonObject)
        {
            if (jsonObject.TryGetPropertyValue("description", out var description) &&
                description is JsonValue descriptionValue &&
                descriptionValue.TryGetValue<string>(out var text) &&
                !string.IsNullOrWhiteSpace(text))
            {
                return text.Trim();
            }

            var properties = jsonObject
                .Select(property => $"{Humanize(property.Key)}: {FormatEntryValue(property.Value)}")
                .ToArray();
            return properties.Length == 0 ? AgentText["NotConfigured"] : string.Join(" · ", properties);
        }

        if (value is JsonArray array)
        {
            var items = array.Select(FormatEntryValue).Where(item => !string.IsNullOrWhiteSpace(item)).ToArray();
            return items.Length == 0 ? AgentText["NotConfigured"] : string.Join(", ", items);
        }

        if (value is JsonValue jsonValue)
        {
            if (jsonValue.TryGetValue<string>(out var stringValue))
            {
                return Humanize(stringValue);
            }
            if (jsonValue.TryGetValue<bool>(out var boolValue))
            {
                return boolValue ? AgentText["Yes"] : AgentText["No"];
            }
            if (jsonValue.TryGetValue<decimal>(out var decimalValue))
            {
                return decimalValue.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);
            }
            if (jsonValue.TryGetValue<double>(out var doubleValue))
            {
                return doubleValue.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);
            }
        }

        return AgentText["Configured"];
    }

    private string Humanize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return AgentText["NotConfigured"];
        }

        var normalized = value.Trim().Replace('_', ' ').Replace('-', ' ');
        var builder = new StringBuilder(normalized.Length + 8);
        for (var index = 0; index < normalized.Length; index++)
        {
            var character = normalized[index];
            if (index > 0 && char.IsUpper(character) && char.IsLower(normalized[index - 1]))
            {
                builder.Append(' ');
            }
            builder.Append(character);
        }

        var result = builder.ToString().Trim();
        return result.Length == 0 ? AgentText["NotConfigured"] : char.ToUpperInvariant(result[0]) + result[1..];
    }

    private string FormatRelativeDate(DateTime? value)
    {
        if (value is null)
        {
            return AgentText["NoActivityYet"];
        }

        var elapsed = DateTime.UtcNow - value.Value.ToUniversalTime();
        if (elapsed.TotalMinutes < 1) return AgentText["JustNow"];
        if (elapsed.TotalHours < 1) return AgentText["MinutesAgo", Math.Max(1, (int)elapsed.TotalMinutes)];
        if (elapsed.TotalDays < 1) return AgentText["HoursAgo", Math.Max(1, (int)elapsed.TotalHours)];
        if (elapsed.TotalDays < 7) return AgentText["DaysAgo", Math.Max(1, (int)elapsed.TotalDays)];
        return value.Value.ToLocalTime().ToString("d MMM yyyy");
    }

    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("g");

    private string GetOptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? AgentText["NotConfigured"] : value.Trim();

    private string GetHealthLabel(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "healthy" => AgentText["HealthHealthy"],
        "busy" => AgentText["HealthBusy"],
        "inactive" => AgentText["HealthInactive"],
        "blocked" => AgentText["HealthBlocked"],
        "needs_attention" => AgentText["HealthNeedsAttention"],
        _ => AgentText["Unknown"]
    };

    private string GetAutonomyLabel(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "level_0" => AgentText["AutonomyLevel0"],
        "level_1" => AgentText["AutonomyLevel1"],
        "level_2" => AgentText["AutonomyLevel2"],
        "level_3" => AgentText["AutonomyLevel3"],
        _ => AgentText["Unknown"]
    };

    private static string GetHealthCss(string healthStatus) =>
        healthStatus.Trim().ToLowerInvariant() switch
        {
            "healthy" => "agent-health-healthy",
            "busy" => "agent-health-busy",
            "inactive" => "agent-health-inactive",
            "blocked" or "needs_attention" => "agent-health-attention",
            "archived" => "agent-health-archived",
            _ => "text-body-secondary"
        };

    private static string GetHealthBadgeCss(string healthStatus) =>
        healthStatus.Trim().ToLowerInvariant() switch
        {
            "healthy" => "agent-profile-status--healthy",
            "blocked" or "needs_attention" => "agent-profile-status--attention",
            _ => "agent-profile-status--neutral"
        };

    private static string GetSeverityCss(string severity) =>
        severity.Trim().ToLowerInvariant() switch
        {
            "critical" => "is-critical",
            "high" => "is-high",
            "warning" or "medium" => "is-warning",
            _ => "is-neutral"
        };

    private static string GetInitials(string value)
    {
        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
            .ToArray();
        return parts.Length == 0 ? "AG" : new string(parts);
    }

    private static bool IsFinanceProfile(AgentProfileViewModel currentProfile) =>
        AgentFinancePresentation.IsFinanceProfile(currentProfile);

    private sealed record AgentProfileTab(string Key, string ResourceKey, string Icon);
    private sealed record AgentProfileDetailItem(string Label, string Value);
}
