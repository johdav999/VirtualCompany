@page "/agents"
@rendermode InteractiveServer
@inject OnboardingApiClient OnboardingApiClient
@inject AgentApiClient AgentApiClient
@inject NavigationManager Navigation
@inject IStringLocalizer<AgentsResources> AgentText
@inject IStringLocalizer<CommonResources> CommonText

<PageTitle>@AgentText["AgentRoster"]</PageTitle>

@if (isLoading)
{
    <section class="py-4">
        <h1>@AgentText["AgentRoster"]</h1>
        <p class="text-body-secondary mb-0">@AgentText["LoadingAgentRoster"]</p>
    </section>
}
else if (CompanyId is null)
{
    <section class="py-4 dashboard-hero">
        <div class="wizard-card">
            <h1>@AgentText["SelectCompany"]</h1>
            <p class="text-body-secondary">@AgentText["ChooseCompanyForRoster"]</p>

            @if (activeMemberships.Count == 0)
            {
                <p class="mb-0">@AgentText["NoActiveMemberships"]</p>
            }
            else
            {
                <div class="template-grid">
                    @foreach (var membership in activeMemberships)
                    {
                        <a class="template-card text-decoration-none text-reset" href="@BuildRosterUri(membership.CompanyId, null, null)">
                            <strong>@membership.CompanyName</strong>
                            <CompanyIdentityHint Membership="membership" />
                            <div class="text-body-secondary mt-2">@AgentText["MembershipRole", membership.MembershipRole]</div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="py-4 dashboard-hero">
        <div class="wizard-card">
            <div class="agent-roster-header">
                <div>
                    <span class="dashboard-kicker">@AgentText["AgentDirectory"]</span>
                    <h1 class="mb-0 mt-2">@(companyAccess?.CompanyName ?? AgentText["AgentRoster"])</h1>
                    <p class="text-body-secondary mt-3 mb-0">@AgentText["AgentRosterDescription"]</p>
                </div>
                <div class="dashboard-actions">
                    <a class="btn btn-outline-secondary" href="@($"/dashboard?companyId={CompanyId}")">@AgentText["BackToDashboard"]</a>
                    <a class="btn btn-outline-secondary" href="@($"/agents/staff?companyId={CompanyId}")">@AgentText["AgentStaff"]</a>
                    @if (CanManageProfiles)
                    {
                        <a class="btn btn-primary" href="@BuildManageUri(CompanyId!.Value, Department, Status, null)">@AgentText["OpenAgentManagement"]</a>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4 mb-0">@errorMessage</div>
            }
        </div>

        @if (!CanViewDirectory)
        {
            <div class="wizard-card mt-4">
                <h2 class="h5 mb-2">@AgentText["RestrictedRosterAccess"]</h2>
                <p class="text-body-secondary mb-0">@AgentText["RestrictedRosterExplanation"]</p>
            </div>
        }
        else
        {
            <div class="wizard-card mt-4">
                <div class="agent-roster-header">
                    <div>
                        <span class="dashboard-kicker">@AgentText["DirectoryFilters"]</span>
                        <h2 class="h4 mb-0 mt-2">@AgentText["CompanyAgents"]</h2>
                    </div>
                    <span class="badge text-bg-light">@AgentText["TotalCount", rosterResponse.Items.Count]</span>
                </div>

                <form class="agent-filter-bar mt-4" method="get">
                    <input type="hidden" name="companyId" value="@CompanyId" />

                    <div>
                        <label class="form-label" for="department-filter">@AgentText["Department"]</label>
                        <select id="department-filter" class="form-select" name="department">
                            <option value="" selected="@string.IsNullOrWhiteSpace(Department)">@AgentText["AllDepartments"]</option>
                            @foreach (var department in rosterResponse.Departments)
                            {
                                <option value="@department" selected="@IsSelected(Department, department)">@department</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="status-filter">@AgentText["Status"]</label>
                        <select id="status-filter" class="form-select" name="status">
                            <option value="" selected="@string.IsNullOrWhiteSpace(Status)">@AgentText["AllStatuses"]</option>
                            @foreach (var status in rosterResponse.Statuses)
                            {
                                <option value="@status" selected="@IsSelected(Status, status)">@GetStatusLabel(status)</option>
                            }
                        </select>
                    </div>

                    <div class="dashboard-actions">
                        <button class="btn btn-primary" type="submit">@AgentText["ApplyFilters"]</button>
                        <a class="btn btn-outline-secondary" href="@BuildRosterUri(CompanyId!.Value, null, null)">@AgentText["ClearFilters"]</a>
                    </div>
                </form>

                <div class="agent-template-header mt-4">
                    <div>
                        <span class="dashboard-kicker">@AgentText["LiveStatus"]</span>
                        <h3 class="h5 mb-0 mt-2">@AgentText["StatusCards"]</h3>
                    </div>
                    @if (statusCards is not null)
                    {
                        <span class="text-body-secondary small">@AgentText["UpdatedAt", statusCards.GeneratedUtc.ToLocalTime().ToString("g")]</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(statusErrorMessage))
                {
                    <div class="alert alert-warning mt-3 mb-0">@statusErrorMessage</div>
                }
                else if (statusCards is null)
                {
                    <p class="text-body-secondary mb-0 mt-3">@AgentText["LoadingStatusCards"]</p>
                }
                else if (statusCards.Items.Count == 0)
                {
                    <p class="text-body-secondary mb-0 mt-3">@AgentText["NoLiveStatus"]</p>
                }
                else
                {
                    <div class="agent-status-grid mt-3">
                        @foreach (var card in statusCards.Items.Where(MatchesRosterFilters))
                        {
                            <AgentStatusCard Card="card" />
                        }
                    </div>
                }

                @if (rosterResponse.Items.Count == 0)
                {
                    <p class="text-body-secondary mb-0 mt-4">@AgentText["NoAgentsMatch"]</p>
                }
                else
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@AgentText["Name"]</th>
                                    <th scope="col">@AgentText["Role"]</th>
                                    <th scope="col">@AgentText["Department"]</th>
                                    <th scope="col">@AgentText["Status"]</th>
                                    <th scope="col">@AgentText["Autonomy"]</th>
                                    <th scope="col">@AgentText["WorkloadAndHealth"]</th>
                                    <th scope="col">@AgentText["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agent in rosterResponse.Items)
                                {
                                    <tr>
                                        <th scope="row">
                                            <a class="fw-semibold text-decoration-none" href="@GetProfileRoute(agent)">@agent.DisplayName</a>
                                            <div class="small text-body-secondary mt-1">@agent.Seniority</div>
                                        </th>
                                        <td>@agent.RoleName</td>
                                        <td>@agent.Department</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeCss(agent.Status)">@GetStatusLabel(agent.Status)</span>
                                        </td>
                                        <td>@ToDisplayText(agent.AutonomyLevel)</td>
                                        <td>
                                            <div class="fw-semibold @GetHealthCss(agent.WorkloadSummary.HealthSummary.Status)">@GetHealthLabel(agent.WorkloadSummary.HealthSummary.Status)</div>
                                            <div class="small text-body-secondary mt-1">@agent.WorkloadSummary.HealthSummary.Reason</div>
                                            <div class="small text-body-secondary mt-1">@FormatRosterActivity(agent.WorkloadSummary.LastActivityUtc)</div>
                                        </td>
                                        <td>
                                            <div class="dashboard-actions">
                                                <a class="btn btn-sm btn-outline-secondary" href="@GetProfileRoute(agent)">@AgentText["OpenProfile"]</a>
                                                @if (IsDirectChatEligible(agent.Status))
                                                {
                                                    <a class="btn btn-sm btn-primary" href="@BuildChatUri(agent.CompanyId, agent.Id)">@AgentText["Chat"]</a>
                                                }
                                                @if (CanManageProfiles)
                                                {
                                                    <a class="btn btn-sm btn-primary" href="@BuildManageUri(agent.CompanyId, Department, Status, agent.Id)">@AgentText["Manage"]</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [SupplyParameterFromQuery(Name = "department")]
    public string? Department { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private CurrentUserContextViewModel? currentUser;
    private CompanyAccessViewModel? companyAccess;
    private AgentStatusCardsResponseViewModel? statusCards;
    private string? statusErrorMessage;
    private AgentRosterResponseViewModel rosterResponse = new();
    private CancellationTokenSource? refreshCancellationTokenSource;

    private IReadOnlyList<CompanyMembershipViewModel> activeMemberships =>
        currentUser?.Memberships
            .Where(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase))
            .ToList()
        ?? [];

    private bool CanViewDirectory =>
        string.Equals(companyAccess?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    private bool CanManageProfiles => CanViewDirectory;

    public void Dispose()
    {
        refreshCancellationTokenSource?.Cancel();
        refreshCancellationTokenSource?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        statusErrorMessage = null;
        statusCards = null;
        refreshCancellationTokenSource?.Cancel();
        refreshCancellationTokenSource?.Dispose();
        refreshCancellationTokenSource = null;
        rosterResponse = new AgentRosterResponseViewModel();

        try
        {
            currentUser = await OnboardingApiClient.GetCurrentUserContextAsync(CompanyId);

            if (CompanyId is null && currentUser?.ActiveCompany is not null)
            {
                Navigation.NavigateTo(BuildRosterUri(currentUser.ActiveCompany.CompanyId, Department, Status), replace: true);
                return;
            }

            if (CompanyId is Guid companyId)
            {
                companyAccess = await OnboardingApiClient.GetCompanyAccessAsync(companyId);
                if (companyAccess is null)
                {
                    errorMessage = AgentText["NoCompanyAccess"];
                    return;
                }

                if (CanViewDirectory)
                {
                    rosterResponse = await AgentApiClient.GetRosterViewAsync(companyId, Department, Status);
                    await LoadStatusCardsAsync(companyId, CancellationToken.None);
                    StartStatusRefresh(companyId);
                }
            }
        }
        catch (OnboardingApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartStatusRefresh(Guid companyId)
    {
        refreshCancellationTokenSource = new CancellationTokenSource();
        var token = refreshCancellationTokenSource.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadStatusCardsAsync(companyId, token);
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private async Task LoadStatusCardsAsync(Guid companyId, CancellationToken cancellationToken)
    {
        try
        {
            statusCards = await AgentApiClient.GetStatusCardsAsync(companyId, cancellationToken);
            statusErrorMessage = null;
        }
        catch (OnboardingApiException ex)
        {
            statusErrorMessage = ex.Message;
        }
    }

    private bool MatchesRosterFilters(AgentStatusCardViewModel card) =>
        MatchesFilter(card.Department, Department) && MatchesFilter(card.HealthStatus, null) && MatchesFilter(card.DisplayName, null) && MatchesFilter(card.Department, Department);

    private static bool IsSelected(string? currentValue, string expectedValue) =>
        string.Equals(currentValue?.Trim(), expectedValue, StringComparison.OrdinalIgnoreCase);

    private string GetProfileRoute(AgentRosterItemViewModel agent) => string.IsNullOrWhiteSpace(agent.ProfileRoute) ? $"/agents/{agent.Id}?companyId={agent.CompanyId}" : agent.ProfileRoute!;

    private static string GetStatusBadgeCss(string? status) =>
        status?.Trim().ToLowerInvariant() switch
        {
            "active" => "text-bg-success",
            "paused" => "text-bg-warning",
            "restricted" => "text-bg-secondary",
            "archived" => "text-bg-dark",
            _ => "text-bg-light"
        };

    private string GetStatusLabel(string? status) => SharedStatusPresenter.Format(status, CommonText);
    private string ToDisplayText(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "level_0" => AgentText["AutonomyLevel0"],
        "level_1" => AgentText["AutonomyLevel1"],
        "level_2" => AgentText["AutonomyLevel2"],
        "level_3" => AgentText["AutonomyLevel3"],
        _ => AgentText["Unknown"]
    };
    private string GetHealthLabel(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "healthy" => AgentText["HealthHealthy"],
        "busy" => AgentText["HealthBusy"],
        "inactive" => AgentText["HealthInactive"],
        "blocked" => AgentText["HealthBlocked"],
        "needs_attention" => AgentText["HealthNeedsAttention"],
        _ => AgentText["Unknown"]
    };
    private static string GetHealthCss(string? healthStatus) =>
        healthStatus?.Trim().ToLowerInvariant() switch
        {
            "healthy" => "agent-health-healthy",
            "busy" => "agent-health-busy",
            "inactive" => "agent-health-inactive",
            "blocked" => "agent-health-attention",
            "needs_attention" => "agent-health-attention",
            _ => "text-body-secondary"
        };
    private string FormatRosterActivity(DateTime? lastActivityUtc) => lastActivityUtc is null
        ? AgentText["NoRecentActivity"]
        : AgentText["LastActivityAt", lastActivityUtc.Value.ToLocalTime().ToString("g")];
    private static bool IsDirectChatEligible(string? status) =>
        !string.Equals(status, "paused", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(status, "archived", StringComparison.OrdinalIgnoreCase);

    private static string BuildChatUri(Guid companyId, Guid agentId)
    {
        var query = $"companyId={companyId}";
        return $"/agents/{agentId}/chat?{query}";
    }

    private static string BuildRosterUri(Guid companyId, string? department, string? status)
    {
        var query = new List<string> { $"companyId={companyId}" };
        if (!string.IsNullOrWhiteSpace(department)) query.Add($"department={Uri.EscapeDataString(department)}");
        if (!string.IsNullOrWhiteSpace(status)) query.Add($"status={Uri.EscapeDataString(status)}");
        return $"/agents?{string.Join("&", query)}";
    }

    private static string BuildManageUri(Guid companyId, string? department, string? status, Guid? agentId)
    {
        var query = new List<string> { $"companyId={companyId}" };
        if (!string.IsNullOrWhiteSpace(department)) query.Add($"department={Uri.EscapeDataString(department)}");
        if (!string.IsNullOrWhiteSpace(status)) query.Add($"status={Uri.EscapeDataString(status)}");
        if (agentId is Guid selectedAgentId) query.Add($"agentId={selectedAgentId}");
        return $"/agents/manage?{string.Join("&", query)}";
    }

    private static bool MatchesFilter(string value, string? filter) =>
        string.IsNullOrWhiteSpace(filter) ||
        string.Equals(value, filter.Trim(), StringComparison.OrdinalIgnoreCase);
}
