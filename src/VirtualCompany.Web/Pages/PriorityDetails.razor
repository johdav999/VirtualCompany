@page "/dashboard/priorities"
@rendermode InteractiveServer
@implements IDisposable
@inject ITodayWorkspaceApiClient WorkspaceApi
@inject TodayPriorityChanges PriorityChanges
@inject NavigationManager Navigation
@inject OnboardingApiClient CompanyContextApi
@inject TaskApiClient TasksApi

<PageTitle>@CommonText["PriorityDetails"]</PageTitle>
<PriorityEvidenceDetail CompanyId="@(CompanyId ?? Guid.Empty)" PriorityKey="@Key" ReturnUrl="@ReturnUrl"
    Workspace="workspace" IsLoading="loading" IsUnauthorized="restricted" ErrorMessage="@error"
    RefreshRequested="LoadAsync" ChangedCount="changes.Changed" RemovedCount="changes.Removed" PreviousCheck="changes.PreviousCheck"
    HealthReturnUrl="@HealthReturnUrl" FollowUpRequested="RecordFollowUpAsync" FollowUpBusy="followUpBusy" FollowUpError="@followUpError" />

@code {
    [SupplyParameterFromQuery(Name = "companyId")] public Guid? CompanyId { get; set; }
    [SupplyParameterFromQuery(Name = "lens")] public string? Lens { get; set; }
    [SupplyParameterFromQuery(Name = "key")] public string? Key { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "healthReturnUrl")] public string? HealthReturnUrl { get; set; }
    private bool followUpBusy;
    private string? followUpError;
    private TodayWorkspaceViewModel? workspace;
    private bool loading = true, restricted, disposed;
    private string? error;
    private CancellationTokenSource? cancellation;
    private int version;
    private (int Changed, int Removed, DateTime? PreviousCheck) changes;
    private string? followUpScope;
    protected override Task OnParametersSetAsync()
    {
        var scope = $"{CompanyId}:{Key}";
        if (scope != followUpScope) { followUpScope = scope; followUpBusy = false; followUpError = null; }
        return LoadAsync();
    }
    private async Task LoadAsync()
    {
        if (new Uri(Navigation.Uri).AbsolutePath != "/dashboard/priorities") { version++; cancellation?.Cancel(); return; }
        cancellation?.Cancel(); cancellation?.Dispose();
        var token = (cancellation = new CancellationTokenSource()).Token;
        var requestVersion = ++version;
        var company = CompanyId;
        bool Current() => !disposed && !token.IsCancellationRequested && requestVersion == version &&
            new Uri(Navigation.Uri).AbsolutePath == "/dashboard/priorities";
        loading = true; restricted = false; error = null; workspace = null; changes = default;
        try
        {
            if (company is not Guid id || id == Guid.Empty) { restricted = true; return; }
            await CompanyContextApi.GetCurrentUserContextAsync(id, token);
            if (!Current()) return;
            var lens = TodayWorkspaceLensValues.Normalize(Lens);
            var result = await WorkspaceApi.RefreshAsync(id, TodayWorkspaceLensValues.All.Contains(lens) ? lens : null, token);
            if (!Current()) return;
            // Membership and responsibility are authoritative in the API. A key is never a grant.
            if (result?.CompanyId == id) { workspace = result; changes = PriorityChanges.Observe(result, updateBaseline: false); }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (TodayWorkspaceAccessException) { if (Current()) restricted = true; }
        catch (HttpRequestException) { if (Current()) error = CommonText["TodayErrorDescription"]; }
        catch (OnboardingApiException) { if (Current()) error = CommonText["TodayErrorDescription"]; }
        finally { if (Current()) loading = false; }
    }
    private async Task RecordFollowUpAsync()
    {
        if (followUpBusy || workspace?.ActiveLens != "company" || CompanyId is not Guid id) return;
        followUpBusy = true; followUpError = null;
        var savedVersion = version; var key = Key;
        try
        {
            // Revalidate access and evidence immediately before recording a personal work item.
            var fresh = await WorkspaceApi.RefreshAsync(id, "company");
            if (disposed || version != savedVersion || CompanyId != id || Key != key || new Uri(Navigation.Uri).AbsolutePath != "/dashboard/priorities") return;
            var risk = fresh?.CompanyId == id && fresh.ActiveLens == "company" ? CompanyHealthPresentation.FindRisk(fresh, key) : null;
            if (risk is null) { workspace = fresh; followUpError = CommonText["PriorityUnavailableDescription"]; followUpBusy = false; return; }
            workspace = fresh;
            var existing = fresh!.RiskFollowUps?.FirstOrDefault(x => x.EvidenceKey == risk.Key);
            var task = existing is not null ? new RiskFollowUpResult(existing.TaskId, id, existing.State, existing.ObservedAtUtc)
                : await TasksApi.CreateRiskFollowUpAsync(id, risk);
            if (disposed || version != savedVersion || CompanyId != id || Key != key) return;
            var origin = DashboardRoutes.NormalizeOverviewPath(ReturnUrl, id) ?? DashboardRoutes.BuildTodayPath(id, "company");
            var detail = DashboardRoutes.WithQuery(DashboardRoutes.BuildPriorityPath(id, "company", key!, origin),
                ("healthReturnUrl", DashboardRoutes.NormalizeHealthPath(HealthReturnUrl, id)));
            Navigation.NavigateTo(DashboardRoutes.WithQuery(DashboardRoutes.EnsureWorkspaceContext(
                $"/work?companyId={id:D}&tab=tasks&taskId={task.Id:D}", id, origin), ("priorityReturnUrl", detail)));
        }
        catch (TodayWorkspaceAccessException)
        {
            if (!disposed && version == savedVersion) { workspace = null; restricted = true; followUpBusy = false; }
        }
        catch (Exception ex) when (ex is HttpRequestException or OnboardingApiException or System.Text.Json.JsonException)
        {
            if (!disposed && version == savedVersion) followUpError = CommonText["HealthFollowUpUncertain"];
            // Do not retry an uncertain POST automatically: the existing task command has no idempotency key.
        }
    }
    public void Dispose() { disposed = true; cancellation?.Cancel(); cancellation?.Dispose(); }
}
