@page "/agents/staff"
@rendermode InteractiveServer
@implements IDisposable
@inject OnboardingApiClient Onboarding
@inject AgentWorkApiClient WorkApi
@inject NavigationManager Navigation
<PageTitle>Agent team</PageTitle>
<div class="agent-work-page">
    <header><div><span class="dashboard-kicker">AGENT TEAM</span><h1>Agent team</h1><p>Follow company outcomes from plan to completion.</p></div><button class="btn btn-outline-primary" @onclick="Reload" disabled="@loading">Refresh</button></header>
    @if (CompanyId is Guid company)
    {
        <nav aria-label="Agent work navigation"><a href="@(DashboardRoutes.NormalizeOverviewPath(ReturnUrl,company) ?? DashboardRoutes.BuildTodayPath(company))">Overview</a><a href="@AgentWorkRoutes.Related($"/work?companyId={company:D}&tab=tasks", company, Navigation.Uri)">Work</a><a href="@DashboardRoutes.WithQuery("/agents/staff/summary", ("companyId", company.ToString("D")), ("year", Year?.ToString()), ("month", Month?.ToString()))">Monthly company summary and roster</a></nav>
    }
    <form class="agent-work-filters" @onsubmit="Apply" @onsubmit:preventDefault>
        <label>Responsibility<select @key="(CompanyId, data is not null)" @bind="area" disabled="@loading"><option value="">All permitted</option>@foreach(var option in data?.Responsibilities ?? []) { <option value="@option">@AgentWorkRoutes.Area(option)</option> }</select></label>
        <label>Agent<select @key="(CompanyId, data is not null)" @bind="agent" disabled="@loading"><option value="">All permitted</option>@foreach(var option in data?.Agents ?? []) { <option value="@option.Id">@option.Name</option> }</select></label>
        <label>Objective<input @bind="objective" @bind:event="oninput" maxlength="200" placeholder="Search objectives" /></label>
        <label>State<select @bind="state"><option value="">All</option>@foreach(var option in AgentWorkStates.All) { <option value="@option">@AgentWorkRoutes.State(option)</option> }</select></label>
        <button class="btn btn-primary" type="submit" disabled="@loading">Apply</button><button class="btn btn-outline-secondary" type="button" @onclick="Clear">Clear</button>
    </form>
    @if(loading) { <section class="agent-work-card" role="status">Loading current work…</section> }
    else if(error is not null || data is null) { <section class="agent-work-card" role="alert"><h2>Work unavailable</h2><p>@(error ?? "Select a company with permitted work. No work counts or records are shown outside your access scope.")</p><button class="btn btn-outline-primary" @onclick="Reload">Retry</button></section> }
    else
    {
        <AgentWorkBoard Data="data" Location="@Navigation.Uri" PerStatePages="true" />
        @if (Empty(State) is null)
        {
            <p class="agent-work-pagination">@data.Items.Count shown across columns · @data.Total authorized outcomes@(data.IsPartial ? " in the source window" : ""). Use each column's page links to review more work.</p>
        }
        else
        {
            <nav class="agent-work-pagination" aria-label="Work pages"><button class="btn btn-outline-primary" disabled="@(Skip <= 0)" @onclick="Previous">Previous</button><span>@(data.Items.Count == 0 ? "0 on this page" : $"{data.Skip + 1}–{Math.Min(data.Skip + data.Items.Count, data.Total)}") of @data.Total authorized outcomes@(data.IsPartial ? " in the source window" : "")</span><button class="btn btn-outline-primary" disabled="@(!data.HasNext)" @onclick="Next">Next</button></nav>
        }
    }
</div>
@code {
    [SupplyParameterFromQuery] public Guid? CompanyId { get; set; }
    [SupplyParameterFromQuery] public string? Responsibility { get; set; }
    [SupplyParameterFromQuery] public Guid? AgentId { get; set; }
    [SupplyParameterFromQuery] public string? Objective { get; set; }
    [SupplyParameterFromQuery] public string? State { get; set; }
    [SupplyParameterFromQuery] public int Skip { get; set; }
    [SupplyParameterFromQuery] public int? Year { get; set; }
    [SupplyParameterFromQuery] public int? Month { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private AgentWorkBoardDto? data; private string? error; private bool loading = true;
    private string? area, agent, objective, state; private int version; private CancellationTokenSource? read;
    protected override Task OnParametersSetAsync() { area=Responsibility; agent=AgentId?.ToString(); objective=Objective; state=State; return Reload(); }
    private async Task Reload()
    {
        var current = ++version; read?.Cancel(); read?.Dispose(); read = new(); var token=read.Token; loading=true; data=null; error=null;
        try
        {
            if(CompanyId is not Guid company || company == Guid.Empty)
            {
                var context = await Onboarding.GetCurrentUserContextAsync(); if(current != version) return;
                if(context?.ActiveCompany is { } active) Navigation.NavigateTo($"/agents/staff?companyId={active.CompanyId:D}",replace:true); return;
            }
            var result = await WorkApi.ListAsync(new(company, Empty(Responsibility), AgentId, Empty(Objective), Empty(State), Skip, PerState: true), token);
            if(current == version && !token.IsCancellationRequested) data=result;
        }
        catch(OperationCanceledException) when(token.IsCancellationRequested) { }
        catch(Exception ex) when(ex is OnboardingApiException or ArgumentException) { if(current == version) error=ex.Message; }
        finally { if(current == version) loading=false; }
    }
    private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
    private void Apply() => Navigate(0);
    private void Clear() { area=agent=objective=state=null; Navigate(0); }
    private void Previous()=>Navigate(Math.Max(0,Skip-24)); private void Next()=>Navigate(Skip+24);
    private void Navigate(int skip)
    {
        if(CompanyId is not Guid company) return;
        Navigation.NavigateTo(DashboardRoutes.WithQuery("/agents/staff",("companyId",company.ToString("D")),("responsibility",Empty(area)),("agentId",Empty(agent)),("objective",Empty(objective)),("state",Empty(state)),("skip",skip.ToString(System.Globalization.CultureInfo.InvariantCulture)),("returnUrl",DashboardRoutes.NormalizeOverviewPath(ReturnUrl, company)),("year",Year?.ToString()),("month",Month?.ToString())));
    }
    public void Dispose() { version++; read?.Cancel(); read?.Dispose(); }
}
