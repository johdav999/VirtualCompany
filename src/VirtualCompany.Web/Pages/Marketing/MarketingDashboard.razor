@page "/marketing"
@rendermode InteractiveServer
@using System.Globalization
@using VirtualCompany.Web.Components.Marketing
@inject MarketingApiClient MarketingApi
@inject GuidedWorkApiClient GuidedWorkApi
@inject OnboardingApiClient OnboardingApi
@inject AgentApiClient AgentApi
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation

<PageTitle>Marketing</PageTitle>

<main class="vc-page marketing-page">
    <header class="vc-page-header marketing-header">
        <div>
            <span class="vc-kicker">MARKETING</span>
            <h1>Marketing workspace</h1>
            <p>Plan measurable growth, coordinate campaigns and content, and hand qualified demand to Sales.</p>
        </div>
        <div class="marketing-header__actions">
            <a class="btn btn-outline-primary" href="@PreviousView">Back to previous view</a>
            <a class="btn btn-outline-primary" href="@WithCompany("/company-operation")">Company operation</a>
            <button class="btn btn-outline-primary" disabled="@isLoading" @onclick="LoadAsync">Refresh</button>
            <button class="btn btn-primary" disabled="@(isLoading || marketingAgentId is null)" @onclick="RunAnalysisAsync">Ask Maya for priorities</button>
        </div>
    </header>

    <nav class="vc-section-tabs marketing-tabs" aria-label="Marketing sections">
        @foreach (var tab in tabs)
        {
            <a class="@(activeTab == tab ? "active" : null)" href="@WithCompany($"/marketing?section={tab}")" data-enhance-nav="false">@tab</a>
        }
    </nav>
    <nav class="vc-section-tabs" aria-label="Operational Marketing reports">@foreach (var kind in new[] { "delivery", "spend", "leads" }) { <a href="@MarketingJourneyRoutes.Report(resolvedCompanyId ?? CompanyId ?? Guid.Empty, kind, WorkspaceOrigin)">@(kind == "delivery" ? "Campaign delivery" : kind == "spend" ? "Spend versus budget" : "Available lead results")</a> }<a href="@WithCompany("/marketing/reports/management")">Performance and budget proposals</a></nav>

    @if (isLoading)
    {
        <section class="vc-panel marketing-state" aria-live="polite">Loading current marketing data...</section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="vc-panel marketing-state marketing-state--error" role="alert">
            <h2>Marketing is unavailable</h2>
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadAsync">Try again</button>
        </section>
    }
    else if (dashboard is not null)
    {
        @if (activeTab == "Overview")
        {
            <MarketingOverviewWorkspace OverviewState="overviewState" Dashboard="dashboard" WithCompany="WithCompany" ShowObjectives="ShowObjectives" />
        }
        else if (activeTab == "Objectives")
        {
            <MarketingObjectivesWorkspace ObjectivesState="objectivesState" Dashboard="dashboard" IsSaving="isSaving" CreateObjectiveAsync="CreateObjectiveAsync" ActivateObjectiveAsync="ActivateObjectiveAsync" />
        }
        else if (activeTab == "Plans")
        {
            <MarketingPlansWorkspace
                PlansState="plansState"
                SegmentsState="segmentsState"
                IsSaving="isSaving"
                MarketingAgentId="marketingAgentId"
                CompanyId="resolvedCompanyId"
                WithCompany="WithCompany"
                CreateGroundedPlanAsync="CreateGroundedPlanAsync"
                SelectPlanAsync="SelectPlanAsync"
                SubmitSelectedPlanAsync="SubmitSelectedPlanAsync"
                ActivateSelectedPlanAsync="ActivateSelectedPlanAsync"
                PrepareSelectedPlanPortfolioAsync="PrepareSelectedPlanPortfolioAsync"
                CommitSelectedPlanPortfolioAsync="CommitSelectedPlanPortfolioAsync"
                OpenPlanForm="OpenPlanForm"
                ClosePlanForm="ClosePlanForm" />
        }
        else if (activeTab == "Calendar")
        {
            <MarketingCalendarWorkspace Dashboard="dashboard" WithCompany="WithCompany" />
        }
        else if (activeTab == "Content")
        {
            <MarketingContentWorkspace
                BriefId="BriefId"
                WorkspaceOrigin="@WorkspaceOrigin"
                ContentState="contentState"
                Dashboard="dashboard"
                IsSaving="isSaving"
                CompanyId="resolvedCompanyId"
                CreateContentAsync="CreateContentAsync"
                SubmitContentAsync="SubmitContentAsync"
                PreflightContentAsync="PreflightContentAsync"
                ReviewContentAsync="@(args => ReviewContentAsync(args.Id, args.Approved))" />
        }
        else if (activeTab == "Audiences")
        {
            <MarketingAudiencesWorkspace AudiencesState="audiencesState" Dashboard="dashboard" IsSaving="isSaving" CreateQualificationAsync="CreateQualificationAsync" ActivateQualificationAsync="ActivateQualificationAsync" />
        }
        else if (activeTab == "Handoffs")
        {
            <MarketingHandoffsWorkspace Dashboard="dashboard" WithCompany="WithCompany" DecideHandoffAsync="@(args => DecideHandoffAsync(args.Id, args.Accepted))" />
        }
        else if (activeTab == "Experiments")
        {
            <MarketingExperimentsWorkspace
                AssetId="AssetId"
                ContentState="contentState"
                CreativeState="creativeState"
                ExperimentsState="experimentsState"
                Dashboard="dashboard"
                IsSaving="isSaving"
                MarketingAgentId="marketingAgentId"
                CreateExperimentAsync="CreateExperimentAsync"
                GenerateContentVariantsAsync="GenerateContentVariantsAsync"
                ActivateExperimentAsync="ActivateExperimentAsync"
                CompleteExperimentAsync="CompleteExperimentAsync"
                GenerateCreativeAsync="GenerateCreativeAsync"
                SubmitCreativeAsync="SubmitCreativeAsync"
                ReviewCreativeAsync="@(args => ReviewCreativeAsync(args.AssetId, args.Approved))"
                RequestCreativeChangesAsync="RequestCreativeChangesAsync"
                RescanCreativeAsync="RescanCreativeAsync"
                RetireCreativeAsync="RetireCreativeAsync" />
        }
        else if (activeTab == "Strategy")
        {
            <MarketingStrategyWorkspace
                SegmentsState="segmentsState"
                StrategyState="strategyState"
                IsSaving="isSaving"
                MarketingAgentId="marketingAgentId"
                CompanyId="resolvedCompanyId"
                PrepareStrategyProposalAsync="PrepareStrategyProposalAsync"
                CommitStrategyProposalAsync="CommitStrategyProposalAsync" />
        }
        else if (activeTab == "Segments")
        {
            <MarketingSegmentsWorkspace
                OverviewState="overviewState"
                SegmentsState="segmentsState"
                IsSaving="isSaving"
                MarketingAgentId="marketingAgentId"
                CompanyId="resolvedCompanyId"
                ReviewSegmentImpactAsync="ReviewSegmentImpactAsync"
                PrepareSegmentProposalAsync="PrepareSegmentProposalAsync"
                CommitSegmentProposalAsync="CommitSegmentProposalAsync" />
        }
        else if (activeTab == "Intelligence")
        {
            <MarketingIntelligenceWorkspace
                IntelligenceState="intelligenceState"
                IsSaving="isSaving"
                SelectIntelligenceAsync="SelectIntelligenceAsync"
                ReviewIntelligenceAsync="ReviewIntelligenceAsync"
                ArchiveIntelligenceAsync="ArchiveIntelligenceAsync" />
        }
        else if (activeTab == "Channels")
        {
            <MarketingChannelsWorkspace
                ActionId="ActionId"
                ChannelsState="channelsState"
                CreativeState="creativeState"
                JourneysState="journeysState"
                Dashboard="dashboard"
                IsSaving="isSaving"
                SynchronizeChannelActionAsync="SynchronizeChannelActionAsync"
                CancelChannelActionAsync="CancelChannelActionAsync"
                ReconcileChannelActionAsync="ReconcileChannelActionAsync"
                RefreshDestinationsAsync="RefreshDestinationsAsync"
                DisconnectChannelAsync="DisconnectChannelAsync"
                StartChannelOAuthAsync="StartChannelOAuthAsync"
                GenerateCreativeAsync="GenerateCreativeAsync" />
        }
        else if (activeTab == "Journeys")
        {
            <MarketingJourneysWorkspace JourneysState="journeysState" OverviewState="overviewState" IsSaving="isSaving" SelectJourneyAsync="SelectJourneyAsync" TransitionSelectedJourneyAsync="TransitionSelectedJourneyAsync" />
        }
        else if (activeTab == "Performance")
        {
            <MarketingPerformanceWorkspace OperationsState="operationsState" PerformanceState="performanceState" IsSaving="isSaving" ResolveEventAsync="ResolveEventAsync" />
        }
        else if (activeTab == "Operations")
        {
            <MarketingOperationsWorkspace
                OperationsState="operationsState"
                SegmentsState="segmentsState"
                IsSaving="isSaving"
                MarketingAgentId="marketingAgentId"
                WithCompany="WithCompany"
                RequestOperatingRunAsync="RequestOperatingRunAsync"
                SelectOperatingRunAsync="SelectOperatingRunAsync"
                RetryOperatingActionAsync="RetryOperatingActionAsync"
                CancelOperatingActionAsync="CancelOperatingActionAsync" />
        }

    }
</main>
