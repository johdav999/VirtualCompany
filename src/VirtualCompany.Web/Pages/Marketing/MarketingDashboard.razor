    private MarketingJourneyValidationViewModel? journeyValidation;
    private MarketingJourneyAudiencePreviewViewModel? journeyAudiencePreview;
    private IReadOnlyList<MarketingCreativeAssetViewModel> creativeAssets = [];
    private IReadOnlyDictionary<Guid, MarketingCreativeAssetScanViewModel> creativeScans = new Dictionary<Guid, MarketingCreativeAssetScanViewModel>();
    private IReadOnlyList<MarketingAttributionViewModel> attribution = [];
    private IReadOnlyList<MarketingEventTriggerViewModel> events = [];
    private readonly ObjectiveForm objectiveForm = new();
    private readonly StrategyProposalForm strategyProposalForm = new();
    private readonly DecompositionForm decompositionForm = new();
    private readonly PlanForm planForm = new();
    private readonly ContentForm contentForm = new();
    private readonly ContentGenerationForm contentGenerationForm = new();
    private readonly ExperimentForm experimentForm = new();
    private readonly QualificationForm qualificationForm = new();
    private readonly CreativeForm creativeForm = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; errorMessage = null;
        try
        {
            var context = await OnboardingApi.GetCurrentUserContextAsync();
            resolvedCompanyId = CompanyId ?? context?.ActiveCompany?.CompanyId ?? context?.Memberships.FirstOrDefault()?.CompanyId;
            if (resolvedCompanyId is not Guid companyId) throw new MarketingApiException("Choose a company before opening Marketing.");
            if (CompanyId is null) Navigation.NavigateTo($"/marketing?companyId={companyId:D}", true);
            var to = DateTime.UtcNow.AddDays(1);
            dashboard = await MarketingApi.GetDashboardAsync(companyId, to.AddDays(-30), to);
            if (contentGenerationForm.BriefId == Guid.Empty) contentGenerationForm.BriefId = dashboard.Content.FirstOrDefault(x => x.Status.Equals("draft", StringComparison.OrdinalIgnoreCase))?.Id ?? Guid.Empty;
            if (creativeForm.BriefId == Guid.Empty) creativeForm.BriefId = dashboard.Content.FirstOrDefault(x => x.Status is "submitted" or "approved")?.Id ?? Guid.Empty;
            strategies = await MarketingApi.GetStrategiesAsync(companyId);
            segments = await MarketingApi.GetSegmentsAsync(companyId);
            if (strategyProposalForm.SegmentVersionId == Guid.Empty) strategyProposalForm.SegmentVersionId = segments.SelectMany(x => x.Versions).FirstOrDefault(x => x.Status is "approved" or "active")?.Id ?? Guid.Empty;
            salesCampaigns = await SalesApi.ListCampaignsAsync(companyId);
            decompositionForm.StrategyId = decompositionForm.StrategyId == Guid.Empty ? strategies.FirstOrDefault(x => x.Status is "approved" or "active")?.Id ?? Guid.Empty : decompositionForm.StrategyId;
            decompositionForm.CampaignId = decompositionForm.CampaignId == Guid.Empty ? salesCampaigns.FirstOrDefault()?.Id ?? Guid.Empty : decompositionForm.CampaignId;
            decompositionForm.ObjectiveId = decompositionForm.ObjectiveId == Guid.Empty ? dashboard.Objectives.FirstOrDefault()?.Id ?? Guid.Empty : decompositionForm.ObjectiveId;
            intelligence = await MarketingApi.GetIntelligenceAsync(companyId);
            if (selectedIntelligence is null || !intelligence.Any(x => x.Id == selectedIntelligence.Id))
                selectedIntelligence = intelligence.FirstOrDefault();
            if (selectedIntelligence is not null)
                intelligenceReviews = await MarketingApi.GetIntelligenceReviewsAsync(companyId, selectedIntelligence.Id);
            operatingRuns = await MarketingApi.GetOperatingRunsAsync(companyId);
            if (selectedOperatingRun is null || !operatingRuns.Any(x => x.Id == selectedOperatingRun.Id))
                selectedOperatingRun = operatingRuns.FirstOrDefault();
            operatingActions = selectedOperatingRun is null ? [] : await MarketingApi.GetOperatingRunActionsAsync(companyId, selectedOperatingRun.Id);
            channelConnections = await MarketingApi.GetChannelConnectionsAsync(companyId);
            channelDestinations = await MarketingApi.GetChannelDestinationsAsync(companyId);
            channelActions = await MarketingApi.GetChannelActionsAsync(companyId);
            journeys = await MarketingApi.GetJourneysAsync(companyId);
            journeyEnrollments = await MarketingApi.GetJourneyEnrollmentsAsync(companyId);
            if (selectedJourney is null || !journeys.Any(x => x.Id == selectedJourney.Id)) selectedJourney = journeys.FirstOrDefault();
            if (selectedJourney is not null)
            {
                journeyValidation = await MarketingApi.ValidateJourneyAsync(companyId, selectedJourney.Id);
                journeyAudiencePreview = await MarketingApi.PreviewJourneyAudienceAsync(companyId, selectedJourney.Id);
            }
            creativeAssets = await MarketingApi.GetCreativeAssetsAsync(companyId);
            var scanSets = await Task.WhenAll(creativeAssets.Select(x => MarketingApi.GetCreativeAssetScansAsync(companyId, x.Id)));
            creativeScans = scanSets.SelectMany(x => x).GroupBy(x => x.AssetId).ToDictionary(x => x.Key, x => x.OrderByDescending(y => y.ScannedUtc).First());
            attribution = await MarketingApi.GetAttributionAsync(companyId);
            events = await MarketingApi.GetEventsAsync(companyId);
            var roster = await AgentApi.GetRosterAsync(companyId);
            marketingAgentId = roster.FirstOrDefault(x => x.Department.Equals("Marketing", StringComparison.OrdinalIgnoreCase) && !x.Status.Equals("archived", StringComparison.OrdinalIgnoreCase))?.Id;
        }
        catch (Exception ex) when (ex is MarketingApiException or OnboardingApiException) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private async Task ExecuteAndReloadAsync(Func<Guid, Task> action)
    {
        if (resolvedCompanyId is not Guid companyId) return;
        isSaving = true; errorMessage = null;
        try { await action(companyId); await LoadAsync(); }
        catch (MarketingApiException ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }

    private Task CreateObjectiveAsync() => ExecuteAndReloadAsync(async id => await MarketingApi.CreateObjectiveAsync(id,
        new(objectiveForm.Name, objectiveForm.ObjectiveType, objectiveForm.TargetValue, objectiveForm.Unit, DateTime.UtcNow.Date, DateTime.UtcNow.Date.AddMonths(3))));
    private async Task ReviewSegmentImpactAsync(Guid versionId)
    {
        if (resolvedCompanyId is not Guid companyId) return;
        isSaving = true; errorMessage = null;
        try
        {
            var requests = new[] { MarketingApi.GetSegmentImpactAsync(companyId, versionId) };
            await Task.WhenAll(requests);
            segmentImpact = requests[0].Result;
            segmentDecisionData = await MarketingApi.GetSegmentDecisionDataAsync(companyId, versionId);
        }
        catch (MarketingApiException ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }
    private async Task PrepareSegmentProposalAsync()
    {
        if (resolvedCompanyId is not Guid companyId || marketingAgentId is not Guid agentId) return;
        isSaving = true; errorMessage = null;
        try { segmentProposal = await MarketingApi.PrepareSegmentProposalAsync(companyId,
            new(agentId, segmentProposalForm.Name, segmentProposalForm.Objective)); }
        catch (MarketingApiException ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }
    private Task CommitSegmentProposalAsync() => ExecuteAndReloadAsync(async companyId =>
    {
        if (segmentProposal is null) return;
        var claims = segmentProposal.Claims.Select(x => new { area = x.Area, text = x.Recommendation,
            classification = x.Classification, confidence = x.Confidence, sourceIds = x.SourceIds }).ToArray();
        var claimJson = System.Text.Json.JsonSerializer.Serialize(claims);
        var evidenceJson = System.Text.Json.JsonSerializer.Serialize(new { sourceIds = segmentProposal.Sources.Select(x => x.Id),
            missingEvidence = segmentProposal.MissingEvidence });
        var scores = new Dictionary<string, decimal> { ["sizeGrowth"] = 0, ["needIntensity"] = 0,
            ["productFit"] = 0, ["differentiation"] = 0, ["reachability"] = 0, ["priceValueFit"] = 0,
            ["economics"] = 0, ["evidenceQuality"] = 0, ["risk"] = 100 };
        var key = $"segment-proposal:{segmentProposal.RunId:N}";
        var version = new CreateMarketingSegmentVersionViewModel(
            System.Text.Json.JsonSerializer.Serialize(new { basis = "Maya grounded proposal", requiresHumanReview = true }),
            claimJson, claimJson, claimJson, claimJson, null, null, "not_estimated", segmentProposal.Confidence,
            System.Text.Json.JsonSerializer.Serialize(new { status = "not_estimated", missingEvidence = true }),
            System.Text.Json.JsonSerializer.Serialize(new { policy = "segment-attractiveness-v1", missingEvidenceScore = 0 }),
            scores, evidenceJson, DateTime.UtcNow, key);
        await MarketingApi.CommitSegmentProposalAsync(companyId, new(segmentProposal.AgentId, segmentProposal.RunId,
            segmentProposal.SegmentName, segmentProposal.Summary, version, key));
        segmentProposal = null;
    });
    private async Task PrepareStrategyProposalAsync()
    {
        if (resolvedCompanyId is not Guid companyId || marketingAgentId is not Guid agentId || strategyProposalForm.SegmentVersionId == Guid.Empty) return;
        isSaving = true; errorMessage = null;
        try { strategyProposal = await MarketingApi.PrepareStrategyProposalAsync(companyId, new(agentId,
            strategyProposalForm.Objective, strategyProposalForm.Title, DateTime.UtcNow.Date,
            DateTime.UtcNow.Date.AddMonths(6), [strategyProposalForm.SegmentVersionId])); }
