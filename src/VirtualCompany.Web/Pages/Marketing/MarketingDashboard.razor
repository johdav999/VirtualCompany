@page "/marketing"
@rendermode InteractiveServer
@using System.Globalization
@using VirtualCompany.Web.Components.Marketing
@inject MarketingApiClient MarketingApi
@inject OnboardingApiClient OnboardingApi
@inject AgentApiClient AgentApi
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation

<PageTitle>Marketing</PageTitle>

<main class="vc-page marketing-page">
    <header class="vc-page-header marketing-header">
        <div>
            <span class="vc-kicker">MARKETING</span>
            <h1>Marketing workspace</h1>
            <p>Plan measurable growth, coordinate campaigns and content, and hand qualified demand to Sales.</p>
        </div>
        <div class="marketing-header__actions">
            <a class="btn btn-outline-primary" href="@WithCompany("/company-operation")">Company operation</a>
            <button class="btn btn-outline-primary" disabled="@isLoading" @onclick="LoadAsync">Refresh</button>
            <button class="btn btn-primary" disabled="@(isLoading || marketingAgentId is null)" @onclick="RunAnalysisAsync">Ask Maya for priorities</button>
        </div>
    </header>

    <nav class="vc-section-tabs marketing-tabs" aria-label="Marketing sections">
        @foreach (var tab in tabs)
        {
            <button type="button" class="@(activeTab == tab ? "active" : null)" @onclick="() => activeTab = tab">@tab</button>
        }
    </nav>

    @if (isLoading)
    {
        <section class="vc-panel marketing-state" aria-live="polite">Loading current marketing data...</section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="vc-panel marketing-state marketing-state--error" role="alert">
            <h2>Marketing is unavailable</h2>
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadAsync">Try again</button>
        </section>
    }
    else if (dashboard is not null)
    {
        @if (activeTab == "Overview")
        {
            <section class="marketing-kpis" aria-label="Marketing performance">
                @foreach (var metric in dashboard.Metrics.Take(4))
                {
                    <article class="vc-panel">
                        <span>@FriendlyMetric(metric.Name)</span>
                        <strong>@MetricValue(metric)</strong>
                        <small>@metric.Explanation</small>
                    </article>
                }
            </section>

            <div class="marketing-overview-grid">
                <div class="marketing-main-column">
                    <section class="vc-panel marketing-section">
                        <div class="marketing-section__header">
                            <div><span class="vc-kicker">DIRECTION</span><h2>Objectives and plans</h2></div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="ShowObjectives">Manage</button>
                        </div>
                        @if (dashboard.Objectives.Count == 0)
                        {
                            <MarketingEmpty Title="No marketing objectives yet" Message="Create a measurable objective before campaigns and content are prioritized." ActionText="Create objective" OnAction="ShowObjectives" />
                        }
                        else
                        {
                            <div class="marketing-list">
                                @foreach (var objective in dashboard.Objectives.Take(4))
                                {
                                    <article><div><strong>@objective.Name</strong><span>@objective.ObjectiveType / @objective.Status</span></div><strong>@objective.TargetValue.ToString("0.##") @objective.Unit</strong></article>
                                }
                            </div>
                        }
                    </section>

                    <section class="vc-panel marketing-section">
                        <div class="marketing-section__header">
                            <div><span class="vc-kicker">DELIVERY</span><h2>Campaign and content calendar</h2></div>
                            <a class="btn btn-sm btn-outline-primary" href="@WithCompany("/app/sales/campaigns")">Open campaigns</a>
                        </div>
                        @if (dashboard.Calendar.Count == 0)
                        {
                            <MarketingEmpty Title="No scheduled marketing work" Message="Campaign activities and plan dates will appear here when they are scheduled." />
                        }
                        else
                        {
                            <div class="marketing-calendar">
                                @foreach (var item in dashboard.Calendar.OrderBy(x => x.StartsUtc).Take(8))
                                {
                                    <article><time>@item.StartsUtc.ToLocalTime().ToString("dd MMM")</time><div><strong>@item.Name</strong><span>@item.Kind · @item.Status</span></div></article>
                                }
                            </div>
                        }
                    </section>
                </div>

                <aside class="vc-panel marketing-section marketing-attention">
                    <span class="vc-kicker">MAYA'S REVIEW</span>
                    <h2>Priorities and evidence</h2>
                    @if (analysis is null)
                    {
                        <p>Run a grounded review to rank current work using objectives, campaigns, observations, and approved company knowledge.</p>
                    }
                    else
                    {
                        <div class="marketing-analysis-status">Confidence @analysis.Confidence.ToString("P0") · @(analysis.RequiresReview ? "Human review needed" : "Ready to review")</div>
                        <p>@analysis.Summary</p>
                        @foreach (var priority in analysis.Priorities.Take(5))
                        {
                            <article class="marketing-priority"><strong>@priority.Title</strong><span>Priority score @priority.Score · @priority.Band</span></article>
                        }
                        @if (analysis.MissingEvidence.Count > 0)
                        {
                            <div class="marketing-evidence"><strong>Missing information</strong><span>@string.Join(", ", analysis.MissingEvidence)</span></div>
                        }
                    }
                </aside>
            </div>
        }
        else if (activeTab == "Objectives")
        {
            <section class="marketing-two-column">
                <div class="vc-panel marketing-section">
                    <div class="marketing-section__header"><div><span class="vc-kicker">OUTCOMES</span><h2>Marketing objectives</h2></div></div>
                    @if (dashboard.Objectives.Count == 0) { <MarketingEmpty Title="No objectives" Message="Objectives connect marketing work to an explicit target and period." /> }
                    <div class="marketing-list">
                        @foreach (var item in dashboard.Objectives)
                        {
                            <article>
                                <div><strong>@item.Name</strong><span>@item.PeriodStartUtc.ToString("d") - @item.PeriodEndUtc.ToString("d") / @item.Status</span></div>
                                <div class="marketing-inline-actions">
                                    <strong>@item.TargetValue.ToString("0.##") @item.Unit</strong>
                                    @if (item.Status.Equals("draft", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ActivateObjectiveAsync(item.Id)">Activate</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
                <EditForm Model="objectiveForm" OnValidSubmit="CreateObjectiveAsync" class="vc-panel marketing-form">
                    <h2>Create objective</h2>
                    <label>Name<InputText @bind-Value="objectiveForm.Name" /></label>
                    <label>Measure<InputText @bind-Value="objectiveForm.ObjectiveType" /></label>
                    <div class="marketing-form__row"><label>Target<InputNumber @bind-Value="objectiveForm.TargetValue" /></label><label>Unit<InputText @bind-Value="objectiveForm.Unit" /></label></div>
                    <button class="btn btn-primary" disabled="@isSaving">Create objective</button>
                </EditForm>
            </section>
        }
        else if (activeTab == "Plans")
        {
            <section class="marketing-two-column">
                <div class="vc-panel marketing-section">
                    <h2>Marketing plans</h2>
                    @if (dashboard.Plans.Count == 0) { <MarketingEmpty Title="No active plans" Message="Create a bounded plan with a period, summary, and optional budget." /> }
                    <div class="marketing-list">@foreach (var item in dashboard.Plans) { <article><div><strong>@item.Name</strong><span>@item.Summary / @item.Status</span></div><div class="marketing-inline-actions"><strong>@(item.PlannedBudget?.ToString("N0") ?? "No budget") @item.BudgetCurrency</strong>@if (item.Status.Equals("draft", StringComparison.OrdinalIgnoreCase)) { <button class="btn btn-sm btn-outline-primary" @onclick="() => ActivatePlanAsync(item.Id)">Activate</button> }</div></article> }</div>
                </div>
                <EditForm Model="planForm" OnValidSubmit="CreatePlanAsync" class="vc-panel marketing-form">
                    <h2>Create plan</h2>
                    <label>Name<InputText @bind-Value="planForm.Name" /></label>
                    <label>Summary<InputTextArea @bind-Value="planForm.Summary" /></label>
                    <div class="marketing-form__row"><label>Budget<InputNumber @bind-Value="planForm.Budget" /></label><label>Currency<InputText @bind-Value="planForm.Currency" /></label></div>
                    <button class="btn btn-primary" disabled="@isSaving">Create plan</button>
                </EditForm>
            </section>
        }
        else if (activeTab == "Calendar")
        {
            <section class="vc-panel marketing-section">
                <div class="marketing-section__header"><div><span class="vc-kicker">SCHEDULE</span><h2>Marketing calendar</h2></div><a href="@WithCompany("/app/sales/campaigns")">Manage campaigns</a></div>
                @if (dashboard.Calendar.Count == 0) { <MarketingEmpty Title="Calendar is empty" Message="Dated plans, campaigns, and campaign activities are combined here." /> }
                <div class="marketing-calendar marketing-calendar--wide">@foreach (var item in dashboard.Calendar.OrderBy(x => x.StartsUtc)) { <article><time>@item.StartsUtc.ToLocalTime().ToString("dd MMM yyyy")</time><div><strong>@item.Name</strong><span>@item.Kind · @item.Status · ends @item.EndsUtc.ToLocalTime().ToString("dd MMM")</span></div></article> }</div>
            </section>
        }
        else if (activeTab == "Content")
        {
            <section class="marketing-two-column">
                <div class="vc-panel marketing-section">
                    <h2>Content workflow</h2>
                    @if (dashboard.Content.Count == 0) { <MarketingEmpty Title="No content briefs" Message="Briefs keep audience, claims, tone, channel, sources, and approval state together." /> }
                    <div class="marketing-content-list">
                        @foreach (var item in dashboard.Content)
                        {
                            <article><div><strong>@item.Title</strong><span>@item.Channel / @item.Audience / @item.Status</span><p>@item.Purpose</p>
                                @if (item.Variants.Count > 0)
                                {
                                    <div class="marketing-list">@foreach (var variant in item.Variants) { <article><div><strong>@variant.Name</strong><span>v@variant.VersionNumber · @Friendly(variant.ContentFormat) · @Friendly(variant.Status)</span><p>@variant.Body</p><small>Sources: @JsonSummary(variant.SourceReferences, "No sources recorded") · @variant.PromptVersion</small></div></article> }</div>
                                }
                            </div>
                            @if (item.Status.Equals("draft", StringComparison.OrdinalIgnoreCase)) { <div class="marketing-inline-actions"><button class="btn btn-sm btn-outline-primary" @onclick="() => PreflightContentAsync(item.Id)">Check readiness</button><button class="btn btn-sm btn-primary" @onclick="() => SubmitContentAsync(item.Id)">Submit for review</button></div> }
                            else if (item.Status.Equals("submitted", StringComparison.OrdinalIgnoreCase)) { <div><button class="btn btn-sm btn-primary" @onclick="() => ReviewContentAsync(item.Id, true)">Approve</button><button class="btn btn-sm btn-outline-danger" @onclick="() => ReviewContentAsync(item.Id, false)">Reject</button></div> }</article>
                        }
                    </div>
                </div>
                <EditForm Model="contentForm" OnValidSubmit="CreateContentAsync" class="vc-panel marketing-form">
                    <h2>Create content brief</h2>
                    <label>Title<InputText @bind-Value="contentForm.Title" /></label>
                    <label>Purpose<InputTextArea @bind-Value="contentForm.Purpose" /></label>
                    <label>Audience<InputText @bind-Value="contentForm.Audience" /></label>
                    <div class="marketing-form__row"><label>Channel<InputText @bind-Value="contentForm.Channel" /></label><label>Language<InputText @bind-Value="contentForm.Language" /></label></div>
                    <div class="marketing-form__row"><label>Measurable objective<InputText @bind-Value="contentForm.MeasurableObjective" /></label><label>Funnel stage<InputSelect @bind-Value="contentForm.FunnelStage"><option value="awareness">Awareness</option><option value="consideration">Consideration</option><option value="conversion">Conversion</option><option value="retention">Retention</option></InputSelect></label></div>
                    <label>Key message<InputTextArea @bind-Value="contentForm.KeyMessage" /></label>
                    <label>Offer<InputText @bind-Value="contentForm.Offer" /></label>
                    <label>Call to action<InputText @bind-Value="contentForm.CallToAction" /></label>
                    <button class="btn btn-primary" disabled="@isSaving">Create brief</button>
                </EditForm>
            </section>
            @if (contentPreflight is not null)
            {
                <section class="vc-panel marketing-section" aria-live="polite">
                    <span class="vc-kicker">CONTENT CHECK</span>
                    <h2>@(contentPreflight.ReadyForReview ? "Ready for review" : "Resolve before submission")</h2>
                    @if (contentPreflight.Issues.Count == 0) { <p>No blocking content or evidence issues were found.</p> }
                    <div class="marketing-list">@foreach (var issue in contentPreflight.Issues) { <article><div><strong>@issue.Explanation</strong><span>@issue.Severity</span></div></article> }</div>
                </section>
            }
        }
        else if (activeTab == "Audiences")
        {
            <section class="marketing-two-column">
                <div class="vc-panel marketing-section">
                    <div class="marketing-section__header"><div><span class="vc-kicker">QUALIFIED DEMAND</span><h2>Audience qualification</h2></div></div>
                    @if (dashboard.QualificationDefinitions.Count == 0) { <MarketingEmpty Title="No qualification definition" Message="Define measurable B2B or B2C criteria before demand is handed to Sales." /> }
                    <div class="marketing-list">
                        @foreach (var item in dashboard.QualificationDefinitions)
                        {
                            <article><div><strong>@item.Name</strong><span>@item.AudienceType / @item.Channel / @item.Status</span></div><div class="marketing-inline-actions"><strong>Score @item.MinimumScore.ToString("0")+</strong>@if (item.Status.Equals("draft", StringComparison.OrdinalIgnoreCase)) { <button class="btn btn-sm btn-outline-primary" @onclick="() => ActivateQualificationAsync(item.Id)">Activate</button> }</div></article>
                        }
                    </div>
                    @if (dashboard.QualificationEvaluations.Count > 0)
                    {
                        <h3>Recent evaluations</h3>
                        <div class="marketing-list">@foreach (var item in dashboard.QualificationEvaluations.Take(10)) { <article><div><strong>@item.Status</strong><span>Contact @item.ContactId / @item.ObservedUtc.ToLocalTime().ToString("g")</span></div><strong>@item.Score.ToString("0")</strong></article> }</div>
                    }
                </div>
                <EditForm Model="qualificationForm" OnValidSubmit="CreateQualificationAsync" class="vc-panel marketing-form">
                    <h2>Create qualification definition</h2>
                    <label>Name<InputText @bind-Value="qualificationForm.Name" /></label>
                    <div class="marketing-form__row"><label>Audience type<InputSelect @bind-Value="qualificationForm.AudienceType"><option value="b2b">B2B</option><option value="b2c">B2C</option></InputSelect></label><label>Channel<InputText @bind-Value="qualificationForm.Channel" /></label></div>
                    <div class="marketing-form__row"><label>Minimum score<InputNumber @bind-Value="qualificationForm.MinimumScore" /></label><label>Freshness in days<InputNumber @bind-Value="qualificationForm.FreshnessDays" /></label></div>
                    <label><InputCheckbox @bind-Value="qualificationForm.RequiresCustomerCompany" /> Require a linked company</label>
                    <button class="btn btn-primary" disabled="@isSaving">Create definition</button>
                </EditForm>
            </section>
        }
        else if (activeTab == "Handoffs")
        {
            <section class="vc-panel marketing-section">
                <div class="marketing-section__header"><div><span class="vc-kicker">MARKETING TO SALES</span><h2>Qualified demand handoffs</h2></div><a href="@WithCompany("/app/sales/prospects")">Open Sales prospects</a></div>
                @if (dashboard.Handoffs.Count == 0) { <MarketingEmpty Title="No handoffs" Message="Qualified engagement can be transferred to Sales with evidence, urgency, ownership, and an expiry." /> }
                <div class="marketing-content-list">@foreach (var item in dashboard.Handoffs) { <article><div><strong>@item.Reason</strong><span>@item.Urgency / @item.Status / expires @item.ExpiresUtc.ToLocalTime().ToString("d")</span><p>@item.SuggestedAction</p></div>@if (item.Status.Equals("proposed", StringComparison.OrdinalIgnoreCase)) { <div><button class="btn btn-sm btn-primary" @onclick="() => DecideHandoffAsync(item.Id, true)">Accept</button><button class="btn btn-sm btn-outline-danger" @onclick="() => DecideHandoffAsync(item.Id, false)">Decline</button></div> }</article> }</div>
            </section>
        }
        else if (activeTab == "Experiments")
        {
            <section class="marketing-two-column">
                <div class="vc-panel marketing-section">
                    <h2>Experiments</h2>
                    @if (dashboard.Experiments.Count == 0) { <MarketingEmpty Title="No experiments" Message="Define a hypothesis, primary metric, guardrail, sample size, and decision window." /> }
                    <div class="marketing-list">@foreach (var item in dashboard.Experiments) { <article><div><strong>@item.Name</strong><span>@item.Hypothesis / @item.Status</span></div><div class="marketing-inline-actions"><strong>@item.PrimaryMetric</strong>@if (item.Status.Equals("draft", StringComparison.OrdinalIgnoreCase)) { <button class="btn btn-sm btn-outline-primary" @onclick="() => ActivateExperimentAsync(item.Id)">Start</button> } else if (item.Status.Equals("active", StringComparison.OrdinalIgnoreCase)) { <button class="btn btn-sm btn-outline-primary" @onclick="() => CompleteExperimentAsync(item.Id)">Complete</button> }</div></article> }</div>
                </div>
                <EditForm Model="experimentForm" OnValidSubmit="CreateExperimentAsync" class="vc-panel marketing-form">
                    <h2>Create experiment</h2>
                    <label>Name<InputText @bind-Value="experimentForm.Name" /></label>
                    <label>Hypothesis<InputTextArea @bind-Value="experimentForm.Hypothesis" /></label>
                    <label>Primary metric<InputText @bind-Value="experimentForm.PrimaryMetric" /></label>
                    <label>Guardrail metric<InputText @bind-Value="experimentForm.GuardrailMetric" /></label>
                    <label>Minimum sample<InputNumber @bind-Value="experimentForm.MinimumSampleSize" /></label>
                    <button class="btn btn-primary" disabled="@isSaving">Create experiment</button>
                </EditForm>
            </section>
            @if (dashboard.Content.Any(x => x.Status.Equals("draft", StringComparison.OrdinalIgnoreCase)))
            {
                <section class="marketing-two-column">
                    <EditForm Model="contentGenerationForm" OnValidSubmit="GenerateContentVariantsAsync" class="vc-panel marketing-form">
                        <span class="vc-kicker">MAYA CONTENT STUDIO</span><h2>Generate grounded variants</h2>
                        <label>Draft brief<InputSelect @bind-Value="contentGenerationForm.BriefId">@foreach (var brief in dashboard.Content.Where(x => x.Status.Equals("draft", StringComparison.OrdinalIgnoreCase))) { <option value="@brief.Id">@brief.Title</option> }</InputSelect></label>
                        <div class="marketing-form__row"><label>Format<InputSelect @bind-Value="contentGenerationForm.ContentFormat"><option value="social_post">Social post</option><option value="email">Email</option><option value="landing_page">Landing page</option><option value="article">Article</option><option value="ad">Ad</option><option value="sales_enablement">Sales enablement</option></InputSelect></label><label>Variants<InputNumber @bind-Value="contentGenerationForm.VariantCount" /></label></div>
                        <label>Instructions<InputTextArea @bind-Value="contentGenerationForm.Instructions" /></label>
                        <button class="btn btn-primary" disabled="@(isSaving || marketingAgentId is null)">Generate drafts</button>
                    </EditForm>
                    <aside class="vc-panel marketing-section" aria-live="polite"><span class="vc-kicker">GENERATION SAFETY</span><h2>Evidence before claims</h2><p>Maya stores drafts only when every generated factual claim cites an accessible company source. Publishing remains a separate approved action.</p>@if (contentGenerationResult?.RequiresReview == true) { <div class="marketing-list">@foreach (var gap in contentGenerationResult.MissingEvidence) { <article><div><strong>Needs review</strong><span>@gap</span></div></article> }</div> }</aside>
                </section>
            }
            <section class="vc-panel marketing-section marketing-creative-studio">
                <div class="marketing-section__header"><div><span class="vc-kicker">CREATIVE STUDIO</span><h2>Governed visual assets</h2></div><span>@creativeAssets.Count immutable versions</span></div>
                <div class="marketing-two-column">
                    <div class="marketing-run-list">
                        @if (creativeAssets.Count == 0) { <MarketingEmpty Title="No creative assets" Message="Generate from a submitted brief or upload a human-created alternative for review." /> }
                        @foreach (var asset in creativeAssets)
                        {
                            var scan = LatestScan(asset.Id);
                            <article><div><strong>@asset.Name · v@asset.VersionNumber</strong><span>@asset.Dimensions · @asset.MediaType · @Friendly(asset.Status)</span><p>@asset.AltText</p><small>Brand @asset.BrandProfileVersion · scan: @(scan is null ? "not available" : Friendly(scan.Result))</small>@if(scan?.Result != "passed"){<p role="status">Quarantined — an authoritative safety scan must pass before submission, approval, download, or publication. @(scan?.ReasonCode is null ? "" : Friendly(scan.ReasonCode))</p>}<details><summary>Provenance, scan, and audit</summary><pre>@JsonSummary(asset.ProvenanceJson)</pre>@if(scan is not null){<small>@scan.Provider · @scan.ScannerVersion · @scan.ScannedUtc.ToLocalTime().ToString("g")</small><pre>@JsonSummary(scan.EvidenceJson)</pre>}<small>Sources: @JsonSummary(asset.SourceAssetIdsJson) · @asset.AuditReference · checksum @asset.Checksum[..Math.Min(12, asset.Checksum.Length)]</small></details></div><div class="marketing-inline-actions">@if (scan?.Result != "passed") { <button class="btn btn-sm btn-outline-secondary" disabled="@isSaving" @onclick="() => RescanCreativeAsync(asset.Id)">Rescan</button> }@if (asset.Status is "draft" or "changes_requested") { <button class="btn btn-sm btn-primary" disabled="@(isSaving || scan?.Result != "passed")" @onclick="() => SubmitCreativeAsync(asset.Id)">Submit</button> }@if (asset.Status == "submitted") { <button class="btn btn-sm btn-primary" disabled="@(isSaving || scan?.Result != "passed")" @onclick="() => ReviewCreativeAsync(asset.Id, true)">Approve</button><button class="btn btn-sm btn-outline-secondary" disabled="@isSaving" @onclick="() => RequestCreativeChangesAsync(asset.Id)">Request changes</button><button class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick="() => ReviewCreativeAsync(asset.Id, false)">Reject</button> }@if (asset.Status == "approved") { <button class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick="() => RetireCreativeAsync(asset.Id)">Retire</button> }</div></article>
                        }
                    </div>
                    @if (dashboard.Content.Any(x => x.Status is "submitted" or "approved"))
                    {
                        <EditForm Model="creativeForm" OnValidSubmit="GenerateCreativeAsync" class="marketing-form marketing-form--compact">
                            <h3>Generate review draft</h3>
                            <label>Approved brief<InputSelect @bind-Value="creativeForm.BriefId">@foreach(var brief in dashboard.Content.Where(x=>x.Status is "submitted" or "approved")){<option value="@brief.Id">@brief.Title</option>}</InputSelect></label>
                            <label>Asset name<InputText @bind-Value="creativeForm.Name" /></label>
                            <label>Art direction<InputTextArea @bind-Value="creativeForm.Prompt" /></label>
                            <label>Accessible alt text<InputText @bind-Value="creativeForm.AltText" /></label>
                            <button class="btn btn-primary" disabled="@isSaving">Generate immutable draft</button>
                        </EditForm>
                    }
                </div>
            </section>
        }
        else if (activeTab == "Strategy")
        {
            <section class="marketing-workspace-grid">
                <article class="vc-panel marketing-section marketing-workspace-hero">
                    <span class="vc-kicker">ACTIVE DIRECTION</span>
                    @if (strategies.Count == 0) { <MarketingEmpty Title="No Marketing strategy yet" Message="Create a versioned 4P and STP strategy grounded in approved customer segments and evidence." /> }
                    else
                    {
                        var item = strategies.First();
                        <div class="marketing-section__header"><div><h2>@item.Title</h2><span class="marketing-status">@Friendly(item.Status) · version @item.Version</span></div><strong>@item.ValidFromUtc.ToString("d") – @item.ValidToUtc.ToString("d")</strong></div>
                        <p>@item.Summary</p><div class="marketing-evidence"><strong>Evidence and gaps</strong><span>@JsonSummary(item.MissingEvidenceJson, "No missing evidence recorded")</span></div>
                    }
                </article>
                <article class="vc-panel marketing-section"><span class="vc-kicker">GOVERNANCE</span><h2>Next action</h2><p>Strategy activation requires completed company approval. Maya can prepare recommendations and drafts, but cannot approve or activate them.</p></article>
            </section>
            @if (segments.SelectMany(x => x.Versions).Any(x => x.Status is "approved" or "active"))
            {
                <section class="marketing-two-column">
                    <EditForm Model="strategyProposalForm" OnValidSubmit="PrepareStrategyProposalAsync" class="vc-panel marketing-form">
                        <span class="vc-kicker">ASK MAYA</span><h2>Prepare a grounded strategy</h2>
                        <label>Strategy title<InputText @bind-Value="strategyProposalForm.Title" /></label>
                        <label>Business objective<InputTextArea @bind-Value="strategyProposalForm.Objective" /></label>
                        <label>Approved target segment<InputSelect @bind-Value="strategyProposalForm.SegmentVersionId">@foreach (var segment in segments) { @foreach (var version in segment.Versions.Where(x => x.Status is "approved" or "active")) { <option value="@version.Id">@segment.Name · v@version.VersionNumber</option> } }</InputSelect></label>
                        <button class="btn btn-primary" disabled="@(isSaving || marketingAgentId is null)">Preview proposal</button>
                    </EditForm>
                    <aside class="vc-panel marketing-section" aria-live="polite">
                        <span class="vc-kicker">PROPOSAL REVIEW</span><h2>@(strategyProposal?.Title ?? "No proposal prepared")</h2>
                        @if (strategyProposal is not null)
                        {
                            <p>@strategyProposal.Summary</p><div class="marketing-list">@foreach (var item in strategyProposal.MarketCustomerSynthesis.Concat(strategyProposal.StpAndPositioning).Concat(strategyProposal.FourPs).Concat(strategyProposal.CompetitiveAnalysis).Concat(strategyProposal.SwotAndFiveForces)) { <article><div><strong>@Friendly(item.Area)</strong><span>@item.Recommendation</span><small>@item.Classification · @item.Confidence.ToString("P0") · @string.Join(", ", item.SourceIds)</small></div></article> }</div>
                            <div class="marketing-evidence"><strong>Source inspection</strong><span>@string.Join(" · ", strategyProposal.Sources.Select(x => x.Title))</span></div>
                            <button class="btn btn-primary" disabled="@(isSaving || strategyProposal.RequiresReview)" @onclick="CommitStrategyProposalAsync">Create draft</button>
                            @if (strategyProposal.RequiresReview) { <p>Resolve missing or invalid evidence before creating a draft: @string.Join("; ", strategyProposal.MissingEvidence)</p> }
                        }
                    </aside>
                </section>
            }
            @if (strategies.Any(x => x.Status is "approved" or "active") && salesCampaigns.Count > 0 && dashboard.Objectives.Count > 0)
            {
                <section class="marketing-two-column">
                    <EditForm Model="decompositionForm" OnValidSubmit="PreviewDecompositionAsync" class="vc-panel marketing-form">
                        <span class="vc-kicker">STRATEGY TO WORK</span><h2>Decompose into campaign work</h2>
                        <label>Approved strategy<InputSelect @bind-Value="decompositionForm.StrategyId">@foreach (var item in strategies.Where(x => x.Status is "approved" or "active")) { <option value="@item.Id">@item.Title</option> }</InputSelect></label>
                        <label>Existing Sales campaign<InputSelect @bind-Value="decompositionForm.CampaignId">@foreach (var item in salesCampaigns) { <option value="@item.Id">@item.Name · @Friendly(item.Status)</option> }</InputSelect></label>
                        <label>Objective<InputSelect @bind-Value="decompositionForm.ObjectiveId">@foreach (var item in dashboard.Objectives) { <option value="@item.Id">@item.Name</option> }</InputSelect></label>
                        <label>Plan name<InputText @bind-Value="decompositionForm.PlanName" /></label>
                        <button class="btn btn-outline-primary" disabled="@isSaving">Preview tree</button>
                    </EditForm>
                    <aside class="vc-panel marketing-section" aria-live="polite"><span class="vc-kicker">TREE AND READINESS</span><h2>@(decompositionProposal?.PlanName ?? "No decomposition preview")</h2>
                        @if (decompositionProposal is not null) { <div class="marketing-list">@foreach (var item in decompositionProposal.Activities) { <article><div><strong>@item.Name</strong><span>@Friendly(item.ActivityType) · @item.Channel · @item.StartsUtc.ToString("d")–@item.DueUtc.ToString("d")</span><small>@(item.DependsOnName is null ? "No dependency" : $"After {item.DependsOnName}") · @(item.ContentRequired ? "Content brief required" : "No content brief")</small></div></article> }</div><div class="marketing-evidence"><strong>Readiness</strong><span>@(decompositionProposal.ReadinessGaps.Count == 0 ? "Ready to commit as drafts" : string.Join("; ", decompositionProposal.ReadinessGaps))</span></div><button class="btn btn-primary" disabled="@(isSaving || !decompositionProposal.ReadyToCommit)" @onclick="CommitDecompositionAsync">Commit drafts</button> }
                    </aside>
                </section>
            }
        }
        else if (activeTab == "Segments")
        {
            <section class="vc-panel marketing-section">
                <div class="marketing-section__header"><div><span class="vc-kicker">TARGET SELECTION</span><h2>Strategic customer segments</h2></div><button class="btn btn-sm btn-outline-primary" disabled="@(marketingAgentId is null || isSaving)" @onclick="PrepareSegmentProposalAsync">Ask Maya</button></div>
                <div class="marketing-form__row"><label>Proposed segment name<InputText @bind-Value="segmentProposalForm.Name" /></label><label>Analysis objective<InputText @bind-Value="segmentProposalForm.Objective" /></label></div>
                @if (segments.Count == 0) { <MarketingEmpty Title="No strategic segments" Message="Define needs, behaviours, channel presence, price sensitivity, size, economics, evidence, and target rationale." /> }
                <div class="marketing-segment-grid">
                    @foreach (var segment in segments)
                    {
                        var version = segment.Versions.FirstOrDefault();
                        <article><div><strong>@segment.Name</strong><span>@segment.Description</span></div>
                            @if (version is not null) { <dl><div><dt>Needs</dt><dd>@JsonSummary(version.NeedsJson)</dd></div><div><dt>Behaviour</dt><dd>@JsonSummary(version.BehaviorsJson)</dd></div><div><dt>Channels</dt><dd>@JsonSummary(version.ChannelsJson)</dd></div><div><dt>Price sensitivity</dt><dd>@JsonSummary(version.PricingJson)</dd></div><div><dt>Size</dt><dd>@Size(version)</dd></div><div><dt>Confidence</dt><dd>@version.Confidence.ToString("P0")</dd></div></dl><div class="marketing-inline-actions"><span class="marketing-status">@Friendly(version.TargetState) · score @version.AttractivenessScore.ToString("0")</span><button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick="() => ReviewSegmentImpactAsync(version.Id)">Review downstream impact</button></div> }
                        </article>
                    }
                </div>
                @if (segmentDecisionData is not null)
                {
                    <section class="marketing-segment-decision" aria-label="Structured segment decision evidence">
                        <article><div class="marketing-section__header"><div><span class="vc-kicker">STRUCTURED ESTIMATES</span><h3>Size and economics</h3></div><span>@segmentDecisionData.SizeEstimates.Count size source@(segmentDecisionData.SizeEstimates.Count == 1 ? "" : "s")</span></div>
                            @if (segmentDecisionData.SizeEstimates.Count == 0) { <p>Needs review: no queryable size estimate is available.</p> }
                            @foreach (var estimate in segmentDecisionData.SizeEstimates) { <dl><div><dt>Range</dt><dd>@(estimate.Low?.ToString("N0") ?? "?") – @(estimate.High?.ToString("N0") ?? "?") @estimate.Unit</dd></div><div><dt>Scope</dt><dd>@estimate.Period · @estimate.Geography</dd></div><div><dt>Method</dt><dd>@Friendly(estimate.Method) · @estimate.Confidence.ToString("P0")</dd></div><div><dt>Freshness</dt><dd>@estimate.AsOfUtc.ToString("d") · @Friendly(estimate.Classification)</dd></div></dl> }
                            <div class="marketing-economics-grid">@foreach (var estimate in segmentDecisionData.EconomicEstimates) { <div><span>@Friendly(estimate.MetricCode)</span><strong>@(estimate.Low?.ToString("N1") ?? "?") – @(estimate.High?.ToString("N1") ?? "?") @estimate.Unit</strong><small>@Friendly(estimate.Method) · @estimate.Confidence.ToString("P0")</small></div> }</div>
                        </article>
                        <article><span class="vc-kicker">DETERMINISTIC SCORE</span><h3>@(segmentDecisionData.ScorePolicy?.CalculatedScore?.ToString("0.##") ?? "Needs review")</h3>
                            @if (segmentDecisionData.ScorePolicy is null) { <p>No versioned score policy is available.</p> }
                            else { <p>@Friendly(segmentDecisionData.ScorePolicy.Decision) · target @segmentDecisionData.ScorePolicy.TargetThreshold.ToString("0.##")</p><small>Missing evidence: @Friendly(segmentDecisionData.ScorePolicy.MissingEvidenceBehavior)</small><div class="marketing-score-list">@foreach (var dimension in segmentDecisionData.ScorePolicy.Dimensions) { <div><span>@Friendly(dimension.Code)</span><strong>@(dimension.Score?.ToString("0.##") ?? "Missing")</strong><small>Weight @dimension.Weight.ToString("P0")</small></div> }</div> }
                        </article>
                        <article><span class="vc-kicker">TARGET DECISION</span><h3>Recommendation is not activation</h3>@if (segmentDecisionData.TargetDecisions.Count == 0) { <p>No target recommendation has been recorded. Approval and activation remain separate guarded actions.</p> } else { var decision = segmentDecisionData.TargetDecisions.First(); <p>@decision.Rationale</p><span class="marketing-status">@Friendly(decision.ApprovalStatus) · @decision.Confidence.ToString("P0")</span><small>Review @decision.ReviewUtc.ToString("d")</small> }<h3>Explicit mappings</h3>@if (segmentDecisionData.Mappings.Count == 0) { <p>No ICP, audience, qualification, or Sales handoff mapping.</p> } else { @foreach (var mapping in segmentDecisionData.Mappings) { <p><strong>@mapping.Label</strong><br /><small>@Friendly(mapping.MappingType)</small></p> } }</article>
                    </section>
                }
                @if (segmentImpact is not null)
                {
                    <aside class="marketing-segment-impact"><h3>@(segmentImpact.RequiresReview ? "Downstream review required" : "Downstream impact")</h3><p>@(segmentImpact.IsCurrentVersion ? "These artifacts use the current segment version." : "This is not the current segment version. Linked artifacts were not silently rewritten.")</p><div class="marketing-review-history">@foreach (var item in segmentImpact.Artifacts) { <article><strong>@item.Label</strong><span>@Friendly(item.ArtifactType) · @Friendly(item.Status)</span><p>@item.ReviewReason</p></article> }</div></aside>
                }
                @if (segmentProposal is not null)
                {
                    <aside class="marketing-segment-impact"><h3>Maya's grounded segment proposal</h3><p>@segmentProposal.Summary</p><div class="marketing-review-history">@foreach (var claim in segmentProposal.Claims) { <article><strong>@Friendly(claim.Area) · @Friendly(claim.Classification)</strong><span>Confidence @claim.Confidence.ToString("P0")</span><p>@claim.Recommendation</p><small>Sources: @string.Join(", ", claim.SourceIds)</small></article> }</div>@if (segmentProposal.MissingEvidence.Count > 0) { <p><strong>Evidence to add before approval:</strong> @string.Join(", ", segmentProposal.MissingEvidence)</p> }@if (segmentProposal.CanCreateDraft) { <p role="status">You can save this as a reviewable draft now. Evidence gaps remain visible and do not bypass human approval.</p> } else { <p role="alert">Maya did not return any safely grounded draft content. Retry the analysis.</p> }<div class="marketing-inline-actions"><button class="btn btn-primary" disabled="@(isSaving || !segmentProposal.CanCreateDraft)" @onclick="CommitSegmentProposalAsync">Create reviewable draft</button>@if (!segmentProposal.CanCreateDraft) { <button class="btn btn-outline-primary" disabled="@isSaving" @onclick="PrepareSegmentProposalAsync">Retry Maya</button> }</div></aside>
                }
            </section>
        }
        else if (activeTab == "Intelligence")
        {
            <section class="marketing-workspace-grid marketing-intelligence-workspace">
                <article class="vc-panel marketing-section">
                    <div class="marketing-section__header"><div><span class="vc-kicker">SOURCE-GROUNDED</span><h2>Market intelligence</h2><p>Every record shows what we know, how certain it is, and when it needs review.</p></div></div>
                    <div class="marketing-intelligence-filter"><label>Find intelligence<InputText @bind-Value="intelligenceSearch" placeholder="Search market, customer, or competitor evidence" /></label><label>Freshness<InputSelect @bind-Value="intelligenceFreshness"><option value="all">All records</option><option value="due">Needs review</option><option value="current">Current</option></InputSelect></label></div>
                    @if (FilteredIntelligence.Count == 0) { <MarketingEmpty Title="No intelligence records" Message="Dated hypotheses, insights, competitor claims, sources, confidence, and review dates will appear here." /> }
                    <div class="marketing-intelligence-list">
                        @foreach (var item in FilteredIntelligence)
                        {
                            <button type="button" class="marketing-intelligence-row @(selectedIntelligence?.Id == item.Id ? "selected" : null)" @onclick="() => SelectIntelligenceAsync(item)">
                                <span><strong>@item.Subject</strong><small>@Friendly(item.Kind) · @Friendly(item.Classification) · confidence @item.Confidence.ToString("P0")</small><small>@item.Summary</small></span>
                                <span class="marketing-status @(item.ReviewDueUtc <= DateTime.UtcNow ? "warning" : null)">@(item.ReviewDueUtc <= DateTime.UtcNow ? "Needs review" : $"Review {item.ReviewDueUtc:d}")</span>
                            </button>
                        }
                    </div>
                </article>
                <aside class="vc-panel marketing-section marketing-intelligence-detail">
                    @if (selectedIntelligence is null)
                    {
                        <MarketingEmpty Title="No intelligence selected" Message="Select a record to inspect its evidence, uncertainty, and review history." />
                    }
                    else
                    {
                        <div class="marketing-section__header"><div><span class="vc-kicker">@Friendly(selectedIntelligence.Kind)</span><h2>@selectedIntelligence.Subject</h2></div><span class="marketing-status @(selectedIntelligence.ReviewDueUtc <= DateTime.UtcNow ? "warning" : null)">@Friendly(selectedIntelligence.ReviewStatus)</span></div>
                        <h3>What this means</h3><p>@selectedIntelligence.Summary</p>
                        <dl class="marketing-intelligence-facts"><div><dt>Classification</dt><dd>@Friendly(selectedIntelligence.Classification)</dd></div><div><dt>Confidence</dt><dd>@selectedIntelligence.Confidence.ToString("P0")</dd></div><div><dt>Data used</dt><dd>@selectedIntelligence.SourceReference</dd></div><div><dt>Observed</dt><dd>@selectedIntelligence.ObservedUtc.ToString("d")</dd></div><div><dt>Review due</dt><dd>@selectedIntelligence.ReviewDueUtc.ToString("d")</dd></div></dl>
                        <details><summary>Comparison dimensions</summary><pre>@JsonSummary(selectedIntelligence.DimensionsJson)</pre></details>
                        <label>Review note<InputTextArea @bind-Value="intelligenceReviewRationale" /></label>
                        <div class="marketing-inline-actions"><button class="btn btn-sm btn-primary" disabled="@isSaving" @onclick="() => ReviewIntelligenceAsync(true)">Mark reviewed</button><button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick="() => ReviewIntelligenceAsync(false)">Needs more evidence</button><button class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick="ArchiveIntelligenceAsync">Archive</button></div>
                        <h3>Review history</h3>
                        @if (intelligenceReviews.Count == 0) { <p>No reviews recorded yet.</p> }
                        else { <div class="marketing-review-history">@foreach (var review in intelligenceReviews) { <article><strong>@Friendly(review.Outcome)</strong><span>@review.CreatedUtc.ToLocalTime().ToString("g")</span><p>@review.Rationale</p></article> }</div> }
                    }
                </aside>
            </section>
        }
        else if (activeTab == "Channels")
        {
            <section class="marketing-operations-summary">
                <article class="vc-panel">
                    <span>Connect a channel</span><strong>Provider authorization</strong>
                    <small>Connections open the provider's secure consent screen. The callback must be allowlisted by an operator.</small>
                    <div class="marketing-inline-actions">
                        <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick='() => StartChannelOAuthAsync("linkedin")'>LinkedIn</button>
                        <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick='() => StartChannelOAuthAsync("meta")'>Meta</button>
                        <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick='() => StartChannelOAuthAsync("x")'>X</button>
                    </div>
                </article>
                @foreach (var connection in channelConnections)
                {
                    <article class="vc-panel"><span>@Friendly(connection.Provider)</span><strong>@connection.DisplayName</strong><small class="marketing-status @(connection.HealthStatus == "reauthorization_required" ? "warning" : null)">@Friendly(connection.HealthStatus)</small><div class="marketing-inline-actions"><button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick="() => RefreshDestinationsAsync(connection.Id)">Refresh accounts</button><button class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick="() => DisconnectChannelAsync(connection.Id)">Disconnect</button></div></article>
                }
                @if (channelConnections.Count == 0) { <article class="vc-panel"><span>Connections</span><strong>No provider connected</strong><small>Add protected provider credentials before external delivery.</small></article> }
            </section>
            <section class="marketing-workspace-grid">
                <article class="vc-panel marketing-section">
                    <div class="marketing-section__header"><div><span class="vc-kicker">APPROVAL-BACKED DELIVERY</span><h2>Channel action queue</h2></div></div>
                    @if (channelDestinations.Count > 0) { <p>@channelDestinations.Count manageable destinations discovered: @string.Join(", ", channelDestinations.Where(x => x.Status == "active").Select(x => x.DisplayName))</p> }
                    @if (channelActions.Count == 0) { <MarketingEmpty Title="No channel actions" Message="Approved content delivery will appear here before it is dispatched by the background worker." /> }
                    <div class="marketing-run-list">@foreach (var action in channelActions) { <article><div><strong>@Friendly(action.ActionType)</strong><span>@action.DestinationReference · @(action.ScheduledUtc?.ToLocalTime().ToString("g") ?? "Ready when approved")</span><p>@(action.FailureCode is null ? $"Attempt {action.AttemptCount}" : Friendly(action.FailureCode))</p></div><div class="marketing-inline-actions"><span class="marketing-status @(action.Status is "failed" or "ambiguous" ? "warning" : null)">@Friendly(action.Status)</span>@if (action.Status == "awaiting_approval") { <button class="btn btn-sm btn-outline-primary" @onclick="() => SynchronizeChannelActionAsync(action.Id)">Check approval</button> }@if (action.Status is "ambiguous" or "dispatched") { <button class="btn btn-sm btn-outline-primary" @onclick="() => ReconcileChannelActionAsync(action.Id)">Reconcile</button> }@if (action.Status is "proposed" or "awaiting_approval" or "queued" or "retry_scheduled") { <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelChannelActionAsync(action.Id)">Cancel</button> }</div></article> }</div>
                </article>
                <aside class="vc-panel marketing-section"><span class="vc-kicker">LIFECYCLE AND CREATIVE</span><h2>Governed assets</h2><p>@creativeAssets.Count creative assets · @journeys.Count lifecycle journeys</p><div class="marketing-list">@foreach (var asset in creativeAssets.Take(5)) { <article><div><strong>@asset.Name</strong><span>@asset.Dimensions · @Friendly(asset.Status)</span><small>@asset.AltText</small></div></article> }</div>
                    @if (dashboard.Content.Any(x => x.Status is "submitted" or "approved"))
                    {
                        <EditForm Model="creativeForm" OnValidSubmit="GenerateCreativeAsync" class="marketing-form marketing-form--compact">
                            <h3>Generate review draft</h3>
                            <label>Content brief<InputSelect @bind-Value="creativeForm.BriefId">@foreach(var brief in dashboard.Content.Where(x=>x.Status is "submitted" or "approved")){<option value="@brief.Id">@brief.Title</option>}</InputSelect></label>
                            <label>Asset name<InputText @bind-Value="creativeForm.Name" /></label>
                            <label>Art direction<InputTextArea @bind-Value="creativeForm.Prompt" /></label>
                            <label>Alt text<InputText @bind-Value="creativeForm.AltText" /></label>
                            <button class="btn btn-primary" disabled="@isSaving">Generate draft</button>
                        </EditForm>
                    }
                </aside>
            </section>
        }
        else if (activeTab == "Journeys")
        {
            <section class="marketing-journey-workspace">
                <div class="vc-panel marketing-section marketing-journey-list">
                    <div class="marketing-section__header"><div><span class="vc-kicker">LIFECYCLE</span><h2>Customer journeys</h2></div></div>
                    @if (journeys.Count == 0) { <MarketingEmpty Title="No lifecycle journeys" Message="Create a consent-aware journey to coordinate nurture, activation, retention, or follow-up." /> }
                    @foreach (var journey in journeys)
                    {
                        <button type="button" class="marketing-select-row @(selectedJourney?.Id == journey.Id ? "selected" : null)" @onclick="() => SelectJourneyAsync(journey)">
                            <span><strong>@journey.Name</strong><small>Version @journey.Version · @journey.ValidToUtc.ToLocalTime().ToString("d")</small></span>
                            <span class="marketing-status">@Friendly(journey.Status)</span>
                        </button>
                    }
                </div>
                <article class="vc-panel marketing-section marketing-journey-builder">
                    @if (selectedJourney is null) { <p>Select a journey to review its definition and operating state.</p> }
                    else
                    {
                        <div class="marketing-section__header"><div><span class="vc-kicker">VERSION @selectedJourney.Version</span><h2>@selectedJourney.Name</h2></div><span class="marketing-status">@Friendly(selectedJourney.Status)</span></div>
                        <div class="marketing-journey-guardrails"><span>Consent checked</span><span>Suppression checked</span><span>@selectedJourney.FrequencyCap per day</span></div>
                        <h3>Audience and entry</h3><pre>@JsonSummary(selectedJourney.AudienceEligibilityJson)</pre>
                        <h3>Journey steps</h3><pre>@JsonSummary(selectedJourney.StepsJson)</pre>
                        <h3>Exit criteria and guardrails</h3><pre>@JsonSummary(selectedJourney.EntryExitCriteriaJson)</pre><pre>@JsonSummary(selectedJourney.GuardrailsJson)</pre>
                    }
                </article>
                <aside class="vc-panel marketing-section marketing-journey-review">
                    <span class="vc-kicker">REVIEW AND OPERATE</span><h2>Readiness</h2>
                    @if (journeyValidation is not null)
                    {
                        <div class="marketing-analysis-status">@(journeyValidation.Valid ? "Validation passed" : "Changes required") · @journeyValidation.StepCount steps</div>
                        @foreach (var error in journeyValidation.Errors) { <p class="text-danger">@error</p> }
                        @foreach (var warning in journeyValidation.Warnings) { <small>@warning</small> }
                    }
                    @if (journeyAudiencePreview is not null)
                    {
                        <h3>Audience preview</h3><div class="marketing-journey-counts"><span><strong>@journeyAudiencePreview.EligibleCount</strong> eligible</span><span><strong>@journeyAudiencePreview.SuppressedCount</strong> suppressed</span><span><strong>@journeyAudiencePreview.MissingConsentCount</strong> missing consent</span></div>
                    }
                    @if (selectedJourney is not null)
                    {
                        <div class="marketing-inline-actions">
                            @if (selectedJourney.Status == "active") { <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick='() => TransitionSelectedJourneyAsync("pause")'>Pause</button> }
                            @if (selectedJourney.Status == "paused") { <button class="btn btn-sm btn-primary" disabled="@isSaving" @onclick='() => TransitionSelectedJourneyAsync("resume")'>Resume</button> }
                            @if (selectedJourney.Status is "active" or "paused") { <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick='() => TransitionSelectedJourneyAsync("complete")'>Complete</button> }
                            @if (selectedJourney.Status is "draft" or "in_review" or "paused") { <button class="btn btn-sm btn-outline-danger" disabled="@isSaving" @onclick='() => TransitionSelectedJourneyAsync("cancel")'>Cancel</button> }
                        </div>
                        <h3>Active instances and exceptions</h3>
                        <div class="marketing-review-history">@foreach (var enrollment in journeyEnrollments.Where(x => x.JourneyId == selectedJourney.Id).Take(12)) { <article><strong>@Friendly(enrollment.Status)</strong><span>Contact @enrollment.ContactId.ToString("N")[..8] · step @enrollment.NextStepIndex</span>@if (enrollment.FailureCode is not null) { <p>@Friendly(enrollment.FailureCode)</p> }</article> }</div>
                    }
                </aside>
            </section>
        }
        else if (activeTab == "Performance")
        {
            <section class="marketing-kpis" aria-label="Marketing evidence classification">
                @foreach (var group in attribution.GroupBy(x => x.Classification))
                { <article class="vc-panel"><span>@Friendly(group.Key)</span><strong>@group.Sum(x => x.AttributedValue).ToString("N1") @group.First().Unit</strong><small>@group.Count() results · confidence @group.Average(x => x.Confidence).ToString("P0")</small></article> }
            </section>
            <section class="marketing-workspace-grid">
                <article class="vc-panel marketing-section"><span class="vc-kicker">ATTRIBUTION WITH LIMITS</span><h2>Evidence and performance</h2>
                    @if (attribution.Count == 0) { <MarketingEmpty Title="No attribution results" Message="Results explicitly distinguish observed evidence, configured rules, correlation, and inference." /> }
                    <div class="marketing-list">@foreach (var item in attribution) { <article><div><strong>@Friendly(item.SubjectType) · @item.Model</strong><span>@Friendly(item.Classification) · @item.PeriodStartUtc.ToString("d")–@item.PeriodEndUtc.ToString("d")</span><p>@JsonSummary(item.EvidenceJson)</p></div><strong>@item.AttributedValue.ToString("N1") @item.Unit</strong></article> }</div>
                </article>
                <aside class="vc-panel marketing-section"><span class="vc-kicker">EVENT-DRIVEN REVIEW</span><h2>Needs attention</h2>@if (events.Count == 0) { <p>No unresolved Marketing events.</p> }<div class="marketing-run-list">@foreach (var item in events) { <article><div><strong>@Friendly(item.EventType)</strong><span>@Friendly(item.Severity) · @item.SourceType</span><p>@(item.FailureSummary ?? JsonSummary(item.EvidenceJson))</p>@if (item.RelatedTaskId is not null) { <small>Durable response task linked</small> }</div><div><span class="marketing-status @(item.Status == "failed" ? "warning" : null)">@Friendly(item.Status)</span>@if (item.Status != "resolved") { <button class="btn btn-sm btn-outline-primary" disabled="@isSaving" @onclick="() => ResolveEventAsync(item.Id)">Resolve</button> }</div></article> }</div></aside>
            </section>
        }
        else if (activeTab == "Operations")
        {
            <section class="marketing-operations-summary">
                <article class="vc-panel"><span>Why Maya started</span><strong>@(operatingRuns.FirstOrDefault()?.TriggerReference ?? "No operating run yet")</strong></article>
                <article class="vc-panel"><span>Effective autonomy</span><strong>@Friendly(operatingRuns.FirstOrDefault()?.EffectiveAuthority ?? "recommend")</strong></article>
                <article class="vc-panel"><span>Approvals and limits</span><strong>@(operatingRuns.FirstOrDefault()?.BudgetLimit is decimal limit ? $"Budget limit {limit:N0}" : "Policy limits apply")</strong></article>
                <article class="vc-panel"><span>Evidence state</span><strong>@(operatingRuns.FirstOrDefault()?.RecoveryCode is null ? "Current or not yet reviewed" : "Evidence needs review")</strong></article>
            </section>
            <section class="marketing-workspace-grid">
                <article class="vc-panel marketing-section"><div class="marketing-section__header"><div><span class="vc-kicker">INDEPENDENT DEPARTMENT LOOP</span><h2>Recent Marketing runs</h2></div><button class="btn btn-primary" disabled="@(isSaving || marketingAgentId is null)" @onclick="RequestOperatingRunAsync">Run governed review</button></div>
                    @if (operatingRuns.Count == 0) { <MarketingEmpty Title="No Marketing operating runs" Message="Maya will start from company assignments, cadence, material events, or an operator request." /> }
                    <div class="marketing-run-list">@foreach (var run in operatingRuns) { <button type="button" class="marketing-run-row @(selectedOperatingRun?.Id == run.Id ? "selected" : null)" @onclick="() => SelectOperatingRunAsync(run)"><span><strong>@Friendly(run.TriggerType) · @run.CreatedUtc.ToLocalTime().ToString("g")</strong><small>@run.TriggerReference</small><small>@(run.OutcomeSummary ?? "Waiting for a safe outcome")</small></span><span class="marketing-status @(run.Status == "blocked" ? "warning" : null)">@Friendly(run.Status)</span></button> }</div>
                    @if (selectedOperatingRun is not null)
                    {
                        <section class="marketing-action-plan" aria-label="Selected Marketing run action plan">
                            <div class="marketing-section__header"><div><span class="vc-kicker">DURABLE ACTION PLAN</span><h3>@operatingActions.Count action@(operatingActions.Count == 1 ? "" : "s")</h3></div><span>@selectedOperatingRun.BudgetUsed.ToString("N2") / @(selectedOperatingRun.BudgetLimit?.ToString("N2") ?? "policy limit")</span></div>
                            @if (operatingActions.Count == 0) { <p>No actions were selected for this run.</p> }
                            @foreach (var action in operatingActions)
                            {
                                <article class="marketing-action-card">
                                    <div><strong>@action.Sequence. @action.Title</strong><span>@Friendly(action.Tool ?? action.ActionType) · @Friendly(action.AuthorityDecision)</span><p>Expected: @action.ExpectedCompletionEvidence</p>@if (!string.IsNullOrWhiteSpace(action.RecoveryGuidance)) { <p class="marketing-action-warning">@action.RecoveryGuidance</p> }</div>
                                    <div class="marketing-action-state"><span class="marketing-status @(action.Status is "blocked" or "dead_letter" or "retry_wait" ? "warning" : null)">@Friendly(action.Status)</span><small>Attempt @action.AttemptCount / @action.MaximumAttempts</small>@if (action.ArtifactId.HasValue) { <small>@Friendly(action.ArtifactType ?? "artifact") · @action.ArtifactId.Value.ToString("N")[..8]</small> }@if (action.Status is "blocked" or "dead_letter" or "retry_wait") { <button class="btn btn-sm btn-outline-primary" @onclick="() => RetryOperatingActionAsync(action)">Retry</button> }@if (action.Status is "planned" or "retry_wait" or "blocked") { <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelOperatingActionAsync(action)">Cancel</button> }</div>
                                </article>
                            }
                        </section>
                    }
                </article>
                <aside class="vc-panel marketing-section"><span class="vc-kicker">INSTRUCTION PRECEDENCE</span><h2>Company direction governs</h2><ol class="marketing-precedence"><li>Safety, consent, law, and tenant policy</li><li>Company pause, goals, plans, budgets, and instructions</li><li>Approved Marketing strategy and segments</li><li>Assigned task and dependencies</li><li>Maya's role and cadence</li><li>Model suggestions</li></ol><a href="@WithCompany("/company-operation")">Open Company operation</a></aside>
            </section>
        }
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "companyId")] public Guid? CompanyId { get; set; }
    private readonly string[] tabs = ["Overview", "Strategy", "Segments", "Intelligence", "Objectives", "Plans", "Calendar", "Content", "Audiences", "Handoffs", "Experiments", "Channels", "Journeys", "Performance", "Operations"];
    private string activeTab = "Overview";
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private Guid? resolvedCompanyId;
    private Guid? marketingAgentId;
    private MarketingDashboardViewModel? dashboard;
    private RoleAgentAnalysisViewModel? analysis;
    private MarketingContentPreflightViewModel? contentPreflight;
    private GenerateMarketingContentVariantsResultViewModel? contentGenerationResult;
    private IReadOnlyList<MarketingStrategyViewModel> strategies = [];
    private MarketingStrategyProposalViewModel? strategyProposal;
