    private string WithCompany(string path) => resolvedCompanyId is Guid id ? $"{path}?companyId={id:D}" : path;
    private void ShowObjectives() => activeTab = "Objectives";
    private static string FriendlyMetric(string value) => value.Replace("_", " ", StringComparison.Ordinal).Replace("-", " ", StringComparison.Ordinal);
    private static string MetricValue(MarketingMetricViewModel metric) => metric.Value is decimal value ? $"{value:N1} {metric.Unit}".Trim() : "No data";
    private static string Friendly(string value) => value.Replace("_", " ", StringComparison.Ordinal).Replace('-', ' ');
    private static string JsonSummary(string value, string fallback = "Not yet recorded")
    { if (string.IsNullOrWhiteSpace(value) || value is "{}" or "[]") return fallback; var clean = value.Trim().Trim('{', '}', '[', ']').Replace('"', ' ').Replace(':', ' '); return clean.Length > 140 ? clean[..140] + "…" : clean; }
    private static string Size(MarketingSegmentVersionViewModel value) => value.SizeLow.HasValue || value.SizeHigh.HasValue ? $"{value.SizeLow?.ToString("N0") ?? "?"}–{value.SizeHigh?.ToString("N0") ?? "?"} ({Friendly(value.SizeMethod)})" : "Not estimated";

