<div class="wizard-actions"><button class="btn btn-outline-secondary" type="button" disabled="@Busy" @onclick="BackAction">@Back</button><button class="btn btn-primary" type="button" disabled="@(Busy || PrimaryDisabled)" @onclick="PrimaryAction">@Primary</button></div>
@code { [Parameter] public string Back { get; set; } = "Back"; [Parameter] public EventCallback BackAction { get; set; } [Parameter] public string Primary { get; set; } = "Continue"; [Parameter] public EventCallback PrimaryAction { get; set; } [Parameter] public bool PrimaryDisabled { get; set; } [Parameter] public bool Busy { get; set; } }
