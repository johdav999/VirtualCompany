@page "/support/cases/{CaseId:guid}"
@rendermode InteractiveServer
@inherits SupportPageBase
@using System.Globalization

<PageTitle>@SupportText["SupportCase"]</PageTitle>

<section class="py-4 dashboard-hero">
    <div class="dashboard-shell">
        <div class="wizard-card dashboard-summary">
            @if (isLoading)
            {
                <p class="text-body-secondary mb-0">@SupportText["LoadingSupportCase"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(ShellErrorMessage) || !string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mb-0">@(ShellErrorMessage ?? errorMessage)</div>
            }
            else if (supportCase is not null)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <span class="dashboard-kicker">@SupportText["SupportCase"] @supportCase.CaseNumber</span>
                        <h1>@supportCase.Subject</h1>
                        <p class="text-body-secondary mb-0">@supportCase.Summary</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="RunSupportAgentAsync" disabled="@isBusy">@SupportText["AskBenPrepareReply"]</button>
                        <span class="@PriorityBadge(supportCase.Priority)">@supportCase.PriorityLabel</span>
                        <span class="badge text-bg-light">@supportCase.StatusLabel</span>
                        @if (supportCase.IsSlaBreached)
                        {
                            <span class="badge text-bg-danger">@SupportText["SlaBreached"]</span>
                        }
                        else if (supportCase.IsSlaRisk)
                        {
                            <span class="badge text-bg-warning">@SupportText["SlaAtRisk"]</span>
                        }
                    </div>
                </div>

                <div class="row g-4 mt-2">
                    <div class="col-12 col-xl-8">
                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["CustomerMessageTimeline"]</h2>
                            @if (supportCase.Messages.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@SupportText["NoMessages"]</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var message in supportCase.Messages)
                                    {
                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between gap-3">
                                                <strong>@MessageHeading(message)</strong>
                                                <span class="small text-body-secondary">@LocalDateTime.DateTime(message.OccurredUtc)</span>
                                            </div>
                                            <p class="mb-0 mt-2">@message.Body</p>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["InternalNote"]</h2>
        <textarea class="form-control" rows="4" @bind="noteBody" placeholder="@SupportText["NotePlaceholder"]"></textarea>
                            <button class="btn btn-primary mt-3" @onclick="AddNoteAsync" disabled="@isBusy">@SupportText["AddNote"]</button>
                        </section>

                        <section class="border rounded bg-white p-3 mb-4">
                            <div class="d-flex flex-wrap justify-content-between gap-3">
                                <div>
                                    <h2 class="h5">@SupportText["ReplyDrafts"]</h2>
                                    <p class="text-body-secondary mb-0">@SupportText["DraftGovernance"]</p>
                                </div>
                                <button class="btn btn-outline-primary" @onclick="GenerateDraftAsync" disabled="@isBusy">@SupportText["DraftReply"]</button>
                            </div>
                            <div class="border rounded bg-light p-3 mt-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                    <div>
                                        <strong>@SupportText["AnswerReadiness"]</strong>
                                        <p class="small text-body-secondary mb-0">@SupportText["AnswerReadinessDescription"]</p>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="AnalyzeAnswerabilityAsync" disabled="@(isBusy || supportAgentId is null)">@SupportText["RefreshAnalysis"]</button>
                                </div>
                                @if (supportAgentId is null)
                                {
                                    <p class="small text-body-secondary mt-3 mb-0">@SupportText["NoSupportAgent"]</p>
                                }
                                else if (answerability is not null)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        <span class="badge text-bg-light">@answerability.State</span>
                                        <span class="badge text-bg-light">@Percent(answerability.Score) answerable</span>
                                        @if (answerability.RequiresReview)
                                        {
                                            <span class="badge text-bg-warning">@SupportText["ReviewRequired"]</span>
                                        }
                                    </div>
                                    @if (answerability.MissingInformation.Count > 0)
                                    {
                                        <p class="small fw-semibold mt-3 mb-1">@SupportText["MissingInformation"]</p>
                                        <ul class="small mb-0">
                                            @foreach (var item in answerability.MissingInformation)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }
                                    @if (answerability.QuestionsToAsk.Count > 0)
                                    {
                                        <p class="small fw-semibold mt-3 mb-1">@SupportText["QuestionsToAsk"]</p>
                                        <ul class="small mb-0">
                                            @foreach (var question in answerability.QuestionsToAsk)
                                            {
                                                <li>@question</li>
                                            }
                                        </ul>
                                    }
                                }
                            </div>
                            <label class="form-label mt-3" for="support-reply-to">@SupportText["ReplyTo"]</label>
                <input id="support-reply-to" class="form-control" type="email" @bind="replyToEmail" placeholder="@SupportText["CustomerEmailPlaceholder"]" disabled="@isBusy" />

                            @if (ActiveReplyDrafts.Count == 0)
                            {
                                <p class="text-body-secondary mt-3 mb-0">@SupportText["NoReplyDraft"]</p>
                            }
                            else
                            {
                                <div class="list-group mt-3">
                                    @foreach (var draft in ActiveReplyDrafts)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                                <strong>@draft.StatusLabel</strong>
                                                <span class="small text-body-secondary">@SupportText["DraftConfidence", Percent(draft.Confidence), Percent(draft.Answerability)]</span>
                                            </div>
                                            @if (DraftEditable(draft))
                                            {
                                                <label class="form-label mt-3" for="@($"support-draft-{draft.Id:D}")">@SupportText["ReplyText"]</label>
                                                <textarea id="@($"support-draft-{draft.Id:D}")" class="form-control" rows="8" value="@DraftBody(draft)" @onchange="eventArgs => SetDraftBody(draft.Id, eventArgs.Value?.ToString())"></textarea>
                                                <label class="form-label mt-2" for="@($"support-tone-{draft.Id:D}")">@SupportText["Tone"]</label>
                                                <select id="@($"support-tone-{draft.Id:D}")" class="form-select" value="@DraftTone(draft)" @onchange="eventArgs => SetDraftTone(draft.Id, eventArgs.Value?.ToString())">
                                                    <option value="Helpful">@SupportText["ToneHelpful"]</option>
                                                    <option value="Concise">@SupportText["ToneConcise"]</option>
                                                    <option value="Empathetic">@SupportText["ToneEmpathetic"]</option>
                                                    <option value="Formal">@SupportText["ToneFormal"]</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <pre class="bg-light border rounded p-3 mt-3 mb-3 text-wrap">@draft.DraftBody</pre>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(draft.RationaleSummary))
                                            {
                                                <p class="small text-body-secondary">@draft.RationaleSummary</p>
                                            }
                                            <p class="small text-body-secondary">@DraftSourceSummary(draft)</p>
                                            @if (!string.IsNullOrWhiteSpace(draft.SafetyDecision))
                                            {
                                                <div class="@SafetyAlertClass(draft.SafetyDecision)">
                                                    Safety: @SafetyLabel(draft.SafetyDecision)
                                                    @if (!string.IsNullOrWhiteSpace(draft.SafetyReasonCodesJson))
                                                    {
                                                        <span class="d-block small">@draft.SafetyReasonCodesJson</span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(draft.SendFailureSummary))
                                            {
                                                <div class="alert alert-danger py-2 mb-3">@draft.SendFailureSummary</div>
                                            }
                                            <div class="d-flex flex-wrap gap-2">
                                                @if (DraftEditable(draft))
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SaveDraftAsync(draft.Id)" disabled="@isBusy">@SupportText["SaveDraft"]</button>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ApproveDraftAsync(draft.Id)" disabled="@isBusy">@SupportText["Approve"]</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectDraftAsync(draft.Id)" disabled="@isBusy">@SupportText["Reject"]</button>
                                                }
                                                @if (draft.Status == "approved" && !draft.SentUtc.HasValue)
                                                {
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SendDraftAsync(draft.Id, false)" disabled="@isBusy">@SupportText["Send"]</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SendDraftAsync(draft.Id, true)" disabled="@isBusy">@SupportText["SendAndResolve"]</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        @if (LatestRefund() is { } refund)
                        {
                            <section class="support-refund-panel" aria-labelledby="support-refund-title">
                                <div class="support-refund-heading">
                                    <div>
                                        <span class="dashboard-kicker">@SupportText["FinanceHandoff"]</span>
                                        <h2 id="support-refund-title" class="h5 mb-1">@SupportText["RefundOrCredit"]</h2>
                                        <p class="text-body-secondary mb-0">@RefundStatusMessage(refund)</p>
                                    </div>
                                    <span class="@RefundStatusBadge(refund.Status)">@refund.StatusLabel</span>
                                </div>

                                <dl class="support-refund-facts">
                                    <div><dt>@SupportText["Amount"]</dt><dd>@LocalMoney.Format(refund.Amount, refund.Currency)</dd></div>
                                    <div><dt>@SupportText["CustomerInvoice"]</dt><dd>@(refund.InvoiceId.HasValue ? SupportText["Linked"] : SupportText["NotLinked"])</dd></div>
                                    <div><dt>@SupportText["SupportApproval"]</dt><dd>@(refund.ApprovalRequestId.HasValue ? SupportText["Requested"] : SupportText["NotRequested"])</dd></div>
                                    <div><dt>@SupportText["AccountingSystem"]</dt><dd>@ProviderStepLabel(refund)</dd></div>
                                </dl>

                <ol class="support-refund-progress" aria-label="@SupportText["RefundProgress"]">
                                    @RefundStep("Requested", true)
                                    @RefundStep("Support approved", RefundAtLeast(refund, 1))
                                    @RefundStep("Finance approval", RefundAtLeast(refund, 2))
                                    @RefundStep("Fortnox", RefundAtLeast(refund, 3))
                                    @RefundStep("Completed", refund.Status == "completed")
                                </ol>

                                @if (!string.IsNullOrWhiteSpace(refund.LastFailureSummary))
                                {
                                    <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@refund.LastFailureSummary</div>
                                }

                                <div class="support-refund-footer">
                                    <div class="support-refund-data-used">
                                        <strong>@SupportText["DataUsed"]</strong>
                                        @if (refund.InvoiceId is Guid invoiceId)
                                        {
                                            <a href="@($"/finance/invoices/{invoiceId:D}")">@SupportText["CustomerInvoice"]</a>
                                        }
                                        @if (refund.PaymentId.HasValue)
                                        {
                                            <span>@SupportText["LinkedPayment"]</span>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (RefundApprovalId(refund) is Guid approvalId)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@BuildApprovalHref(approvalId)">@SupportText["OpenApproval"]</a>
                                        }
                                        @if (refund.AllowedActions.Contains("request_execution") || refund.AllowedActions.Contains("retry"))
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => RequestRefundExecutionAsync(refund.Id)" disabled="@isBusy">
                                                @(refund.AllowedActions.Contains("retry") ? "Retry safely" : "Request finance execution")
                                            </button>
                                        }
                                        @if (refund.AllowedActions.Contains("reconcile"))
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ReconcileRefundAsync(refund.Id)" disabled="@isBusy">@SupportText["Reconcile"]</button>
                                        }
                                        @if (refund.AllowedActions.Contains("cancel"))
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelRefundAsync(refund.Id)" disabled="@(isBusy || string.IsNullOrWhiteSpace(caseActionNote))">@SupportText["Cancel"]</button>
                                        }
                                    </div>
                                </div>
                            </section>
                        }
                    </div>

                    <div class="col-12 col-xl-4">
                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["CaseControls"]</h2>
                            <label class="form-label mt-2" for="support-assignee">@SupportText["Owner"]</label>
                            <select id="support-assignee" class="form-select" @bind="selectedAssignee">
                                <option value="">@SupportText["Unassigned"]</option>
                                @foreach (var option in assignees)
                                {
                                    <option value="@AssigneeKey(option)" disabled="@(!option.Available)">@option.DisplayName · @option.SecondaryText · @option.OpenCaseCount open</option>
                                }
                            </select>
            <input class="form-control mt-2" @bind="assignmentReason" placeholder="@SupportText["AssignmentReasonPlaceholder"]" />
                            <button class="btn btn-outline-primary w-100 mt-2" @onclick="SaveAssignmentAsync" disabled="@isBusy">@SupportText["SaveOwner"]</button>

                            <label class="form-label mt-3">@SupportText["Priority"]</label>
                            <select class="form-select" @bind="selectedPriority">
                                @foreach (var itemCode in Priorities) { <option value="@itemCode">@SupportStatusPresenter.Present(itemCode, SupportText)</option> }
                            </select>

                            <label class="form-label mt-3">@SupportText["Category"]</label>
                            <select class="form-select" @bind="selectedCategory">
                                @foreach (var itemCode in Categories) { <option value="@itemCode">@SupportStatusPresenter.Present(itemCode, SupportText)</option> }
                            </select>

                            <div class="d-grid gap-2 mt-3">
                                <button class="btn btn-primary" @onclick="SaveControlsAsync" disabled="@isBusy">@SupportText["SaveChanges"]</button>
                                <button class="btn btn-outline-secondary" @onclick="TriageAsync" disabled="@isBusy">@SupportText["RunTriage"]</button>
                            </div>
                        </section>

                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["NextAction"]</h2>
                            @if (supportCase.AllowedActions.Contains("resolve"))
                            {
                                <label class="form-label mt-2" for="support-resolution-summary">@SupportText["ResolutionSummary"]</label>
                <textarea id="support-resolution-summary" class="form-control" rows="3" @bind="resolutionSummary" placeholder="@SupportText["ResolutionSummaryPlaceholder"]"></textarea>
                                <label class="form-label mt-2" for="support-resolution-outcome">@SupportText["Outcome"]</label>
                <input id="support-resolution-outcome" class="form-control" @bind="resolutionOutcome" placeholder="@SupportText["ResolutionOutcomePlaceholder"]" />
                                <label class="form-label mt-2" for="support-root-cause">@SupportText["RootCause"]</label>
                                <select id="support-root-cause" class="form-select" @bind="resolutionRootCause"><option value="product_guidance">@SupportText["RootCauseProductGuidance"]</option><option value="configuration">@SupportText["RootCauseConfiguration"]</option><option value="billing_error">@SupportText["RootCauseBillingError"]</option><option value="product_defect">@SupportText["RootCauseProductDefect"]</option><option value="customer_error">@SupportText["RootCauseCustomerError"]</option><option value="third_party">@SupportText["RootCauseThirdParty"]</option><option value="other">@SupportText["RootCauseOther"]</option></select>
                                <label class="form-label mt-2" for="support-action-taken">@SupportText["ActionTaken"]</label>
                                <textarea id="support-action-taken" class="form-control" rows="2" @bind="resolutionActionTaken"></textarea>
                                <label class="form-label mt-2" for="support-reusable-answer">@SupportText["ReusableAnswer"]</label>
                                <textarea id="support-reusable-answer" class="form-control" rows="3" @bind="resolutionReusableAnswer"></textarea>
                                <label class="form-label mt-2" for="support-preference-observation">@SupportText["CustomerPreferenceOptional"]</label>
                                <textarea id="support-preference-observation" class="form-control" rows="2" @bind="resolutionPreferenceObservation"></textarea>
                                <label class="form-check mt-2"><input class="form-check-input" type="checkbox" @bind="resolutionReuseEligible" /> <span class="form-check-label">@SupportText["EligibleAnswerReuse"]</span></label>
                                <button class="btn btn-primary w-100 mt-2" @onclick="ResolveCaseAsync" disabled="@isBusy">@SupportText["ResolveCase"]</button>
                            }

                            <label class="form-label mt-3" for="support-action-note">@SupportText["ReasonOrNote"]</label>
            <textarea id="support-action-note" class="form-control" rows="2" @bind="caseActionNote" placeholder="@SupportText["ActionNotePlaceholder"]"></textarea>
                            <div class="d-grid gap-2 mt-2">
                                @if (supportCase.AllowedActions.Contains("wait_for_customer"))
                                {
                                    <button class="btn btn-outline-secondary" @onclick='() => ChangeCaseStateAsync("waiting_for_customer")' disabled="@isBusy">@SupportText["WaitForCustomer"]</button>
                                }
                                @if (supportCase.AllowedActions.Contains("wait_internally"))
                                {
                                    <button class="btn btn-outline-secondary" @onclick='() => ChangeCaseStateAsync("waiting_internal")' disabled="@isBusy">@SupportText["WaitInternally"]</button>
                                }
                                @if (supportCase.AllowedActions.Contains("escalate"))
                                {
                                    <button class="btn btn-outline-warning" @onclick='() => ChangeCaseStateAsync("escalated")' disabled="@isBusy">@SupportText["Escalate"]</button>
                                }
                                @if (supportCase.AllowedActions.Contains("reopen"))
                                {
                                    <button class="btn btn-outline-primary" @onclick="ReopenCaseAsync" disabled="@isBusy">@SupportText["ReopenCase"]</button>
                                }
                                @if (supportCase.AllowedActions.Contains("close"))
                                {
                                    <button class="btn btn-outline-secondary" @onclick="CloseCaseAsync" disabled="@isBusy">@SupportText["CloseCase"]</button>
                                }
                            </div>
                        </section>

                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["CustomerContext"]</h2>
                            <dl class="mb-0">
                                <dt>@SupportText["Customer"]</dt>
                                <dd>@(supportCase.CustomerName ?? "No customer linked")</dd>
                                <dt>@SupportText["Contact"]</dt>
                                <dd>@(supportCase.ContactName ?? "No contact linked")</dd>
                                <dt>@SupportText["Email"]</dt>
                                <dd>@(supportCase.ContactEmail ?? "No email linked")</dd>
                                <dt>@SupportText["Match"]</dt>
                                <dd>@supportCase.Context.MatchRationale</dd>
                            </dl>
                        </section>

                        <section class="border rounded bg-white p-3 mb-4">
                            <h2 class="h5">@SupportText["RefundHandoff"]</h2>
        <input class="form-control mb-2" type="number" step="0.01" @bind="refundAmount" placeholder="@SupportText["AmountPlaceholder"]" />
        <input class="form-control mb-2" @bind="refundCurrency" placeholder="@SupportText["CurrencyPlaceholder"]" />
        <input class="form-control mb-2" @bind="refundReason" placeholder="@SupportText["ReasonCodePlaceholder"]" />
        <textarea class="form-control mb-2" rows="3" @bind="refundExplanation" placeholder="@SupportText["ExplanationPlaceholder"]"></textarea>
                            <button class="btn btn-outline-primary" @onclick="RequestRefundAsync" disabled="@isBusy">@SupportText["RequestFinanceReview"]</button>
                        </section>

                        <section class="border rounded bg-white p-3">
                            <h2 class="h5">@SupportText["Activity"]</h2>
                            @if (supportCase.Events.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@SupportText["NoActivity"]</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var evt in supportCase.Events.Take(12))
                                    {
                                        <div class="list-group-item px-0">
                                            <strong>@evt.EventLabel</strong>
                                            <div>@evt.Summary</div>
                                            <small class="text-body-secondary">@LocalDateTime.DateTime(evt.OccurredUtc)</small>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] Priorities = ["low", "normal", "high", "urgent"];
    private static readonly string[] Categories = ["general_question", "billing", "refund", "technical_issue", "account_access", "complaint", "bug_report", "churn_risk"];
    [Parameter] public Guid CaseId { get; set; }

    private SupportCaseDetailResponse? supportCase;
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private string? noteBody;
    private string selectedPriority = "normal";
    private string selectedCategory = "general_question";
    private IReadOnlyList<SupportAssigneeOptionDto> assignees = [];
    private string selectedAssignee = string.Empty;
    private string? assignmentReason;
    private string? resolutionSummary;
    private string resolutionOutcome = "Resolved for customer";
    private string resolutionRootCause = "other";
    private string? resolutionActionTaken;
    private string? resolutionReusableAnswer;
    private string? resolutionPreferenceObservation;
    private bool resolutionReuseEligible;
    private string? caseActionNote;
    private decimal refundAmount;
    private string refundCurrency = "SEK";
    private string refundReason = "customer_request";
    private string? refundExplanation;
    private string? replyToEmail;
    private Guid? supportAgentId;
    private SupportAnswerabilityResultViewModel? answerability;
    private Guid? loadedCaseId;
    private readonly Dictionary<Guid, string> draftBodies = [];
    private readonly Dictionary<Guid, string> draftTones = [];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = supportCase is null;
        errorMessage = null;

        try
        {
            if (!await ResolveCompanyAsync() || ResolvedCompanyId is not Guid companyId)
            {
                return;
            }

            supportCase = await SupportApiClient.GetCaseAsync(companyId, CaseId);
            if (supportCase is null)
            {
                errorMessage = "The support case was not found.";
                return;
            }

            if (loadedCaseId != supportCase.Id)
            {
                replyToEmail = null;
                loadedCaseId = supportCase.Id;
            }

            assignees = await SupportApiClient.ListAssigneesAsync(companyId);
            selectedAssignee = supportCase.AssignedAgentId is Guid agentId
                ? $"agent:{agentId:D}"
                : supportCase.AssignedUserId is Guid userId
                    ? $"user:{userId:D}"
                    : string.Empty;
            selectedPriority = supportCase.Priority;
            selectedCategory = supportCase.Category;
            replyToEmail = FirstNonBlank(replyToEmail, supportCase.ContactEmail, LatestInboundMessage()?.Sender);
            foreach (var draft in supportCase.ReplyDrafts)
            {
                draftBodies.TryAdd(draft.Id, draft.DraftBody);
                draftTones.TryAdd(draft.Id, draft.Tone);
            }

            supportAgentId = supportCase.AssignedAgentId ?? await ResolveSupportAgentIdAsync(companyId);
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunActionAsync(Func<Guid, Task> action)
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            await action(companyId);
            await LoadAsync();
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task SaveControlsAsync() => RunActionAsync(async companyId =>
    {
        await SupportApiClient.ChangePriorityAsync(companyId, CaseId, selectedPriority);
        await SupportApiClient.ChangeCategoryAsync(companyId, CaseId, selectedCategory);
    });

    private Task SaveAssignmentAsync() => RunActionAsync(companyId =>
    {
        var parts = selectedAssignee.Split(':', 2);
        var id = Guid.Empty;
        var hasSelection = parts.Length == 2 && Guid.TryParse(parts[1], out id);
        return SupportApiClient.AssignAsync(
            companyId,
            CaseId,
            new AssignSupportCaseRequest(
                hasSelection && parts[0] == "agent" ? id : null,
                hasSelection && parts[0] == "user" ? id : null,
                assignmentReason));
    });

    private Task ResolveCaseAsync() => string.IsNullOrWhiteSpace(resolutionSummary) || string.IsNullOrWhiteSpace(resolutionOutcome)
        ? Task.CompletedTask
