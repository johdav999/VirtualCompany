    private string BuildApprovalHref(Guid approvalId) =>
        ResolvedCompanyId is Guid companyId
            ? $"/approvals?companyId={companyId:D}&approvalId={approvalId:D}"
            : "/approvals";

    private static Guid? RefundApprovalId(SupportRefundRequestDto refund) =>
        refund.Status is "pending_finance_approval" or "executing"
            ? refund.ProviderApprovalRequestId ?? refund.ApprovalRequestId
            : refund.ApprovalRequestId;

    private static string RefundStatusMessage(SupportRefundRequestDto refund) => refund.Status switch
    {
        "pending_approval" => "Support approval is required before finance can validate this request.",
        "queued" => "Support approved this request. The customer credit is ready for finance execution.",
        "pending_finance_approval" => "The customer credit is waiting for finance approval before Fortnox receives it.",
        "executing" => "The approved customer credit is being sent to Fortnox.",
        "completed" => "The customer credit was completed in Fortnox.",
        "failed" => "The accounting-system action failed safely and can be retried after review.",
        "reconciliation_required" => "Confirm the Fortnox outcome before attempting another export.",
        "rejected" or "expired" or "cancelled" => "This request will not continue without a new review.",
        _ => "Review the refund or credit details and next action."
    };

    private static string ProviderStepLabel(SupportRefundRequestDto refund) => refund.Status switch
    {
        "completed" => "Completed",
        "executing" => "Sending",
        "failed" => "Needs attention",
        "reconciliation_required" => "Needs reconciliation",
        _ when refund.ProviderWriteRequestId.HasValue => "Waiting",
        _ => "Not requested"
    };

    private static string RefundStatusBadge(string status) => status switch
    {
        "completed" => "badge text-bg-success",
        "failed" or "reconciliation_required" => "badge text-bg-danger",
        "pending_approval" or "pending_finance_approval" or "executing" => "badge text-bg-warning",
        _ => "badge text-bg-light"
    };

    private static bool RefundAtLeast(SupportRefundRequestDto refund, int step) => step switch
    {
        1 => refund.Status is not "pending_approval" and not "rejected" and not "expired" and not "cancelled",
        2 => refund.Status is "pending_finance_approval" or "executing" or "completed" or "failed" or "reconciliation_required",
        3 => refund.Status is "executing" or "completed" or "failed" or "reconciliation_required",
        _ => false
    };

    private static RenderFragment RefundStep(string label, bool complete) => builder =>
    {
        builder.OpenElement(0, "li");
        builder.AddAttribute(1, "class", complete ? "is-complete" : null);
        builder.OpenElement(2, "span");
        builder.AddContent(3, complete ? "OK" : "");
        builder.CloseElement();
        builder.OpenElement(4, "small");
        builder.AddContent(5, label);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string MessageHeading(SupportMessageDto message) =>
        message.Direction switch
        {
            "inbound" => $"Customer via {message.Channel}",
            "outbound" => $"Support reply via {message.Channel}",
            _ => "Internal note"
        };

    private static string PriorityBadge(string priority) => priority switch
    {
        "urgent" => "badge text-bg-danger",
        "high" => "badge text-bg-warning",
        "low" => "badge text-bg-light",
        _ => "badge text-bg-primary"
    };

    private string Percent(decimal value) => LocalNumber.Percentage(value);

    private SupportMessageDto? LatestInboundMessage() =>
        supportCase?.Messages
            .Where(message => string.Equals(message.Direction, "inbound", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(message => message.OccurredUtc)
            .FirstOrDefault();

    private static string? FirstNonBlank(params string?[] values) =>
        values.Select(value => value?.Trim()).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
