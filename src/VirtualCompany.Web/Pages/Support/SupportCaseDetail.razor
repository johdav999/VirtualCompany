    private static string AssigneeKey(SupportAssigneeOptionDto option) => $"{option.Type}:{option.Id:D}";

    private static bool DraftEditable(SupportReplyDraftDto draft) =>
        (draft.Status is "draft" or "needs_review") && !draft.SentUtc.HasValue;
    private IReadOnlyList<SupportReplyDraftDto> ActiveReplyDrafts => supportCase?.ReplyDrafts
        .Where(draft => draft.Status is not "rejected")
        .OrderByDescending(draft => draft.UpdatedUtc)
        .ToList() ?? [];
    private string DraftBody(SupportReplyDraftDto draft) => draftBodies.GetValueOrDefault(draft.Id, draft.DraftBody);
    private string DraftTone(SupportReplyDraftDto draft) => draftTones.GetValueOrDefault(draft.Id, draft.Tone);
    private void SetDraftBody(Guid id, string? value) => draftBodies[id] = value ?? string.Empty;
    private void SetDraftTone(Guid id, string? value) => draftTones[id] = string.IsNullOrWhiteSpace(value) ? "Helpful" : value;

    private static string DraftSourceSummary(SupportReplyDraftDto draft)
    {
        if (string.IsNullOrWhiteSpace(draft.SourceReferencesJson))
        {
            return "No approved knowledge sources were attached to this draft.";
        }

        try
        {
            var trustedSources = System.Text.Json.Nodes.JsonNode.Parse(draft.SourceReferencesJson)?.AsArray()
                .Where(x => x?["trusted"]?.GetValue<bool>() == true)
                .Select(x => x?["label"]?.GetValue<string>())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];
            return trustedSources.Count == 0
                ? "No approved knowledge sources support this draft. Review is required."
                : $"Approved sources: {string.Join(", ", trustedSources)}.";
        }
        catch (System.Text.Json.JsonException)
        {
            return "Source details need review.";
        }
    }

    private Task AnalyzeAnswerabilityAsync() => RunActionAsync(LoadAnswerabilityAsync);

    private async Task LoadAnswerabilityAsync(Guid companyId)
    {
        if (supportAgentId is not Guid agentId)
        {
            answerability = null;
            return;
        }

        var latestDraft = ActiveReplyDrafts.FirstOrDefault();
        var draftBody = latestDraft is null ? null : DraftBody(latestDraft);
        answerability = await SupportApiClient.AnalyzeAnswerabilityAsync(companyId, agentId,
            new SupportAnswerabilityRequestViewModel
            {
                SupportCaseId = CaseId,
                DraftBody = draftBody,
                Objective = "Assess whether the current case can be answered safely from trusted company knowledge."
            });
    }

