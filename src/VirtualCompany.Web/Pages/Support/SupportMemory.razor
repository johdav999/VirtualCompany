@page "/support/memory"
@rendermode InteractiveServer
@inherits SupportPageBase
@using System.Globalization

<PageTitle>@SupportText["MemoryReview"]</PageTitle>

<section class="py-4 dashboard-hero">
    <div class="dashboard-shell">
        <div class="wizard-card dashboard-summary">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="dashboard-kicker">@SupportText["Support"]</span>
                    <h1>@SupportText["MemoryReview"]</h1>
                    <p class="text-body-secondary mb-0">@SupportText["MemoryDescription"]</p>
                </div>
                <a class="btn btn-outline-secondary" href="@BuildPath("/support")">@SupportText["BackToSupport"]</a>
            </div>

            <div class="border rounded p-3 mt-4 bg-white">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="support-memory-status">@SupportText["Status"]</label>
                        <select id="support-memory-status" class="form-select" @bind="statusFilter">
                            <option value="">@SupportText["All"]</option>
                            @foreach (var value in MemoryStatuses) { <option value="@value">@SupportStatusPresenter.Present(value, SupportText)</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-8 d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isBusy">@SupportText["Apply"]</button>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <p class="text-body-secondary mt-4 mb-0">@SupportText["LoadingMemory"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage) || !string.IsNullOrWhiteSpace(ShellErrorMessage))
            {
                <div class="alert alert-danger mt-4 mb-0">@(ShellErrorMessage ?? errorMessage)</div>
            }
            else if (observations.Count == 0)
            {
                <div class="alert alert-light border mt-4 mb-0">@SupportText["NoMemory"]</div>
            }
            else
            {
                <div class="table-responsive mt-4">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>@SupportText["Observation"]</th>
                                <th>@SupportText["Status"]</th>
                                <th>@SupportText["Evidence"]</th>
                                <th>@SupportText["Observed"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in observations)
                            {
                                <tr>
                                    <td>
                                        <strong>@(item.Value ?? SupportText["ValueHidden"])</strong>
                                        <div class="small text-body-secondary">@SupportText["Confidence", LocalNumber.Percentage(item.Confidence)]</div>
                                        <a class="small" href="@BuildPath($"/support/cases/{item.SupportCaseId:D}")">@SupportText["OpenSourceCase"]</a>
                                    </td>
                                    <td><span class="badge text-bg-light">@SupportStatusPresenter.Present(item.Status, SupportText)</span></td>
                                    <td>@item.EvidenceSummary</td>
                                    <td>
                                        @LocalDateTime.DateTime(item.ObservedUtc)
                                        @if (item.ValidUntilUtc is DateTime validUntil)
                                        {
                                            <div class="small text-body-secondary">@SupportText["ValidUntil", LocalDateTime.DateTime(validUntil)]</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (item.AllowedActions.Contains("approve"))
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => ApproveAsync(item.Id)" disabled="@isBusy">@SupportText["Approve"]</button>
                                            }
                                            @if (item.AllowedActions.Contains("reject"))
                                            {
                                                <button class="btn btn-outline-secondary" @onclick="() => RejectAsync(item.Id)" disabled="@isBusy">@SupportText["Reject"]</button>
                                            }
                                            @if (item.AllowedActions.Contains("expire"))
                                            {
                                                <button class="btn btn-outline-secondary" @onclick="() => ExpireAsync(item.Id)" disabled="@isBusy">@SupportText["Expire"]</button>
                                            }
                                            @if (item.AllowedActions.Contains("delete"))
                                            {
                                                <button class="btn btn-outline-danger" @onclick="() => DeleteAsync(item.Id)" disabled="@isBusy">@SupportText["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] MemoryStatuses = ["review", "approved", "rejected", "expired", "deleted"];
    private IReadOnlyList<SupportMemoryObservationDto> observations = [];
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private string? statusFilter = "review";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync() || ResolvedCompanyId is not Guid companyId)
            {
                return;
            }

            observations = await SupportApiClient.ListMemoryObservationsAsync(companyId, statusFilter);
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            isBusy = false;
        }
    }

    private Task ApproveAsync(Guid id) => RunActionAsync(companyId => SupportApiClient.ApproveMemoryObservationAsync(companyId, id, "Approved from support memory review."));
    private Task RejectAsync(Guid id) => RunActionAsync(companyId => SupportApiClient.RejectMemoryObservationAsync(companyId, id, "Rejected from support memory review."));
    private Task ExpireAsync(Guid id) => RunActionAsync(companyId => SupportApiClient.ExpireMemoryObservationAsync(companyId, id, "Expired from support memory review."));
    private Task DeleteAsync(Guid id) => RunActionAsync(companyId => SupportApiClient.DeleteMemoryObservationAsync(companyId, id, "Deleted from support memory review."));

    private async Task RunActionAsync(Func<Guid, Task> action)
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            await action(companyId);
            await LoadAsync();
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
