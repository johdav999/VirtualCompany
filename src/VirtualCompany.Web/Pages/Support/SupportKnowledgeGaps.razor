@page "/support/knowledge-gaps"
@page "/support/knowledge"
@rendermode InteractiveServer
@inherits SupportPageBase
@using System.Globalization

<PageTitle>@SupportText["KnowledgeGaps"]</PageTitle>

<section class="py-4 dashboard-hero">
    <div class="dashboard-shell">
        <div class="wizard-card dashboard-summary">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <span class="dashboard-kicker">@SupportText["Support"]</span>
                    <h1>@SupportText["KnowledgeGaps"]</h1>
                    <p class="text-body-secondary mb-0">@SupportText["KnowledgeGapsDescription"]</p>
                </div>
                <a class="btn btn-outline-secondary" href="/support">@SupportText["BackToCases"]</a>
            </div>
            <nav class="vc-section-tabs mt-3" aria-label="@SupportText["Knowledge"]">
                <a class="active" href="@BuildPath("/support/knowledge")">@SupportText["KnowledgeGaps"]</a>
                <a href="@BuildPath("/support/memory")">@SupportText["MemoryReview"]</a>
            </nav>

            <div class="border rounded bg-white p-3 mt-4">
                <label class="form-label" for="support-gap-status">@SupportText["Status"]</label>
                <div class="d-flex flex-wrap gap-2">
                    <select id="support-gap-status" class="form-select support-gap-filter" @bind="statusFilter">
                        <option value="">@SupportText["All"]</option>
                        @foreach (var value in GapStatuses) { <option value="@value">@SupportStatusPresenter.Present(value, SupportText)</option> }
                    </select>
                    <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isBusy">@SupportText["Apply"]</button>
                </div>
            </div>

            <div class="border rounded bg-white p-3 mt-3">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div>
                        <h2 class="h5 mb-1">@SupportText["ApprovedSupportKnowledge"]</h2>
                        <p class="text-body-secondary mb-0">@SupportText["ApprovedKnowledgeDescription"]</p>
                    </div>
                    <button class="btn btn-outline-primary" @onclick="ImportDefaultKnowledgeAsync" disabled="@isBusy">
                        @SupportText["ImportDefaultKnowledge"]
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(importMessage))
                {
                    <div class="alert alert-success py-2 mt-3 mb-0">@importMessage</div>
                }
                @if (knowledgeDocuments.Count > 0)
                {
                    <div class="d-flex flex-column gap-2 mt-3">
                        @foreach (var document in knowledgeDocuments)
                        {
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-top pt-2">
                                <span>@document.Title</span>
                                <span class="badge @(document.IndexingStatus == "indexed" ? "text-bg-success" : "text-bg-light")">
                                    @KnowledgeStatus(document)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (isLoading)
            {
                <p class="text-body-secondary mt-4">@SupportText["LoadingKnowledgeGaps"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4">@errorMessage</div>
            }
            else if (gaps.Count == 0)
            {
                <div class="border rounded bg-white p-4 mt-4 text-center">
                    <h2 class="h5">@SupportText["NoKnowledgeGaps"]</h2>
                    <p class="text-body-secondary mb-0">@SupportText["NoKnowledgeGapsDescription"]</p>
                </div>
            }
            else
            {
                <div class="support-gap-grid mt-4">
                    @foreach (var gap in gaps)
                    {
                        <article class="border rounded bg-white p-3">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <span class="badge text-bg-light">@gap.CategoryLabel</span>
                                    <h2 class="h5 mt-2">@gap.QuestionSummary</h2>
                                </div>
                                <span class="badge text-bg-warning">@SupportText["CaseCount", gap.FrequencyCount]</span>
                            </div>
                            <p>@gap.MissingInformationSummary</p>
                            @if (!string.IsNullOrWhiteSpace(gap.RetrievalSourceSummary))
                            {
                                <p class="small text-body-secondary">@gap.RetrievalSourceSummary</p>
                            }
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="small text-body-secondary">@SupportText["UpdatedAt", LocalDateTime.DateTime(gap.UpdatedUtc)]</span>
                                @if (gap.LinkedTaskId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/tasks?taskId={gap.LinkedTaskId:D}")">@SupportText["OpenDocumentationTask"]</a>
                                }
                                else if (gap.Status == "open")
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => CreateTaskAsync(gap.Id)" disabled="@isBusy">@SupportText["CreateDocumentationTask"]</button>
                                }
                            </div>
                            @if (gap.Status is "open" or "linked_to_task")
                            {
                                <div class="border-top mt-3 pt-3">
                                    <label class="form-label" for="@($"knowledge-document-{gap.Id:D}")">@SupportText["ApprovedKnowledgeDocumentId"]</label>
                                    <div class="input-group">
                                        <input id="@($"knowledge-document-{gap.Id:D}")" class="form-control" value="@DocumentValue(gap.Id)" @oninput="e => SetDocumentValue(gap.Id, e.Value?.ToString())" />
                                        <button class="btn btn-outline-primary" @onclick="() => ResolveAsync(gap.Id)" disabled="@isBusy">@SupportText["ResolveGap"]</button>
                                    </div>
                                </div>
                            }
                            else if (gap.Status == "resolved")
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 border-top mt-3 pt-3">
                                    <span class="small text-body-secondary">@SupportText["KnowledgeDocument", gap.LinkedKnowledgeDocumentId]</span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReopenAsync(gap.Id)" disabled="@isBusy">@SupportText["ReopenGap"]</button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] GapStatuses = ["open", "linked_to_task", "resolved"];
    private IReadOnlyList<SupportKnowledgeGapDto> gaps = [];
    private IReadOnlyList<SupportKnowledgeDocumentDto> knowledgeDocuments = [];
    private string statusFilter = "open";
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private string? importMessage;
    private readonly Dictionary<Guid, string> documentIds = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync() || ResolvedCompanyId is not Guid companyId) return;
            gaps = await SupportApiClient.ListKnowledgeGapsAsync(companyId, statusFilter);
            knowledgeDocuments = await SupportApiClient.ListSupportKnowledgeAsync(companyId);
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ImportDefaultKnowledgeAsync()
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        isBusy = true;
        errorMessage = null;
        importMessage = null;
        try
        {
            var result = await SupportApiClient.ImportDefaultSupportKnowledgeAsync(companyId);
            importMessage = result.Imported.Count > 0
                ? SupportText["ImportedKnowledge", result.Imported.Count]
                : SupportText["DefaultKnowledgeImported"];
            await LoadAsync();
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string KnowledgeStatus(SupportKnowledgeDocumentDto document) => document.IndexingStatus switch
    {
        "indexed" => SupportText["IndexedSections", document.ActiveChunkCount],
        "failed" => SupportText["IndexingFailed"],
        "indexing" => SupportText["StatusIndexing"],
        "queued" => SupportText["StatusQueued"],
        _ when document.IngestionStatus == "failed" => SupportText["ImportFailed"],
        _ => SupportText["StatusProcessing"]
    };

    private async Task CreateTaskAsync(Guid gapId)
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        isBusy = true;
        try
        {
            await SupportApiClient.CreateKnowledgeDocumentationTaskAsync(companyId, gapId);
            await LoadAsync();
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string DocumentValue(Guid gapId) => documentIds.GetValueOrDefault(gapId, string.Empty);
    private void SetDocumentValue(Guid gapId, string? value) => documentIds[gapId] = value?.Trim() ?? string.Empty;

    private async Task ResolveAsync(Guid gapId)
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        if (!Guid.TryParse(DocumentValue(gapId), out var documentId)) { errorMessage = SupportText["ValidKnowledgeDocumentId"]; return; }
        isBusy = true;
        try { await SupportApiClient.ResolveKnowledgeGapAsync(companyId, gapId, documentId); await LoadAsync(); }
        catch (SupportApiException ex) { errorMessage = ex.Message; }
        finally { isBusy = false; }
    }

    private async Task ReopenAsync(Guid gapId)
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        isBusy = true;
        try { await SupportApiClient.ReopenKnowledgeGapAsync(companyId, gapId); await LoadAsync(); }
        catch (SupportApiException ex) { errorMessage = ex.Message; }
        finally { isBusy = false; }
    }
}
