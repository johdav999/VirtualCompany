@page "/support"
@page "/support/cases"
@rendermode InteractiveServer
@inherits SupportPageBase
@using System.Globalization
@using Microsoft.AspNetCore.Components

<PageTitle>@SupportText["Support"]</PageTitle>

<section class="py-4 dashboard-hero">
    <div class="dashboard-shell">
        <div class="wizard-card dashboard-summary">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="dashboard-kicker">@SupportText["Support"]</span>
                    <h1>@SupportText["CustomerSupport"]</h1>
                    <p class="text-body-secondary mb-0">@SupportText["SupportDescription"]</p>
                </div>
                <button class="btn btn-primary" @onclick="CreateCaseAsync" disabled="@isBusy">@SupportText["CreateCase"]</button>
                <a class="btn btn-outline-secondary" href="/support/knowledge-gaps">@SupportText["KnowledgeGaps"]</a>
                <a class="btn btn-outline-secondary" href="@BuildPath("/support/memory")">@SupportText["MemoryReview"]</a>
                <a class="btn btn-outline-secondary" href="/support/settings/sla">@SupportText["SlaSettings"]</a>
            </div>

            @if (isLoading)
            {
                <p class="text-body-secondary mt-4 mb-0">@SupportText["LoadingCases"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(ShellErrorMessage) || !string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4 mb-0">@(ShellErrorMessage ?? errorMessage)</div>
            }
            else if (cases is not null)
            {
                <div class="row g-3 mt-4">
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["Open"], cases.Summary.Open, "open")</div>
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["SlaRisk"], cases.Summary.SlaRisk, "sla-risk")</div>
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["Breached"], cases.Summary.SlaBreached, "breached")</div>
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["Escalated"], cases.Summary.Escalated, "escalated")</div>
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["Approvals"], cases.Summary.AwaitingApproval, "approvals")</div>
                    <div class="col-6 col-xl-2">@MetricCard(SupportText["ResolvedToday"], cases.Summary.ResolvedToday, "resolved")</div>
                </div>

                <div class="border rounded p-3 mt-4 bg-white support-filter-panel">
                    <div class="support-filter-grid">
                        <div class="support-filter-field support-filter-field--search">
                            <label class="form-label" for="support-search">@SupportText["Search"]</label>
                            <input id="support-search" class="form-control" value="@search" @onchange="OnSearchChanged" placeholder="@SupportText["SearchPlaceholder"]" />
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-status">@SupportText["Status"]</label>
                            <select id="support-status" class="form-select" @bind="status">
                                <option value="">@SupportText["All"]</option>
                                @foreach (var itemCode in CaseStatuses)
                                {
                                    <option value="@itemCode">@SupportStatusPresenter.Present(itemCode, SupportText)</option>
                                }
                            </select>
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-priority">@SupportText["Priority"]</label>
                            <select id="support-priority" class="form-select" @bind="priority">
                                <option value="">@SupportText["All"]</option>
                                @foreach (var itemCode in Priorities)
                                {
                                    <option value="@itemCode">@SupportStatusPresenter.Present(itemCode, SupportText)</option>
                                }
                            </select>
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-category">@SupportText["Category"]</label>
                            <select id="support-category" class="form-select" @bind="category">
                                <option value="">@SupportText["All"]</option>
                                @foreach (var itemCode in Categories)
                                {
                                    <option value="@itemCode">@SupportStatusPresenter.Present(itemCode, SupportText)</option>
                                }
                            </select>
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-owner">@SupportText["Owner"]</label>
                            <select id="support-owner" class="form-select" @bind="ownerFilter">
                                <option value="">@SupportText["All"]</option>
                                <option value="unassigned">@SupportText["Unassigned"]</option>
                                <option value="mine">@SupportText["AssignedToMe"]</option>
                            </select>
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-view">@SupportText["AttentionView"]</label>
                            <select id="support-view" class="form-select" @bind="attentionView">
                                <option value="">@SupportText["AllCases"]</option>
                                <option value="open">@SupportText["OpenCases"]</option>
                                <option value="waiting">@SupportText["WaitingTooLong"]</option>
                                <option value="failed-reply">@SupportText["FailedReplies"]</option>
                                <option value="sla-risk">@SupportText["SlaRisk"]</option>
                                <option value="breached">@SupportText["Breached"]</option>
                                <option value="approvals">@SupportText["AwaitingApproval"]</option>
                                <option value="escalated">@SupportText["Escalated"]</option>
                                <option value="resolved">@SupportText["ResolvedToday"]</option>
                            </select>
                        </div>
                        <div class="support-filter-field">
                            <label class="form-label" for="support-sort">@SupportText["Sort"]</label>
                            <select id="support-sort" class="form-select" @bind="sortBy">
                                <option value="attention">@SupportText["Attention"]</option>
                                <option value="updated">@SupportText["RecentlyUpdated"]</option>
                                <option value="created">@SupportText["RecentlyCreated"]</option>
                                <option value="due">@SupportText["DueDate"]</option>
                            </select>
                        </div>
                        <div class="support-filter-actions">
                            <button class="btn btn-outline-secondary" @onclick="ApplyFiltersAsync" disabled="@isBusy">@SupportText["Apply"]</button>
                            <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@isBusy">@SupportText["Clear"]</button>
                        </div>
                    </div>
                </div>

                @if (analytics is not null && analytics.Insights.Count > 0)
                {
                    <div class="alert alert-warning mt-4 mb-0">
                        <strong>@analytics.Insights[0].Title</strong>
                        <div>@analytics.Insights[0].Summary @analytics.Insights[0].SuggestedAction</div>
                    </div>
                }

                @if (analytics is not null)
                {
                    <div class="border rounded p-3 mt-4 bg-white">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <h2 class="h6 mb-1">@SupportText["SlaPerformance"]</h2>
                                <p class="text-body-secondary mb-0">@analytics.SlaPerformance.Rationale</p>
                            </div>
                            <a class="btn btn-sm btn-outline-secondary" href="@BuildPath("/support/settings/sla")">@SupportText["ReviewTargets"]</a>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-6 col-lg-2">@MetricCard(SupportText["AtRiskNow"], analytics.SlaPerformance.OpenAtRisk, "sla-risk")</div>
                            <div class="col-6 col-lg-2">@MetricCard(SupportText["BreachedNow"], analytics.SlaPerformance.OpenBreached, "breached")</div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["ResponsesMet"]</div><strong>@analytics.SlaPerformance.FirstResponsesMet.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["ResponsesMissed"]</div><strong>@analytics.SlaPerformance.FirstResponsesMissed.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["ResolutionsMet"]</div><strong>@analytics.SlaPerformance.ResolutionsMet.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["MissingTargets"]</div><strong>@analytics.SlaPerformance.MissingTargets.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mt-4 bg-white">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <h2 class="h6 mb-1">@SupportText["LearningImpact"]</h2>
                                <p class="text-body-secondary mb-0">@analytics.Learning.Rationale</p>
                            </div>
                            <a class="btn btn-sm btn-outline-secondary" href="@BuildPath("/support/memory")">@SupportText["ReviewMemory"]</a>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["MemoryUsed"]</div><strong>@analytics.Learning.DraftsUsingMemory.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["NeedsReview"]</div><strong>@analytics.Learning.ReviewMemoryObservations.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["ApprovedMemory"]</div><strong>@analytics.Learning.ApprovedMemoryObservations.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["RejectedMemory"]</div><strong>@analytics.Learning.RejectedMemoryObservations.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["AnswerabilityWithMemory"]</div><strong>@FormatPercent(analytics.Learning.AverageAnswerabilityWithMemory)</strong></div></div>
                            <div class="col-6 col-lg-2"><div class="border rounded p-3 h-100"><div class="small text-body-secondary">@SupportText["ReopenedCases"]</div><strong>@analytics.Learning.ReopenedCases.ToString(CultureInfo.CurrentCulture)</strong></div></div>
                        </div>
                    </div>
                }

                <div class="table-responsive mt-4">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>@SupportText["Case"]</th>
                                <th>@SupportText["Customer"]</th>
                                <th>@SupportText["Category"]</th>
                                <th>@SupportText["Priority"]</th>
                                <th>@SupportText["Status"]</th>
                                <th>@SupportText["Due"]</th>
                                <th>@SupportText["Updated"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (cases.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-body-secondary py-4">@SupportText["NoMatchingCases"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in cases.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.CaseNumber</strong>
                                            <div>@item.Subject</div>
                                        </td>
                                        <td>
                                            @(item.CustomerName ?? item.ContactName ?? SupportText["Unmatched"])
                                            <div class="small text-body-secondary">@item.ContactEmail</div>
                                        </td>
                                        <td>@SupportStatusPresenter.Present(item.Category, SupportText)</td>
                                        <td><span class="@PriorityBadge(item.Priority)">@SupportStatusPresenter.Present(item.Priority, SupportText)</span></td>
                                        <td><span class="badge text-bg-light">@SupportStatusPresenter.Present(item.Status, SupportText)</span></td>
                                        <td>
                                            @if (item.IsSlaBreached)
                                            {
                                                <span class="badge text-bg-danger">@SupportText["Breached"]</span>
                                            }
                                            else if (item.IsSlaRisk)
                                            {
                                                <span class="badge text-bg-warning">@SupportText["AtRisk"]</span>
                                            }
                                            else
                                            {
                                                <span class="text-body-secondary">@FormatDue(item.ResolutionDueUtc)</span>
                                            }
                                        </td>
                                        <td>@LocalDateTime.DateTime(item.UpdatedUtc)</td>
                                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@BuildPath($"/support/cases/{item.Id:D}")">@SupportText["OpenCase"]</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (cases.TotalCount > pageSize)
                {
                    <nav class="d-flex align-items-center justify-content-between gap-3 mt-3" aria-label="@SupportText["SupportPages"]">
                        <span class="small text-body-secondary">@SupportText["ShowingRange", pageIndex * pageSize + 1, Math.Min(cases.TotalCount, (pageIndex + 1) * pageSize), cases.TotalCount]</span>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || pageIndex == 0)">@SupportText["Previous"]</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || (pageIndex + 1) * pageSize >= cases.TotalCount)">@SupportText["Next"]</button>
                        </div>
                    </nav>
                }
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] CaseStatuses = ["new", "triaged", "waiting_for_customer", "waiting_internal", "escalated", "awaiting_approval", "resolved"];
    private static readonly string[] Priorities = ["urgent", "high", "normal", "low"];
    private static readonly string[] Categories = ["billing", "refund", "technical_issue", "account_access", "complaint", "bug_report", "churn_risk"];
    private SupportCaseListResponse? cases;
    private SupportAnalyticsDashboardResponse? analytics;
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;
    private string? search;
    private string? status;
    private string? priority;
    private string? category;
    private string? ownerFilter;
    private string? attentionView;
    private string sortBy = "attention";
    private int pageIndex;
    private const int pageSize = 25;

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "priority")]
    public string? PriorityQuery { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = "owner")]
    public string? OwnerQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        ReadQueryState();
        isLoading = cases is null;
        isBusy = true;
        errorMessage = null;

        try
        {
            if (!await ResolveCompanyAsync() || ResolvedCompanyId is not Guid companyId)
            {
                return;
            }

            var effectiveStatus = attentionView switch
            {
                "approvals" => "awaiting_approval",
                "escalated" => "escalated",
                "resolved" => "resolved",
                _ => status
            };
            cases = await SupportApiClient.ListCasesAsync(companyId, new SupportCaseListQuery(
                Status: effectiveStatus,
                Priority: priority,
                Category: category,
                Search: search,
                OpenOnly: attentionView == "open",
                ResolvedToday: attentionView == "resolved",
                Unassigned: ownerFilter == "unassigned",
                AssignedToMe: ownerFilter == "mine",
                SlaRisk: attentionView == "sla-risk" ? true : null,
                SlaBreached: attentionView == "breached" ? true : null,
                WaitingTooLong: attentionView == "waiting",
                FailedReply: attentionView == "failed-reply",
                SortBy: sortBy == "attention" ? null : sortBy,
                Skip: pageIndex * pageSize,
                Take: pageSize));
            analytics = await SupportApiClient.GetAnalyticsAsync(companyId);
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            isBusy = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        search = status = priority = category = ownerFilter = attentionView = null;
        sortBy = "attention";
        pageIndex = 0;
        await NavigateWithStateAsync(replace: false);
    }

    private async Task ApplyFiltersAsync()
    {
        pageIndex = 0;
        await NavigateWithStateAsync(replace: false);
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        search = args.Value?.ToString();
        pageIndex = 0;
        await NavigateWithStateAsync(replace: false);
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex > 0) pageIndex--;
        await NavigateWithStateAsync(replace: false);
    }

    private async Task NextPageAsync()
    {
        if (cases is not null && (pageIndex + 1) * pageSize < cases.TotalCount) pageIndex++;
        await NavigateWithStateAsync(replace: false);
    }

    private async Task CreateCaseAsync()
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        isBusy = true;
        try
        {
            var created = await SupportApiClient.CreateCaseAsync(companyId, new CreateSupportCaseRequest("New support case", "Add the customer question or issue here.", "Manual"));
            Navigation.NavigateTo(BuildPath($"/support/cases/{created.Id:D}"));
        }
        catch (SupportApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string FormatDue(DateTime? value) =>
        value is DateTime due ? LocalDateTime.DateTime(due) : SupportText["NotSet"];

    private static string PriorityBadge(string priority) => priority switch
    {
        "urgent" => "badge text-bg-danger",
        "high" => "badge text-bg-warning",
        "low" => "badge text-bg-light",
        _ => "badge text-bg-primary"
    };

    private string FormatPercent(decimal? value) =>
        value is decimal actual ? LocalNumber.Percentage(actual) : SupportText["NoData"];

    private RenderFragment MetricCard(string label, int value, string view) => @<button type="button" class="border rounded bg-white p-3 h-100 w-100 text-start" @onclick="() => ApplyViewAsync(view)">
        <div class="small text-body-secondary">@label</div>
        <strong class="fs-3">@value.ToString(CultureInfo.CurrentCulture)</strong>
    </button>;

    private async Task ApplyViewAsync(string view)
    {
        status = view switch { "escalated" => "escalated", "approvals" => "awaiting_approval", "resolved" => "resolved", _ => null };
        attentionView = view switch { "open" => "open", "sla-risk" => "sla-risk", "breached" => "breached", "waiting" => "waiting", "failed-reply" => "failed-reply", "approvals" => "approvals", "escalated" => "escalated", "resolved" => "resolved", _ => null };
        pageIndex = 0;
        await NavigateWithStateAsync(replace: false);
    }

    private void ReadQueryState()
    {
        search = SearchQuery;
        status = StatusQuery;
        priority = PriorityQuery;
        category = CategoryQuery;
        ownerFilter = NormalizeKnown(OwnerQuery, ["mine", "unassigned"]);
        attentionView = NormalizeKnown(ViewQuery, ["open", "sla-risk", "breached", "waiting", "failed-reply", "approvals", "escalated", "resolved"]);
        sortBy = NormalizeKnown(SortQuery, ["attention", "updated", "created", "due"]) ?? "attention";
        pageIndex = Math.Max(0, (PageQuery ?? 1) - 1);
    }

    private async Task NavigateWithStateAsync(bool replace)
    {
        var companyId = ResolvedCompanyId ?? CompanyId;

        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["companyId"] = companyId,
            ["q"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            ["status"] = string.IsNullOrWhiteSpace(status) ? null : status,
            ["priority"] = string.IsNullOrWhiteSpace(priority) ? null : priority,
            ["category"] = string.IsNullOrWhiteSpace(category) ? null : category,
            ["owner"] = string.IsNullOrWhiteSpace(ownerFilter) ? null : ownerFilter,
            ["view"] = string.IsNullOrWhiteSpace(attentionView) ? null : attentionView,
            ["sort"] = sortBy == "attention" ? null : sortBy,
            ["page"] = pageIndex <= 0 ? null : pageIndex + 1
        });
        if (string.Equals(uri, Navigation.Uri, StringComparison.Ordinal))
        {
            await LoadAsync();
            return;
        }

        Navigation.NavigateTo(uri, replace);
    }

    private static string? NormalizeKnown(string? value, IReadOnlyCollection<string> allowed)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var normalized = value.Trim().ToLowerInvariant();
        return allowed.Contains(normalized) ? normalized : null;
    }
}
