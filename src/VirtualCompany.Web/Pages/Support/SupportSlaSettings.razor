@page "/support/settings/sla"
@rendermode InteractiveServer
@inherits SupportPageBase

<PageTitle>Support SLA settings</PageTitle>

<section class="py-4 dashboard-hero">
    <div class="dashboard-shell">
        <div class="wizard-card dashboard-summary">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="dashboard-kicker">Support settings</span>
                    <h1>Response targets</h1>
                    <p class="text-body-secondary mb-0">Set when customer cases need a first response and resolution.</p>
                </div>
                <a class="btn btn-outline-secondary" href="/support">Back to support</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-4">@errorMessage</div>
            }

            <div class="row g-4 mt-1">
                <div class="col-12 col-xl-5">
                    <section class="border rounded bg-white p-3">
                        <h2 class="h5">@(editingId.HasValue ? "Edit response target" : "Add response target")</h2>
                        <label class="form-label mt-2">Name</label>
                        <input class="form-control" @bind="name" />
                        <div class="row g-2 mt-1">
                            <div class="col-6">
                                <label class="form-label">Category</label>
                                <select class="form-select" @bind="category">
                                    <option value="general_question">General question</option><option value="billing">Billing</option><option value="refund">Refund</option><option value="technical_issue">Technical issue</option><option value="account_access">Account access</option><option value="complaint">Complaint</option><option value="bug_report">Bug report</option><option value="churn_risk">Churn risk</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Priority</label>
                                <select class="form-select" @bind="priority"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option></select>
                            </div>
                        </div>
                        <label class="form-label mt-2">Customer tier (optional)</label>
                        <input class="form-control" @bind="customerTier" />
                        <div class="row g-2 mt-1">
                            <div class="col-6"><label class="form-label">First response (minutes)</label><input class="form-control" type="number" min="1" @bind="firstResponseMinutes" /></div>
                            <div class="col-6"><label class="form-label">Resolution (minutes)</label><input class="form-control" type="number" min="1" @bind="resolutionMinutes" /></div>
                        </div>
                        <label class="form-label mt-2">Clock</label>
                        <select class="form-select" @bind="timeBasis"><option value="elapsed">Elapsed time</option><option value="business">Business hours</option></select>
                        <div class="row g-2 mt-1"><div class="col-6"><label class="form-label">At-risk window (minutes)</label><input class="form-control" type="number" min="1" @bind="riskThresholdMinutes" /></div><div class="col-6"><label class="form-label">Notify role</label><select class="form-select" @bind="escalationRecipientRole"><option value="support_supervisor">Support supervisor</option><option value="manager">Manager</option><option value="admin">Admin</option><option value="owner">Owner</option></select></div></div>
                        <button class="btn btn-primary w-100 mt-3" @onclick="SaveAsync" disabled="@isBusy">Save target</button>
                    </section>

                    <section class="border rounded bg-white p-3 mt-3">
                        <h2 class="h5">Preview</h2>
                        <button class="btn btn-outline-secondary" @onclick="PreviewAsync" disabled="@isBusy">Preview current selection</button>
                        @if (preview is not null)
                        {
                            <dl class="mt-3 mb-0"><dt>Policy</dt><dd>@preview.PolicyName</dd><dt>First response</dt><dd>@preview.FirstResponseMinutes minutes</dd><dt>Resolution</dt><dd>@preview.ResolutionMinutes minutes</dd><dt>Why</dt><dd>@preview.Rationale</dd></dl>
                        }
                    </section>
                </div>
                <div class="col-12 col-xl-7">
                    <section class="border rounded bg-white p-3">
                        <h2 class="h5">Configured targets</h2>
                        @if (isLoading) { <p class="text-body-secondary">Loading response targets...</p> }
                        else if (policies.Count == 0) { <p class="text-body-secondary">No custom targets exist. Documented defaults apply.</p> }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var policy in policies)
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex flex-wrap justify-content-between gap-3"><div><strong>@policy.Name</strong><div class="text-body-secondary">@policy.CategoryLabel · @policy.PriorityLabel@(string.IsNullOrWhiteSpace(policy.CustomerTier) ? "" : $" · {policy.CustomerTier}")</div></div><span class="badge @(policy.IsActive ? "text-bg-success" : "text-bg-light")">@(policy.IsActive ? "Active" : "Inactive")</span></div>
                                        <p class="mb-2 mt-2">First response in @policy.FirstResponseMinutes minutes · resolution in @policy.ResolutionMinutes minutes</p>
                                        <div class="d-flex gap-2"><button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(policy)" disabled="@isBusy">Edit</button>@if (policy.IsActive) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => DeactivateAsync(policy.Id)" disabled="@isBusy">Deactivate</button> }</div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                    <section class="border rounded bg-white p-3 mt-3">
                        <h2 class="h5">Business calendar</h2>
                        <p class="text-body-secondary">Used by response targets measured in business hours.</p>
                        <label class="form-label">Time zone</label><input class="form-control" @bind="calendarTimeZone" />
                        <div class="row g-2 mt-1"><div class="col-6"><label class="form-label">Workday starts</label><input class="form-control" type="time" @bind="workdayStart" /></div><div class="col-6"><label class="form-label">Workday ends</label><input class="form-control" type="time" @bind="workdayEnd" /></div></div>
                        <label class="form-label mt-2">Working days</label>
                        <div class="d-flex flex-wrap gap-3">@foreach (var day in Weekdays) { <label class="form-check-label"><input class="form-check-input me-1" type="checkbox" checked="@workingDays.Contains(day)" @onchange="e => ToggleWorkingDay(day, e.Value as bool? == true)" />@day</label> }</div>
                        <label class="form-label mt-2">Holidays (one YYYY-MM-DD date per line)</label><textarea class="form-control" rows="4" @bind="holidayText"></textarea>
                        <button class="btn btn-outline-primary mt-3" @onclick="SaveCalendarAsync" disabled="@isBusy">Save calendar</button>
                    </section>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<SupportSlaPolicyDto> policies = [];
    private SupportSlaResolutionDto? preview;
    private Guid? editingId;
    private string name = "Standard support target";
    private string category = "general_question";
    private string priority = "normal";
    private string? customerTier;
    private int firstResponseMinutes = 480;
    private int resolutionMinutes = 4320;
    private string timeBasis = "elapsed";
    private int riskThresholdMinutes = 240;
    private string escalationRecipientRole = "support_supervisor";
    private string calendarTimeZone = "Europe/Stockholm";
    private TimeOnly workdayStart = new(8, 0);
    private TimeOnly workdayEnd = new(17, 0);
    private HashSet<DayOfWeek> workingDays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
    private string holidayText = string.Empty;
    private static readonly DayOfWeek[] Weekdays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { try { if (!await ResolveCompanyAsync() || ResolvedCompanyId is not Guid companyId) return; policies = await SupportApiClient.ListSlaPoliciesAsync(companyId); var calendar = await SupportApiClient.GetSlaCalendarAsync(companyId); calendarTimeZone = calendar.TimeZoneId; workdayStart = calendar.WorkdayStart; workdayEnd = calendar.WorkdayEnd; workingDays = calendar.WorkingDays.ToHashSet(); holidayText = string.Join(Environment.NewLine, calendar.Holidays.Select(x => x.ToString("yyyy-MM-dd"))); } catch (SupportApiException ex) { errorMessage = ex.Message; } finally { isLoading = false; } }
    private async Task SaveAsync() { if (ResolvedCompanyId is not Guid companyId) return; isBusy = true; errorMessage = null; try { await SupportApiClient.SaveSlaPolicyAsync(companyId, new(editingId, name, category, priority, firstResponseMinutes, resolutionMinutes, customerTier, true, timeBasis, riskThresholdMinutes, escalationRecipientRole)); editingId = null; await LoadAsync(); } catch (SupportApiException ex) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private async Task PreviewAsync() { if (ResolvedCompanyId is not Guid companyId) return; try { preview = await SupportApiClient.PreviewSlaPolicyAsync(companyId, category, priority, customerTier); } catch (SupportApiException ex) { errorMessage = ex.Message; } }
    private async Task DeactivateAsync(Guid id) { if (ResolvedCompanyId is not Guid companyId) return; isBusy = true; try { await SupportApiClient.DeactivateSlaPolicyAsync(companyId, id); await LoadAsync(); } catch (SupportApiException ex) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private async Task SaveCalendarAsync() { if (ResolvedCompanyId is not Guid companyId) return; var holidays = holidayText.Split(['\r', '\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(value => DateOnly.TryParse(value, out var date) ? date : (DateOnly?)null).Where(x => x.HasValue).Select(x => x!.Value).ToArray(); isBusy = true; errorMessage = null; try { await SupportApiClient.SaveSlaCalendarAsync(companyId, new(calendarTimeZone, workdayStart, workdayEnd, workingDays.OrderBy(x => x).ToArray(), holidays)); } catch (SupportApiException ex) { errorMessage = ex.Message; } finally { isBusy = false; } }
    private void ToggleWorkingDay(DayOfWeek day, bool enabled) { if (enabled) workingDays.Add(day); else workingDays.Remove(day); }
    private void Edit(SupportSlaPolicyDto policy) { editingId = policy.Id; name = policy.Name; category = policy.Category; priority = policy.Priority; customerTier = policy.CustomerTier; firstResponseMinutes = policy.FirstResponseMinutes; resolutionMinutes = policy.ResolutionMinutes; timeBasis = policy.TimeBasis; riskThresholdMinutes = policy.RiskThresholdMinutes; escalationRecipientRole = policy.EscalationRecipientRole; }
}
