@page "/app/sales/contacts/{ContactId:guid}"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["CustomerProfile"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@(profile?.ContactName ?? SalesText["CustomerProfile"])</h1>
            <p>@SalesText["CustomerProfileDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a href="@BuildPath("/app/sales/leads")">@SalesText["Leads"]</a>
                <a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
                <a href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
        </header>

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingCustomerProfile"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["CustomerProfileUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else if (profile is not null)
        {
            <section class="sales-detail-hero">
                <div>
                    <span class="sales-badge sales-badge--active">@EngagementBand(profile.EngagementScore)</span>
                    <h2>@profile.ContactName</h2>
                    <p>@profile.ContactEmail - @(profile.CustomerCompanyName ?? SalesText["NoCompanyLinked"])</p>
                </div>
                <div class="sales-detail-hero__value">
                    <span>@SalesText["EngagementScore"]</span>
                    <strong>@Score(profile.EngagementScore)</strong>
                </div>
            </section>

            <section class="sales-card">
                <div class="sales-section-heading">
                    <div>
                        <span>@SalesText["Memory"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                        <h2>@SalesText["RelationshipProfile"]</h2>
                    </div>
                    <span class="sales-badge">@SalesText["UpdatedAt", LocalDateTime.DateTime(profile.RefreshedUtc)]</span>
                </div>
                <div class="sales-memory-layout">
                    <div class="sales-score-card">
                        <span>@SalesText["EngagementScore"]</span>
                        <strong>@Score(profile.EngagementScore)</strong>
                        <small>@EngagementBand(profile.EngagementScore)</small>
                    </div>
                    <div class="sales-memory-copy">
                        <h3>@SalesText["AiSummary"]</h3>
                        <p>@EmptyText(profile.AiSummary, SalesText["NoAiSummary"])</p>
                        <h3>@SalesText["RelationshipMemory"]</h3>
                        <p>@EmptyText(profile.RelationshipMemory, SalesText["NoRelationshipMemory"])</p>
                        <h3>@SalesText["LastOutreach"]</h3>
                        <p>@(string.IsNullOrWhiteSpace(profile.LastOutreachSummary) ? SalesText["NoOutreach"] : profile.LastOutreachSummary)</p>
                    </div>
                </div>
            </section>

            <div class="sales-two-column sales-two-column--detail">
                <div class="sales-detail-stack">
                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Interactions"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["HistoricalInteractions"]</h2>
                            </div>
                        </div>
                        @if (profile.PastConversations.Count == 0)
                        {
                            <div class="sales-empty">@SalesText["NoInteractions"]</div>
                        }
                        else
                        {
                            <div class="sales-timeline">
                                @foreach (var item in profile.PastConversations)
                                {
                                    <div class="sales-timeline-row">
                                        <span></span>
                                        <div>
                                            <strong>@item.Summary</strong>
                                            <small>@PlainLabel(item.SourceType) - @LocalDateTime.DateTime(item.OccurredUtc)</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Deals"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["PastDeals"]</h2>
                            </div>
                        </div>
                        @if (profile.PreviousDeals.Count == 0)
                        {
                            <div class="sales-empty">@SalesText["NoPriorDeals"]</div>
                        }
                        else
                        {
                            <div class="sales-list">
                                @foreach (var deal in profile.PreviousDeals)
                                {
                                    <a class="sales-list-row sales-list-row--button" href="@BuildPath($"/app/sales/deals/{deal.DealId:D}")">
                                        <div>
                                            <strong>@deal.Title</strong>
                                            <span>@deal.Summary</span>
                                        </div>
                                        <div class="sales-list-row__meta">
                                            <span class="@BadgeClass(deal.Status)">@SalesStatusPresenter.Present(deal.Status, SalesText)</span>
                                            <strong>@Money(deal.Amount, deal.Currency)</strong>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                </div>

                <aside class="sales-detail-stack">
                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Signals"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["Preferences"]</h2>
                            </div>
                        </div>
                        <SignalList Items="@profile.Preferences" EmptyText="@SalesText["NoPreferences"]" />
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Signals"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["PriceSensitivity"]</h2>
                            </div>
                        </div>
                        <SignalList Items="@profile.PriceSensitivityIndicators" EmptyText="@SalesText["NoPriceSensitivity"]" />
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Signals"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["IndustrySignals"]</h2>
                            </div>
                        </div>
                        <SignalList Items="@profile.IndustrySignals" EmptyText="@SalesText["NoIndustrySignals"]" />
                    </section>
                </aside>
            </div>
        }
    </main>

    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    [Parameter] public Guid ContactId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private CustomerMemoryContext? profile;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            profile = await SalesApiClient.GetContactProfileAsync(ResolvedCompanyId!.Value, ContactId);
            if (profile is null)
            {
                errorMessage = SalesText["ContactNotFound"];
            }

            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private static string Score(decimal score) => string.Create(CultureInfo.CurrentCulture, $"{score:0.#}/100");
    private string EngagementBand(decimal score) => score >= 75m ? SalesText["StrongEngagement"] : score >= 45m ? SalesText["ModerateEngagement"] : SalesText["LightEngagement"];
    private static string EmptyText(string? value, string emptyText) => string.IsNullOrWhiteSpace(value) ? emptyText : value;
    private static string Money(decimal value, string currency) => string.Create(CultureInfo.CurrentCulture, $"{value:N0} {currency}");
    private static string PlainLabel(string value) => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace("_", " ", StringComparison.Ordinal).Replace("-", " ", StringComparison.Ordinal));
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";

    private sealed partial class SignalList : ComponentBase
    {
        [Parameter] public IReadOnlyList<CustomerMemorySignal> Items { get; set; } = [];
        [Parameter] public string EmptyText { get; set; } = "No signals recorded yet.";
        [Inject] public INumberFormatter LocalNumber { get; set; } = default!;
        [Inject] public ILocalDateTimeFormatter LocalDateTime { get; set; } = default!;

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            var sequence = 0;
            if (Items.Count == 0)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "sales-empty sales-empty--compact");
                builder.AddContent(sequence++, EmptyText);
                builder.CloseElement();
                return;
            }

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "sales-signal-list");
            foreach (var signal in Items)
            {
                builder.OpenElement(sequence++, "div");
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, PlainLabel(signal.Key));
                builder.CloseElement();
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, signal.Value);
                builder.CloseElement();
                builder.OpenElement(sequence++, "small");
                builder.AddContent(sequence++, $"{LocalNumber.Percentage(signal.Confidence, 0)} confidence - {LocalDateTime.DateTime(signal.ObservedUtc)}");
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    }
}
