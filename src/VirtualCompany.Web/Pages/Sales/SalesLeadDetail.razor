    private async Task RunActionAsync(Func<Guid, Guid, Task<SalesLeadDetailResponse>> action)
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        isBusy = true;
        actionMessage = null;
        try { lead = await action(companyId, LeadId); actionMessage = "Lead updated."; await RefreshAgentPanelAsync(); }
        catch (SalesApiException ex) { actionMessage = ex.Message; }
        finally { isBusy = false; }
    }

    private RenderFragment MessageMetadata(SalesLeadSourceEmailResponse email) => @<dl class="sales-message-metadata">
        <div><dt>From</dt><dd>@Sender(email)</dd></div>
        <div><dt>To</dt><dd>@(email.Recipients.Count == 0 ? "Not available" : string.Join(", ", email.Recipients))</dd></div>
        <div><dt>Received</dt><dd>@ReceivedLabel(email)</dd></div>
        <div><dt>Message ID</dt><dd>@(email.InternetMessageId ?? email.ProviderMessageId)</dd></div>
    </dl>;

    private string LeadsPath => ResolvedCompanyId is Guid companyId ? $"/app/sales/prospects?companyId={companyId:D}" : "/app/sales/prospects";
    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private string Confidence(decimal? confidence) => confidence.HasValue ? LocalNumber.Percentage(confidence.Value) : "Not scored";
    private string MoneyOrDash(decimal? value, string? currency) => value.HasValue ? LocalMoney.Format(value.Value, currency ?? "USD") : "Not estimated";
    private string ReceivedLabel(SalesLeadSourceEmailResponse? email) => email?.ReceivedUtc is DateTime received ? LocalDateTime.DateTime(received) : "Time unavailable";
    private static string Plain(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value.Replace('_', ' ');
    private static string Sender(SalesLeadSourceEmailResponse email) => string.IsNullOrWhiteSpace(email.SenderName) ? email.SenderEmail ?? "Sender unavailable" : $"{email.SenderName} <{email.SenderEmail}>";
    private static string BadgeClass(string status) => $"sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";
    private static string FriendlyStatus(string status) => string.Equals(status, "NotQualified", StringComparison.OrdinalIgnoreCase) ? "Not qualified" : Plain(status, "Open");
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string DisplayBody(SalesLeadSourceEmailResponse email)
    {
        var body = email.PlainTextBody?.Trim();
        if (string.IsNullOrWhiteSpace(body)) return "This email has no readable plain-text content.";
        var match = QuotedReplyPattern().Match(body);
        return (match.Success ? body[..match.Index] : body).Trim();
    }

    private static bool HasQuotedHistory(SalesLeadSourceEmailResponse email) =>
        !string.IsNullOrWhiteSpace(email.PlainTextBody) && QuotedReplyPattern().IsMatch(email.PlainTextBody);

    private static string QuotedHistory(SalesLeadSourceEmailResponse email)
    {
        var body = email.PlainTextBody ?? string.Empty;
        var match = QuotedReplyPattern().Match(body);
        return match.Success ? body[match.Index..].Trim() : string.Empty;
    }

    private static Regex QuotedReplyPattern() => new(@"(?:\r?\n|\s)On\s+(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)[^\r\n]{0,180}?wrote:\s*", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
}
