    {
        var operation = change.Operation.Equals("cancel", StringComparison.OrdinalIgnoreCase) ? "Cancellation" : "Reschedule";
        return change.Status.ToLowerInvariant() switch
        {
            "waiting_for_approval" => $"{operation} awaiting approval",
            "queued" => $"{operation} approved",
            "executing" => $"{operation} in progress",
            "completed" => $"{operation} completed",
            "reconciliation_required" => $"{operation} needs review",
            "failed" => $"{operation} failed",
            "rejected" => $"{operation} not approved",
            _ => operation
        };
    }

