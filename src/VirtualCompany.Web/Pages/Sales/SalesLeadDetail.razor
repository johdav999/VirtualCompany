    private (DateTime StartsUtc, DateTime EndsUtc) BuildMeetingTime()
    {
        if (meetingDate is null || meetingTime is null)
            throw new FormatException("Choose a valid meeting date and start time.");
        var time = meetingTime.Value.ToTimeSpan();
        var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
        var local = DateTime.SpecifyKind(meetingDate.Value.Date.Add(time), DateTimeKind.Unspecified);
        if (zone.IsInvalidTime(local)) throw new FormatException("This time does not exist because of a daylight-saving change.");
        var startsUtc = TimeZoneInfo.ConvertTimeToUtc(local, zone);
        return (startsUtc, startsUtc.AddMinutes(meetingDurationMinutes));
    }

    private void SelectSuggestedSlot(CalendarAvailableSlot slot)
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
        var localStart = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(slot.StartsUtc, DateTimeKind.Utc), zone);
        meetingDate = localStart.Date;
        meetingTime = TimeOnly.FromDateTime(localStart);
        meetingDurationMinutes = Math.Max(15, (int)(slot.EndsUtc - slot.StartsUtc).TotalMinutes);
        actionMessage = $"Selected {localStart:dddd, MMMM d} at {localStart:HH:mm}.";
    }

    private string SuggestedSlotDay(CalendarAvailableSlot slot)
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(slot.StartsUtc, DateTimeKind.Utc), zone).ToString("ddd, MMM d");
    }

    private string SuggestedSlotTime(CalendarAvailableSlot slot)
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
        var start = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(slot.StartsUtc, DateTimeKind.Utc), zone);
        var end = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(slot.EndsUtc, DateTimeKind.Utc), zone);
        return $"{start:HH:mm}–{end:HH:mm}";
    }
    private string BusyWindowLabel(CalendarBusyWindow window)
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
        var start = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(window.StartsUtc, DateTimeKind.Utc), zone);
        var end = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(window.EndsUtc, DateTimeKind.Utc), zone);
        return $"{start:HH:mm}–{end:HH:mm} busy";
    }

    private string MeetingDateLabel(SalesMeetingInvitationResponse invitation)
    {
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(invitation.TimeZoneId);
            var start = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(invitation.StartsUtc, DateTimeKind.Utc), zone);
            var end = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(invitation.EndsUtc, DateTimeKind.Utc), zone);
            return $"{start:ddd, MMM d · HH:mm}–{end:HH:mm}";
        }
        catch (TimeZoneNotFoundException)
        {
            return LocalDateTime.DateTime(invitation.StartsUtc);
        }
    }

