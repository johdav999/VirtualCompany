    private bool IsOpen => string.Equals(lead?.Status, "Open", StringComparison.OrdinalIgnoreCase);
    private bool IsConverted => string.Equals(lead?.Status, "Converted", StringComparison.OrdinalIgnoreCase);
    private bool CanSchedule => IsQualified || IsConverted;
