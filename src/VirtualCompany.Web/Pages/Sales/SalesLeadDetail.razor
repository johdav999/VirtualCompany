    private string OnlineMeetingLabel => SelectedCalendar?.Provider.ToLowerInvariant() switch
    {
        "gmail" => "Google Meet",
        "microsoft365" => "Microsoft Teams",
        _ => "Provider meeting link"
    };
    private string AvailabilitySummary => suggestedSlots.Count > 0
        ? $"{suggestedSlots.Count} suitable time{(suggestedSlots.Count == 1 ? "" : "s")} found over the next {availabilityDays} days."
        : busyWindows.Count == 0
            ? $"Find suitable times from the host's calendar over the next {availabilityDays} days."
            : "No suitable business-hour slot was found in the selected range.";
    private string AssessmentSummary => PrimaryEmail?.Confidence switch
    {
        >= 0.8m => "Strong buying intent with clear interest and a concrete next step.",
        >= 0.6m => "Positive buying signals are present, but the lead still needs review.",
        _ => "Alex found sales intent that should be reviewed by a person."
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync()) { errorMessage = ShellErrorMessage; return; }
            var companyId = ResolvedCompanyId!.Value;
            var leadTask = SalesApiClient.GetLeadAsync(companyId, LeadId);
            var emailTask = SalesApiClient.ListLeadSourceEmailsAsync(companyId, LeadId);
            var dashboardTask = SalesApiClient.GetDashboardAsync(companyId);
            var calendarsTask = SalesApiClient.ListCalendarConnectionsAsync(companyId);
            var invitationsTask = SalesApiClient.ListMeetingInvitationsAsync(companyId, LeadId);
            await Task.WhenAll(leadTask, emailTask, dashboardTask, calendarsTask, invitationsTask);
            lead = await leadTask;
            sourceEmails = await emailTask;
            AgentPanelDashboard = await dashboardTask;
            calendarConnections = await calendarsTask;
            meetingInvitations = await invitationsTask;
            meetingChanges = (await Task.WhenAll(meetingInvitations.Select(x => SalesApiClient.ListMeetingChangesAsync(companyId, x.Id))))
                .SelectMany(x => x).OrderByDescending(x => x.CreatedUtc).ToArray();
            selectedCalendarId ??= calendarConnections.FirstOrDefault(x => !x.RequiresReconnect)?.Id ?? calendarConnections.FirstOrDefault()?.Id;
            if (OpenMeetingScheduler && CanSchedule) ShowMeetingForm();
        }
        catch (SalesApiException ex) { errorMessage = ex.Message; AgentPanelErrorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private async Task QualifyAsync() => await RunActionAsync((companyId, id) => SalesApiClient.QualifyLeadAsync(companyId, id, "Qualified from the lead detail view."));
    private async Task RejectAsync() => await RunActionAsync((companyId, id) => SalesApiClient.RejectLeadAsync(companyId, id, "Marked not qualified from the lead detail view."));

    private void ShowCreateDealForm()
    {
        if (!IsQualified || lead is null) return;
        dealAmount = lead.EstimatedValue is > 0 ? lead.EstimatedValue.Value : 1000m;
        dealCurrency = string.IsNullOrWhiteSpace(lead.Currency) ? "USD" : lead.Currency;
        dealExpectedCloseDate = DateTime.Today.AddDays(30);
        actionMessage = null;
        showCreateDealForm = true;
    }

    private void CancelCreateDeal()
    {
        showCreateDealForm = false;
        actionMessage = null;
    }

    private async Task CreateDealAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || !IsQualified) return;
        if (dealAmount <= 0)
        {
            actionMessage = "Enter a deal value greater than zero.";
            return;
        }

        var currency = dealCurrency.Trim().ToUpperInvariant();
        if (currency.Length != 3)
        {
            actionMessage = "Enter a three-letter currency code, such as USD or EUR.";
            return;
        }

        if (dealExpectedCloseDate is null)
        {
            actionMessage = "Choose an expected close date.";
            return;
        }

        isBusy = true;
        actionMessage = null;
        try
        {
            var expectedCloseUtc = DateTime.SpecifyKind(dealExpectedCloseDate.Value.Date, DateTimeKind.Utc);
            var deal = await SalesApiClient.ConvertLeadAsync(companyId, LeadId, new ConvertLeadRequest(dealAmount, currency, expectedCloseUtc, "Created from the qualified lead detail view."));
            Navigation.NavigateTo(BuildPath($"/app/sales/deals/{deal.Id:D}"));
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowMeetingForm()
    {
        if (!CanSchedule || lead is null) return;
        meetingDate ??= DateTime.Today.AddDays(1);
        meetingTitle = string.IsNullOrWhiteSpace(meetingTitle) ? $"Virtual Company demo · {lead.CustomerCompanyName ?? lead.ContactName ?? "Sales conversation"}" : meetingTitle;
        meetingDescription = string.IsNullOrWhiteSpace(meetingDescription)
            ? "Product overview\nQuestions and requirements\nRecommended next steps"
            : meetingDescription;
        selectedCalendarId ??= calendarConnections.FirstOrDefault(x => !x.RequiresReconnect)?.Id ?? calendarConnections.FirstOrDefault()?.Id;
        busyWindows = [];
        suggestedSlots = [];
        actionMessage = null;
        showMeetingForm = true;
    }

    private void CancelMeetingForm()
    {
        showMeetingForm = false;
        busyWindows = [];
        suggestedSlots = [];
        actionMessage = null;
    }

    private async Task CheckAvailabilityAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || selectedCalendarId is not Guid connectionId || meetingDate is null) return;
        var connection = SelectedCalendar;
        if (connection?.RequiresReconnect == true)
        {
            actionMessage = "Reconnect this account and grant calendar access before checking availability.";
            return;
        }

        isCheckingAvailability = true;
        actionMessage = null;
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(meetingTimeZoneId);
            var localStart = DateTime.SpecifyKind(meetingDate.Value.Date, DateTimeKind.Unspecified);
            var fromUtc = TimeZoneInfo.ConvertTimeToUtc(localStart, zone);
            var result = await SalesApiClient.GetCalendarAvailabilityAsync(
                companyId,
                new SalesMeetingAvailabilityRequest(
                    connectionId, fromUtc, fromUtc.AddDays(availabilityDays),
                    meetingTimeZoneId, meetingDurationMinutes));
            busyWindows = result.BusyWindows;
            suggestedSlots = result.SuggestedSlots;
        }
        catch (Exception ex) when (ex is SalesApiException or TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isCheckingAvailability = false;
        }
    }

    private async Task SubmitMeetingForApprovalAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || selectedCalendarId is not Guid connectionId || meetingDate is null) return;
        if (SelectedCalendar?.RequiresReconnect == true)
        {
            actionMessage = "Reconnect this account and grant calendar access before scheduling.";
            return;
        }

        isBusy = true;
        actionMessage = null;
        try
        {
            var (startsUtc, endsUtc) = BuildMeetingTime();
            var invitation = await SalesApiClient.CreateMeetingInvitationAsync(
                companyId,
                LeadId,
                new CreateSalesMeetingInvitationRequest(
                    connectionId,
                    startsUtc,
                    endsUtc,
                    meetingTimeZoneId,
                    meetingTitle,
                    meetingDescription,
                    meetingLocation,
                    createOnlineMeeting));
            meetingInvitations = [invitation, .. meetingInvitations.Where(x => x.Id != invitation.Id)];
            showMeetingForm = false;
            busyWindows = [];
            actionMessage = "Meeting invitation submitted for approval.";
        }
        catch (Exception ex) when (ex is SalesApiException or FormatException or TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowRescheduleForm(SalesMeetingInvitationResponse invitation)
    {
        if (HasOpenMeetingChange(invitation.Id))
        {
            actionMessage = "This meeting already has a change awaiting completion.";
            return;
        }

        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(invitation.TimeZoneId);
            var localStart = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(invitation.StartsUtc, DateTimeKind.Utc), zone);
            changeDate = localStart.Date;
            changeTime = TimeOnly.FromDateTime(localStart);
        }
        catch (TimeZoneNotFoundException)
        {
            changeDate = invitation.StartsUtc.Date;
            changeTime = TimeOnly.FromDateTime(invitation.StartsUtc);
        }
        changeDurationMinutes = Math.Max(1, (int)(invitation.EndsUtc - invitation.StartsUtc).TotalMinutes);
        changeTimeZoneId = invitation.TimeZoneId;
        changeTitle = invitation.Title;
        changeDescription = invitation.Description;
        changeLocation = invitation.Location;
        changeCreateOnlineMeeting = invitation.CreateOnlineMeeting;
        changingInvitationId = invitation.Id;
        changeOperation = "reschedule";
        changeFormKey = Guid.NewGuid();
        actionMessage = null;
    }

    private void ShowCancellationConfirmation(SalesMeetingInvitationResponse invitation)
    {
        if (HasOpenMeetingChange(invitation.Id))
        {
            actionMessage = "This meeting already has a change awaiting completion.";
            return;
        }
        changingInvitationId = invitation.Id;
        changeOperation = "cancel";
        changeFormKey = Guid.NewGuid();
        actionMessage = null;
    }

    private void CloseMeetingChangeForm()
    {
        changingInvitationId = null;
        changeOperation = null;
    }

    private async Task SubmitMeetingChangeAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || changingInvitationId is not Guid invitationId || string.IsNullOrWhiteSpace(changeOperation)) return;
        isBusy = true;
        actionMessage = null;
        try
        {
            SalesMeetingChangeRequestResponse change;
            if (changeOperation == "cancel")
            {
                change = await SalesApiClient.RequestMeetingCancellationAsync(companyId, invitationId);
            }
            else
            {
                var (startsUtc, endsUtc) = BuildChangeMeetingTime();
                change = await SalesApiClient.RequestMeetingRescheduleAsync(companyId, invitationId,
                    new CreateSalesMeetingRescheduleRequest(startsUtc, endsUtc, changeTimeZoneId, changeTitle, changeDescription, changeLocation, changeCreateOnlineMeeting));
            }
            meetingChanges = [change, .. meetingChanges.Where(x => x.Id != change.Id)];
            CloseMeetingChangeForm();
            actionMessage = change.Operation.Equals("cancel", StringComparison.OrdinalIgnoreCase)
                ? "Meeting cancellation submitted for approval."
                : "Meeting reschedule submitted for approval.";
        }
        catch (Exception ex) when (ex is SalesApiException or FormatException or TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            actionMessage = ex.Message;
        }
        finally { isBusy = false; }
    }

    private (DateTime StartsUtc, DateTime EndsUtc) BuildChangeMeetingTime()
    {
        if (changeDate is null || changeTime is null) throw new FormatException("Choose a valid meeting date and start time.");
        var zone = TimeZoneInfo.FindSystemTimeZoneById(changeTimeZoneId);
        var local = DateTime.SpecifyKind(changeDate.Value.Date.Add(changeTime.Value.ToTimeSpan()), DateTimeKind.Unspecified);
        if (zone.IsInvalidTime(local)) throw new FormatException("This time does not exist because of a daylight-saving change.");
        var startsUtc = TimeZoneInfo.ConvertTimeToUtc(local, zone);
        return (startsUtc, startsUtc.AddMinutes(changeDurationMinutes));
    }

    private SalesMeetingChangeRequestResponse? LatestMeetingChange(Guid invitationId) =>
        meetingChanges.Where(x => x.InvitationId == invitationId).OrderByDescending(x => x.CreatedUtc).FirstOrDefault();

    private bool HasOpenMeetingChange(Guid invitationId) => meetingChanges.Any(x => x.InvitationId == invitationId &&
        x.Status is not ("completed" or "rejected"));

