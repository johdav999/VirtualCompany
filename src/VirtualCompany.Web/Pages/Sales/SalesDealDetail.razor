@page "/app/sales/deals/{DealId:guid}"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["DealDetails"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@(deal?.Title ?? SalesText["DealDetails"])</h1>
            <p>@SalesText["DealDetailsDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a href="@BuildPath("/app/sales/prospects")">@SalesText["Prospects"]</a>
                <a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
            </nav>
        </header>

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingDeal"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["DealUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else if (deal is not null)
        {
            <section class="sales-detail-hero">
                <div>
                    <span class="@BadgeClass(deal.Status)">@SalesStatusPresenter.Present(deal.Status, SalesText)</span>
                    <h2>@deal.Title</h2>
                    <p>@deal.Summary</p>
                </div>
                <div class="sales-detail-hero__value">
                    <span>@deal.StageName</span>
                    <strong>@Money(deal.Amount, deal.Currency)</strong>
                    @if (deal.SourceLeadId is Guid sourceLeadId)
                    {
                        <a class="sales-button" href="@BuildMeetingPath(sourceLeadId)"><span class="bi bi-calendar-event" aria-hidden="true"></span>Schedule demo</a>
                    }
                </div>
            </section>

            <div class="sales-two-column sales-two-column--detail">
                <div class="sales-detail-stack">
                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Contact"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["WhoThisInvolves"]</h2>
                            </div>
                        </div>
                        <dl class="sales-definition-list">
                            <div>
                                <dt>@SalesText["Contact"]</dt>
                                <dd>
                                    @if (deal.CustomerMemory is not null)
                                    {
                                        <a class="sales-inline-link" href="@BuildContactProfilePath(deal.CustomerMemory.ContactId)">@deal.CustomerMemory.ContactName</a>
                                    }
                                    else
                                    {
                                        @(deal.ContactName ?? SalesText["NoContactLinked"])
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt>@SalesText["Email"]</dt>
                                <dd>@(deal.ContactEmail ?? SalesText["NoEmailLinked"])</dd>
                            </div>
                            <div>
                                <dt>@SalesText["Company"]</dt>
                                <dd>@(deal.CustomerCompanyName ?? SalesText["NoCompanyLinked"])</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["CustomerMemory"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["RelationshipProfile"]</h2>
                            </div>
                            @if (deal.CustomerMemory is not null)
                            {
                                <a class="sales-button sales-button--small" href="@BuildContactProfilePath(deal.CustomerMemory.ContactId)">@SalesText["OpenProfile"]</a>
                            }
                        </div>
                        @if (deal.CustomerMemory is null)
                        {
                            <div class="sales-empty">@SalesText["NoCustomerMemory"]</div>
                        }
                        else
                        {
                            <div class="sales-memory-layout">
                                <div class="sales-score-card">
                                    <span>@SalesText["EngagementScore"]</span>
                                    <strong>@Score(deal.CustomerMemory.EngagementScore)</strong>
                                    <small>@EngagementBand(deal.CustomerMemory.EngagementScore) · updated @LocalDateTime.DateTime(deal.CustomerMemory.RefreshedUtc)</small>
                                </div>
                                <div class="sales-memory-copy">
                                    <h3>@SalesText["AiSummary"]</h3>
                                    <p>@EmptyText(deal.CustomerMemory.AiSummary, SalesText["NoAiSummary"])</p>
                                    <h3>@SalesText["RelationshipMemory"]</h3>
                                    <p>@EmptyText(deal.CustomerMemory.RelationshipMemory, SalesText["NoRelationshipMemory"])</p>
                                    @if (!string.IsNullOrWhiteSpace(deal.CustomerMemory.LastOutreachSummary))
                                    {
                                        <h3>@SalesText["LastOutreach"]</h3>
                                        <p>@deal.CustomerMemory.LastOutreachSummary</p>
                                    }
                                </div>
                            </div>

                            <div class="sales-memory-signal-grid">
                                <section>
                                    <h3>@SalesText["Preferences"]</h3>
                                    @if (deal.CustomerMemory.Preferences.Count == 0)
                                    {
                                        <div class="sales-empty sales-empty--compact">@SalesText["NoPreferences"]</div>
                                    }
                                    else
                                    {
                                        <div class="sales-signal-list">
                                            @foreach (var signal in deal.CustomerMemory.Preferences.Take(4))
                                            {
                                                <div>
                                                    <strong>@PlainLabel(signal.Key)</strong>
                                                    <span>@signal.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                                <section>
                                    <h3>@SalesText["PriceSensitivity"]</h3>
                                    @if (deal.CustomerMemory.PriceSensitivityIndicators.Count == 0)
                                    {
                                        <div class="sales-empty sales-empty--compact">@SalesText["NoPriceSensitivity"]</div>
                                    }
                                    else
                                    {
                                        <div class="sales-signal-list">
                                            @foreach (var signal in deal.CustomerMemory.PriceSensitivityIndicators.Take(4))
                                            {
                                                <div>
                                                    <strong>@PlainLabel(signal.Key)</strong>
                                                    <span>@signal.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                                <section>
                                    <h3>@SalesText["IndustrySignals"]</h3>
                                    @if (deal.CustomerMemory.IndustrySignals.Count == 0)
                                    {
                                        <div class="sales-empty sales-empty--compact">@SalesText["NoIndustrySignals"]</div>
                                    }
                                    else
                                    {
                                        <div class="sales-signal-list">
                                            @foreach (var signal in deal.CustomerMemory.IndustrySignals.Take(4))
                                            {
                                                <div>
                                                    <strong>@PlainLabel(signal.Key)</strong>
                                                    <span>@signal.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                            </div>
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["EmailTimeline"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["ConversationHistory"]</h2>
                            </div>
                        </div>
                        @if (dealEmails.Count == 0)
                        {
                            <div class="sales-empty">@SalesText["NoLinkedEmails"]</div>
                        }
                        else
                        {
                            <EmailTimeline Items="@dealEmails" />
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Activity"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["DealTimeline"]</h2>
                            </div>
                        </div>
                        @if (deal.Activities.Count == 0)
                        {
                            <div class="sales-empty">@SalesText["NoActivity"]</div>
                        }
                        else
                        {
                            <Timeline Items="@deal.Activities" />
                        }
                    </section>
                </div>

                <aside class="sales-detail-stack">
                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["AlexAnalysis"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["WhatThisMeans"]</h2>
                            </div>
                        </div>
                        <p>@deal.AgentAnalysis</p>
                        @if (intelligenceBrief is not null)
                        {
                            <dl class="sales-definition-list mt-3">
                                @foreach (var fact in intelligenceBrief.ConfirmedFacts.Take(8))
                                {
                                    <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div>
                                }
                            </dl>
                            @if (intelligenceBrief.QualificationGaps.Count > 0)
                            {
                                <h3 class="h6 mt-3">@SalesText["QualificationGaps"]</h3>
                                <ul class="mb-0">
                                    @foreach (var gap in intelligenceBrief.QualificationGaps)
                                    {
                                        <li>@gap</li>
                                    }
                                </ul>
                            }
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["DealStrategy"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["RiskRecoveryPlan"]</h2>
                            </div>
                            <button class="sales-button sales-button--small" disabled="@(isSubmitting || salesAgentId is null)" @onclick="RefreshDecisionAdviceAsync">@(dealStrategy is null ? SalesText["Analyze"] : SalesText["Refresh"])</button>
                        </div>
                        @if (salesAgentId is null)
                        {
                            <div class="sales-empty sales-empty--compact">@SalesText["NoSalesAgent"]</div>
                        }
                        else if (dealStrategy is null)
                        {
                            <div class="sales-empty sales-empty--compact">@SalesText["RunDealAnalysis"]</div>
                        }
                        else if (dealStrategy is not null)
                        {
                            <div class="sales-list">
                                <div class="sales-list-row">
                                    <div><strong>@PlainLabel(dealStrategy.RiskBand) risk</strong><span>@(dealStrategy.RiskScore.HasValue ? $"Score {dealStrategy.RiskScore:0.#}" : "Risk score unavailable")</span></div>
                                    @if (dealStrategy.RequiresReview)
                                    {
                                        <span class="sales-badge sales-badge--warning">@SalesText["Review"]</span>
                                    }
                                </div>
                                @foreach (var step in dealStrategy.RecoveryPlan.OrderBy(x => x.Order))
                                {
                                    <div class="sales-list-row">
                                        <div><strong>@step.Milestone</strong><span>@step.Owner@(step.DueUtc.HasValue ? $" | {LocalDateTime.DateTime(step.DueUtc.Value)}" : string.Empty)</span></div>
                                        <span class="@BadgeClass(step.Status)">@SalesStatusPresenter.Present(step.Status, SalesText)</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["ProposalCheck"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["ClaimsPricingTerms"]</h2>
                            </div>
                        </div>
                        @if (proposalAdvice is not null)
                        {
                            @foreach (var validation in proposalAdvice.Validations)
                            {
                                <div class="sales-list-row">
                                    <div><strong>@PlainLabel(validation.Code)</strong><span>@validation.Message</span></div>
                                    <span class="@BadgeClass(validation.Status)">@SalesStatusPresenter.Present(validation.Status, SalesText)</span>
                                </div>
                            }
                            @if (proposalAdvice.PricingApprovalRequired || proposalAdvice.TermsApprovalRequired)
                            {
                                <div class="sales-empty sales-empty--compact">@SalesText["ApprovalRequiredPricing"]</div>
                            }
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["SuggestedReply"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["DraftResponse"]</h2>
                            </div>
                        </div>
                        @if (string.IsNullOrWhiteSpace(deal.SuggestedReply))
                        {
                            <div class="sales-empty">@SalesText["NoClosedReply"]</div>
                        }
                        else
                        {
                            <p class="sales-suggested-reply">@deal.SuggestedReply</p>
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["NextActions"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["FollowUpActions"]</h2>
                            </div>
                        </div>
                        <div class="sales-actions sales-actions--stacked">
                            <button class="sales-button sales-button--primary" disabled="@isSubmitting" @onclick="MarkWonAsync">@SalesText["MarkWon"]</button>
                            <button class="sales-button" disabled="@isSubmitting" @onclick="MarkLostAsync">@SalesText["MarkLost"]</button>
                        </div>
                        @if (financeHandoff is not null)
                        {
                            <div class="sales-finance-handoff">
                                <span class="@BadgeClass(financeHandoff.Status)">@SalesStatusPresenter.Present(financeHandoff.Status, SalesText)</span>
                                <strong>@financeHandoff.DocumentType draft in @financeHandoff.ExternalSystem</strong>
                                <p>@financeHandoff.Summary</p>
                                @if (!string.IsNullOrWhiteSpace(financeHandoff.ExternalDocumentNumber) || !string.IsNullOrWhiteSpace(financeHandoff.ExternalDocumentId))
                                {
                                    <small>@SalesText["DraftReference", financeHandoff.ExternalDocumentNumber ?? financeHandoff.ExternalDocumentId ?? string.Empty]</small>
                                }
                                else if (financeHandoff.ApprovalStatus == "Waiting for approval")
                                {
                                    <small>@SalesText["LauraWaitingApproval"]</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(financeHandoff.FailureSummary))
                                {
                                    <p class="sales-error-text">@financeHandoff.FailureSummary</p>
                                }
                                <div class="sales-actions">
                                    @if (financeHandoff.ApprovalStatus == "Waiting for approval")
                                    {
                                        <button class="sales-button sales-button--primary" disabled="@isSubmitting" @onclick="ApproveFinanceHandoffAsync">@SalesText["ApproveFinanceDraft"]</button>
                                    }
                                    @if (financeHandoff.CanRetry)
                                    {
                                        <button class="sales-button" disabled="@isSubmitting" @onclick="RetryFinanceHandoffAsync">@SalesText["Retry"]</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(actionMessage))
                        {
                            <div class="sales-toast sales-toast--inline">@actionMessage</div>
                        }
                    </section>

                    <section class="sales-card">
                        <div class="sales-section-heading">
                            <div>
                                <span>@SalesText["Recommendations"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                <h2>@SalesText["AlexRecommendsHeading"]</h2>
                            </div>
                        </div>
                        @if (deal.Recommendations.Count == 0)
                        {
                            <div class="sales-empty">@SalesText["NoDealRecommendations"]</div>
                        }
                        else
                        {
                            <div class="sales-list">
                                @foreach (var recommendation in deal.Recommendations)
                                {
                                    <div class="sales-list-row">
                                        <div>
                                            <strong>@recommendation.Recommendation</strong>
                                            <span>@recommendation.Rationale</span>
                                        </div>
                                        <span class="@BadgeClass(recommendation.Status)">@SalesStatusPresenter.Present(recommendation.Status, SalesText)</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </aside>
            </div>
        }
    </main>

    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    [Parameter] public Guid DealId { get; set; }

    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? actionMessage;
    private SalesDealDetailResponse? deal;
    private IReadOnlyList<SalesEmailTimelineResponse> dealEmails = [];
    private SalesFinanceHandoffResponse? financeHandoff;
    private Guid? salesAgentId;
    private SalesDealStrategyResultViewModel? dealStrategy;
    private SalesProposalAdviceResultViewModel? proposalAdvice;
    private SalesIntelligenceBriefResultViewModel? intelligenceBrief;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            deal = await SalesApiClient.GetDealAsync(ResolvedCompanyId!.Value, DealId);
            dealEmails = await SalesApiClient.ListDealEmailsAsync(ResolvedCompanyId!.Value, DealId);
            financeHandoff = await SalesApiClient.GetFinanceHandoffAsync(ResolvedCompanyId!.Value, DealId);
            if (deal is null)
            {
                errorMessage = SalesText["DealNotFound"];
            }
            else
            {
                salesAgentId = await ResolveSalesAgentIdAsync(ResolvedCompanyId.Value);
            }

            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshDecisionAdviceAsync()
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            await LoadDecisionAdviceAsync(companyId);
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadDecisionAdviceAsync(Guid companyId)
    {
        if (salesAgentId is not Guid agentId)
        {
            dealStrategy = null;
            proposalAdvice = null;
            return;
        }

        dealStrategy = await SalesApiClient.AnalyzeDealStrategyAsync(companyId, agentId,
            new SalesDealStrategyRequestViewModel { DealId = DealId, Objective = "Assess current deal risk and propose a review-only recovery plan." });
        intelligenceBrief = await SalesApiClient.BuildIntelligenceBriefAsync(companyId, agentId,
            new SalesIntelligenceBriefRequestViewModel
            {
                DealId = DealId,
                Objective = "Summarize confirmed deal facts, qualification gaps, buying signals, and risks."
            });
        proposalAdvice = await SalesApiClient.AnalyzeProposalAsync(companyId, agentId,
            new SalesProposalAdviceRequestViewModel
            {
                DealId = DealId,
                RequestedPrice = deal?.Amount,
                Currency = deal?.Currency,
                Objective = "Validate proposal claims, pricing, and terms against approved company knowledge and policy."
            });
    }

    private async Task MarkWonAsync() => await RunDealActionAsync(async companyId => deal = await SalesApiClient.MarkWonAsync(companyId, DealId, "Marked won from the sales review screen."), "Deal marked won.");
    private async Task MarkLostAsync() => await RunDealActionAsync(async companyId => deal = await SalesApiClient.MarkLostAsync(companyId, DealId, "Marked lost from the sales review screen."), "Deal marked lost.");
    private async Task ApproveFinanceHandoffAsync() => await RunDealActionAsync(async companyId => financeHandoff = await SalesApiClient.ApproveFinanceHandoffAsync(companyId, DealId, "Approved from the deal review screen."), "Finance draft approved.");
    private async Task RetryFinanceHandoffAsync() => await RunDealActionAsync(async companyId => financeHandoff = await SalesApiClient.RetryFinanceHandoffAsync(companyId, DealId), "Finance draft retry started.");

    private async Task RunDealActionAsync(Func<Guid, Task> action, string successMessage)
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        isSubmitting = true;
        actionMessage = null;
        try
        {
            await action(companyId);
            await RefreshAgentPanelAsync();
            financeHandoff = await SalesApiClient.GetFinanceHandoffAsync(companyId, DealId);
            actionMessage = successMessage;
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private string BuildFinanceDocumentPath() => ResolvedCompanyId is Guid companyId ? $"/finance/invoices?companyId={companyId:D}&source=sales&dealId={DealId:D}" : "/finance/invoices";
    private string BuildMeetingPath(Guid leadId) => ResolvedCompanyId is Guid companyId ? $"/app/sales/leads/{leadId:D}?companyId={companyId:D}&schedule=true" : $"/app/sales/leads/{leadId:D}?schedule=true";
    private string BuildContactProfilePath(Guid contactId) => BuildPath($"/app/sales/contacts/{contactId:D}");
    private static string Score(decimal score) => string.Create(CultureInfo.CurrentCulture, $"{score:0.#}/100");
    private static string EngagementBand(decimal score) => score >= 75m ? "Strong engagement" : score >= 45m ? "Moderate engagement" : "Light engagement";
    private static string EmptyText(string? value, string emptyText) => string.IsNullOrWhiteSpace(value) ? emptyText : value;
    private static string PlainLabel(string value) => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace("_", " ", StringComparison.Ordinal).Replace("-", " ", StringComparison.Ordinal));
    private static string Money(decimal value, string currency) => string.Create(CultureInfo.CurrentCulture, $"{value:N0} {currency}");
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";

    private sealed partial class Timeline : ComponentBase
    {
        [Parameter] public IReadOnlyList<SalesActivityResponse> Items { get; set; } = [];
        [Inject] public ILocalDateTimeFormatter LocalDateTime { get; set; } = default!;

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            var sequence = 0;
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "sales-timeline");
            foreach (var item in Items)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "sales-timeline-row");
                builder.OpenElement(sequence++, "span");
                builder.CloseElement();
                builder.OpenElement(sequence++, "div");
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, item.Summary);
                builder.CloseElement();
                builder.OpenElement(sequence++, "small");
                builder.AddContent(sequence++, $"{item.ActivityType} | {LocalDateTime.DateTime(item.OccurredUtc)}");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    }

    private sealed partial class EmailTimeline : ComponentBase
    {
        [Parameter] public IReadOnlyList<SalesEmailTimelineResponse> Items { get; set; } = [];
        [Inject] public ILocalDateTimeFormatter LocalDateTime { get; set; } = default!;

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            var sequence = 0;
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "sales-timeline");
            foreach (var item in Items)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "sales-timeline-row");
                builder.OpenElement(sequence++, "span");
                builder.CloseElement();
                builder.OpenElement(sequence++, "div");
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, item.DetectedIntent ?? "Sales email");
                builder.CloseElement();
                builder.OpenElement(sequence++, "small");
                builder.AddContent(sequence++, $"{item.Status} - {LocalDateTime.DateTime(item.OccurredUtc)}");
                builder.CloseElement();
                if (!string.IsNullOrWhiteSpace(item.Rationale))
                {
                    builder.OpenElement(sequence++, "p");
                    builder.AddContent(sequence++, item.Rationale);
                    builder.CloseElement();
                }
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    }
}
