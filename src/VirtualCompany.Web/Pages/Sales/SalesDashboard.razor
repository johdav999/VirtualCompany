@page "/app/sales"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["Sales"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@SalesText["SalesReview"]</h1>
            <p>@SalesText["SalesReviewDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a class="active" href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a href="@BuildPath("/app/sales/leads")">@SalesText["Leads"]</a>
                <a href="@BuildPath("/app/sales/prospecting")">@SalesText["Prospecting"]</a>
                <a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
                <a href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
        </header>

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingSalesData"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["SalesUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else if (dashboard is not null)
        {
            <section class="sales-kpi-grid" aria-label="@SalesText["SalesKpis"]">
                <article class="sales-kpi-card">
                    <span>@SalesText["PipelineValue"]</span>
                    <strong>@Money(dashboard.PipelineValue, dashboard.Currency)</strong>
                    <small>@SalesText["OpenDealsActivePipeline"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["NewLeads"]</span>
                    <strong>@dashboard.NewLeads</strong>
                    <small>@SalesText["WaitingFirstReview"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["HotLeads"]</span>
                    <strong>@dashboard.HotLeads</strong>
                    <small>@SalesText["AlexSeesBuyingIntent"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["ForecastRevenue"]</span>
                    <strong>@Money(PrimaryForecastValue, PrimaryForecastCurrency)</strong>
                    <small>@SalesText["ExpectedNext30Days"]</small>
                </article>
            </section>

            <section class="sales-briefing-card">
                <div>
                    <span>@SalesText["TodaysBriefing"]</span>
                    <h2>@SalesText["DealsNeedFollowUp", dashboard.DealsNeedingAttention]</h2>
                    <p>
                        @if (dashboard.HotLeads > 0)
                        {
                            <text>@SalesText["HotLeadsReady", dashboard.HotLeads]</text>
                        }
                        @if (dashboard.AgentRecommendations.Count > 0)
                        {
                            <text>@SalesText["TopRecommendation", dashboard.AgentRecommendations[0].Recommendation]</text>
                        }
                        else
                        {
                            <text>@SalesText["NoUrgentRecommendation"]</text>
                        }
                    </p>
                </div>
                <div class="sales-actions">
                    <a class="sales-button sales-button--primary" href="@BuildPath("/app/sales/leads")">@SalesText["ReviewLeads"]</a>
                    <a class="sales-button" href="@BuildPath("/app/sales/pipeline")">@SalesText["OpenPipeline"]</a>
                </div>
            </section>

            <section class="sales-card">
                <div class="sales-section-heading">
                    <div>
                        <span>@SalesText["RevenueInsights"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                        <h2>@SalesText["ConversionAndForecast"]</h2>
                    </div>
                </div>
                @if (analytics is null && forecast is null)
                {
                    <div class="sales-empty">@SalesText["NotEnoughConversionData"]</div>
                }
                else
                {
                    <div class="sales-kpi-grid sales-kpi-grid--compact">
                        <article class="sales-kpi-card">
                            <span>@SalesText["ReplyRate"]</span>
                            <strong>@Percent(analytics?.Rates.ReplyRate ?? 0m)</strong>
                            <small>@SalesText["RepliesFromSent", analytics?.Funnel.Replied ?? 0, analytics?.Funnel.Sent ?? 0]</small>
                        </article>
                        <article class="sales-kpi-card">
                            <span>@SalesText["ConversionRate"]</span>
                            <strong>@Percent(analytics?.Rates.ConversionRate ?? 0m)</strong>
                            <small>@SalesText["ConvertedOpportunities", analytics?.Funnel.Converted ?? 0]</small>
                        </article>
                        <article class="sales-kpi-card">
                            <span>@SalesText["SixtyDayForecast"]</span>
                            <strong>@Money(ForecastValue(60), PrimaryForecastCurrency)</strong>
                            <small>@SalesText["RiskAdjustedRevenue"]</small>
                        </article>
                        <article class="sales-kpi-card">
                            <span>@SalesText["HighRiskDeals"]</span>
                            <strong>@(forecast?.RiskDistribution.High ?? 0)</strong>
                            <small>@SalesText["ReviewBeforeForecast"]</small>
                        </article>
                    </div>
                    <div class="sales-two-column sales-two-column--even">
                        <div class="sales-list">
                            <h3>@SalesText["CampaignPerformance"]</h3>
                            @if (analytics?.Campaigns.Count > 0)
                            {
                                @foreach (var campaign in analytics.Campaigns)
                                {
                                    <div class="sales-list-row">
                                        <div>
                                            <strong>@campaign.CampaignName</strong>
                                            <span>@SalesText["CampaignCounts", campaign.Counts.Sent, campaign.Counts.Replied, campaign.Counts.Converted]</span>
                                        </div>
                                        <span class="sales-badge sales-badge--active">@Percent(campaign.Rates.ReplyRate)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="sales-empty">@SalesText["NoCampaignSends"]</div>
                            }
                        </div>
                        <div class="sales-list">
                            <h3>@SalesText["MessageVariants"]</h3>
                            @if (analytics?.Variants.Count > 0)
                            {
                                @foreach (var variant in analytics.Variants)
                                {
                                    <div class="sales-list-row">
                                        <div>
                                            <strong>@variant.VariantKey</strong>
                                            <span>@SalesText["CampaignCounts", variant.Counts.Sent, variant.Counts.Replied, variant.Counts.Converted]</span>
                                        </div>
                                        <span class="sales-badge sales-badge--active">@Percent(variant.Rates.ConversionRate)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="sales-empty">@SalesText["NoVariantComparison"]</div>
                            }
                        </div>
                    </div>
                }
            </section>

            <div class="sales-two-column">
                <section class="sales-card">
                    <div class="sales-section-heading">
                        <div>
                            <span>@SalesText["AgentRecommendations"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@SalesText["WhatAlexRecommends"]</h2>
                        </div>
                    </div>
                    @if (dashboard.AgentRecommendations.Count == 0)
                    {
                        <div class="sales-empty">@SalesText["NoRecommendations"]</div>
                    }
                    else
                    {
                        <div class="sales-list">
                            @foreach (var recommendation in dashboard.AgentRecommendations)
                            {
                                <a class="sales-list-row" href="@RecommendationPath(recommendation)">
                                    <div>
                                        <strong>@recommendation.Recommendation</strong>
                                        <span>@recommendation.Rationale</span>
                                    </div>
                                    <span class="@BadgeClass(recommendation.Status)">@SalesStatusPresenter.Present(recommendation.Status, SalesText)</span>
                                </a>
                            }
                        </div>
                    }
                </section>

                <section class="sales-card">
                    <div class="sales-section-heading">
                        <div>
                            <span>@SalesText["RecentActivity"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@SalesText["LatestSalesMovement"]</h2>
                        </div>
                    </div>
                    @if (dashboard.RecentActivity.Count == 0)
                    {
                        <div class="sales-empty">@SalesText["NoSalesActivity"]</div>
                    }
                    else
                    {
                        <div class="sales-timeline">
                            @foreach (var item in dashboard.RecentActivity)
                            {
                                <a class="sales-timeline-row" href="@(item.DealId is Guid dealId ? BuildPath($"/app/sales/deals/{dealId:D}") : BuildPath("/app/sales/leads"))">
                                    <span></span>
                                    <div>
                                        <strong>@item.Summary</strong>
                                        <small>@SalesText["ActivityAt", item.ActivityType, LocalDateTime.DateTime(item.OccurredUtc)]</small>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </main>

    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@(AgentPanelDashboard ?? dashboard)" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private SalesDashboardResponse? dashboard;
    private SalesAnalyticsDashboardResponse? analytics;
    private RevenueForecastSnapshotResponse? forecast;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            dashboard = await SalesApiClient.GetDashboardAsync(ResolvedCompanyId!.Value);
            analytics = await SalesApiClient.GetAnalyticsAsync(ResolvedCompanyId!.Value);
            forecast = await SalesApiClient.GetRevenueForecastAsync(ResolvedCompanyId!.Value);
            AgentPanelDashboard = dashboard;
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private decimal PrimaryForecastValue => ForecastValue(30) > 0m ? ForecastValue(30) : dashboard?.ForecastRevenue ?? 0m;
    private string PrimaryForecastCurrency => forecast?.Currency ?? dashboard?.Currency ?? "USD";
    private decimal ForecastValue(int days) => forecast?.Windows.FirstOrDefault(x => x.Days == days)?.ExpectedRevenue ?? 0m;
    private string RecommendationPath(SalesRecommendationResponse recommendation) => recommendation.DealId is Guid dealId ? BuildPath($"/app/sales/deals/{dealId:D}") : BuildPath("/app/sales/leads");
    private static string Money(decimal value, string currency) => string.Create(CultureInfo.CurrentCulture, $"{value:N0} {currency}");
    private static string Percent(decimal value) => string.Create(CultureInfo.CurrentCulture, $"{value:P0}");
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";
}
