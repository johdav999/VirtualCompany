@page "/app/sales/pipeline"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["SalesPipeline"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main sales-main--wide">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@SalesText["Pipeline"]</h1>
            <p>@SalesText["PipelineDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a href="@BuildPath("/app/sales/prospects")">@SalesText["Prospects"]</a>
                <a class="active" href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
                <a href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
        </header>

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingPipeline"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["PipelineUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else if (pipeline is not null)
        {
            <section class="sales-kanban" aria-label="@SalesText["SalesPipelineBoard"]">
                @foreach (var stage in pipeline.Stages)
                {
                    <article class="sales-kanban-column" @key="stage.StageId" @ondrop="() => DropDealAsync(stage.StageId)" @ondragover:preventDefault>
                        <header>
                            <div>
                                <h2>@stage.Name</h2>
                                <span>@SalesText["DealCount", stage.DealCount]</span>
                            </div>
                            <strong>@Money(stage.TotalValue, StageCurrency(stage))</strong>
                        </header>

                        @if (stage.Deals.Count == 0)
                        {
                            <div class="sales-empty sales-empty--compact">@SalesText["NoDealsInStage"]</div>
                        }
                        else
                        {
                            <div class="sales-kanban-stack">
                                @foreach (var deal in stage.Deals)
                                {
                                    <a class="sales-deal-card"
                                       draggable="true"
                                       @key="deal.Id"
                                       @ondragstart="() => BeginDrag(deal.Id)"
                                       href="@BuildPath($"/app/sales/deals/{deal.Id:D}")">
                                        <span class="@BadgeClass(deal.Status)">@SalesStatusPresenter.Present(deal.Status, SalesText)</span>
                                        <strong>@deal.Title</strong>
                                        <small>@(deal.CustomerCompanyName ?? deal.ContactName ?? SalesText["NoContactLinked"])</small>
                                        <div>
                                            <span>@Money(deal.Amount, deal.Currency)</span>
                                            <span>@CloseDate(deal.ExpectedCloseUtc)</span>
                                        </div>
                                        <label class="sales-stage-select" @onclick:stopPropagation @onmousedown:stopPropagation>
                                            <span>@SalesText["MoveTo"]</span>
                                            <select value="@deal.StageId"
                                                    disabled="@IsMoving(deal.Id)"
                                                    @onchange="args => ChangeStageFromSelectAsync(deal.Id, args.Value?.ToString())">
                                                @foreach (var targetStage in pipeline.Stages)
                                                {
                                                    <option value="@targetStage.StageId">@targetStage.Name</option>
                                                }
                                            </select>
                                        </label>
                                    </a>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <div class="sales-toast">@actionMessage</div>
        }
    </main>

    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? actionMessage;
    private SalesPipelineResponse? pipeline;
    private Guid? draggedDealId;
    private Guid? movingDealId;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            pipeline = await SalesApiClient.GetPipelineAsync(ResolvedCompanyId!.Value);
            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginDrag(Guid dealId) => draggedDealId = dealId;

    private async Task DropDealAsync(Guid stageId)
    {
        if (draggedDealId is not Guid dealId || ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        actionMessage = null;
        try
        {
            movingDealId = dealId;
            await SalesApiClient.ChangeDealStageAsync(companyId, dealId, stageId, "Moved from the sales pipeline board.");
            pipeline = await SalesApiClient.GetPipelineAsync(companyId);
            await RefreshAgentPanelAsync();
            actionMessage = SalesText["DealStageUpdated"];
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            draggedDealId = null;
            movingDealId = null;
        }
    }

    private async Task ChangeStageFromSelectAsync(Guid dealId, string? stageIdValue)
    {
        if (!Guid.TryParse(stageIdValue, out var stageId) || ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        actionMessage = null;
        movingDealId = dealId;
        try
        {
            await SalesApiClient.ChangeDealStageAsync(companyId, dealId, stageId, "Moved from the stage selector.");
            pipeline = await SalesApiClient.GetPipelineAsync(companyId);
            await RefreshAgentPanelAsync();
            actionMessage = SalesText["DealStageUpdated"];
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            movingDealId = null;
        }
    }

    private bool IsMoving(Guid dealId) => movingDealId == dealId;
    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private static string StageCurrency(SalesPipelineStageResponse stage) => stage.Deals.FirstOrDefault()?.Currency ?? "USD";
    private static string Money(decimal value, string currency) => string.Create(CultureInfo.CurrentCulture, $"{value:N0} {currency}");
    private string CloseDate(DateTime? value) => value.HasValue ? LocalDateTime.DateTime(value.Value) : SalesText["NoCloseDate"];
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";
}
