@page "/app/sales/prospecting"
@page "/app/sales/prospects"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["SalesProspecting"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
<h1>@SalesText["Prospects"]</h1>
<p>@SalesText["ProspectingDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
<a class="active" href="@BuildPath("/app/sales/prospects")">@SalesText["Prospects"]</a>
<a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
<a href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
        </header>

        @if (isLoading) { <section class="sales-card sales-empty">@SalesText["LoadingProspecting"]</section> }
        else if (!string.IsNullOrWhiteSpace(errorMessage)) { <section class="sales-card sales-error">
<h2>@SalesText["ProspectingUnavailable"]</h2>
<p>@errorMessage</p>
<button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
</section> }
        else
        {
            <section class="prospecting-kpis" aria-label="@SalesText["LeadGenerationPerformance"]">
                <div>
<span>@SalesText["Candidates"]</span>
<strong>@metrics.Candidates</strong>
<small>@SalesText["AwaitingQualification"]</small>
</div>
                <div>
<span>@SalesStatusPresenter.Present("Qualified", SalesText)</span>
<strong>@metrics.Qualified</strong>
<small>@SalesText["MatchedActiveIcp"]</small>
</div>
                <div>
<span>@SalesText["Accepted"]</span>
<strong>@metrics.Accepted</strong>
<small>@SalesText["ReviewAcceptance", LocalNumber.Decimal(metrics.AcceptanceRate, 0)]</small>
</div>
                <div>
<span>@SalesStatusPresenter.Present("Converted", SalesText)</span>
<strong>@metrics.Converted</strong>
<small>@SalesText["AverageCompleteness", LocalNumber.Decimal(metrics.AverageCompleteness, 0)]</small>
</div>
            </section>

            <nav class="prospecting-view-tabs" aria-label="@SalesText["ProspectingViews"]">
                @foreach (var view in new[] { "Leads", "Accounts", "ICP", "Runs", "Data sources", "Suppressions" })
                { <button class="@(activeView == view ? "active" : null)" @onclick="() => SelectView(view)">@ProspectingViewLabel(view)</button> }
            </nav>

            @if (activeView == "Accounts") { @AccountsView() }
            else if (activeView == "Leads") { <SalesLeads Embedded="true" /> }
            else if (activeView == "ICP") { @IcpView() }
            else if (activeView == "Runs") { @RunsView() }
            else if (activeView == "Data sources") { @SourcesView() }
            else { @SuppressionsView() }
        }
    </main>
    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    private bool isLoading = true, isBusy, isSuggestingIcp;
    private string? errorMessage, actionMessage, search, statusFilter, rejectionReason;
    private string activeView = "Leads";
    private ProspectPageResponse prospects = new([], 0, 1, 50);
    private ProspectAccountResponse? selected;
    private LeadGenerationMetricsResponse metrics = new(0, 0, 0, 0, 0, 0, 0, new Dictionary<string, int>());
    private List<IcpProfileResponse> profiles = [];
    private List<ProspectingRunResponse> runs = [];
    private List<SuppressionResponse> suppressions = [];
    private SourcePolicyResponse? sourcePolicy;
    private SaveIcpProfileRequest icpForm = new("", "", "", null, null, null, null, "", "", "", "", "");
    private Guid? editingIcpId;
    private IcpSuggestionResponse? icpSuggestion;
    private CreateProspectingRunRequest runForm = new(Guid.Empty, "", 100, 300, "first_party", "", 30, 0, null);
    private SaveSourcePolicyRequest sourceForm = new("first_party,csv", "", "company,domain,industry,country,name,title,email,phone", 0, 0, 0, 365, 30);
    private SaveSuppressionRequest suppressionForm = new("domain", "", "", "manual", null);
    private SaveProspectContactRequest contactForm = new("", null, "decision-maker", null, null, null, "unknown", null, null, .5m, "manual", Guid.NewGuid().ToString("N"));
    private SaveProspectSignalRequest signalForm = new("hiring", "manual", Guid.NewGuid().ToString("N"), "", DateTime.UtcNow, .8m, 90);
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedView { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        activeView = RequestedView?.Trim().ToLowerInvariant() switch
        {
            "accounts" => "Accounts",
            "leads" => "Leads",
            "icp" => "ICP",
            "runs" => "Runs",
            "data-sources" => "Data sources",
            "suppressions" => "Suppressions",
            _ => "Leads"
        };
        await LoadAsync();
    }

    private void SelectView(string view)
    {
        activeView = view;
        var viewToken = view switch
        {
            "Accounts" => "accounts",
            "ICP" => "icp",
            "Runs" => "runs",
            "Data sources" => "data-sources",
            "Suppressions" => "suppressions",
            _ => null
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", viewToken), replace: true);
    }
    private async Task LoadAsync()
    {
        isLoading = true; errorMessage = null;
        try { if (!await ResolveCompanyAsync()) { errorMessage = ShellErrorMessage; return; } var companyId = ResolvedCompanyId!.Value;
            var p = SalesApiClient.ListProspectsAsync(companyId, search, statusFilter); var m = SalesApiClient.GetLeadGenerationMetricsAsync(companyId); var i = SalesApiClient.ListIcpProfilesAsync(companyId); var r = SalesApiClient.ListProspectingRunsAsync(companyId); var s = SalesApiClient.GetProspectSourcePolicyAsync(companyId); var x = SalesApiClient.ListSuppressionsAsync(companyId); await Task.WhenAll(p, m, i, r, s, x); prospects = await p; metrics = await m; profiles = (await i).ToList(); runs = (await r).ToList(); sourcePolicy = await s; suppressions = (await x).ToList(); sourceForm = new(sourcePolicy.EnabledSources, sourcePolicy.AllowedCountries, sourcePolicy.AllowedFields, sourcePolicy.PerRunBudget, sourcePolicy.MonthlyBudget, sourcePolicy.ApprovalThreshold, sourcePolicy.RetentionDays, sourcePolicy.RefreshDays); selected = selected is null ? prospects.Items.FirstOrDefault() : prospects.Items.FirstOrDefault(a => a.Id == selected.Id) ?? prospects.Items.FirstOrDefault(); await RefreshAgentPanelAsync(); }
        catch (SalesApiException ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private RenderFragment AccountsView() => @<text>
        <section class="sales-card sales-filter-card prospecting-filter">
<label>
<span>@SalesText["SearchAccounts"]</span>
<input class="sales-input" @bind="search" @bind:event="oninput" />
</label>
<label>
<span>@SalesText["Status"]</span>
<select class="sales-input" @bind="statusFilter">
<option value="">@SalesText["AllStatuses"]</option>
<option value="Candidate">@SalesText["Candidates"]</option>
<option value="Ready For Review">@SalesText["Review"]</option>
<option value="Qualified">@SalesStatusPresenter.Present("Qualified", SalesText)</option>
<option value="Accepted">@SalesText["Accepted"]</option>
<option value="Converted">@SalesStatusPresenter.Present("Converted", SalesText)</option>
<option value="Rejected">@SalesStatusPresenter.Present("Rejected", SalesText)</option>
</select>
</label>
<button class="sales-button sales-button--primary" @onclick="ApplyFilters">@SalesText["Apply"]</button>
<a class="sales-button" href="@ApiExportPath()">@SalesText["ExportCsv"]</a>
</section>
        <section class="prospecting-split">
            <div class="sales-card prospecting-list">
                @if (prospects.Items.Count == 0) { <div class="sales-empty">
<h2>@SalesText["NoProspects"]</h2>
<p>@SalesText["NoProspectsMessage"]</p>
</div> }
                else { @foreach (var item in prospects.Items) { <button class="prospect-row @(selected?.Id == item.Id ? "selected" : null)" @onclick="() => selected = item">
<span class="prospect-mark">@Initials(item.Name)</span>
<span class="prospect-main">
<strong>@item.Name</strong>
<small>@(item.Industry ?? SalesText["IndustryUnknown"]) · @(item.Country ?? SalesText["LocationUnknown"])</small>
</span>
<span>
<small>@SalesText["Fit"]</small>
<strong>@LocalNumber.Decimal(item.FitScore, 0)%</strong>
</span>
<span>
<small>@SalesText["Timing"]</small>
<strong>@LocalNumber.Decimal(item.TimingScore, 0)%</strong>
</span>
<span class="sales-badge @ScoreClass(item.ScoreBand)">@item.ScoreBand</span>
</button> } }
            </div>
            <div class="sales-card prospecting-detail">
                @if (selected is null) { <div class="sales-empty">
<h2>@SalesText["NoAccountSelected"]</h2>
<p>@SalesText["SelectAccountMessage"]</p>
</div> }
                else { <div class="prospect-detail-head">
<div class="prospect-mark large">@Initials(selected.Name)</div>
<div>
<h2>@selected.Name</h2>
<p>@(selected.Domain ?? SalesText["DomainNotVerified"]) · @(selected.Employees.HasValue ? LocalNumber.Integer(selected.Employees.Value) : SalesText["SizeUnknown"]) employees</p>
</div>
<strong>@LocalNumber.Decimal(selected.OverallScore, 0)%</strong>
</div>
                    <div class="score-strip">
<span>@SalesText["IcpFit"] <b>@LocalNumber.Decimal(selected.FitScore, 0)</b>
</span>
<span>@SalesText["Timing"] <b>@LocalNumber.Decimal(selected.TimingScore, 0)</b>
</span>
<span>@SalesText["RoleCoverage"] <b>@LocalNumber.Decimal(selected.RoleScore, 0)</b>
</span>
<span>@SalesText["DataConfidence"] <b>@LocalNumber.Decimal(selected.DataConfidenceScore, 0)</b>
</span>
</div>
                    <section>
<h3>@SalesText["WhyThisAccount"]</h3>@foreach (var line in BriefItems(selected.ResearchBriefJson, "confirmedFacts")) { <p class="evidence-line">@SalesText["VerifiedEvidence", line]</p> } @if (!BriefItems(selected.ResearchBriefJson, "confirmedFacts").Any()) { <p>@SalesText["RefreshResearchBrief"]</p> }</section>
                    <div class="prospect-detail-grid">
<section>
<h3>@SalesText["BuyingGroup"]</h3>@if (selected.Contacts.Count == 0) { <p>@SalesText["NoContactsReviewed"]</p> } else { @foreach (var c in selected.Contacts) { <div class="compact-item">
<strong>@c.FullName</strong>
<span>@(c.Title ?? SalesText["RoleUnknown"]) · @c.BuyingRoles</span>
<small>@c.EmailStatus · @c.Status</small>
</div> } }<button class="sales-button sales-button--small" @onclick="() => showContactForm = !showContactForm">@SalesText["AddContact"]</button>
</section>
                    <section>
<h3>@SalesText["RecentSignals"]</h3>@if (selected.Signals.Count == 0) { <p>@SalesText["NoFreshSignals"]</p> } else { @foreach (var s in selected.Signals) { <div class="compact-item">
<strong>@s.Type</strong>
<span>@s.Summary</span>
<small>@LocalDateTime.DateTime(s.EventUtc) | @s.Source</small>
</div> } }<button class="sales-button sales-button--small" @onclick="() => showSignalForm = !showSignalForm">@SalesText["AddSignal"]</button>
</section>
</div>
                    @if (showContactForm) { <div class="inline-form">
<input class="sales-input" placeholder="@SalesText["FullName"]" @bind="contactForm.FullName" />
<input class="sales-input" placeholder="@SalesText["Title"]" @bind="contactForm.Title" />
<input class="sales-input" placeholder="@SalesText["BusinessEmail"]" @bind="contactForm.Email" />
<input class="sales-input" placeholder="@SalesText["BuyingRoles"]" @bind="contactForm.BuyingRoles" />
<button class="sales-button sales-button--primary" @onclick="AddContact">@SalesText["SaveContact"]</button>
</div> }
                    @if (showSignalForm) { <div class="inline-form">
<select class="sales-input" @bind="signalForm.Type">
<option value="hiring">@SalesText["SignalHiring"]</option>
<option value="funding">@SalesText["SignalFunding"]</option>
<option value="expansion">@SalesText["SignalExpansion"]</option>
<option value="leadership_change">@SalesText["SignalLeadershipChange"]</option>
<option value="technology_adoption">@SalesText["SignalTechnologyAdoption"]</option>
</select>
<input class="sales-input" placeholder="@SalesText["EvidenceSummary"]" @bind="signalForm.Summary" />
<button class="sales-button sales-button--primary" @onclick="AddSignal">@SalesText["SaveSignal"]</button>
</div> }
                    <section>
<h3>@SalesText["DataUsed"]</h3>
<p>@SalesText["ObservedAt", selected.Source, LocalDateTime.DateTime(selected.LastObservedUtc)]</p>
</section>
                    <div class="prospect-actions">
<button class="sales-button sales-button--primary" disabled="@isBusy" @onclick="AcceptSelected">@SalesText["Accept"]</button>
<input class="sales-input" placeholder="@SalesText["RejectionReasonPlaceholder"]" @bind="rejectionReason" />
<button class="sales-button sales-button--danger" disabled="@isBusy" @onclick="RejectSelected">@SalesText["Reject"]</button>
<button class="sales-button" disabled="@isBusy" @onclick="RefreshSelected">@SalesText["RefreshResearch"]</button>@if (selected.Status == "Accepted") { <button class="sales-button sales-button--primary" disabled="@isBusy" @onclick="ConvertSelected">@SalesText["CreateLead"]</button> }</div>
                }
            </div>
        </section>@ActionMessage()
    </text>;

    private bool showContactForm, showSignalForm;
    private RenderFragment IcpView() => @<section class="settings-grid">
<div class="sales-card">
<h2>@SalesText["IdealCustomerProfiles"]</h2>@if (profiles.Count == 0) { <p>@SalesText["NoIcpProfiles"]</p> }@foreach (var p in profiles) { <div class="settings-row">
<div>
<strong>@p.Name · v@p.Version</strong>
<span>@p.Industries · @p.Countries</span>
</div>
<span class="sales-badge">@SalesStatusPresenter.Present(p.Status, SalesText)</span>
<button class="sales-button sales-button--small" @onclick="() => EditIcp(p)">@SalesText["Edit"]</button>@if (p.Status == "Draft") { <button class="sales-button sales-button--small sales-button--primary" @onclick="() => ActivateIcp(p.Id)">@SalesText["Activate"]</button> }<button class="sales-button sales-button--small" @onclick="() => CloneIcp(p.Id)">@SalesText["NewVersion"]</button>
</div> }</div>
<div class="sales-card settings-form">
<div class="icp-form-heading">
<h2>@(editingIcpId.HasValue ? SalesText["EditIcpDraft"] : SalesText["NewIcp"])</h2>
<button class="sales-button sales-button--small" disabled="@isSuggestingIcp" @onclick="SuggestIcp">
    @(isSuggestingIcp ? SalesText["IcpSuggestionWorking"] : SalesText["AskAlexForIcp"])
</button>
</div>
@if (icpSuggestion is not null)
{
<section class="icp-suggestion" aria-label="@SalesText["AlexIcpSuggestion"]">
<div class="icp-suggestion__heading">
<div>
<span>@SalesText["AlexIcpSuggestion"]</span>
<strong>@icpSuggestion.Profile.Name</strong>
</div>
<span class="sales-badge">@SalesText["ConfidenceLabel", LocalNumber.Percentage(icpSuggestion.Confidence)]</span>
</div>
<p>@icpSuggestion.Rationale</p>
<div>
<strong class="icp-suggestion__label">@SalesText["BasedOn"]</strong>
<div class="icp-suggestion__sources">
@foreach (var source in icpSuggestion.Evidence)
{
<div>
<strong>@source.Title</strong>
<span>@source.Type.Replace('_', ' ')</span>
</div>
}
</div>
</div>
@if (icpSuggestion.MissingEvidence.Count > 0)
{
<div class="icp-suggestion__missing">
<strong>@SalesText["MissingInformation"]</strong>
<span>@string.Join(" · ", icpSuggestion.MissingEvidence)</span>
</div>
}
<p class="form-help">@SalesText["IcpSuggestionReviewHelp"]</p>
<div class="icp-suggestion__actions">
<button class="sales-button sales-button--primary" @onclick="ApplyIcpSuggestion">@SalesText["UseSuggestion"]</button>
<button class="sales-button" @onclick="DismissIcpSuggestion">@SalesText["Dismiss"]</button>
</div>
</section>
}
<label>@SalesText["Name"]<input class="sales-input" @bind="icpForm.Name" />
</label>
<label>@SalesText["Countries"]<input class="sales-input" placeholder="@SalesText["CountriesPlaceholder"]" @bind="icpForm.Countries" />
</label>
<label>@SalesText["Industries"]<input class="sales-input" placeholder="@SalesText["IndustriesPlaceholder"]" @bind="icpForm.Industries" />
</label>
<div class="form-pair">
<label>@SalesText["MinimumEmployees"]<input class="sales-input" type="number" @bind="icpForm.EmployeeMin" />
</label>
<label>@SalesText["MaximumEmployees"]<input class="sales-input" type="number" @bind="icpForm.EmployeeMax" />
</label>
</div>
<label>@SalesText["BuyerRolesLabel"]<input class="sales-input" placeholder="@SalesText["BuyerRolesPlaceholder"]" @bind="icpForm.BuyerRoles" />
</label>
<label>@SalesText["Technologies"]<input class="sales-input" @bind="icpForm.Technologies" />
</label>
<label>@SalesText["BusinessProblems"]<textarea class="sales-input" @bind="icpForm.PainHypotheses">
</textarea>
</label>
<label>@SalesText["PositiveIndicators"]<textarea class="sales-input" @bind="icpForm.PositiveCriteria">
</textarea>
</label>
<label>@SalesText["Exclusions"]<textarea class="sales-input" @bind="icpForm.Disqualifiers">
</textarea>
</label>
<button class="sales-button sales-button--primary" @onclick="SaveIcp">@SalesText["SaveDraft"]</button>
</div>@ActionMessage()</section>;
    private RenderFragment RunsView() => @<section class="settings-grid">
<div class="sales-card">
<h2>@SalesText["ProspectingRuns"]</h2>@foreach (var r in runs) { <div class="settings-row">
<div>
<strong>@r.Name</strong>
<span>@r.CurrentStep - @r.AccountsFound / @r.AccountLimit accounts</span>
</div>
<span class="sales-badge">@SalesStatusPresenter.Present(r.Status, SalesText)</span>
<label class="sales-button sales-button--small">@SalesText["ImportSpreadsheet"]<InputFile class="visually-hidden" OnChange="e => ImportFile(r.Id, e)" accept=".csv,.xlsx" />
</label>@if (r.Status is "Planned" or "Paused" or "Failed") { <button class="sales-button sales-button--small sales-button--primary" @onclick="() => StartRun(r.Id)">@SalesText["Start"]</button> }@if (r.Status == "Running") { <button class="sales-button sales-button--small" @onclick="() => PauseRun(r.Id)">@SalesText["Pause"]</button> }</div> }@if (runs.Count == 0) { <p>@SalesText["NoRuns"]</p> }</div>
<div class="sales-card settings-form">
<h2>@SalesText["PlanRun"]</h2>
<label>@SalesText["ActiveIcp"]<select class="sales-input" @bind="runForm.IcpProfileId">
<option value="@Guid.Empty">@SalesText["ChooseProfile"]</option>@foreach (var p in profiles.Where(x => x.Status == "Active")) { <option value="@p.Id">@p.Name - v@p.Version</option> }</select>
</label>
<label>@SalesText["RunName"]<input class="sales-input" @bind="runForm.Name" />
</label>
<div class="form-pair">
<label>@SalesText["AccountLimit"]<input class="sales-input" type="number" @bind="runForm.AccountLimit" />
</label>
<label>@SalesText["ContactLimit"]<input class="sales-input" type="number" @bind="runForm.ContactLimit" />
</label>
</div>
<label>@SalesText["Sources"]<input class="sales-input" @bind="runForm.Sources" />
</label>
<label>@SalesText["Geography"]<input class="sales-input" @bind="runForm.Geography" />
</label>
<button class="sales-button sales-button--primary" @onclick="CreateRun">@SalesText["CreatePlan"]</button>
<p class="form-help">@SalesText["CreatePlanHelp"]</p>
</div>@ActionMessage()</section>;
    private RenderFragment SourcesView() => @<section class="settings-grid">
<div class="sales-card">
<h2>@SalesText["AvailableDataSources"]</h2>@foreach (var p in sourcePolicy?.Providers ?? []) { <div class="settings-row">
<div>
<strong>@p.Label</strong>
<span>@p.Health · @(p.Capabilities.IsPaid ? "Paid source" : "No provider charge")</span>
</div>
<span class="sales-badge">@(sourceForm.EnabledSources.Contains(p.Key) ? SalesText["Enabled"] : SalesStatusPresenter.Present("Paused", SalesText))</span>
</div> }<div class="settings-row">
<div>
<strong>@SalesText["SpreadsheetImport"]</strong>
<span>@SalesText["SpreadsheetImportDescription"]</span>
</div>
<span class="sales-badge">@SalesText["Enabled"]</span>
</div>
</div>
<div class="sales-card settings-form">
<h2>@SalesText["SourceGovernance"]</h2>
<label>@SalesText["EnabledSources"]<input class="sales-input" @bind="sourceForm.EnabledSources" />
</label>
<label>@SalesText["AllowedCountries"]<input class="sales-input" @bind="sourceForm.AllowedCountries" />
</label>
<label>@SalesText["AllowedFields"]<input class="sales-input" @bind="sourceForm.AllowedFields" />
</label>
<div class="form-pair">
<label>@SalesText["PerRunBudget"]<input class="sales-input" type="number" @bind="sourceForm.PerRunBudget" />
</label>
<label>@SalesText["MonthlyBudget"]<input class="sales-input" type="number" @bind="sourceForm.MonthlyBudget" />
</label>
</div>
<div class="form-pair">
<label>@SalesText["RetentionDays"]<input class="sales-input" type="number" @bind="sourceForm.RetentionDays" />
</label>
<label>@SalesText["RefreshInterval"]<input class="sales-input" type="number" @bind="sourceForm.RefreshDays" />
</label>
</div>
<button class="sales-button sales-button--primary" @onclick="SaveSources">@SalesText["SavePolicy"]</button>
</div>@ActionMessage()</section>;
    private RenderFragment SuppressionsView() => @<section class="settings-grid">
<div class="sales-card">
<h2>@SalesText["SuppressionList"]</h2>@foreach (var s in suppressions) { <div class="settings-row">
<div>
<strong>@s.ScopeValue</strong>
<span>@s.ScopeType · @s.Reason</span>
</div>
<small>@(s.ExpiresUtc.HasValue ? LocalDateTime.DateTime(s.ExpiresUtc.Value) : SalesText["NoExpiry"])</small>
</div> }@if (suppressions.Count == 0) { <p>@SalesText["NoSuppressions"]</p> }</div>
<div class="sales-card settings-form">
<h2>@SalesText["AddSuppression"]</h2>
<label>@SalesText["Scope"]<select class="sales-input" @bind="suppressionForm.ScopeType">
<option value="domain">@SalesText["ScopeDomain"]</option>
<option value="company">@SalesText["ScopeCompany"]</option>
<option value="email">@SalesText["ScopeEmail"]</option>
<option value="person">@SalesText["ScopePerson"]</option>
</select>
</label>
<label>@SalesText["Value"]<input class="sales-input" @bind="suppressionForm.ScopeValue" />
</label>
<label>@SalesText["Reason"]<input class="sales-input" @bind="suppressionForm.Reason" />
</label>
<button class="sales-button sales-button--primary" @onclick="AddSuppression">@SalesText["Suppress"]</button>
</div>@ActionMessage()</section>;
    private RenderFragment ActionMessage() => @<text>@if (!string.IsNullOrWhiteSpace(actionMessage)) { <div class="sales-toast">@actionMessage</div> }</text>;

    private async Task ApplyFilters() => await LoadAsync();
    private async Task RunAction(Func<Guid, Task> action) { if (ResolvedCompanyId is not Guid companyId) return; isBusy = true; actionMessage = null; try { await action(companyId); await LoadAsync(); } catch (SalesApiException ex) { actionMessage = ex.Message; } finally { isBusy = false; } }
    private async Task Review(string action) { if (selected is null) return; if (action == "reject" && string.IsNullOrWhiteSpace(rejectionReason)) { actionMessage = SalesText["RejectionReasonRequired"]; return; } await RunAction(async c => { selected = await SalesApiClient.ReviewProspectAsync(c, selected.Id, action, rejectionReason); }); }
    private Task AcceptSelected() => Review("accept");
    private Task RejectSelected() => Review("reject");
    private async Task RefreshSelected() { if (selected is not null) await RunAction(async c => selected = await SalesApiClient.RefreshProspectAsync(c, selected.Id)); }
    private async Task ConvertSelected() { if (selected is null) return; await RunAction(async c => { var result = await SalesApiClient.ConvertProspectAsync(c, selected.Id, selected.Contacts.FirstOrDefault(x => x.Status == "Accepted")?.Id); Navigation.NavigateTo(BuildPath($"/app/sales/leads")); }); }
    private async Task AddContact() { if (selected is null) return; contactForm.SourceReference = Guid.NewGuid().ToString("N"); await RunAction(async c => { await SalesApiClient.AddProspectContactAsync(c, selected.Id, contactForm); selected = await SalesApiClient.GetProspectAsync(c, selected.Id); showContactForm = false; }); }
    private async Task AddSignal() { if (selected is null) return; signalForm.SourceReference = Guid.NewGuid().ToString("N"); signalForm.EventUtc = DateTime.UtcNow; await RunAction(async c => { await SalesApiClient.AddProspectSignalAsync(c, selected.Id, signalForm); selected = await SalesApiClient.RefreshProspectAsync(c, selected.Id); showSignalForm = false; }); }
    private async Task SuggestIcp()
    {
        if (ResolvedCompanyId is not Guid companyId) return;
        isSuggestingIcp = true;
        actionMessage = null;
        try
        {
            var agentId = await ResolveSalesAgentIdAsync(companyId);
            if (agentId is null)
            {
                actionMessage = SalesText["ActiveSalesAgentRequired"];
                return;
            }

            icpSuggestion = await SalesApiClient.SuggestIcpAsync(companyId, new SuggestIcpRequest(agentId.Value));
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        catch (OnboardingApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isSuggestingIcp = false;
        }
    }

    private void ApplyIcpSuggestion()
    {
        if (icpSuggestion is null) return;
        var profile = icpSuggestion.Profile;
        editingIcpId = null;
        icpForm = new(
            profile.Name,
            profile.Countries,
            profile.Industries,
            profile.EmployeeMin,
            profile.EmployeeMax,
            profile.RevenueMin,
            profile.RevenueMax,
            profile.BuyerRoles,
            profile.Technologies,
            profile.PainHypotheses,
            profile.PositiveCriteria,
            profile.Disqualifiers);
        actionMessage = SalesText["IcpSuggestionApplied"];
    }

    private void DismissIcpSuggestion() => icpSuggestion = null;
    private void EditIcp(IcpProfileResponse p) { editingIcpId = p.Status == "Draft" ? p.Id : null; icpForm = new(p.Name, p.Countries, p.Industries, p.EmployeeMin, p.EmployeeMax, p.RevenueMin, p.RevenueMax, p.BuyerRoles, p.Technologies, p.PainHypotheses, p.PositiveCriteria, p.Disqualifiers); }
    private async Task SaveIcp() => await RunAction(async c => { if (editingIcpId.HasValue) await SalesApiClient.UpdateIcpProfileAsync(c, editingIcpId.Value, icpForm); else await SalesApiClient.CreateIcpProfileAsync(c, icpForm); editingIcpId = null; });
    private async Task ActivateIcp(Guid id) => await RunAction(c => SalesApiClient.ActivateIcpProfileAsync(c, id));
    private async Task CloneIcp(Guid id) => await RunAction(c => SalesApiClient.CloneIcpProfileAsync(c, id));
    private async Task CreateRun() => await RunAction(c => SalesApiClient.CreateProspectingRunAsync(c, runForm));
    private async Task StartRun(Guid id) => await RunAction(c => SalesApiClient.StartProspectingRunAsync(c, id));
    private async Task ChangeRun(Guid id, string action) => await RunAction(c => SalesApiClient.ChangeProspectingRunAsync(c, id, action));
    private Task PauseRun(Guid id) => ChangeRun(id, "pause");
    private async Task ImportFile(Guid runId, InputFileChangeEventArgs e) { if (ResolvedCompanyId is not Guid companyId) return; isBusy = true; try { await using var stream = e.File.OpenReadStream(10_000_000); var result = await SalesApiClient.ImportProspectsAsync(companyId, runId, stream, e.File.Name); actionMessage = SalesText["ImportSummary", result.Imported, result.Duplicates, result.Rejected]; await LoadAsync(); } catch (Exception ex) when (ex is SalesApiException or IOException) { actionMessage = ex.Message; } finally { isBusy = false; } }
    private async Task SaveSources() => await RunAction(c => SalesApiClient.SaveProspectSourcePolicyAsync(c, sourceForm));
    private async Task AddSuppression() => await RunAction(c => SalesApiClient.AddSuppressionAsync(c, suppressionForm));
    private string BuildPath(string path) => ResolvedCompanyId is Guid id ? $"{path}?companyId={id:D}" : path;
    private string ProspectingViewLabel(string view) => view switch
    {
        "Accounts" => SalesText["Accounts"],
        "Leads" => SalesText["Leads"],
        "ICP" => SalesText["Icp"],
        "Runs" => SalesText["Runs"],
        "Data sources" => SalesText["DataSources"],
        "Suppressions" => SalesText["Suppressions"],
        _ => view
    };
    private string ApiExportPath() => ResolvedCompanyId is Guid id ? $"/api/sales/prospecting/export.csv?companyId={id:D}" : "#";
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string ScoreClass(string score) => score.StartsWith("High", StringComparison.OrdinalIgnoreCase) ? "sales-badge--qualified" : score.StartsWith("Medium", StringComparison.OrdinalIgnoreCase) ? "sales-badge--warm" : "sales-badge--new";
    private static IReadOnlyList<string> BriefItems(string json, string property) { try { using var doc = JsonDocument.Parse(json); return doc.RootElement.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.Array ? value.EnumerateArray().Select(x => x.ValueKind == JsonValueKind.String ? x.GetString()! : x.ToString()).ToList() : []; } catch { return []; } }
}
