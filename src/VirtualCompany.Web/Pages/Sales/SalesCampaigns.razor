@page "/app/sales/campaigns"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["SalesCampaigns"]</PageTitle>

<div class="sales-workspace">
    <main class="sales-main">
        <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@SalesText["OutboundCampaigns"]</h1>
            <p>@SalesText["CampaignsDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a href="@BuildPath("/app/sales/leads")">@SalesText["Leads"]</a>
                <a href="@BuildPath("/app/sales/prospecting")">@SalesText["Prospecting"]</a>
                <a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
                <a class="active" href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
        </header>

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingCampaigns"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["CampaignsUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else
        {
            <section class="sales-kpi-grid" aria-label="@SalesText["CampaignKpis"]">
                <article class="sales-kpi-card">
                    <span>@SalesText["ActiveCampaigns"]</span>
                    <strong>@campaigns.Count(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))</strong>
                    <small>@SalesText["SendingWhileAllowed"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["AudienceReady"]</span>
                    <strong>@FilteredAudience.Count</strong>
                    <small>@SalesText["EligibleContacts"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["PendingSteps"]</span>
                    <strong>@campaigns.Sum(x => x.PendingSteps)</strong>
                    <small>@SalesText["ScheduledEmails"]</small>
                </article>
                <article class="sales-kpi-card">
                    <span>@SalesText["SentEmails"]</span>
                    <strong>@campaigns.Sum(x => x.SentSteps)</strong>
                    <small>@SalesText["DeliveryRecords"]</small>
                </article>
            </section>

            <div class="sales-two-column sales-two-column--campaigns">
                <section class="sales-card">
                    <div class="sales-section-heading">
                        <div>
                            <span>@SalesText["Campaigns"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@SalesText["LiveCampaignControl"]</h2>
                            <p>@SalesText["CampaignControlDescription"]</p>
                        </div>
                        <button class="sales-button sales-button--primary" @onclick="BeginNewCampaign">@SalesText["NewCampaign"]</button>
                    </div>

                    @if (campaigns.Count == 0)
                    {
                        <div class="sales-empty">
                            <h2>@SalesText["NoCampaigns"]</h2>
                            <p>@SalesText["NoCampaignsMessage"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="sales-list">
                            @foreach (var campaign in campaigns)
                            {
                                <button class="@CampaignRowClass(campaign.Id)" @onclick="() => SelectCampaignAsync(campaign.Id)">
                                    <div>
                                        <strong>@campaign.Name</strong>
                                        <span>@SalesText["CampaignRowSummary", campaign.AudienceCount, campaign.PendingSteps, campaign.SentSteps, LocalDateTime.DateTime(campaign.UpdatedUtc)]</span>
                                    </div>
                                    <span class="@BadgeClass(campaign.Status)">@SalesStatusPresenter.Present(campaign.Status, SalesText)</span>
                                </button>
                            }
                        </div>
                    }
                </section>

                <section class="sales-card">
                    <div class="sales-section-heading">
                        <div>
                            <span>@SalesText["Details"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@(selectedCampaign is null ? SalesText["CampaignPreview"] : selectedCampaign.Name)</h2>
                            <p>@(selectedCampaign is null ? SalesText["CampaignPreviewDescription"] : SalesText["CampaignDetailDescription"])</p>
                        </div>
                    </div>

                    @if (selectedCampaign is null)
                    {
                        <div class="sales-empty">
                            <h2>@SalesText["NoCampaignSelected"]</h2>
                            <p>@SalesText["NoCampaignSelectedMessage"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="sales-campaign-detail">
                            <div class="sales-campaign-detail__header">
                                <span class="@BadgeClass(selectedCampaign.Status)">@SalesStatusPresenter.Present(selectedCampaign.Status, SalesText)</span>
                                <span>@SalesText["ContactCount", selectedCampaign.Audience.Count]</span>
                                <span>@SalesText["StepCount", selectedCampaign.Steps.Count]</span>
                            </div>

                            <div class="sales-actions">
                                <button class="sales-button sales-button--primary" disabled="@isSubmitting" @onclick='() => ChangeCampaignStateAsync("launch")'>@SalesText["Start"]</button>
                                <button class="sales-button" disabled="@isSubmitting" @onclick='() => ChangeCampaignStateAsync("pause")'>@SalesText["Pause"]</button>
                                <button class="sales-button" disabled="@isSubmitting" @onclick='() => ChangeCampaignStateAsync("stop")'>@SalesText["Stop"]</button>
                            </div>

                            <dl class="sales-definition-list">
                                <div>
                                    <dt>@SalesText["Policy"]</dt>
                                    <dd>@PolicySummary(selectedCampaign.Policy)</dd>
                                </div>
                                <div>
                                    <dt>@SalesText["Delivery"]</dt>
                                    <dd>@SalesText["DeliverySummary", selectedCampaign.Executions.SelectMany(x => x.Steps).Count(x => x.SentUtc.HasValue), selectedCampaign.Executions.SelectMany(x => x.Steps).Count(x => x.Status == "Pending"), selectedCampaign.Executions.SelectMany(x => x.Steps).Count(x => x.BounceStatus is not null)]</dd>
                                </div>
                            </dl>

                            <div class="sales-campaign-executions">
                                @if (selectedCampaign.Executions.Count == 0)
                                {
                                    <div class="sales-empty sales-empty--compact">@SalesText["NoExecutions"]</div>
                                }
                                else
                                {
                                    @foreach (var execution in selectedCampaign.Executions.Take(8))
                                    {
                                        <article>
                                            <header>
                                                <strong>@execution.ContactName</strong>
                                                <span class="@BadgeClass(execution.Status)">@SalesStatusPresenter.Present(execution.Status, SalesText)</span>
                                            </header>
                                            <div>
                                                @foreach (var step in execution.Steps)
                                                {
                                                    <span title="@LocalDateTime.DateTime(step.ScheduledSendUtc)" class="@BadgeClass(step.Status)">@SalesText["StepNumber", step.StepOrder]</span>
                                                }
                                            </div>
                                            @if (execution.Steps.FirstOrDefault(x => x.CurrentDraftSubject is not null) is { } draftStep)
                                            {
                                                <div class="sales-draft-audit">
                                                    <strong>@(draftStep.CurrentDraftSubject ?? draftStep.OriginalGeneratedSubject)</strong>
                                                    <small>
                                                        @SalesText["GeneratedAt", draftStep.GeneratedDraftUtc.HasValue ? LocalDateTime.DateTime(draftStep.GeneratedDraftUtc.Value) : string.Empty]
                                                        @if (draftStep.DraftUpdatedUtc is not null && draftStep.DraftUpdatedUtc != draftStep.GeneratedDraftUtc)
                                                        {
                                                            <span> - @SalesText["EditedAt", LocalDateTime.DateTime(draftStep.DraftUpdatedUtc.Value)]</span>
                                                        }
                                                    </small>
                                                    <p>@TrimDraft(draftStep.CurrentDraftBody ?? draftStep.OriginalGeneratedBody)</p>
                                                </div>
                                            }
                                        </article>
                                    }
                                }
                            </div>
                        </div>
                    }
                </section>
            </div>

            @if (showBuilder)
            {
                <section class="sales-card sales-campaign-builder">
                    <div class="sales-section-heading">
                        <div>
                            <span>@SalesText["CreateCampaign"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@SalesText["BuildFourStepSequence"]</h2>
                            <p>@SalesText["BuilderPolicyDescription"]</p>
                        </div>
                        <button class="sales-button" @onclick="CancelBuilder">@SalesText["Close"]</button>
                    </div>

                    @if (validationErrors.Count > 0)
                    {
                        <div class="sales-alert sales-alert--danger">
                            @foreach (var error in validationErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    }

                    <div class="sales-campaign-form">
                        <label>
                            <span>@SalesText["CampaignName"]</span>
                            <input class="sales-input" @bind="draft.Name" @bind:event="oninput" placeholder="@SalesText["CampaignNamePlaceholder"]" />
                        </label>
                        <label>
                            <span>@SalesText["Description"]</span>
                            <input class="sales-input" @bind="draft.Description" @bind:event="oninput" placeholder="@SalesText["InternalNotePlaceholder"]" />
                        </label>
                    </div>

                    <div class="sales-campaign-layout">
                        <section class="sales-campaign-panel">
                            <div class="sales-section-heading">
                                <div>
                                    <span>@SalesText["Audience"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                    <h2>@SalesText["SelectContacts"]</h2>
                                </div>
                            </div>

                            <div class="sales-filter-card sales-filter-card--campaigns">
                                <label>
                                    <span>@SalesText["AudienceSource"]</span>
                                    <select class="sales-input" @bind="draft.AudienceType">
                                        @foreach (var source in audienceOptions.Sources)
                                        {
                                            <option value="@source.SourceType">@source.Label (@source.ContactCount)</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>@SalesText["SearchContacts"]</span>
                                    <input class="sales-input" @bind="audienceSearch" @bind:event="oninput" placeholder="@SalesText["SearchContactsPlaceholder"]" />
                                </label>
                            </div>

                            <div class="sales-audience-list">
                                @if (FilteredAudience.Count == 0)
                                {
                                    <div class="sales-empty sales-empty--compact">@SalesText["NoAudienceContacts"]</div>
                                }
                                else
                                {
                                    @foreach (var contact in FilteredAudience.Take(80))
                                    {
                                        <label class="sales-audience-row">
                                            <input type="checkbox" checked="@draft.ContactIds.Contains(contact.ContactId)" @onchange="args => ToggleContact(contact.ContactId, args.Value as bool? == true)" />
                                            <span>
                                                <a class="sales-inline-link" href="@BuildPath($"/app/sales/contacts/{contact.ContactId:D}")">@contact.ContactName</a>
                                                <small>@contact.Email - @(contact.CustomerCompanyName ?? SalesText["NoCompanyLinked"])</small>
                                            </span>
                                        </label>
                                    }
                                }
                            </div>
                        </section>

                        <section class="sales-campaign-panel">
                            <div class="sales-section-heading">
                                <div>
                                    <span>@SalesText["Sequence"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                                    <h2>@SalesText["EmailSteps"]</h2>
                                </div>
                                <button class="sales-button sales-button--small" @onclick="AddStep">@SalesText["AddStep"]</button>
                            </div>

                            <div class="sales-sequence-builder">
                                @foreach (var step in draft.Steps.OrderBy(x => x.StepOrder))
                                {
                                    <article class="sales-sequence-step" @key="step.ClientId">
                                        <header>
                                            <strong>@SalesText["StepNumber", step.StepOrder]</strong>
                                            <label class="sales-switch">
                                                <input type="checkbox" @bind="step.AiPersonalizationEnabled" />
                                                <span>@SalesText["AiPersonalization"]</span>
                                            </label>
                                        </header>
                                        <div class="sales-sequence-grid">
                                            <label>
                                                <span>@SalesText["DelayDays"]</span>
                                                <input class="sales-input" type="number" min="0" @bind="step.DelayDays" />
                                            </label>
                                            <label>
                                                <span>@SalesText["Subject"]</span>
                                                <input class="sales-input" @bind="step.Subject" @bind:event="oninput" />
                                            </label>
                                        </div>
                                        <label>
                                            <span>@SalesText["EmailBody"]</span>
                                            <textarea class="sales-input sales-textarea" @bind="step.Body" @bind:event="oninput"></textarea>
                                        </label>
                                    </article>
                                }
                            </div>
                        </section>
                    </div>

                    <section class="sales-campaign-preview">
                        <div>
                            <span>@SalesText["Preview"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                            <h2>@PreviewTitle</h2>
                            <p>@PreviewSummary</p>
                        </div>
                        <div class="sales-campaign-preview__grid">
                            <article>
                                <strong>@draft.ContactIds.Count</strong>
                                <span>@SalesText["EligibleContactsLabel"]</span>
                            </article>
                            <article>
                                <strong>@draft.Steps.Count</strong>
                                <span>@SalesText["SequenceStepsLabel"]</span>
                            </article>
                            <article>
                                <strong>@ProjectedScheduleDays</strong>
                                <span>@SalesText["DaysInSchedule"]</span>
                            </article>
                        </div>
                        <div class="sales-actions">
                            <button class="sales-button sales-button--primary" disabled="@isSubmitting" @onclick="CreateCampaignAsync">@SalesText["SaveCampaign"]</button>
                            <button class="sales-button" @onclick="SelectAllFiltered">@SalesText["SelectAudience"]</button>
                        </div>
                    </section>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(actionMessage))
            {
                <div class="sales-toast">@actionMessage</div>
            }
        }
    </main>

    <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
</div>

@code {
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showBuilder;
    private string? errorMessage;
    private string? actionMessage;
    private string? audienceSearch;
    private List<string> validationErrors = [];
    private List<OutboundCampaignSummaryResponse> campaigns = [];
    private OutboundCampaignDetailResponse? selectedCampaign;
    private OutboundAudienceOptionsResponse audienceOptions = new([], []);
    private CampaignDraft draft = CampaignDraft.CreateDefault();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private IReadOnlyList<OutboundAudienceContactResponse> FilteredAudience => audienceOptions.Contacts
        .Where(x => x.SourceTypes.Contains(draft.AudienceType))
        .Where(x => string.IsNullOrWhiteSpace(audienceSearch) ||
            $"{x.ContactName} {x.Email} {x.CustomerCompanyName}".Contains(audienceSearch, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string PreviewTitle => string.IsNullOrWhiteSpace(draft.Name) ? SalesText["DraftCampaign"] : draft.Name;
    private string PreviewSummary => draft.ContactIds.Count == 0
        ? SalesText["SelectContactsPreview"]
        : SalesText["CampaignPreviewSummary", draft.ContactIds.Count, draft.Steps.Count];
    private int ProjectedScheduleDays => draft.Steps.Count == 0 ? 0 : draft.Steps.Max(x => x.DelayDays) + 1;

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            var companyId = ResolvedCompanyId!.Value;
            campaigns = (await SalesApiClient.ListCampaignsAsync(companyId)).ToList();
            audienceOptions = await SalesApiClient.GetCampaignAudienceOptionsAsync(companyId);
            if (selectedCampaign is not null)
            {
                selectedCampaign = await SalesApiClient.GetCampaignAsync(companyId, selectedCampaign.Id);
            }

            EnsureAudienceSource();
            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginNewCampaign()
    {
        draft = CampaignDraft.CreateDefault();
        EnsureAudienceSource();
        validationErrors = [];
        showBuilder = true;
    }

    private void CancelBuilder()
    {
        showBuilder = false;
        validationErrors = [];
    }

    private async Task SelectCampaignAsync(Guid campaignId)
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        actionMessage = null;
        try
        {
            selectedCampaign = await SalesApiClient.GetCampaignAsync(companyId, campaignId);
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
    }

    private async Task ChangeCampaignStateAsync(string action)
    {
        if (ResolvedCompanyId is not Guid companyId || selectedCampaign is null)
        {
            return;
        }

        isSubmitting = true;
        actionMessage = null;
        try
        {
            selectedCampaign = action switch
            {
                "launch" => await SalesApiClient.LaunchCampaignAsync(companyId, selectedCampaign.Id),
                "pause" => await SalesApiClient.PauseCampaignAsync(companyId, selectedCampaign.Id),
                "stop" => await SalesApiClient.StopCampaignAsync(companyId, selectedCampaign.Id, "Stopped from the campaign control page."),
                _ => selectedCampaign
            };
            campaigns = (await SalesApiClient.ListCampaignsAsync(companyId)).ToList();
            actionMessage = action == "launch" ? SalesText["CampaignStartRequested"] : action == "pause" ? SalesText["CampaignPaused"] : SalesText["CampaignStopped"];
            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CreateCampaignAsync()
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        validationErrors = ValidateDraft();
        if (validationErrors.Count > 0)
        {
            return;
        }

        isSubmitting = true;
        actionMessage = null;
        try
        {
            selectedCampaign = await SalesApiClient.CreateCampaignAsync(companyId, new CreateOutboundCampaignRequest(
                draft.Name,
                draft.Description,
                draft.AudienceType,
                draft.ContactIds.ToList(),
                new OutboundPolicyRequest(draft.OutboundEnabled, draft.MaxEmailsPerDay, draft.ApprovalRequired),
                draft.Steps.OrderBy(x => x.StepOrder).Select(x => new CreateSequenceStepRequest(x.StepOrder, x.DelayDays, x.Subject, x.Body, x.AiPersonalizationEnabled)).ToList()));
            campaigns = (await SalesApiClient.ListCampaignsAsync(companyId)).ToList();
            showBuilder = false;
            actionMessage = SalesText["CampaignSaved"];
        }
        catch (SalesApiException ex)
        {
            validationErrors = ex.Errors?.SelectMany(x => x.Value).ToList() ?? [ex.Message];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private List<string> ValidateDraft()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(draft.Name)) errors.Add(SalesText["CampaignNameRequired"]);
        if (string.IsNullOrWhiteSpace(draft.AudienceType)) errors.Add(SalesText["AudienceRequired"]);
        if (draft.ContactIds.Count == 0) errors.Add(SalesText["ContactRequired"]);
        if (draft.Steps.Count < 4) errors.Add(SalesText["FourStepsRequired"]);
        if (draft.MaxEmailsPerDay <= 0) errors.Add(SalesText["DailyLimitRequired"]);
        if (!draft.OutboundEnabled) errors.Add(SalesText["OutboundRequired"]);
        foreach (var step in draft.Steps)
        {
            if (step.DelayDays < 0) errors.Add(SalesText["StepDelayInvalid", step.StepOrder]);
            if (string.IsNullOrWhiteSpace(step.Subject)) errors.Add(SalesText["StepSubjectRequired", step.StepOrder]);
            if (string.IsNullOrWhiteSpace(step.Body)) errors.Add(SalesText["StepBodyRequired", step.StepOrder]);
        }

        return errors;
    }

    private void ToggleContact(Guid contactId, bool selected)
    {
        if (selected)
        {
            draft.ContactIds.Add(contactId);
        }
        else
        {
            draft.ContactIds.Remove(contactId);
        }
    }

    private void SelectAllFiltered()
    {
        foreach (var contact in FilteredAudience)
        {
            draft.ContactIds.Add(contact.ContactId);
        }
    }

    private void AddStep()
    {
        var nextOrder = draft.Steps.Count == 0 ? 1 : draft.Steps.Max(x => x.StepOrder) + 1;
        draft.Steps.Add(new CampaignStepDraft
        {
            StepOrder = nextOrder,
            DelayDays = nextOrder == 1 ? 0 : (nextOrder - 1) * 3,
            Subject = $"Checking in, step {nextOrder}",
            Body = "Hi {{first_name}},\n\nFollowing up to see if this is still useful for your team.\n\nBest,\nAlex",
            AiPersonalizationEnabled = true
        });
    }

    private void EnsureAudienceSource()
    {
        if (audienceOptions.Sources.Count == 0)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(draft.AudienceType) || audienceOptions.Sources.All(x => x.SourceType != draft.AudienceType))
        {
            draft.AudienceType = audienceOptions.Sources[0].SourceType;
        }
    }

    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private string CampaignRowClass(Guid campaignId) => $"sales-list-row sales-list-row--button{(selectedCampaign?.Id == campaignId ? " sales-list-row--selected" : "")}";
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";
    private static string PolicySummary(OutboundPolicyResponse policy) => $"{(policy.OutboundEnabled ? "Outbound enabled" : "Outbound disabled")}, {policy.MaxEmailsPerDay} emails per day, {(policy.ApprovalRequired ? "approval required" : "no launch approval required")}";
    private string TrimDraft(string? value) => string.IsNullOrWhiteSpace(value) ? SalesText["NoDraftContent"] : value.Length <= 180 ? value : $"{value[..180]}...";

    private sealed class CampaignDraft
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string AudienceType { get; set; } = "existing_contacts";
        public HashSet<Guid> ContactIds { get; } = [];
        public bool OutboundEnabled { get; set; } = true;
        public int MaxEmailsPerDay { get; set; } = 50;
        public bool ApprovalRequired { get; set; }
        public List<CampaignStepDraft> Steps { get; } = [];

        public static CampaignDraft CreateDefault()
        {
            var draft = new CampaignDraft();
            for (var i = 1; i <= 4; i++)
            {
                draft.Steps.Add(new CampaignStepDraft
                {
                    StepOrder = i,
                    DelayDays = i == 1 ? 0 : (i - 1) * 3,
                    Subject = i switch
                    {
                        1 => "Quick question for {{company_name}}",
                        2 => "Useful next step?",
                        3 => "Worth a short review?",
                        _ => "Should I close the loop?"
                    },
                    Body = "Hi {{first_name}},\n\nAlex is following up with a short, relevant note for your team.\n\nBest,\nAlex",
                    AiPersonalizationEnabled = true
                });
            }

            return draft;
        }
    }

    private sealed class CampaignStepDraft
    {
        public Guid ClientId { get; } = Guid.NewGuid();
        public int StepOrder { get; set; }
        public int DelayDays { get; set; }
        public string Subject { get; set; } = "";
        public string Body { get; set; } = "";
        public bool AiPersonalizationEnabled { get; set; }
    }
}
