@page "/app/sales/leads"
@rendermode InteractiveServer
@inherits SalesPageBase
@using System.Globalization
@using VirtualCompany.Web.Components.Sales

<PageTitle>@SalesText["SalesLeads"]</PageTitle>

<div class="sales-workspace @(Embedded ? "sales-workspace--embedded" : null)">
    <main class="sales-main">
        @if (!Embedded)
        {
            <header class="sales-page-header">
            <span>@SalesText["Sales"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
            <h1>@SalesText["Leads"]</h1>
            <p>@SalesText["LeadsDescription"]</p>
            <nav class="sales-tabs" aria-label="@SalesText["SalesSections"]">
                <a href="@BuildPath("/app/sales")">@SalesText["Overview"]</a>
                <a class="active" href="@BuildPath("/app/sales/leads")">@SalesText["Leads"]</a>
                <a href="@BuildPath("/app/sales/prospecting")">@SalesText["Prospecting"]</a>
                <a href="@BuildPath("/app/sales/pipeline")">@SalesText["Pipeline"]</a>
                <a href="@BuildPath("/app/sales/campaigns")">@SalesText["Campaigns"]</a>
            </nav>
            </header>
        }

        @if (isLoading)
        {
            <section class="sales-card sales-empty">@SalesText["LoadingLeads"]</section>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <section class="sales-card sales-error">
                <h2>@SalesText["LeadsUnavailable"]</h2>
                <p>@errorMessage</p>
                <button class="sales-button sales-button--primary" @onclick="LoadAsync">@SalesText["Reload"]</button>
            </section>
        }
        else
        {
            <section class="sales-card sales-filter-card">
                <label>
                    <span>@SalesText["SearchLeads"]</span>
                    <input class="sales-input" @bind="searchText" @bind:event="oninput" placeholder="@SalesText["SearchLeadsPlaceholder"]" />
                </label>
                <label>
                    <span>@SalesText["Status"]</span>
                    <select class="sales-input" @bind="statusFilter">
                        <option value="">@SalesText["AllStatuses"]</option>
                        <option value="Open">@SalesStatusPresenter.Present("Open", SalesText)</option>
                        <option value="Qualified">@SalesStatusPresenter.Present("Qualified", SalesText)</option>
                        <option value="Converted">@SalesStatusPresenter.Present("Converted", SalesText)</option>
                        <option value="Rejected">@SalesStatusPresenter.Present("Rejected", SalesText)</option>
                    </select>
                </label>
            </section>

            <section class="sales-card">
                @if (FilteredLeads.Count == 0)
                {
                    <div class="sales-empty">
                        <h2>@SalesText["NoMatchingLeads"]</h2>
                        <p>@SalesText["NoMatchingLeadsMessage"]</p>
                    </div>
                }
                else
                {
                    <div class="sales-table-wrap">
                        <table class="sales-table">
                            <thead>
                                <tr>
                                    <th>@SalesText["Lead"]</th>
                                    <th>@SalesText["SourceEmail"]</th>
                                    <th>@SalesText["Temperature"]</th>
                                    <th>@SalesText["Qualification"]</th>
                                    <th>@SalesText["Confidence"]</th>
                                    <th>@SalesText["Fit"]</th>
                                    <th>@SalesText["Priority"]</th>
                                    <th>@SalesText["SuggestedNextAction"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lead in FilteredLeads)
                                {
                                    <tr @key="lead.Id" class="sales-clickable-row" @onclick="() => OpenLead(lead.Id)">
                                        <td>
                                            <strong>@lead.Title</strong>
                                            <span>@MoneyOrDash(lead.EstimatedValue, lead.Currency)</span>
                                        </td>
                                        <td>@(lead.SourceEmail ?? SalesText["NoEmailLinked"])</td>
                                        <td><span class="@TemperatureClass(lead.Temperature)">@SalesStatusPresenter.Present(lead.Temperature, SalesText)</span></td>
                                        <td><span class="@BadgeClass(lead.QualificationStatus)">@SalesStatusPresenter.Present(lead.QualificationStatus, SalesText)</span></td>
                                        <td>@Confidence(lead.ConfidenceScore)</td>
                                        <td>@(lead.Fit ?? SalesText["NotSet"])</td>
                                        <td>@(lead.Priority is null ? SalesText["NotSet"] : SalesStatusPresenter.Present(lead.Priority, SalesText))</td>
                                        <td>@lead.SuggestedNextAction</td>
                                        <td>
                                            <div class="sales-row-actions">
                                                @if (string.Equals(lead.QualificationStatus, "Qualified", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button class="sales-button sales-button--small sales-button--primary" disabled="@IsBusy(lead.Id)" @onclick:stopPropagation="true" @onclick="() => BeginConvert(lead)">@SalesText["CreateDeal"]</button>
                                                }
                                                else if (string.Equals(lead.QualificationStatus, "Open", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button class="sales-button sales-button--small" disabled="@IsBusy(lead.Id)" @onclick:stopPropagation="true" @onclick="() => QualifyAsync(lead.Id)">@SalesText["Qualify"]</button>
                                                    <button class="sales-button sales-button--small" disabled="@IsBusy(lead.Id)" @onclick:stopPropagation="true" @onclick="() => RejectAsync(lead.Id)">@SalesText["Reject"]</button>
                                                }
                                                else
                                                {
                                                    <span class="sales-row-actions__complete">@SalesStatusPresenter.Present(lead.QualificationStatus, SalesText)</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (leadToConvert is not null)
            {
                <section class="sales-card sales-convert-panel">
                    <div>
                        <span>@SalesText["ConvertLead"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                        <h2>@leadToConvert.Title</h2>
                        <p>@SalesText["ConvertLeadDescription"]</p>
                    </div>
                    <label>
                        <span>@SalesText["DealValue"]</span>
                        <input class="sales-input" type="number" step="0.01" min="1" @bind="convertAmount" />
                    </label>
                    <label>
                        <span>@SalesText["Currency"]</span>
                        <input class="sales-input" maxlength="3" @bind="convertCurrency" />
                    </label>
                    <label>
                        <span>@SalesText["ExpectedCloseDate"]</span>
                        <input class="sales-input" type="date" @bind="convertExpectedCloseDate" @bind:format="yyyy-MM-dd" />
                    </label>
                    <label>
                        <span>@SalesText["Note"]</span>
                        <input class="sales-input" @bind="actionNote" placeholder="@SalesText["AuditNotePlaceholder"]" />
                    </label>
                    <div class="sales-actions">
                        <button class="sales-button sales-button--primary" disabled="@IsBusy(leadToConvert.Id)" @onclick="ConvertAsync">@SalesText["CreateDeal"]</button>
                        <button class="sales-button" @onclick="CancelConvert">@SalesText["Cancel"]</button>
                    </div>
                </section>
            }

            @if (leadToQualify is not null)
            {
                <section class="sales-card sales-convert-panel">
                    <div>
                        <span>@SalesText["QualifyLead"].Value.ToUpper(CultureInfo.CurrentUICulture)</span>
                        <h2>@leadToQualify.Title</h2>
                        <p>@SalesText["QualifyLeadDescription"]</p>
                    </div>
                    <label><span>@SalesText["Fit"]</span><input class="sales-input" @bind="qualificationFit" /></label>
                    <label><span>@SalesText["Temperature"]</span><select class="sales-input" @bind="qualificationTemperature"><option value="Warm">@SalesStatusPresenter.Present("Warm", SalesText)</option><option value="Hot">@SalesStatusPresenter.Present("Hot", SalesText)</option><option value="New">@SalesStatusPresenter.Present("New", SalesText)</option></select></label>
                    <label><span>@SalesText["Priority"]</span><select class="sales-input" @bind="qualificationPriority"><option value="Medium">@SalesText["StatusMedium"]</option><option value="High">@SalesText["StatusHigh"]</option><option value="Low">@SalesText["StatusLow"]</option></select></label>
                    <label><span>@SalesText["SuggestedNextAction"]</span><input class="sales-input" @bind="qualificationNextAction" /></label>
                    <label><span>@SalesText["Note"]</span><input class="sales-input" @bind="actionNote" placeholder="@SalesText["AuditNotePlaceholder"]" /></label>
                    <div class="sales-actions">
                        <button class="sales-button sales-button--primary" disabled="@IsBusy(leadToQualify.Id)" @onclick="SaveQualificationAsync">@SalesText["SaveQualification"]</button>
                        <button class="sales-button" @onclick="CancelQualification">@SalesText["Cancel"]</button>
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(actionMessage))
            {
                <div class="sales-toast">@actionMessage</div>
            }
        }
    </main>

    @if (!Embedded)
    {
        <SalesAgentPanel CompanyId="@ResolvedCompanyId" Dashboard="@AgentPanelDashboard" ErrorMessage="@AgentPanelErrorMessage" />
    }
</div>

@code {
    [Parameter] public bool Embedded { get; set; }
    private bool isLoading = true;
    private string? errorMessage;
    private string? actionMessage;
    private string? searchText;
    private string? statusFilter;
    private string? actionNote;
    private Guid? busyId;
    private List<SalesLeadSummaryResponse> leads = [];
    private SalesLeadSummaryResponse? leadToConvert;
    private SalesLeadSummaryResponse? leadToQualify;
    private string qualificationFit = "Good fit";
    private string qualificationTemperature = "Warm";
    private string qualificationPriority = "Medium";
    private string qualificationNextAction = "Send a personal follow-up";
    private decimal convertAmount = 1000;
    private string convertCurrency = "USD";
    private DateTime? convertExpectedCloseDate;

    protected override async Task OnParametersSetAsync()
    {
        if (!Embedded)
        {
            if (await ResolveCompanyAsync() && ResolvedCompanyId is Guid companyId)
            {
                Navigation.NavigateTo($"/app/sales/prospects?companyId={companyId:D}&view=leads", replace: true);
            }

            return;
        }

        await LoadAsync();
    }

    private IReadOnlyList<SalesLeadSummaryResponse> FilteredLeads => leads
        .Where(x => string.IsNullOrWhiteSpace(statusFilter) || string.Equals(x.QualificationStatus, statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(searchText) ||
            $"{x.Title} {x.SourceEmail} {x.Temperature} {x.SuggestedNextAction}".Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!await ResolveCompanyAsync())
            {
                errorMessage = ShellErrorMessage;
                return;
            }

            leads = (await SalesApiClient.ListLeadsAsync(ResolvedCompanyId!.Value)).ToList();
            await RefreshAgentPanelAsync();
        }
        catch (SalesApiException ex)
        {
            errorMessage = ex.Message;
            AgentPanelErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void QualifyAsync(Guid leadId) => BeginQualification(leads.Single(x => x.Id == leadId));
    private async Task RejectAsync(Guid leadId) => await RunLeadActionAsync(leadId, async companyId => await SalesApiClient.RejectLeadAsync(companyId, leadId, actionNote));

    private async Task RunLeadActionAsync(Guid leadId, Func<Guid, Task> action)
    {
        if (ResolvedCompanyId is not Guid companyId)
        {
            return;
        }

        busyId = leadId;
        actionMessage = null;
        try
        {
            await action(companyId);
            actionMessage = SalesText["LeadUpdated"];
            await LoadAsync();
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            busyId = null;
        }
    }

    private void BeginQualification(SalesLeadSummaryResponse lead)
    {
        leadToQualify = lead;
        qualificationFit = lead.Fit ?? "Good fit";
        qualificationTemperature = lead.Temperature;
        qualificationPriority = lead.Priority ?? "Medium";
        qualificationNextAction = lead.SuggestedNextAction;
    }

    private void CancelQualification() => leadToQualify = null;

    private async Task SaveQualificationAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || leadToQualify is null)
        {
            return;
        }

        busyId = leadToQualify.Id;
        try
        {
            await SalesApiClient.UpdateLeadQualificationAsync(companyId, leadToQualify.Id, new UpdateLeadQualificationRequest(qualificationFit, qualificationTemperature, qualificationPriority, qualificationNextAction, actionNote));
            actionMessage = SalesText["QualificationSaved"];
            leadToQualify = null;
            await LoadAsync();
        }
        catch (SalesApiException ex) { actionMessage = ex.Message; }
        finally { busyId = null; }
    }

    private void BeginConvert(SalesLeadSummaryResponse lead)
    {
        leadToConvert = lead;
        convertAmount = lead.EstimatedValue ?? 1000;
        convertCurrency = string.IsNullOrWhiteSpace(lead.Currency) ? "USD" : lead.Currency;
        convertExpectedCloseDate = DateTime.Today.AddDays(30);
    }

    private void CancelConvert() => leadToConvert = null;

    private async Task ConvertAsync()
    {
        if (ResolvedCompanyId is not Guid companyId || leadToConvert is null)
        {
            return;
        }

        busyId = leadToConvert.Id;
        try
        {
            if (convertExpectedCloseDate is null)
            {
                actionMessage = SalesText["ExpectedCloseDateRequired"];
                return;
            }

            var expectedCloseUtc = DateTime.SpecifyKind(convertExpectedCloseDate.Value.Date, DateTimeKind.Utc);
            var deal = await SalesApiClient.ConvertLeadAsync(companyId, leadToConvert.Id, new ConvertLeadRequest(convertAmount, convertCurrency, expectedCloseUtc, actionNote));
            Navigation.NavigateTo(BuildPath($"/app/sales/deals/{deal.Id:D}"));
        }
        catch (SalesApiException ex)
        {
            actionMessage = ex.Message;
        }
        finally
        {
            busyId = null;
        }
    }

    private bool IsBusy(Guid id) => busyId == id;
    private void OpenLead(Guid leadId) => Navigation.NavigateTo(BuildPath($"/app/sales/leads/{leadId:D}"));
    private string BuildPath(string path) => ResolvedCompanyId is Guid companyId ? $"{path}?companyId={companyId:D}" : path;
    private string Confidence(decimal? confidence) => confidence.HasValue ? LocalNumber.Percentage(confidence.Value) : SalesText["NotScored"];
    private string MoneyOrDash(decimal? value, string? currency) => value.HasValue ? LocalMoney.Format(value.Value, currency ?? "USD") : SalesText["NoValueYet"];
    private static string BadgeClass(string status) => $"sales-badge sales-badge--{status.Replace(" ", "-", StringComparison.Ordinal).ToLowerInvariant()}";
    private static string TemperatureClass(string temperature) => $"sales-badge sales-badge--{temperature.ToLowerInvariant()}";
}
