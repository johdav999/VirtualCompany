                                        <tbody>
                                            @foreach (var item in financeCollectionsPlan.Items.Take(30))
                                            {
                                                <tr><td>@item.CustomerName</td><td>@item.InvoiceNumber<br /><small>@AgentText["DaysOverdue", LocalNumber.Integer(item.DaysOverdue)]</small></td><td>@LocalMoney.Format(item.OutstandingAmount, item.Currency)</td><td><span class="badge text-bg-light">@FormatReasonCode(item.RiskBand)</span></td><td>@FormatReasonCode(item.RecommendedStrategy)<br /><small>@AgentText["ReviewOn", LocalDateTime.Date(DateOnly.FromDateTime(item.NextReviewUtc))]</small></td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (financeAccountingTreatment is not null)
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["Rank"]</th><th scope="col">@AgentText["Account"]</th><th scope="col">@AgentText["Confidence"]</th><th scope="col">@AgentText["Treatment"]</th><th scope="col">@AgentText["Warnings"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var candidate in financeAccountingTreatment.Candidates)
                                            {
                                                <tr><td>@candidate.Rank</td><td><strong>@candidate.AccountCode</strong><br /><small>@candidate.AccountName</small></td><td>@LocalNumber.Percentage(candidate.Confidence)</td><td>@(candidate.PeriodTreatment ?? AgentText["CurrentPeriod"])<br /><small>@(candidate.VatTreatment ?? AgentText["VatEvidenceRequired"])</small></td><td>@string.Join(" · ", candidate.Warnings.Select(FormatReasonCode))</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (financeAccountingTreatment.MissingEvidence.Count > 0)
                                {
                                    <div class="alert alert-warning mt-2 mb-0">@AgentText["MissingEvidence", string.Join(" ", financeAccountingTreatment.MissingEvidence)]</div>
                                }
                            }
                            @if (financeCloseAnalysis is not null)
                            {
                                <div class="finance-payment-summary mt-3">
                                    <span><strong>@(financeCloseAnalysis.IsReadyToClose ? AgentText["Ready"] : AgentText["Blocked"])</strong> @AgentText["AuthoritativeCloseReadiness"]</span>
                                    <span><strong>@LocalNumber.Integer(financeCloseAnalysis.MaterialVariances.Count)</strong> @AgentText["MaterialVariances"]</span>
                                </div>
                                <div class="table-responsive mt-2">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["CloseCheck"]</th><th scope="col">@AgentText["State"]</th><th scope="col">@AgentText["Owner"]</th><th scope="col">@AgentText["Due"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in financeCloseAnalysis.Checklist)
                                            {
                                                <tr><td>@item.Title</td><td><span class="badge text-bg-light">@FormatReasonCode(item.Status)</span></td><td>@item.Owner</td><td>@LocalDateTime.Date(DateOnly.FromDateTime(item.DueUtc))</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (salesNextActions is not null)
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["Priority"]</th><th scope="col">@AgentText["CustomerWork"]</th><th scope="col">@AgentText["RecommendedAction"]</th><th scope="col">@AgentText["Communication"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in salesNextActions.Actions.Take(30))
                                            {
                                                <tr>
                                                    <td><span class="sales-priority-score">@item.PriorityScore</span></td>
                                                    <td><strong>@item.Title</strong><small class="d-block text-body-secondary">@FormatReasonCode(item.SubjectType) · @FormatReasonCode(item.Timing)</small></td>
                                                    <td>@item.Action<small class="d-block text-body-secondary">@string.Join(" · ", item.ReasonCodes.Select(FormatReasonCode))</small></td>
                                                    <td><span class="@(item.CommunicationAllowed ? "badge text-bg-success" : "badge text-bg-warning")">@(item.CommunicationAllowed ? AgentText["Allowed"] : AgentText["InternalOnly"])</span>@if (item.RequiresApproval) { <small class="d-block text-body-secondary">@AgentText["ApprovalRequired"]</small> }</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (salesForecast is not null)
                            {
                                @foreach (var currencyGroup in salesForecast.Scenarios.GroupBy(x => x.Currency))
                                {
                                    <div class="sales-scenario-heading mt-3"><strong>@currencyGroup.Key forecast</strong><small>@currencyGroup.First().DealCount deals in horizon</small></div>
                                    <div class="finance-agent-scenarios" aria-label="@currencyGroup.Key sales forecast scenarios">
                                        @foreach (var scenario in currencyGroup)
                                        {
                                            <article><span>@FormatSalesScenario(scenario.Scenario)</span><strong>@scenario.ExpectedRevenue.ToString("N0") @scenario.Currency</strong><small>@FormatSignedMoney(scenario.ChangeFromBaseline, scenario.Currency) from commit</small><small>@scenario.HighRiskDeals high risk · @scenario.UnknownRiskDeals unknown risk</small></article>
                                        }
                                    </div>
                                }
                                @if (salesForecast.ConcentrationWarnings.Count > 0)
                                {
                                    <div class="alert alert-warning mt-2 mb-0">@string.Join(" ", salesForecast.ConcentrationWarnings)</div>
                                }
                            }
                            @if (salesCampaigns is not null)
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["Campaign"]</th><th scope="col">@AgentText["Evidence"]</th><th scope="col">@AgentText["Recommendation"]</th><th scope="col">@AgentText["PolicyState"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var campaign in salesCampaigns.Campaigns)
                                            {
                                                <tr><td><strong>@campaign.CampaignName</strong></td><td>@AgentText["DeliveredCount", LocalNumber.Integer(campaign.Delivered)]<br /><small>@AgentText["CampaignRates", LocalNumber.Percentage(campaign.ReplyRate, 1), LocalNumber.Percentage(campaign.ConversionRate, 1)]</small></td><td>@campaign.Recommendation</td><td><span class="@(campaign.LaunchAllowed ? "badge text-bg-success" : "badge text-bg-light")">@(campaign.LaunchAllowed ? AgentText["DraftEligible"] : AgentText["ReviewOnly"])</span>@if (campaign.RequiresApproval) { <small class="d-block text-body-secondary">@AgentText["ApprovalRequired"]</small> }</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (supportQueue is not null)
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["Priority"]</th><th scope="col">@AgentText["Case"]</th><th scope="col">@AgentText["Target"]</th><th scope="col">@AgentText["WhyNow"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in supportQueue.Items)
                                            {
                                                <tr><td><span class="sales-priority-score">@LocalNumber.Decimal(item.PriorityScore)</span><small class="d-block text-body-secondary">@FormatReasonCode(item.PriorityBand)</small></td><td><strong>@item.CaseNumber · @item.Subject</strong><small class="d-block text-body-secondary">@FormatReasonCode(item.Category) · @FormatReasonCode(item.Status)</small></td><td>@FormatSupportDeadline(item.ResolutionDueUtc, item.MinutesToResolutionDue)</td><td>@string.Join(" · ", item.ReasonCodes.Select(FormatReasonCode))@if (item.MandatoryEscalation) { <span class="badge text-bg-danger d-block mt-1">@AgentText["MandatoryEscalation"]</span> }</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (supportRisk is not null)
                            {
                                <div class="agent-governance-grid mt-3">
                                    @foreach (var risk in supportRisk.Risks)
                                    {
                                        <article class="agent-governance-item"><div><strong>@risk.CaseNumber · @risk.Subject</strong><small>@string.Join(" · ", risk.ConfirmedRiskTypes.Select(FormatReasonCode))</small><span>@(risk.Hypotheses.Count > 0 ? AgentText["HypothesesValue", string.Join(", ", risk.Hypotheses.Select(FormatReasonCode))] : AgentText["NoAdditionalHypotheses"])</span><small>@AgentText["RouteTo", FormatReasonCode(risk.RequiredRole), FormatSupportDeadline(risk.ResolutionDueUtc, risk.MinutesToResolutionDue)]</small></div><span class="@(risk.MandatoryEscalation ? "badge text-bg-danger" : "badge text-bg-warning")">@FormatReasonCode(risk.Severity)</span></article>
                                    }
                                </div>
                            }
                            @if (supportRecurringIssues is not null)
                            {
                                <div class="agent-governance-grid mt-3">
                                    @foreach (var cluster in supportRecurringIssues.Clusters)
                                    {
                                        <article class="agent-governance-item"><div><strong>@FormatReasonCode(cluster.Category)</strong><small>@AgentText["RelatedCasesVersion", LocalNumber.Integer(cluster.CaseCount), cluster.Version]</small><span>@cluster.RecommendedInvestigation</span><small>@AgentText["HypothesisValue", string.Join(" ", cluster.RootCauseHypotheses)]</small></div><span class="badge text-bg-warning">@AgentText["Review"]</span></article>
                                    }
                                </div>
                            }
                            @if (supportKnowledgeCoverage is not null)
                            {
                                <div class="finance-payment-summary mt-3"><span>@AgentText["OpenKnowledgeGaps", LocalNumber.Integer(supportKnowledgeCoverage.OpenGapCount)]</span><span>@AgentText["RepeatedTopics", LocalNumber.Integer(supportKnowledgeCoverage.RepeatedGapCount)]</span></div>
                                <div class="table-responsive mt-2">
                                    <table class="table table-sm align-middle mb-0"><thead><tr><th scope="col">@AgentText["Topic"]</th><th scope="col">@AgentText["Frequency"]</th><th scope="col">@AgentText["MissingInformation"]</th><th scope="col">@AgentText["KnowledgeState"]</th></tr></thead><tbody>
                                        @foreach (var gap in supportKnowledgeCoverage.Recommendations)
                                        {
                                                <tr><td><strong>@gap.Topic</strong><small class="d-block text-body-secondary">@FormatReasonCode(gap.Category)</small></td><td>@LocalNumber.Integer(gap.Frequency)</td><td>@gap.MissingInformation</td><td><span class="@(gap.ResolutionVerified ? "badge text-bg-success" : "badge text-bg-warning")">@(gap.ResolutionVerified ? AgentText["IndexedAndVerified"] : FormatReasonCode(gap.Status))</span></td></tr>
                                        }
                                    </tbody></table>
                                </div>
                            }
                            @if (roleAnalysisResult is not null)
                            {
                                <div class="agent-ai-result mt-3">
                                    <p>@roleAnalysisResult.Summary</p>
                                    @if (roleAnalysisResult.Metrics.Count > 0)
                                    {
                                        <div class="agent-governance-grid">
                                            @foreach (var metric in roleAnalysisResult.Metrics.Take(6))
                                            {
                                                <div class="agent-priority-item">
                                                    <span>@LocalNumber.Integer((long)metric.Value)</span>
                                                    <div><strong>@metric.Label</strong><small>@AgentText["AsOf", LocalDateTime.DateTime(metric.AsOfUtc)]</small></div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @foreach (var priority in roleAnalysisResult.Priorities.Take(6))
                                    {
                                        <div class="agent-priority-item">
                                            <span>@priority.Score</span>
                                            <div><strong>@priority.Title</strong><small>@priority.Band.Replace('_', ' ') · @string.Join(" · ", priority.ReasonCodes.Select(x => x.Replace('_', ' ')))</small></div>
                                        </div>
                                    }
                                    @foreach (var claim in roleAnalysisResult.Claims.Take(6))
                                    {
                                        <div class="agent-ai-claim"><strong>@FormatClaimType(claim.Type)</strong><span>@claim.Text</span></div>
                                    }
                                    @if (roleAnalysisResult.MissingEvidence.Count > 0)
                                    {
                                        <div class="alert alert-warning mb-0 mt-2">
                                            @AgentText["MissingEvidence", string.Join(", ", roleAnalysisResult.MissingEvidence)]
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                    <details class="agent-plan-review">
                        <summary>@AgentText["PlanWork"]</summary>
                        <div>
                            <label class="form-label" for="agent-plan-objective">@AgentText["Objective"]</label>
                            <textarea id="agent-plan-objective" class="form-control" rows="3" @bind="planObjective" placeholder="@AgentText["PlanObjectivePlaceholder"]"></textarea>
                            <button class="btn btn-outline-primary" type="button" disabled="@(isGeneratingPlan || string.IsNullOrWhiteSpace(planObjective))" @onclick="GenerateSelectedAgentPlanAsync">
                                @AgentText[isGeneratingPlan ? "GeneratingPlan" : "GenerateReviewablePlan"]
                            </button>
                            @if (selectedPlan is not null)
                            {
                                <ol class="agent-plan-steps">
                                    @foreach (var step in selectedPlan.Steps)
                                    {
                                        <li><strong>@step.Title</strong><span>@step.CompletionEvidence</span></li>
                                    }
                                </ol>
                                <button class="btn btn-primary" type="button" disabled="@(isCommittingPlan || selectedPlan.Status != "draft")" @onclick="CommitSelectedAgentPlanAsync">
                                    @AgentText[isCommittingPlan ? "CreatingTasks" : "CommitPlanTasks"]
                                </button>
                            }
                        </div>
                    </details>
                    <div class="agent-governance-grid">
                        <section class="agent-governance-panel" aria-labelledby="agent-handoffs-heading">
                            <div class="agent-governance-panel__header">
                                <div><h3 id="agent-handoffs-heading">@AgentText["AgentHandoffs"]</h3><p>@AgentText["AgentHandoffsDescription"]</p></div>
                                <span class="badge text-bg-light">@selectedHandoffs.Count</span>
                            </div>
                            @if (selectedHandoffs.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@AgentText["NoActiveHandoffs"]</p>
                            }
                            else
                            {
                                @foreach (var handoff in selectedHandoffs.Take(5))
                                {
                                    <article class="agent-governance-item">
                                        <div><strong>@handoff.Objective</strong><small>@FormatHandoffStatus(handoff.Status) · Due @FormatDueDate(handoff.DueUtc)</small></div>
                                        @if (handoff.ReceivingAgentId == selectedAgentId && handoff.Status == "proposed")
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => TransitionHandoffAsync(handoff.Id, "accepted"))">@AgentText["Accept"]</button>
                                        }
                                        else if (handoff.ReceivingAgentId == selectedAgentId && handoff.Status == "accepted")
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => TransitionHandoffAsync(handoff.Id, "in_progress"))">@AgentText["Start"]</button>
                                        }
                                    </article>
                                }
                            }
                        </section>
                        <section class="agent-governance-panel" aria-labelledby="agent-memory-heading">
                            <div class="agent-governance-panel__header">
                                <div><h3 id="agent-memory-heading">@AgentText["MemoryReview"]</h3><p>@AgentText["MemoryReviewDescription"]</p></div>
                                <span class="badge text-bg-light">@selectedMemoryCandidates.Count</span>
                            </div>
                            @if (selectedMemoryCandidates.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@AgentText["NoMemorySuggestions"]</p>
                            }
                            else
                            {
                                @foreach (var candidate in selectedMemoryCandidates.Take(5))
                                {
                                    <article class="agent-governance-item agent-governance-item--stacked">
                                        <div><strong>@FormatMemoryType(candidate.MemoryType)</strong><p>@candidate.Content</p><small>@candidate.Scope · Confidence @candidate.Confidence.ToString("P0")</small></div>
                                        <div class="agent-governance-actions">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => ReviewMemoryAsync(candidate.Id, false))">@AgentText["Reject"]</button>
                                            <button class="btn btn-sm btn-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => ReviewMemoryAsync(candidate.Id, true))">@AgentText["Approve"]</button>
                                        </div>
                                    </article>
                                }
                            }
                        </section>
                    </div>
                }
            </section>
        }

        <details id="hire-agent" class="agents-advanced-panel">
            <summary>
                <span>@AgentText["HireAnotherAgent"]</span>
                <small>@AgentText["HireAnotherAgentDescription"]</small>
            </summary>
        <div class="agent-layout">
            <div class="wizard-card">
                <span class="dashboard-kicker">@AgentText["TemplateCatalog"]</span>
                <h2>@AgentText["AgentRoles"]</h2>
                <p class="text-body-secondary">@AgentText["TemplateCatalogDescription"]</p>

                <div class="agent-template-grid mt-4">
                    @foreach (var template in templates)
                    {
                        var isSelected = string.Equals(selectedTemplateId, template.TemplateId, StringComparison.OrdinalIgnoreCase);
                        <button class="template-card agent-template-card @(isSelected ? "is-selected" : null)"
                                type="button"
                                @onclick="@(() => SelectTemplate(template.TemplateId))">
                            <div class="agent-template-header">
                                <strong>@template.RoleName</strong>
                                <span class="badge text-bg-light">@template.DefaultSeniority</span>
                            </div>
                            <div class="text-body-secondary">@template.Department</div>
                            <p class="mb-0 mt-3">@template.PersonaSummary</p>
                        </button>
                    }
                </div>
            </div>

            <div class="wizard-card">
                <h2 class="h4 mb-3">@AgentText["CustomizeAndHire"]</h2>

                @if (selectedTemplate is null)
                {
                    <p class="text-body-secondary mb-0">@AgentText["SelectTemplate"]</p>
                }
                else
                {
                    <EditForm Model="@hireModel" OnValidSubmit="@HandleHireAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="display-name">@AgentText["Name"]</label>
                            <InputText id="display-name" class="form-control" @bind-Value="hireModel.DisplayName" />
                            <ValidationMessage For="@(() => hireModel.DisplayName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="avatar-url">@AgentText["AvatarReference"]</label>
                            <InputText id="avatar-url" class="form-control" @bind-Value="hireModel.AvatarUrl" />
                            <div class="form-text">@AgentText["AvatarReferenceHelp"]</div>
                            <ValidationMessage For="@(() => hireModel.AvatarUrl)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="department">@AgentText["Department"]</label>
                            <InputText id="department" class="form-control" @bind-Value="hireModel.Department" />
                            <ValidationMessage For="@(() => hireModel.Department)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="role-name">@AgentText["Role"]</label>
                            <InputText id="role-name" class="form-control" @bind-Value="hireModel.RoleName" />
                            <ValidationMessage For="@(() => hireModel.RoleName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="seniority">@AgentText["Seniority"]</label>
                            <InputSelect id="seniority" class="form-select" @bind-Value="hireModel.Seniority">
                                @foreach (var option in seniorityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => hireModel.Seniority)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="personality">@AgentText["Personality"]</label>
                            <InputTextArea id="personality" class="form-control" rows="4" @bind-Value="hireModel.Personality" />
                            <ValidationMessage For="@(() => hireModel.Personality)" />
                        </div>

                        <div class="dashboard-actions">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">@AgentText["HireAgent"]</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="@ResetSelectedTemplate">@AgentText["ResetDefaults"]</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
        </details>

        <div id="agent-access-configuration" class="agents-access-panel">
            <div class="agent-roster-header">
                <div>
                    <span class="dashboard-kicker">@AgentText["JointAccessBrief"]</span>
                    <h2>@AgentText["SharedCompanySources"]</h2>
                </div>
                <div class="dashboard-actions">
                    <a class="btn btn-outline-secondary" href="@BuildFinanceIntegrationSettingsHref()">
                        <span class="bi bi-plug" aria-hidden="true"></span>
                        @AgentText["FinanceIntegrations"]
                    </a>
                </div>
            </div>
            <p class="text-body-secondary mt-3 mb-0">@AgentText["SharedSourcesDescription"]</p>

            <section class="agent-source-connection-step" aria-labelledby="agent-source-connection-title">
                <div>
                    <span class="agent-access-step">1</span>
                    <div>
                        <h3 id="agent-source-connection-title">@AgentText["MailboxProviderSetupTitle"]</h3>
                        <p>@AgentText["MailboxProviderSetupDescription"]</p>
                    </div>
                </div>
            </section>

            @if (isLoadingMailboxConfiguration)
            {
                <p class="text-body-secondary mt-3">@AgentText["LoadingMailboxConfiguration"]</p>
            }
            else
            {
                @if (CanManageProviderSettings)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3">
                        <p class="text-body-secondary mb-0">@AgentText["MailboxProviderSetupManagedDescription"]</p>
                        <a class="btn btn-outline-primary" href="@BuildEmailProviderSettingsHref()">
                            <span class="bi bi-gear" aria-hidden="true"></span>
                            @AgentText["ConfigureEmailProvider"]
                        </a>
                    </div>
                }
                else if (!CanManageProviderSettings)
                {
                    <p class="agent-source-availability-note mt-3">
                        <span class="bi bi-shield-lock" aria-hidden="true"></span>
                        @AgentText["ProviderSettingsOwnerAdminOnly"]
                    </p>
                }

                <div id="team-mailboxes" class="agent-mailbox-section-heading">
                    <span class="agent-access-step">2</span>
                    <div>
                        <h3>@AgentText["ConnectTeamMailboxesTitle"]</h3>
                        <p>@AgentText["ConnectTeamMailboxesDescription"]</p>
                    </div>
                </div>

                <div class="agent-mailbox-grid">
                    @foreach (var mailbox in MailboxPurposeDefinitions)
                    {
                        var mailboxStatus = GetMailboxStatus(mailbox.Purpose);
                        <article class="agent-mailbox-card">
                            <div class="agent-mailbox-card-header">
                                <div>
                                    <span class="bi @mailbox.Icon" aria-hidden="true"></span>
                                    <h4>@AgentText[mailbox.TitleKey]</h4>
                                </div>
                                <span class="badge @(mailboxStatus?.IsConnected == true ? "text-bg-success" : "text-bg-light")">
                                    @(mailboxStatus?.IsConnected == true ? AgentText["MailboxConnected"] : AgentText["MailboxNotConnected"])
                                </span>
                            </div>
                            <p>@AgentText[mailbox.DescriptionKey]</p>
                            @if (mailboxStatus?.IsConnected == true)
                            {
                                <dl class="agent-mailbox-details">
                                    <div><dt>@AgentText["EmailAddress"]</dt><dd>@mailboxStatus.EmailAddress</dd></div>
                                    <div><dt>@AgentText["Provider"]</dt><dd>@GetProviderDisplayName(mailboxStatus.Provider)</dd></div>
                                </dl>
                            }
                            else
                            {
                                <p class="agent-mailbox-empty">@AgentText["MailboxConnectHelp"]</p>
                            }

                            <div class="agent-mailbox-actions">
                                @RenderMailboxProviderAction(mailbox.Purpose, "gmail", "Gmail", mailboxStatus?.IsConnected == true)
                                @RenderMailboxProviderAction(mailbox.Purpose, "microsoft365", "Microsoft 365", mailboxStatus?.IsConnected == true)
                                @if (mailboxStatus?.IsConnected == true)
                                {
                                    <button class="btn btn-link text-danger" type="button" disabled="@IsMailboxActionRunning(mailbox.Purpose)"
                                            @onclick="@(() => DisconnectMailboxAsync(mailbox.Purpose))">
                                        @AgentText["DisconnectMailbox"]
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>

                @if (!IsAnyMailboxProviderAvailable)
                {
                    <p class="agent-source-availability-note mt-3">
                        <span class="bi bi-info-circle" aria-hidden="true"></span>
                        @AgentText["ConfigureProviderBeforeMailbox"]
                    </p>
                }
            }

            <div class="agents-access-list mt-3">
                @foreach (var source in BuildAgentSourceCards())
                {
                    <article class="agents-access-row">
                        <div>
                            <h3>@source.Title</h3>
                            <p>@source.Description</p>
                        </div>
                        <div><span>@AgentText["Authentication"]</span><strong>@source.Authentication</strong></div>
                        <div><span>@AgentText["Access"]</span><strong>@source.Owner</strong></div>
                        <span class="@source.BadgeCss">@source.Badge</span>
                    </article>
                }
            </div>

            @if (CanManageProfiles && selectedAgentProfile is not null)
            {
                <div class="border-top pt-3 mt-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div class="agent-access-step-heading">
                            <span class="agent-access-step">3</span>
                            <div>
                                <h3 class="h5 mb-1">@AgentText["SelectedAgentAccessBrief"]</h3>
                                <p class="text-body-secondary mb-0">
                                    @AgentText["SelectedAgentAccessDescription", selectedAgentProfile.DisplayName]
                                </p>
                            </div>
                        </div>
                        <span class="badge text-bg-light">@selectedAgentProfile.Department</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-authentication">@AgentText["EmailAuthentication"]</label>
                            <InputSelect id="brief-authentication" class="form-select" @bind-Value="jointBriefModel.EmailAuthentication">
                                <option value="oauth_user_mailbox">@AgentText["AuthOAuthMailbox"]</option>
                                <option value="app_oauth_client">@AgentText["AuthAppOAuthClient"]</option>
                                <option value="provider_api_key">@AgentText["AuthProviderCredential"]</option>
                                <option value="manual_upload_only">@AgentText["AuthManualUpload"]</option>
                            </InputSelect>
                            <div class="form-text">@AgentText["SecretsLocationHelp"]</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-source-owner">@AgentText["PrimaryOwner"]</label>
                            <InputSelect id="brief-source-owner" class="form-select" @bind-Value="jointBriefModel.PrimaryOwner">
                                <option value="finance">@AgentText["OwnerFinance"]</option>
                                <option value="sales">@AgentText["OwnerSales"]</option>
                                <option value="customer_support">@AgentText["OwnerSupport"]</option>
                                <option value="shared_operations">@AgentText["OwnerSharedOperations"]</option>
                            </InputSelect>
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-review">@AgentText["ReviewMode"]</label>
                            <InputSelect id="brief-review" class="form-select" @bind-Value="jointBriefModel.ReviewMode">
                                <option value="human_review_required">@AgentText["ReviewHumanRequired"]</option>
                                <option value="low_risk_autonomous">@AgentText["ReviewLowRiskAutonomous"]</option>
                                <option value="read_only">@AgentText["ReviewReadOnly"]</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["EmailSources"]</legend>
                                @RenderBriefCheckbox(AgentText["FinanceMailbox"], () => jointBriefModel.FinanceMailbox, value => jointBriefModel.FinanceMailbox = value)
                                @RenderBriefCheckbox(AgentText["SalesMailbox"], () => jointBriefModel.SalesMailbox, value => jointBriefModel.SalesMailbox = value)
                                @RenderBriefCheckbox(AgentText["SupportMailbox"], () => jointBriefModel.SupportMailbox, value => jointBriefModel.SupportMailbox = value)
                            </fieldset>
                        </div>
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["WebEnquiries"]</legend>
                                @RenderBriefCheckbox(AgentText["WebsiteContactForms"], () => jointBriefModel.WebContactForms, value => jointBriefModel.WebContactForms = value)
                                @RenderBriefCheckbox(AgentText["SalesLeadForms"], () => jointBriefModel.SalesLeadForms, value => jointBriefModel.SalesLeadForms = value)
                                @RenderBriefCheckbox(AgentText["SupportWebRequests"], () => jointBriefModel.SupportWebRequests, value => jointBriefModel.SupportWebRequests = value)
                            </fieldset>
                        </div>
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["Documents"]</legend>
                                @RenderBriefCheckbox(AgentText["CompanyPolicies"], () => jointBriefModel.CompanyPolicies, value => jointBriefModel.CompanyPolicies = value)
                                @RenderBriefCheckbox(AgentText["ProductCatalog"], () => jointBriefModel.ProductCatalog, value => jointBriefModel.ProductCatalog = value)
                                @RenderBriefCheckbox(AgentText["UploadedKnowledgeDocuments"], () => jointBriefModel.KnowledgeDocuments, value => jointBriefModel.KnowledgeDocuments = value)
                            </fieldset>
                        </div>
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["BusinessSystems"]</legend>
                                @RenderBriefCheckbox(AgentText["FortnoxFinanceData"], () => jointBriefModel.FortnoxFinance, value => jointBriefModel.FortnoxFinance = value)
                                @RenderBriefCheckbox(AgentText["CustomerRecords"], () => jointBriefModel.CustomerRecords, value => jointBriefModel.CustomerRecords = value)
                                @RenderBriefCheckbox(AgentText["OrderInvoiceRecords"], () => jointBriefModel.OrderAndInvoiceRecords, value => jointBriefModel.OrderAndInvoiceRecords = value)
                            </fieldset>
                        </div>
                    </div>

                    <div class="dashboard-actions mt-3">
                        <button class="btn btn-primary" type="button" @onclick="ApplyJointBriefToSelectedAgent">@AgentText["ApplyToSelectedAgent"]</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="LoadRecommendedJointBriefForSelectedAgent">@AgentText["UseRecommendedAccess"]</button>
                    </div>
                    <p class="small text-body-secondary mb-0 mt-2">
                        @AgentText["ApplyAccessHelp"]
                    </p>
                </div>
            }
            else
            {
                <p class="text-body-secondary mb-0 mt-4">@AgentText["SelectAgentForAccess"]</p>
            }
        </div>

        @if (CanManageProfiles)
        {
            <details id="agent-operating-profile" class="agents-advanced-panel mt-4">
                <summary>
                    <span>@AgentText["AdvancedOperatingProfile"]</span>
                    <small>@AgentText["AdvancedOperatingProfileDescription"]</small>
                </summary>
            <div class="wizard-card">
                <div class="agent-roster-header">
                    <div>
                        <span class="dashboard-kicker">@AgentText["OperatingProfile"]</span>
                        <h2 class="h4 mb-0 mt-2">@AgentText["AgentConfiguration"]</h2>
                    </div>
                    <p class="text-body-secondary mb-0">@AgentText["AgentConfigurationDescription"]</p>
                </div>

                @if (selectedAgentProfile is null)
                {
                    <p class="text-body-secondary mb-0 mt-3">@AgentText["SelectAgentForOperatingProfile"]</p>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(profileErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">@profileErrorMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(profileSuccessMessage))
                    {
                        <div class="alert alert-success mt-3">@profileSuccessMessage</div>
                    }

                    <EditForm Model="@profileModel" OnValidSubmit="@HandleProfileSaveAsync" class="mt-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="profile-status">@AgentText["Status"]</label>
                                <InputSelect id="profile-status" class="form-select" @bind-Value="profileModel.Status" disabled="@(!CanEditSelectedAgentStatus)">
                                    @foreach (var status in GetStatusOptionsForSelectedAgent())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => profileModel.Status)" />
                                <div class="form-text">
                                    @AgentText["PausedArchivedAssignmentHelp"]
                                    @if (selectedAgentProfile.Visibility.CanPauseOrRestrictAgent)
                                    {
                                        <span> @AgentText["StatusOwnerAdminHelp"]</span>
                                    }
                                    else
                                    {
                                        <span> @AgentText["StatusManagerHelp"]</span>
                                    }
                                </div>
                                @foreach (var error in GetProfileErrors(nameof(AgentOperatingProfileFormModel.Status)))
                                {
                                    <div class="text-danger small mt-1">@error</div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="profile-autonomy">@AgentText["Autonomy"]</label>
                                <InputSelect id="profile-autonomy" class="form-select" @bind-Value="profileModel.AutonomyLevel" disabled="@(!selectedAgentProfile.Visibility.CanEditSensitiveGovernance)">
                                    @foreach (var level in GetAutonomyOptionsForSelectedAgent())
                                    {
                                        <option value="@level">@ToDisplayText(level)</option>
                                    }
                                </InputSelect>
                                <div class="form-text">
                                    @if (selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                                    {
                                        <span>@AgentText["GovernanceSettingsHelp"]</span>
                                    }
                                    else
                                    {
                                        <span>@AgentText["AutonomyRestrictedHelp"]</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="profile-updated">@AgentText["LastUpdated"]</label>
                                <input id="profile-updated" class="form-control" value="@LocalDateTime.DateTime(selectedAgentProfile.UpdatedUtc)" disabled />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label" for="role-brief">@AgentText["RoleBrief"]</label>
                            <InputTextArea id="role-brief" class="form-control" rows="3" @bind-Value="profileModel.RoleBrief" disabled="@(!selectedAgentProfile.Visibility.CanEditRoleBrief)" />
                            <ValidationMessage For="@(() => profileModel.RoleBrief)" />
                            @foreach (var error in GetProfileErrors(nameof(AgentOperatingProfileFormModel.RoleBrief)))
                            {
                                <div class="text-danger small mt-1">@error</div>
                            }
                        </div>

                        @RenderJsonEditor(AgentText["ObjectivesJson"], "Objectives", () => profileModel.ObjectivesJson, !selectedAgentProfile.Visibility.CanEditObjectives)
                        @RenderJsonEditor(AgentText["Kpis"], "Kpis", () => profileModel.KpisJson, !selectedAgentProfile.Visibility.CanEditKpis)

                        @if (selectedAgentProfile.Visibility.CanViewPermissions)
                        {
                            @RenderJsonEditor(AgentText["DetailToolPermissions"], "ToolPermissions", () => profileModel.ToolPermissionsJson, !selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                            @RenderJsonEditor(AgentText["DataScopes"], "DataScopes", () => profileModel.DataScopesJson, !selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                        }
                        else
                        {
                            <p class="text-body-secondary mt-3 mb-0">@AgentText["PermissionsHidden"]</p>
                        }

                        @if (selectedAgentProfile.Visibility.CanViewThresholds)
                        {
                            @RenderJsonEditor(AgentText["DetailApprovalThresholds"], "ApprovalThresholds", () => profileModel.ApprovalThresholdsJson, !selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                            @RenderJsonEditor(AgentText["DetailEscalationRules"], "EscalationRules", () => profileModel.EscalationRulesJson, !selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                            @RenderJsonEditor(AgentText["TriggerLogic"], "TriggerLogic", () => profileModel.TriggerLogicJson, !selectedAgentProfile.Visibility.CanEditSensitiveGovernance)
                        }
                        else
                        {
                            <p class="text-body-secondary mt-3 mb-0">@AgentText["ThresholdsHidden"]</p>
                        }

                        @if (selectedAgentProfile.Visibility.CanViewWorkingHours)
                        {
                            @RenderJsonEditor(AgentText["DetailWorkingHours"], "WorkingHours", () => profileModel.WorkingHoursJson, !selectedAgentProfile.Visibility.CanEditWorkingHours)
                        }
                        else
                        {
                            <p class="text-body-secondary mt-3 mb-0">@AgentText["WorkingHoursHidden"]</p>
                        }

                        <div class="dashboard-actions mt-3">
                            <button class="btn btn-primary" type="submit" disabled="@isSavingProfile">@AgentText["SaveOperatingProfile"]</button>
                            <a class="btn btn-outline-secondary" href="@BuildProfileUri(selectedAgentId ?? Guid.Empty)">@AgentText["OpenCanonicalProfile"]</a>
                        </div>
                    </EditForm>
                }
            }
            </div>
            </details>
        }

        <details class="agents-advanced-panel mt-4">
            <summary>
                <span>@AgentText["DirectoryFilters"]</span>
                <small>@AgentText["DirectoryFiltersDescription"]</small>
            </summary>
        <div class="wizard-card">
            <div class="agent-roster-header">
                <div>
                    <span class="dashboard-kicker">@AgentText["CompanyRoster"]</span>
                    <h2 class="h4 mb-0 mt-2">@AgentText["CompanyAgents"]</h2>
                </div>
                <span class="badge text-bg-light">@AgentText["TotalCount", rosterResponse.Items.Count]</span>
            </div>

            @if (!canViewDirectory)
            {
                <p class="text-body-secondary mb-0 mt-3">@AgentText["RestrictedRosterShort"]</p>
            }
            else
            {
                <div class="agent-filter-bar mt-4">
                    <div>
                        <label class="form-label" for="department-filter">@AgentText["Department"]</label>
                        <InputSelect id="department-filter" class="form-select" @bind-Value="Department">
                            <option value="">@AgentText["AllDepartments"]</option>
                            @foreach (var department in rosterResponse.Departments)
                            {
                                <option value="@department">@department</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="form-label" for="status-filter">@AgentText["Status"]</label>
                        <InputSelect id="status-filter" class="form-select" @bind-Value="Status">
                            <option value="">@AgentText["AllStatuses"]</option>
                            @foreach (var status in rosterResponse.Statuses)
                            {
                                <option value="@status">@GetStatusLabel(status)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="dashboard-actions">
                        <button class="btn btn-primary" type="button" @onclick="ApplyFilters">@AgentText["ApplyFilters"]</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearFilters">@AgentText["ClearFilters"]</button>
                    </div>
                </div>

                @if (rosterResponse.Items.Count == 0)
                {
                    <p class="text-body-secondary mb-0 mt-4">@AgentText["NoAgentsMatch"]</p>
                }
                else
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@AgentText["Name"]</th>
                                    <th scope="col">@AgentText["Role"]</th>
                                    <th scope="col">@AgentText["Department"]</th>
                                    <th scope="col">@AgentText["Status"]</th>
                                    <th scope="col">@AgentText["Autonomy"]</th>
                                    <th scope="col">@AgentText["WorkloadAndHealth"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agent in rosterResponse.Items)
                                {
                                    <tr class="@(selectedAgentId == agent.Id ? "table-active" : null)">
                                        <th scope="row">
                                            <a class="fw-semibold text-decoration-none" href="@GetProfileRoute(agent)">@agent.DisplayName</a>
                                            @if (CanManageProfiles)
                                            {
                                                <div class="mt-2">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="@(() => OpenEditor(agent.Id))">@AgentText["Configure"]</button>
                                                </div>
                                            }
                                            @if (IsDirectChatEligible(agent.Status))
                                            {
                                                <div class="mt-2"><a class="btn btn-sm btn-primary" href="@BuildChatUri(agent.CompanyId, agent.Id)">@AgentText["Chat"]</a></div>
                                            }
                                        </th>
                                        <td>@agent.RoleName</td>
                                        <td>@agent.Department</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeCss(agent.Status)">@GetStatusLabel(agent.Status)</span>
                                        </td>
                                        <td>@ToDisplayText(agent.AutonomyLevel)</td>
                                        <td>
                                            <div class="fw-semibold @GetHealthCss(agent.WorkloadSummary.HealthStatus)">@agent.WorkloadSummary.Summary</div>
                                            <div class="small text-body-secondary mt-1">@FormatRosterActivity(agent.WorkloadSummary.LastActivityUtc)</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
        </details>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [SupplyParameterFromQuery(Name = "department")]
    public string? Department { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "agentId")]
    public Guid? AgentId { get; set; }

    private static readonly JsonSerializerOptions JsonEditorOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private readonly string[] seniorityOptions = [ "junior", "mid", "senior", "lead", "executive" ];
    private readonly string[] autonomyOptions = [ "level_0", "level_1", "level_2", "level_3" ];
    private readonly string[] statusOptions = [ "active", "paused", "restricted", "archived" ];
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isSavingProfile;
    private string? errorMessage;
    private string? successMessage;
    private string? profileErrorMessage;
    private string? profileSuccessMessage;
    private CurrentUserContextViewModel? currentUser;
    private CompanyAccessViewModel? companyAccess;
    private List<AgentTemplateCatalogItemViewModel> templates = [];
    private AgentRosterResponseViewModel rosterResponse = new();
    private HireAgentFormModel hireModel = new();
    private AgentOperatingProfileViewModel? selectedAgentProfile;
    private AgentOperatingProfileFormModel profileModel = new();
    private JointAgentBriefFormModel jointBriefModel = new();
    private AgentBriefFormModel agentBriefModel = new();
    private List<AgentBriefDocumentViewModel> briefDocuments = [];
    private AgentCapabilityCatalogViewModel? selectedAgentCapabilities;
    private Dictionary<string, string[]> profileErrors = new(StringComparer.OrdinalIgnoreCase);
    private Guid? selectedAgentId;
    private string? selectedTemplateId;
    private string selectedBriefCategory = "company_information";
    private bool shareBriefDocumentsWithTeam;
    private bool isBriefDirty;

    private async Task HandleLocationChangingAsync(LocationChangingContext context)
    {
        if (!isBriefDirty)
        {
            return;
        }

        var shouldLeave = await JS.InvokeAsync<bool>(
            "confirm",
            AgentText["UnsavedBriefNavigationWarning"].Value);
        if (!shouldLeave)
        {
            context.PreventNavigation();
        }
    }
    private bool isSavingBrief;
    private bool isGeneratingBriefDraft;
    private bool isGeneratedBriefDraft;
    private bool isUploadingBriefDocument;
    private bool isLoadingCapabilities;
    private bool isLoadingMailboxConfiguration;
    private string? mailboxActionPurpose;
    private MailboxProviderAvailabilityResponse mailboxProviderAvailability = new();
    private readonly Dictionary<string, MailboxConnectionStatusResponse> mailboxStatuses = new(StringComparer.OrdinalIgnoreCase);
    private string? capabilityErrorMessage;
    private string agentQuestion = string.Empty;
    private AgentQuestionAnswerViewModel? questionAnswer;
    private List<AgentWorkPriorityViewModel> selectedPriorities = [];
    private AgentAiQualityMetricsViewModel? selectedQuality;
    private string planObjective = string.Empty;
    private AgentPlanViewModel? selectedPlan;
    private List<AgentHandoffViewModel> selectedHandoffs = [];
    private List<AgentMemoryCandidateViewModel> selectedMemoryCandidates = [];
    private bool isAskingQuestion;
    private bool isGeneratingPlan;
    private bool isCommittingPlan;
    private bool isUpdatingGovernance;
    private bool isRunningRoleAnalysis;
    private string roleAnalysisType = string.Empty;
    private string roleAnalysisObjective = string.Empty;
    private RoleAgentAnalysisViewModel? roleAnalysisResult;
    private FinanceCashScenarioAnalysisRequestViewModel financeCashRequest = new();
    private FinanceCashScenarioAnalysisViewModel? financeCashAnalysis;
    private FinancePaymentRunAnalysisRequestViewModel financePaymentRunRequest = new();
    private FinancePaymentRunAnalysisViewModel? financePaymentRun;
    private FinanceCollectionsPlanViewModel? financeCollectionsPlan;
    private IReadOnlyList<FinanceBillResponse> financeBills = [];
    private IReadOnlyList<FinanceClosePeriodOptionViewModel> financeClosePeriods = [];
    private Guid selectedAccountingBillId;
    private Guid selectedClosePeriodId;
    private FinanceAccountingTreatmentViewModel? financeAccountingTreatment;
    private FinanceCloseAnalysisRequestViewModel financeCloseRequest = new();
    private FinanceCloseAnalysisViewModel? financeCloseAnalysis;
    private readonly HashSet<Guid> selectedPaymentBillIds = [];
    private bool paymentRunReviewed;
    private bool isCommittingPaymentRun;
    private CommitFinancePaymentRunResultViewModel? paymentRunCommitResult;
    private SalesNextBestActionViewModel? salesNextActions;
    private SalesForecastScenarioResultViewModel? salesForecast;
    private SalesCampaignOptimizationResultViewModel? salesCampaigns;
    private SupportQueueAnalysisResultViewModel? supportQueue;
    private SupportRiskAssessmentResultViewModel? supportRisk;
    private SupportRecurringIssueResultViewModel? supportRecurringIssues;
    private SupportKnowledgeCoverageResultViewModel? supportKnowledgeCoverage;
    private string? briefErrorMessage;
    private string? briefSuccessMessage;
    private CancellationTokenSource? briefDocumentTrackingCts;
    private bool isNavigatingAway;
    private bool isDisposed;

    private static readonly IReadOnlyList<BriefingCategoryDefinition> BriefingCategories =
    [
        new("company_information", "CO", "BriefCategoryCompanyLabel", "BriefCategoryCompanyDescription", "BriefCategoryCompanyPlaceholder"),
        new("products_and_services", "PR", "BriefCategoryProductsLabel", "BriefCategoryProductsDescription", "BriefCategoryProductsPlaceholder"),
        new("policies", "PO", "BriefCategoryPoliciesLabel", "BriefCategoryPoliciesDescription", "BriefCategoryPoliciesPlaceholder"),
        new("customer_support", "CS", "BriefCategorySupportLabel", "BriefCategorySupportDescription", "BriefCategorySupportPlaceholder"),
        new("other_instructions", "IN", "BriefCategoryOtherLabel", "BriefCategoryOtherDescription", "BriefCategoryOtherPlaceholder")
    ];

    private BriefingCategoryDefinition SelectedBriefCategory =>
        BriefingCategories.First(category => category.Key == selectedBriefCategory);

    private string CurrentBriefText
    {
        get => agentBriefModel.Get(selectedBriefCategory);
        set => agentBriefModel.Set(selectedBriefCategory, value);
    }

    private IReadOnlyList<AgentBriefDocumentViewModel> BriefDocumentsForSelectedCategory =>
        AgentBriefDocumentStatusPresenter.Deduplicate(
            briefDocuments.Where(document => IsBriefDocumentForAgentAndCategory(document, selectedAgentId, selectedBriefCategory)))
            .OrderByDescending(document => document.UpdatedUtc)
            .ToList();

    private IReadOnlyList<CompanyMembershipViewModel> activeMemberships =>
        currentUser?.Memberships.Where(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase)).ToList()
        ?? [];

    private IReadOnlyList<RoleAnalysisOption> RoleAnalysisOptions => (selectedAgentProfile?.Department ?? string.Empty).ToLowerInvariant() switch
    {
        "finance" =>
        [
            new("cash_liquidity", "Cash and liquidity"), new("payables", "Payables"),
            new("receivables", "Receivables"), new("accounting_treatment", "Accounting treatment"),
            new("close_analysis", "Close readiness"), new("operating_cadence", "Finance priorities")
        ],
        "sales" =>
        [
            new("lead_intelligence", "Lead intelligence"), new("next_best_action", "Next best actions"),
            new("deal_risk", "Deal risk"), new("forecast_analysis", "Forecast"),
            new("campaign_optimization", "Campaigns"), new("proposal_advice", "Proposal advice"),
            new("operating_cadence", "Sales priorities")
        ],
        "support" or "customer support" =>
        [
            new("triage_analysis", "Queue triage"), new("grounded_reply", "Grounded reply"),
            new("risk_escalation", "Risk and escalation"), new("root_cause_analysis", "Recurring issues"),
            new("knowledge_coverage", "Knowledge coverage"), new("operating_cadence", "Support priorities")
        ],
        _ => []
    };

    private AgentTemplateCatalogItemViewModel? selectedTemplate =>
        templates.FirstOrDefault(x => string.Equals(x.TemplateId, selectedTemplateId, StringComparison.OrdinalIgnoreCase));

    // Owner, admin, and manager memberships can open the operating-profile experience.
    private bool CanManageProfiles =>
        string.Equals(companyAccess?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    private bool CanEditSelectedAgentStatus =>
        selectedAgentProfile is not null &&
        selectedAgentProfile.Visibility.CanEditStatus &&
        (selectedAgentProfile.Visibility.CanPauseOrRestrictAgent || IsManagerEditableStatus(selectedAgentProfile.Status));

    private IEnumerable<string> GetStatusOptionsForSelectedAgent() =>
        EnsureCurrentOption(statusOptions, selectedAgentProfile?.Status, IsManagerEditableStatus, selectedAgentProfile?.Visibility.CanPauseOrRestrictAgent == true);

    private IEnumerable<string> GetAutonomyOptionsForSelectedAgent() => EnsureCurrentOption(autonomyOptions, selectedAgentProfile?.AutonomyLevel, static _ => true, true);

    private bool CanViewDirectory =>
        CanManageProfiles ||
        string.Equals(companyAccess?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    private bool CanManageProviderSettings =>
        string.Equals(companyAccess?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase);

    private bool IsAnyMailboxProviderAvailable =>
        mailboxProviderAvailability.Gmail.IsConfigured || mailboxProviderAvailability.Microsoft365.IsConfigured;

