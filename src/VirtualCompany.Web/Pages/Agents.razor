@page "/agents/manage"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@inject OnboardingApiClient OnboardingApiClient
@inject AgentApiClient AgentApiClient
@inject FinanceApiClient FinanceApiClient
@inject SalesApiClient SalesApiClient
@inject SupportApiClient SupportApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<AgentsResources> AgentText
@inject IStringLocalizer<CommonResources> CommonText

<PageTitle>@AgentText["VirtualCompanyAgents"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="HandleLocationChangingAsync"
                ConfirmExternalNavigation="@isBriefDirty" />

@if (isLoading)
{
    <section class="py-4">
        <h1>@AgentText["AgentManagement"]</h1>
        <p class="text-body-secondary mb-0">@AgentText["LoadingManagement"]</p>
    </section>
}
else if (CompanyId is null)
{
    <section class="py-4 dashboard-hero">
        <div class="wizard-card">
            <h1>@AgentText["SelectCompany"]</h1>
            <p class="text-body-secondary">@AgentText["ChooseCompanyForManagement"]</p>

            @if (activeMemberships.Count == 0)
            {
                <p class="mb-0">@AgentText["NoActiveMemberships"]</p>
            }
            else
            {
                <div class="template-grid">
                    @foreach (var membership in activeMemberships)
                    {
                        <a class="template-card text-decoration-none text-reset" href="@($"/agents/manage?companyId={membership.CompanyId}")">
                            <strong>@membership.CompanyName</strong>
                            <CompanyIdentityHint Membership="membership" />
                            <div class="text-body-secondary mt-2">@AgentText["MembershipRole", membership.MembershipRole]</div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    var canViewDirectory = CanViewDirectory;
    <section class="py-4 agents-workspace">
        <header class="agents-page-header">
            <div>
                <span class="dashboard-kicker">@AgentText["AiWorkforce"]</span>
                <h1>@AgentText["VirtualCompanyAgents"]</h1>
                <p>@AgentText["AgentManagementDescription"]</p>
            </div>
            @if (CanManageProfiles)
            {
                <a class="btn btn-primary" href="@BuildAgentSectionUri("hire-agent")">@AgentText["AddAgent"]</a>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <nav class="vc-section-tabs agents-configuration-tabs" aria-label="@AgentText["AgentConfiguration"]">
            <a href="@BuildAgentSectionUri("agents-roster-title")">@AgentText["YourAgentTeam"]</a>
            @if (CanManageProfiles && selectedAgentProfile is not null)
            {
                <a href="@BuildAgentSectionUri("agent-brief")">@AgentText["RoleBrief"]</a>
                <a href="@BuildAgentSectionUri("agent-capabilities")">@AgentText["AgentCapabilities"]</a>
                <a href="@BuildAgentSectionUri("agent-access-configuration")">@AgentText["Access"]</a>
            }
        </nav>

        <section class="agents-roster-section" aria-labelledby="agents-roster-title">
            <div class="agents-section-heading">
                <div>
                    <h2 id="agents-roster-title">@AgentText["YourAgentTeam"]</h2>
                    <p>@AgentText["AgentTeamSummary", rosterResponse.Items.Count, companyAccess?.CompanyName ?? AgentText["ThisCompany"]]</p>
                </div>
                <span class="agents-count">@AgentText["AgentCount", rosterResponse.Items.Count]</span>
            </div>

            @if (!canViewDirectory)
            {
                <div class="agents-empty-state">@AgentText["RestrictedAgentTeam"]</div>
            }
            else if (rosterResponse.Items.Count == 0)
            {
                <div class="agents-empty-state">@AgentText["NoAgentsMatch"]</div>
            }
            else
            {
                <div class="agents-roster-cards">
                    @foreach (var agent in rosterResponse.Items)
                    {
                        <article class="agents-roster-card @(selectedAgentId == agent.Id ? "is-selected" : null)">
                            <div class="agents-roster-card__identity">
                                <span class="agents-avatar agents-avatar--@GetDepartmentTone(agent.Department)" aria-hidden="true">@GetInitials(agent.DisplayName)</span>
                                <div>
                                    <h3>@agent.DisplayName</h3>
                                    <p>@agent.RoleName</p>
                                </div>
                                <span class="agents-status @GetStatusBadgeCss(agent.Status)">@GetStatusLabel(agent.Status)</span>
                            </div>

                            <dl class="agents-facts">
                                <div><dt>@AgentText["Department"]</dt><dd>@agent.Department</dd></div>
                                <div><dt>@AgentText["Autonomy"]</dt><dd>@ToDisplayText(agent.AutonomyLevel)</dd></div>
                                <div><dt>@AgentText["Workload"]</dt><dd class="@GetHealthCss(agent.WorkloadSummary.HealthStatus)">@agent.WorkloadSummary.Summary</dd></div>
                            </dl>

                            <div class="agents-priority">
                                <span>@AgentText["CurrentActivity"]</span>
                                <strong>@FormatRosterActivity(agent.WorkloadSummary.LastActivityUtc)</strong>
                            </div>

                            <div class="agents-card-actions">
                                @if (IsDirectChatEligible(agent.Status))
                                {
                                    <a class="btn btn-outline-primary" href="@BuildChatUri(agent.CompanyId, agent.Id)">@AgentText["MessageAgent"]</a>
                                }
                                <a class="btn btn-outline-secondary" href="@GetProfileRoute(agent)">@AgentText["ViewProfile"]</a>
                                @if (CanManageProfiles)
                                {
                                    <button class="btn btn-link" type="button" @onclick="@(() => OpenEditor(agent.Id))">@AgentText["Configure"]</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        @if (CanManageProfiles && selectedAgentProfile is not null)
        {
            <section id="agent-brief" class="agent-brief-workspace" aria-labelledby="agent-brief-title">
                <header class="agent-brief-header">
                    <div class="agent-brief-agent">
                        <span class="agents-avatar agents-avatar--@GetDepartmentTone(selectedAgentProfile.Department)" aria-hidden="true">@GetInitials(selectedAgentProfile.DisplayName)</span>
                        <div>
                            <span class="dashboard-kicker">@AgentText["AgentProfile"]</span>
                            <h2 id="agent-brief-title">@selectedAgentProfile.DisplayName</h2>
                            <p>@selectedAgentProfile.RoleName</p>
                        </div>
                    </div>
                    <div class="agent-brief-save-state @(isBriefDirty ? "is-dirty" : null)">
                        @AgentText[isBriefDirty ? "UnsavedChanges" : "Saved"]
                    </div>
                </header>

                <div class="agent-brief-body">
                    <nav class="agent-brief-categories" aria-label="@AgentText["BriefingCategories"]">
                        @foreach (var category in BriefingCategories)
                        {
                            <button type="button"
                                    class="agent-brief-category @(selectedBriefCategory == category.Key ? "is-selected" : null)"
                                    @onclick="@(() => SelectBriefCategory(category.Key))">
                                <span>@category.ShortLabel</span>
                                <strong>@AgentText[category.LabelResourceKey]</strong>
                            </button>
                        }
                    </nav>

                    <div class="agent-brief-editor">
                        <div class="agent-brief-editor__heading">
                            <div>
                                <h3>@AgentText[SelectedBriefCategory.LabelResourceKey]</h3>
                                <p>@AgentText[SelectedBriefCategory.DescriptionResourceKey]</p>
                            </div>
                            <label class="agent-brief-share">
                                <input type="checkbox" @bind="shareBriefDocumentsWithTeam" />
                                @AgentText["ShareBriefDocuments"]
                            </label>
                        </div>

                        <label class="form-label" for="agent-brief-text">@AgentText["InformationForAgent", selectedAgentProfile.DisplayName]</label>
                        <textarea id="agent-brief-text"
                                  class="form-control agent-brief-textarea"
                                  rows="14"
                                  value="@CurrentBriefText"
                                  @oninput="HandleBriefTextInput"
                                  placeholder="@AgentText[SelectedBriefCategory.PlaceholderResourceKey]"></textarea>

                        <div class="agent-brief-documents">
                            <div class="agent-brief-documents__heading">
                                <strong>@AgentText["AttachedDocuments"]</strong>
                                <span>@AgentText["IndexedDocumentsDescription"]</span>
                            </div>
                            @if (BriefDocumentsForSelectedCategory.Count == 0)
                            {
                                <p class="agent-brief-no-documents">@AgentText["NoBriefDocuments"]</p>
                            }
                            else
                            {
                                @foreach (var document in BriefDocumentsForSelectedCategory)
                                {
                                    <div class="agent-brief-document">
                                        <div>
                                            <strong>@document.OriginalFileName</strong>
                                            <span>@FormatFileSize(document.FileSizeBytes)</span>
                                        </div>
                                        <span class="agent-brief-document__status"
                                              title="@AgentBriefDocumentStatusPresenter.GetDetail(document, AgentText)">
                                            @AgentBriefDocumentStatusPresenter.GetLabel(document, AgentText)
                                        </span>
                                    </div>
                                }
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(briefErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@briefErrorMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(briefSuccessMessage))
                        {
                            <div class="alert alert-success mt-3 mb-0">@briefSuccessMessage</div>
                        }

                        <div class="agent-brief-actions">
                            <InputFile id="agent-brief-file"
                                       class="visually-hidden"
                                       accept=".pdf,.doc,.docx,.txt,.md,.csv,.xlsx"
                                       OnChange="HandleBriefDocumentUploadAsync" />
                            <label class="btn btn-outline-primary" for="agent-brief-file">
                                @AgentText[isUploadingBriefDocument ? "Uploading" : "AttachDocument"]
                            </label>
                            <button class="btn btn-outline-primary"
                                    type="button"
                                    disabled="@isGeneratingBriefDraft"
                                    @onclick="GenerateBriefDraftAsync">
                                @AgentText[isGeneratingBriefDraft ? "Generating" : "GenerateDraft"]
                            </button>
                            <button class="btn btn-primary"
                                    type="button"
                                    disabled="@(!isBriefDirty || isSavingBrief)"
                                    @onclick="SaveAgentBriefAsync">
                                @AgentText[isSavingBrief ? "Saving" : "SaveBrief"]
                            </button>
                        </div>

                        @if (isGeneratedBriefDraft)
                        {
                            <div class="agent-brief-review-note">@AgentText["DraftGeneratedReview"]</div>
                        }
                    </div>
                </div>
            </section>

            <section id="agent-capabilities" class="agent-capability-panel" aria-labelledby="agent-capability-title">
                <div class="agent-capability-panel__heading">
                    <div>
                        <span class="dashboard-kicker">@AgentText["GovernedAi"]</span>
                        <h2 id="agent-capability-title">@AgentText["AgentCapabilities"]</h2>
                    </div>
                    <p>@AgentText["AgentCapabilitiesDescription"]</p>
                </div>
                @if (isLoadingCapabilities)
                {
                    <p class="text-body-secondary mb-0">@AgentText["LoadingCapabilities"]</p>
                }
                else if (!string.IsNullOrWhiteSpace(capabilityErrorMessage))
                {
                    <div class="alert alert-warning mb-0">@capabilityErrorMessage</div>
                }
                else if (selectedAgentCapabilities is not null)
                {
                    <div class="agent-capability-list">
                        @foreach (var capability in selectedAgentCapabilities.Capabilities)
                        {
                            <div class="agent-capability-row">
                                <div class="agent-capability-main">
                                    <div class="agent-capability-title-line">
                                        <strong>@capability.Name</strong>
                                        <span class="agent-capability-action">
                                            <span class="@GetCapabilityActionIconClass(capability.ActionType)" aria-hidden="true"></span>
                                            @FormatCapabilityAction(capability.ActionType)
                                        </span>
                                    </div>
                                    <p>@capability.Description</p>
                                </div>
                                <div class="agent-capability-state">
                                    <div class="agent-capability-state__content">
                                        <span class="@GetCapabilityBadgeClass(capability.State)">
                                            <span class="@GetCapabilityStatusIconClass(capability.State)" aria-hidden="true"></span>
                                            @FormatCapabilityState(capability.State)
                                        </span>
                                        @if (AgentCapabilityPresenter.RequiresRemediation(capability))
                                        {
                                            <small class="agent-capability-remediation-message">
                                                <strong>@AgentText["CapabilityToEnable"]</strong>
                                                @AgentCapabilityPresenter.GetExplanation(capability, AgentText)
                                            </small>
                                        }
                                        else
                                        {
                                            <small>@AgentCapabilityPresenter.GetStateExplanation(capability, AgentText)</small>
                                        }
                                    </div>
                                    @if (AgentCapabilityPresenter.RequiresRemediation(capability)
                                        && CompanyId is Guid capabilityCompanyId
                                        && selectedAgentId is Guid capabilityAgentId)
                                    {
                                        <a class="btn btn-sm btn-outline-primary agent-capability-remediation"
                                           href="@AgentCapabilityPresenter.GetActionHref(capability, capabilityCompanyId, capabilityAgentId)">
                                            <span class="bi bi-sliders" aria-hidden="true"></span>
                                            <span>@AgentCapabilityPresenter.GetActionLabel(capability, AgentText)</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="agent-ai-workbench">
                        <div class="agent-ai-workbench__column">
                            <h3>@AgentText["AskCompanyEvidence"]</h3>
                            <textarea class="form-control" rows="4" @bind="agentQuestion" placeholder="@AgentText["AskCompanyPlaceholder"]"></textarea>
                            <button class="btn btn-primary" type="button" disabled="@(isAskingQuestion || string.IsNullOrWhiteSpace(agentQuestion))" @onclick="AskSelectedAgentAsync">
                                @AgentText[isAskingQuestion ? "CheckingSources" : "AskAgent"]
                            </button>
                            @if (questionAnswer is not null)
                            {
                                <div class="agent-ai-result">
                                    <span class="@GetAnswerBadgeClass(questionAnswer.State)">@FormatAnswerState(questionAnswer.State)</span>
                                    <p>@questionAnswer.Answer</p>
                                    @foreach (var claim in questionAnswer.Claims)
                                    {
                                        <div class="agent-ai-claim"><strong>@FormatClaimType(claim.Type)</strong><span>@claim.Text</span></div>
                                    }
                                    @if (questionAnswer.Sources.Count > 0)
                                    {
                                        <small>@AgentText["Sources", string.Join(", ", questionAnswer.Sources.Select(x => x.Title).Distinct())]</small>
                                    }
                                </div>
                            }
                        </div>
                        <div class="agent-ai-workbench__column">
                            <h3>@AgentText["CurrentWorkPriority"]</h3>
                            @if (selectedPriorities.Count == 0)
                            {
                                <p class="text-body-secondary">@AgentText["NoOpenAssignedWork"]</p>
                            }
                            else
                            {
                                @foreach (var item in selectedPriorities.Take(5))
                                {
                                    <div class="agent-priority-item">
                                        <span>@item.DeterministicScore</span>
                                        <div><strong>@item.Title</strong><small>@string.Join(" · ", item.ReasonCodes)</small></div>
                                    </div>
                                }
                            }
                            @if (selectedQuality is not null)
                            {
                                <div class="agent-quality-summary">
                                    <strong>@AgentText["AiQualityEvidence"]</strong>
                                    <span>@AgentText["ReviewedRecommendations", selectedQuality.SampleSize]</span>
                                    <small>@(selectedQuality.HasSufficientEvidence ? AgentText["AcceptedRate", selectedQuality.AcceptanceRate?.ToString("P0", System.Globalization.CultureInfo.CurrentCulture) ?? AgentText["Unknown"]] : AgentText["InsufficientAutonomyEvidence"])</small>
                                </div>
                            }
                        </div>
                    </div>
                    @if (RoleAnalysisOptions.Count > 0)
                    {
                        <section class="agent-governance-panel mt-3" aria-labelledby="role-analysis-heading">
                            <div class="agent-governance-panel__header">
                                <div>
                                    <h3 id="role-analysis-heading">@AgentText["DepartmentAdvice", selectedAgentProfile?.Department ?? AgentText["Agent"]]</h3>
                                    <p>@AgentText["RoleAnalysisDescription"]</p>
                                </div>
                                @if (roleAnalysisResult is not null)
                                {
                                    <span class="@(roleAnalysisResult.RequiresReview ? "badge text-bg-warning" : "badge text-bg-success")">
                                        @AgentText[roleAnalysisResult.RequiresReview ? "ReviewNeeded" : "Ready"]
                                    </span>
                                }
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label" for="role-analysis-type">@AgentText["Analysis"]</label>
                                    <select id="role-analysis-type" class="form-select" @bind="roleAnalysisType">
                                        @foreach (var option in RoleAnalysisOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label" for="role-analysis-objective">@AgentText["Focus"]</label>
                                    <input id="role-analysis-objective" class="form-control" @bind="roleAnalysisObjective" placeholder="@AgentText["OptionalDecisionQuestion"]" />
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button class="btn btn-primary" type="button" disabled="@isRunningRoleAnalysis" @onclick="RunRoleAnalysisAsync">
                                        @AgentText[isRunningRoleAnalysis ? "Analyzing" : "Analyze"]
                                    </button>
                                </div>
                            </div>
                            @if (selectedAgentProfile?.Department.Equals("finance", StringComparison.OrdinalIgnoreCase) == true && roleAnalysisType == "cash_liquidity")
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-md-3"><label class="form-label" for="cash-horizon">@AgentText["Horizon"]</label><input id="cash-horizon" class="form-control" type="number" min="1" max="365" @bind="financeCashRequest.HorizonDays" /></div>
                                    <div class="col-md-3"><label class="form-label" for="cash-upside">@AgentText["AdditionalInflows"]</label><input id="cash-upside" class="form-control" type="number" min="0" step="100" @bind="financeCashRequest.UpsideAdditionalInflows" /></div>
                                    <div class="col-md-3"><label class="form-label" for="cash-delayed">@AgentText["DelayedInflows"]</label><input id="cash-delayed" class="form-control" type="number" min="0" step="100" @bind="financeCashRequest.DownsideDelayedInflows" /></div>
                                    <div class="col-md-3"><label class="form-label" for="cash-extra-outflow">@AgentText["AdditionalOutflows"]</label><input id="cash-extra-outflow" class="form-control" type="number" min="0" step="100" @bind="financeCashRequest.DownsideAdditionalOutflows" /></div>
                                </div>
                            }
                            else if (selectedAgentProfile?.Department.Equals("finance", StringComparison.OrdinalIgnoreCase) == true && roleAnalysisType == "payables")
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-md-4"><label class="form-label" for="payment-cutoff">@AgentText["PayBillsDueBy"]</label><input id="payment-cutoff" class="form-control" type="date" @bind="financePaymentRunRequest.CutoffUtc" /></div>
                                    <div class="col-md-4"><label class="form-label" for="payment-reserve">@AgentText["MinimumCashReserve"]</label><input id="payment-reserve" class="form-control" type="number" min="0" step="100" @bind="financePaymentRunRequest.MinimumCashReserve" /></div>
                                    <div class="col-md-4"><label class="form-label" for="payment-maximum">@AgentText["MaximumOutflow"]</label><input id="payment-maximum" class="form-control" type="number" min="0" step="100" @bind="financePaymentRunRequest.MaximumOutflow" /></div>
                                </div>
                            }
                            else if (selectedAgentProfile?.Department.Equals("finance", StringComparison.OrdinalIgnoreCase) == true && roleAnalysisType == "accounting_treatment")
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-md-8">
                                        <label class="form-label" for="accounting-bill">@AgentText["SupplierBill"]</label>
                                        <select id="accounting-bill" class="form-select" @bind="selectedAccountingBillId">
                                            <option value="@Guid.Empty">@AgentText["ChooseSupplierBill"]</option>
                                            @foreach (var bill in financeBills.OrderByDescending(x => x.ReceivedUtc).Take(100))
                                            {
                                                <option value="@bill.Id">@bill.CounterpartyName · @bill.BillNumber · @bill.Amount.ToString("N0") @bill.Currency</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end"><p class="small text-body-secondary mb-2">@AgentText["AccountingRecommendationReview"]</p></div>
                                </div>
                            }
                            else if (selectedAgentProfile?.Department.Equals("finance", StringComparison.OrdinalIgnoreCase) == true && roleAnalysisType == "close_analysis")
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <label class="form-label" for="close-period">@AgentText["FiscalPeriod"]</label>
                                        <select id="close-period" class="form-select" @bind="selectedClosePeriodId">
                                            <option value="@Guid.Empty">@AgentText["ChooseFiscalPeriod"]</option>
                                            @foreach (var period in financeClosePeriods)
                                            {
                                                <option value="@period.Id">@period.Label · @FormatReasonCode(period.Status)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3"><label class="form-label" for="close-materiality">@AgentText["MaterialAmount"]</label><input id="close-materiality" class="form-control" type="number" min="0" step="100" @bind="financeCloseRequest.MaterialityAmount" /></div>
                                    <div class="col-md-3"><label class="form-label" for="close-percentage">@AgentText["MaterialPercentage"]</label><input id="close-percentage" class="form-control" type="number" min="0" step="1" @bind="financeCloseRequest.MaterialityPercentage" /></div>
                                </div>
                            }
                            @if (financeCashAnalysis is not null)
                            {
                                <div class="finance-agent-scenarios mt-3" aria-label="Cash scenario comparison">
                                    @foreach (var scenario in new[] { financeCashAnalysis.Baseline, financeCashAnalysis.Upside, financeCashAnalysis.Downside })
                                    {
                                        <article>
                                            <span>@FormatFinanceScenario(scenario.Scenario)</span>
                                            <strong>@scenario.EndingCash.ToString("N0") @scenario.Currency</strong>
                                            <small>@AgentText["FromBaseline", FormatSignedMoney(scenario.ChangeFromBaseline, scenario.Currency)]</small>
                                            <small>@string.Join(" ", scenario.Assumptions)</small>
                                        </article>
                                    }
                                </div>
                                @if (financeCashAnalysis.FreshnessWarnings.Count > 0)
                                {
                                    <div class="alert alert-warning mt-2 mb-0">@string.Join(" ", financeCashAnalysis.FreshnessWarnings)</div>
                                }
                            }
                            @if (financePaymentRun is not null)
                            {
                                <div class="finance-payment-summary mt-3">
                                    @foreach (var currency in financePaymentRun.CashBeforeByCurrency.Keys.OrderBy(x => x))
                                    {
                                        <span><strong>@currency</strong> @AgentText["PaymentCashSummary", LocalNumber.Integer((long)financePaymentRun.CashBeforeByCurrency[currency]), LocalNumber.Integer((long)financePaymentRun.RecommendedOutflowByCurrency.GetValueOrDefault(currency)), LocalNumber.Integer((long)financePaymentRun.CashAfterByCurrency.GetValueOrDefault(currency))]</span>
                                    }
                                </div>
                                <div class="table-responsive finance-payment-table mt-2">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead><tr><th scope="col">@AgentText["Select"]</th><th scope="col">@AgentText["State"]</th><th scope="col">@AgentText["Supplier"]</th><th scope="col">@AgentText["Due"]</th><th scope="col">@AgentText["Amount"]</th><th scope="col">@AgentText["Reason"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in financePaymentRun.Items.OrderBy(x => PaymentGroupOrder(x.Group)).ThenByDescending(x => x.PriorityScore))
                                            {
                                                <tr>
                                                    <td><input type="checkbox" checked="@selectedPaymentBillIds.Contains(item.BillId)" disabled="@(item.Group != "pay")" @onchange="@(e => TogglePaymentBill(item.BillId, e.Value as bool? == true))" aria-label="@AgentText["SelectBill", item.BillNumber]" /></td>
                                                    <td><span class="@PaymentGroupBadge(item.Group)">@FormatPaymentGroup(item.Group)</span></td>
                                                    <td><strong>@item.SupplierName</strong><small class="d-block text-body-secondary">@item.BillNumber</small></td>
                                                    <td>@LocalDateTime.Date(DateOnly.FromDateTime(item.DueUtc))</td>
                                                    <td>@LocalMoney.Format(item.OutstandingAmount, item.Currency)</td>
                                                    <td>@string.Join(" · ", item.ReasonCodes.Select(FormatReasonCode))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="finance-payment-review mt-2">
                                    <label><input type="checkbox" @bind="paymentRunReviewed" /> @AgentText["PaymentRunReviewed"]</label>
                                    <button class="btn btn-primary" type="button" disabled="@(isCommittingPaymentRun || !paymentRunReviewed || selectedPaymentBillIds.Count == 0)" @onclick="CommitFinancePaymentRunAsync">
                                        @AgentText[isCommittingPaymentRun ? "CreatingProposals" : "ConvertToPaymentProposals"]
                                    </button>
                                </div>
                                @if (paymentRunCommitResult is not null)
                                {
                                    <div class="alert alert-success mt-2 mb-0">@AgentText["PaymentProposalsCreated", LocalNumber.Integer(paymentRunCommitResult.PaymentProposals.Count), FormatReasonCode(paymentRunCommitResult.Status)]</div>
