    private void NavigateIfChanged(string targetUri)
    {
        var currentRelativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (isDisposed ||
            isNavigatingAway ||
            !AgentManagementNavigationPolicy.IsManagementRoute(currentRelativeUri))
        {
            return;
        }

        var targetRelativeUri = Navigation.ToBaseRelativePath(Navigation.ToAbsoluteUri(targetUri).ToString());

        if (string.Equals(currentRelativeUri, targetRelativeUri, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo(targetUri, replace: true);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var nextRelativeUri = Navigation.ToBaseRelativePath(args.Location);
        if (AgentManagementNavigationPolicy.IsManagementRoute(nextRelativeUri))
        {
            return;
        }

        isNavigatingAway = true;
        CancelBriefDocumentTracking();
    }

