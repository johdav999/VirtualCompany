@using static VirtualCompany.Web.Features.Agents.AgentIdentityPresentation
@using VirtualCompany.Web.Features.Agents
@using VirtualCompany.Web.Components.Agents
@page "/agents/manage"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@inject OnboardingApiClient OnboardingApiClient
@inject AgentApiClient AgentApiClient
@inject FinanceApiClient FinanceApiClient
@inject SalesApiClient SalesApiClient
@inject SupportApiClient SupportApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<AgentsResources> AgentText
@inject IStringLocalizer<CommonResources> CommonText

<PageTitle>@AgentText["VirtualCompanyAgents"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="HandleLocationChangingAsync"
                ConfirmExternalNavigation="@briefState.IsBriefDirty" />

@if (isLoading)
{
    <section class="py-4">
        <h1>@AgentText["AgentManagement"]</h1>
        <p class="text-body-secondary mb-0">@AgentText["LoadingManagement"]</p>
    </section>
}
else if (CompanyId is null)
{
    <section class="py-4 dashboard-hero">
        <div class="wizard-card">
            <h1>@AgentText["SelectCompany"]</h1>
            <p class="text-body-secondary">@AgentText["ChooseCompanyForManagement"]</p>

            @if (activeMemberships.Count == 0)
            {
                <p class="mb-0">@AgentText["NoActiveMemberships"]</p>
            }
            else
            {
                <div class="template-grid">
                    @foreach (var membership in activeMemberships)
                    {
                        <a class="template-card text-decoration-none text-reset" href="@($"/agents/manage?companyId={membership.CompanyId}")">
                            <strong>@membership.CompanyName</strong>
                            <CompanyIdentityHint Membership="membership" />
                            <div class="text-body-secondary mt-2">@AgentText["MembershipRole", membership.MembershipRole]</div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    var canViewDirectory = CanViewDirectory;
    <section class="py-4 agents-workspace">
        <header class="agents-page-header">
            <div>
                <span class="dashboard-kicker">@AgentText["AiWorkforce"]</span>
                <h1>@AgentText["VirtualCompanyAgents"]</h1>
                <p>@AgentText["AgentManagementDescription"]</p>
            </div>
            @if (CanManageProfiles)
            {
                <a class="btn btn-primary" href="@BuildAgentSectionUri("hire-agent")">@AgentText["AddAgent"]</a>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <nav class="vc-section-tabs agents-configuration-tabs" aria-label="@AgentText["AgentConfiguration"]">
            <a href="@BuildAgentSectionUri("agents-roster-title")">@AgentText["YourAgentTeam"]</a>
            @if (CanManageProfiles && selectedAgentProfile is not null)
            {
                <a href="@BuildAgentSectionUri("agent-brief")">@AgentText["RoleBrief"]</a>
                <a href="@BuildAgentSectionUri("agent-capabilities")">@AgentText["AgentCapabilities"]</a>
                <a href="@BuildAgentSectionUri("agent-access-configuration")">@AgentText["Access"]</a>
            }
        </nav>

        <AgentRosterPanel
            Roster="rosterResponse"
            SelectedAgentId="selectedAgentId"
            CompanyName="@(companyAccess?.CompanyName)"
            CanViewDirectory="CanViewDirectory"
            CanManageProfiles="CanManageProfiles"
            GetProfileRoute="GetProfileRoute"
            OpenEditor="OpenEditor" />

        @if (CanManageProfiles && selectedAgentProfile is not null)
        {
            <AgentBriefEditor Profile="selectedAgentProfile"
                              State="briefState"
                              BriefDocumentsForSelectedCategory="briefState.DocumentsForCategory(selectedAgentId)"
                              SelectBriefCategory="briefState.SelectBriefCategory"
                              HandleBriefTextInput="HandleBriefTextInput"
                              HandleBriefDocumentUploadAsync="HandleBriefDocumentUploadAsync"
                              GenerateBriefDraftAsync="GenerateBriefDraftAsync"
                              SaveAgentBriefAsync="SaveAgentBriefAsync" />

            <section id="agent-capabilities" class="agent-capability-panel" aria-labelledby="agent-capability-title">
                <div class="agent-capability-panel__heading">
                    <div>
                        <span class="dashboard-kicker">@AgentText["GovernedAi"]</span>
                        <h2 id="agent-capability-title">@AgentText["AgentCapabilities"]</h2>
                    </div>
                    <p>@AgentText["AgentCapabilitiesDescription"]</p>
                </div>
                @if (isLoadingCapabilities)
                {
                    <p class="text-body-secondary mb-0">@AgentText["LoadingCapabilities"]</p>
                }
                else if (!string.IsNullOrWhiteSpace(capabilityErrorMessage))
                {
                    <div class="alert alert-warning mb-0">@capabilityErrorMessage</div>
                }
                else if (selectedAgentCapabilities is not null)
                {
                    <div class="agent-capability-list">
                        @foreach (var capability in selectedAgentCapabilities.Capabilities)
                        {
                            <div class="agent-capability-row">
                                <div class="agent-capability-main">
                                    <div class="agent-capability-title-line">
                                        <strong>@capability.Name</strong>
                                        <span class="agent-capability-action">
                                            <span class="@GetCapabilityActionIconClass(capability.ActionType)" aria-hidden="true"></span>
                                            @FormatCapabilityAction(capability.ActionType)
                                        </span>
                                    </div>
                                    <p>@capability.Description</p>
                                </div>
                                <div class="agent-capability-state">
                                    <div class="agent-capability-state__content">
                                        <span class="@GetCapabilityBadgeClass(capability.State)">
                                            <span class="@GetCapabilityStatusIconClass(capability.State)" aria-hidden="true"></span>
                                            @FormatCapabilityState(capability.State)
                                        </span>
                                        @if (AgentCapabilityPresenter.RequiresRemediation(capability))
                                        {
                                            <small class="agent-capability-remediation-message">
                                                <strong>@AgentText["CapabilityToEnable"]</strong>
                                                @AgentCapabilityPresenter.GetExplanation(capability, AgentText)
                                            </small>
                                        }
                                        else
                                        {
                                            <small>@AgentCapabilityPresenter.GetStateExplanation(capability, AgentText)</small>
                                        }
                                    </div>
                                    @if (AgentCapabilityPresenter.RequiresRemediation(capability)
                                        && CompanyId is Guid capabilityCompanyId
                                        && selectedAgentId is Guid capabilityAgentId)
                                    {
                                        <a class="btn btn-sm btn-outline-primary agent-capability-remediation"
                                           href="@AgentCapabilityPresenter.GetActionHref(capability, capabilityCompanyId, capabilityAgentId)">
                                            <span class="bi bi-sliders" aria-hidden="true"></span>
                                            <span>@AgentCapabilityPresenter.GetActionLabel(capability, AgentText)</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="agent-ai-workbench">
                        <div class="agent-ai-workbench__column">
                            <h3>@AgentText["AskCompanyEvidence"]</h3>
                            <textarea class="form-control" rows="4" @bind="agentQuestion" placeholder="@AgentText["AskCompanyPlaceholder"]"></textarea>
                            <button class="btn btn-primary" type="button" disabled="@(isAskingQuestion || string.IsNullOrWhiteSpace(agentQuestion))" @onclick="AskSelectedAgentAsync">
                                @AgentText[isAskingQuestion ? "CheckingSources" : "AskAgent"]
                            </button>
                            @if (questionAnswer is not null)
                            {
                                <div class="agent-ai-result">
                                    <span class="@GetAnswerBadgeClass(questionAnswer.State)">@FormatAnswerState(questionAnswer.State)</span>
                                    <p>@questionAnswer.Answer</p>
                                    @foreach (var claim in questionAnswer.Claims)
                                    {
                                        <div class="agent-ai-claim"><strong>@FormatClaimType(claim.Type)</strong><span>@claim.Text</span></div>
                                    }
                                    @if (questionAnswer.Sources.Count > 0)
                                    {
                                        <small>@AgentText["Sources", string.Join(", ", questionAnswer.Sources.Select(x => x.Title).Distinct())]</small>
                                    }
                                </div>
                            }
                        </div>
                        <div class="agent-ai-workbench__column">
                            <h3>@AgentText["CurrentWorkPriority"]</h3>
                            @if (selectedPriorities.Count == 0)
                            {
                                <p class="text-body-secondary">@AgentText["NoOpenAssignedWork"]</p>
                            }
                            else
                            {
                                @foreach (var item in selectedPriorities.Take(5))
                                {
                                    <div class="agent-priority-item">
                                        <span>@item.DeterministicScore</span>
                                        <div><strong>@item.Title</strong><small>@string.Join(" · ", item.ReasonCodes)</small></div>
                                    </div>
                                }
                            }
                            @if (selectedQuality is not null)
                            {
                                <div class="agent-quality-summary">
                                    <strong>@AgentText["AiQualityEvidence"]</strong>
                                    <span>@AgentText["ReviewedRecommendations", selectedQuality.SampleSize]</span>
                                    <small>@(selectedQuality.HasSufficientEvidence ? AgentText["AcceptedRate", selectedQuality.AcceptanceRate?.ToString("P0", System.Globalization.CultureInfo.CurrentCulture) ?? AgentText["Unknown"]] : AgentText["InsufficientAutonomyEvidence"])</small>
                                </div>
                            }
                        </div>
                    </div>
                    <AgentRoleAnalysisPanel Profile="selectedAgentProfile" State="analysisState" RunRoleAnalysisAsync="RunRoleAnalysisAsync" CommitFinancePaymentRunAsync="CommitFinancePaymentRunAsync" />
                    <details class="agent-plan-review">
                        <summary>@AgentText["PlanWork"]</summary>
                        <div>
                            <label class="form-label" for="agent-plan-objective">@AgentText["Objective"]</label>
                            <textarea id="agent-plan-objective" class="form-control" rows="3" @bind="planObjective" placeholder="@AgentText["PlanObjectivePlaceholder"]"></textarea>
                            <button class="btn btn-outline-primary" type="button" disabled="@(isGeneratingPlan || string.IsNullOrWhiteSpace(planObjective))" @onclick="GenerateSelectedAgentPlanAsync">
                                @AgentText[isGeneratingPlan ? "GeneratingPlan" : "GenerateReviewablePlan"]
                            </button>
                            @if (selectedPlan is not null)
                            {
                                <ol class="agent-plan-steps">
                                    @foreach (var step in selectedPlan.Steps)
                                    {
                                        <li><strong>@step.Title</strong><span>@step.CompletionEvidence</span></li>
                                    }
                                </ol>
                                <button class="btn btn-primary" type="button" disabled="@(isCommittingPlan || selectedPlan.Status != "draft")" @onclick="CommitSelectedAgentPlanAsync">
                                    @AgentText[isCommittingPlan ? "CreatingTasks" : "CommitPlanTasks"]
                                </button>
                            }
                        </div>
                    </details>
                    <div class="agent-governance-grid">
                        <section class="agent-governance-panel" aria-labelledby="agent-handoffs-heading">
                            <div class="agent-governance-panel__header">
                                <div><h3 id="agent-handoffs-heading">@AgentText["AgentHandoffs"]</h3><p>@AgentText["AgentHandoffsDescription"]</p></div>
                                <span class="badge text-bg-light">@selectedHandoffs.Count</span>
                            </div>
                            @if (selectedHandoffs.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@AgentText["NoActiveHandoffs"]</p>
                            }
                            else
                            {
                                @foreach (var handoff in selectedHandoffs.Take(5))
                                {
                                    <article class="agent-governance-item">
                                        <div><strong>@handoff.Objective</strong><small>@FormatHandoffStatus(handoff.Status) · Due @FormatDueDate(handoff.DueUtc)</small></div>
                                        @if (handoff.ReceivingAgentId == selectedAgentId && handoff.Status == "proposed")
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => TransitionHandoffAsync(handoff.Id, "accepted"))">@AgentText["Accept"]</button>
                                        }
                                        else if (handoff.ReceivingAgentId == selectedAgentId && handoff.Status == "accepted")
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => TransitionHandoffAsync(handoff.Id, "in_progress"))">@AgentText["Start"]</button>
                                        }
                                    </article>
                                }
                            }
                        </section>
                        <section class="agent-governance-panel" aria-labelledby="agent-memory-heading">
                            <div class="agent-governance-panel__header">
                                <div><h3 id="agent-memory-heading">@AgentText["MemoryReview"]</h3><p>@AgentText["MemoryReviewDescription"]</p></div>
                                <span class="badge text-bg-light">@selectedMemoryCandidates.Count</span>
                            </div>
                            @if (selectedMemoryCandidates.Count == 0)
                            {
                                <p class="text-body-secondary mb-0">@AgentText["NoMemorySuggestions"]</p>
                            }
                            else
                            {
                                @foreach (var candidate in selectedMemoryCandidates.Take(5))
                                {
                                    <article class="agent-governance-item agent-governance-item--stacked">
                                        <div><strong>@FormatMemoryType(candidate.MemoryType)</strong><p>@candidate.Content</p><small>@candidate.Scope · Confidence @candidate.Confidence.ToString("P0")</small></div>
                                        <div class="agent-governance-actions">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => ReviewMemoryAsync(candidate.Id, false))">@AgentText["Reject"]</button>
                                            <button class="btn btn-sm btn-primary" type="button" disabled="@isUpdatingGovernance" @onclick="@(() => ReviewMemoryAsync(candidate.Id, true))">@AgentText["Approve"]</button>
                                        </div>
                                    </article>
                                }
                            }
                        </section>
                    </div>
                }
            </section>
        }

        <details id="hire-agent" class="agents-advanced-panel">
            <summary>
                <span>@AgentText["HireAnotherAgent"]</span>
                <small>@AgentText["HireAnotherAgentDescription"]</small>
            </summary>
        <div class="agent-layout">
            <div class="wizard-card">
                <span class="dashboard-kicker">@AgentText["TemplateCatalog"]</span>
                <h2>@AgentText["AgentRoles"]</h2>
                <p class="text-body-secondary">@AgentText["TemplateCatalogDescription"]</p>

                <div class="agent-template-grid mt-4">
                    @foreach (var template in templates)
                    {
                        var isSelected = string.Equals(selectedTemplateId, template.TemplateId, StringComparison.OrdinalIgnoreCase);
                        <button class="template-card agent-template-card @(isSelected ? "is-selected" : null)"
                                type="button"
                                @onclick="@(() => SelectTemplate(template.TemplateId))">
                            <div class="agent-template-header">
                                <strong>@template.RoleName</strong>
                                <span class="badge text-bg-light">@template.DefaultSeniority</span>
                            </div>
                            <div class="text-body-secondary">@template.Department</div>
                            <p class="mb-0 mt-3">@template.PersonaSummary</p>
                        </button>
                    }
                </div>
            </div>

            <div class="wizard-card">
                <h2 class="h4 mb-3">@AgentText["CustomizeAndHire"]</h2>

                @if (selectedTemplate is null)
                {
                    <p class="text-body-secondary mb-0">@AgentText["SelectTemplate"]</p>
                }
                else
                {
                    <EditForm Model="@hireModel" OnValidSubmit="@HandleHireAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="display-name">@AgentText["Name"]</label>
                            <InputText id="display-name" class="form-control" @bind-Value="hireModel.DisplayName" />
                            <ValidationMessage For="@(() => hireModel.DisplayName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="avatar-url">@AgentText["AvatarReference"]</label>
                            <InputText id="avatar-url" class="form-control" @bind-Value="hireModel.AvatarUrl" />
                            <div class="form-text">@AgentText["AvatarReferenceHelp"]</div>
                            <ValidationMessage For="@(() => hireModel.AvatarUrl)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="department">@AgentText["Department"]</label>
                            <InputText id="department" class="form-control" @bind-Value="hireModel.Department" />
                            <ValidationMessage For="@(() => hireModel.Department)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="role-name">@AgentText["Role"]</label>
                            <InputText id="role-name" class="form-control" @bind-Value="hireModel.RoleName" />
                            <ValidationMessage For="@(() => hireModel.RoleName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="seniority">@AgentText["Seniority"]</label>
                            <InputSelect id="seniority" class="form-select" @bind-Value="hireModel.Seniority">
                                @foreach (var option in seniorityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => hireModel.Seniority)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="personality">@AgentText["Personality"]</label>
                            <InputTextArea id="personality" class="form-control" rows="4" @bind-Value="hireModel.Personality" />
                            <ValidationMessage For="@(() => hireModel.Personality)" />
                        </div>

                        <div class="dashboard-actions">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">@AgentText["HireAgent"]</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="@ResetSelectedTemplate">@AgentText["ResetDefaults"]</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
        </details>

        <div id="agent-access-configuration" class="agents-access-panel">
            <div class="agent-roster-header">
                <div>
                    <span class="dashboard-kicker">@AgentText["JointAccessBrief"]</span>
                    <h2>@AgentText["SharedCompanySources"]</h2>
                </div>
                <div class="dashboard-actions">
                    <a class="btn btn-outline-secondary" href="@BuildFinanceIntegrationSettingsHref()">
                        <span class="bi bi-plug" aria-hidden="true"></span>
                        @AgentText["FinanceIntegrations"]
                    </a>
                </div>
            </div>
            <p class="text-body-secondary mt-3 mb-0">@AgentText["SharedSourcesDescription"]</p>

            <section class="agent-source-connection-step" aria-labelledby="agent-source-connection-title">
                <div>
                    <span class="agent-access-step">1</span>
                    <div>
                        <h3 id="agent-source-connection-title">@AgentText["MailboxProviderSetupTitle"]</h3>
                        <p>@AgentText["MailboxProviderSetupDescription"]</p>
                    </div>
                </div>
            </section>

            @if (isLoadingMailboxConfiguration)
            {
                <p class="text-body-secondary mt-3">@AgentText["LoadingMailboxConfiguration"]</p>
            }
            else
            {
                @if (CanManageProviderSettings)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3">
                        <p class="text-body-secondary mb-0">@AgentText["MailboxProviderSetupManagedDescription"]</p>
                        <a class="btn btn-outline-primary" href="@BuildEmailProviderSettingsHref()">
                            <span class="bi bi-gear" aria-hidden="true"></span>
                            @AgentText["ConfigureEmailProvider"]
                        </a>
                    </div>
                }
                else if (!CanManageProviderSettings)
                {
                    <p class="agent-source-availability-note mt-3">
                        <span class="bi bi-shield-lock" aria-hidden="true"></span>
                        @AgentText["ProviderSettingsOwnerAdminOnly"]
                    </p>
                }

                <div id="team-mailboxes" class="agent-mailbox-section-heading">
                    <span class="agent-access-step">2</span>
                    <div>
                        <h3>@AgentText["ConnectTeamMailboxesTitle"]</h3>
                        <p>@AgentText["ConnectTeamMailboxesDescription"]</p>
                    </div>
                </div>

                <div class="agent-mailbox-grid">
                    @foreach (var mailbox in MailboxPurposeDefinitions)
                    {
                        var mailboxStatus = GetMailboxStatus(mailbox.Purpose);
                        <article class="agent-mailbox-card">
                            <div class="agent-mailbox-card-header">
                                <div>
                                    <span class="bi @mailbox.Icon" aria-hidden="true"></span>
                                    <h4>@AgentText[mailbox.TitleKey]</h4>
                                </div>
                                <span class="badge @(mailboxStatus?.IsConnected == true ? "text-bg-success" : "text-bg-light")">
                                    @(mailboxStatus?.IsConnected == true ? AgentText["MailboxConnected"] : AgentText["MailboxNotConnected"])
                                </span>
                            </div>
                            <p>@AgentText[mailbox.DescriptionKey]</p>
                            @if (mailboxStatus?.IsConnected == true)
                            {
                                <dl class="agent-mailbox-details">
                                    <div><dt>@AgentText["EmailAddress"]</dt><dd>@mailboxStatus.EmailAddress</dd></div>
                                    <div><dt>@AgentText["Provider"]</dt><dd>@GetProviderDisplayName(mailboxStatus.Provider)</dd></div>
                                </dl>
                            }
                            else
                            {
                                <p class="agent-mailbox-empty">@AgentText["MailboxConnectHelp"]</p>
                            }

                            <div class="agent-mailbox-actions">
                                @RenderMailboxProviderAction(mailbox.Purpose, "gmail", "Gmail", mailboxStatus?.IsConnected == true)
                                @RenderMailboxProviderAction(mailbox.Purpose, "microsoft365", "Microsoft 365", mailboxStatus?.IsConnected == true)
                                @if (mailboxStatus?.IsConnected == true)
                                {
                                    <button class="btn btn-link text-danger" type="button" disabled="@IsMailboxActionRunning(mailbox.Purpose)"
                                            @onclick="@(() => DisconnectMailboxAsync(mailbox.Purpose))">
                                        @AgentText["DisconnectMailbox"]
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>

                @if (!IsAnyMailboxProviderAvailable)
                {
                    <p class="agent-source-availability-note mt-3">
                        <span class="bi bi-info-circle" aria-hidden="true"></span>
                        @AgentText["ConfigureProviderBeforeMailbox"]
                    </p>
                }
            }

            <div class="agents-access-list mt-3">
                @foreach (var source in BuildAgentSourceCards())
                {
                    <article class="agents-access-row">
                        <div>
                            <h3>@source.Title</h3>
                            <p>@source.Description</p>
                        </div>
                        <div><span>@AgentText["Authentication"]</span><strong>@source.Authentication</strong></div>
                        <div><span>@AgentText["Access"]</span><strong>@source.Owner</strong></div>
                        <span class="@source.BadgeCss">@source.Badge</span>
                    </article>
                }
            </div>

            @if (CanManageProfiles && selectedAgentProfile is not null)
            {
                <div class="border-top pt-3 mt-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div class="agent-access-step-heading">
                            <span class="agent-access-step">3</span>
                            <div>
                                <h3 class="h5 mb-1">@AgentText["SelectedAgentAccessBrief"]</h3>
                                <p class="text-body-secondary mb-0">
                                    @AgentText["SelectedAgentAccessDescription", selectedAgentProfile.DisplayName]
                                </p>
                            </div>
                        </div>
                        <span class="badge text-bg-light">@selectedAgentProfile.Department</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-authentication">@AgentText["EmailAuthentication"]</label>
                            <InputSelect id="brief-authentication" class="form-select" @bind-Value="jointBriefModel.EmailAuthentication">
                                <option value="oauth_user_mailbox">@AgentText["AuthOAuthMailbox"]</option>
                                <option value="app_oauth_client">@AgentText["AuthAppOAuthClient"]</option>
                                <option value="provider_api_key">@AgentText["AuthProviderCredential"]</option>
                                <option value="manual_upload_only">@AgentText["AuthManualUpload"]</option>
                            </InputSelect>
                            <div class="form-text">@AgentText["SecretsLocationHelp"]</div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-source-owner">@AgentText["PrimaryOwner"]</label>
                            <InputSelect id="brief-source-owner" class="form-select" @bind-Value="jointBriefModel.PrimaryOwner">
                                <option value="finance">@AgentText["OwnerFinance"]</option>
                                <option value="sales">@AgentText["OwnerSales"]</option>
                                <option value="customer_support">@AgentText["OwnerSupport"]</option>
                                <option value="shared_operations">@AgentText["OwnerSharedOperations"]</option>
                            </InputSelect>
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label" for="brief-review">@AgentText["ReviewMode"]</label>
                            <InputSelect id="brief-review" class="form-select" @bind-Value="jointBriefModel.ReviewMode">
                                <option value="human_review_required">@AgentText["ReviewHumanRequired"]</option>
                                <option value="low_risk_autonomous">@AgentText["ReviewLowRiskAutonomous"]</option>
                                <option value="read_only">@AgentText["ReviewReadOnly"]</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["EmailSources"]</legend>
