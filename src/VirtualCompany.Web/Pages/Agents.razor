                return new JointAgentBriefFormModel
                {
                    PrimaryOwner = "sales",
                    SalesMailbox = true,
                    WebContactForms = true,
                    SalesLeadForms = true,
                    CompanyPolicies = true,
                    ProductCatalog = true,
                    KnowledgeDocuments = true,
                    CustomerRecords = true,
                    OrderAndInvoiceRecords = true,
                    ReviewMode = "human_review_required"
