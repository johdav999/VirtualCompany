                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["WebEnquiries"]</legend>
                                @RenderBriefCheckbox(AgentText["WebsiteContactForms"], () => jointBriefModel.WebContactForms, value => jointBriefModel.WebContactForms = value)
                                @RenderBriefCheckbox(AgentText["SalesLeadForms"], () => jointBriefModel.SalesLeadForms, value => jointBriefModel.SalesLeadForms = value)
                                @RenderBriefCheckbox(AgentText["SupportWebRequests"], () => jointBriefModel.SupportWebRequests, value => jointBriefModel.SupportWebRequests = value)
                            </fieldset>
                        </div>
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["Documents"]</legend>
                                @RenderBriefCheckbox(AgentText["CompanyPolicies"], () => jointBriefModel.CompanyPolicies, value => jointBriefModel.CompanyPolicies = value)
                                @RenderBriefCheckbox(AgentText["ProductCatalog"], () => jointBriefModel.ProductCatalog, value => jointBriefModel.ProductCatalog = value)
                                @RenderBriefCheckbox(AgentText["UploadedKnowledgeDocuments"], () => jointBriefModel.KnowledgeDocuments, value => jointBriefModel.KnowledgeDocuments = value)
                            </fieldset>
                        </div>
                        <div class="col-12 col-lg-3">
                            <fieldset class="border rounded-3 p-3 h-100">
                                <legend class="h6 mb-3">@AgentText["BusinessSystems"]</legend>
                                @RenderBriefCheckbox(AgentText["FortnoxFinanceData"], () => jointBriefModel.FortnoxFinance, value => jointBriefModel.FortnoxFinance = value)
                                @RenderBriefCheckbox(AgentText["CustomerRecords"], () => jointBriefModel.CustomerRecords, value => jointBriefModel.CustomerRecords = value)
                                @RenderBriefCheckbox(AgentText["OrderInvoiceRecords"], () => jointBriefModel.OrderAndInvoiceRecords, value => jointBriefModel.OrderAndInvoiceRecords = value)
                            </fieldset>
                        </div>
                    </div>

                    <div class="dashboard-actions mt-3">
                        <button class="btn btn-primary" type="button" @onclick="ApplyJointBriefToSelectedAgent">@AgentText["ApplyToSelectedAgent"]</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="LoadRecommendedJointBriefForSelectedAgent">@AgentText["UseRecommendedAccess"]</button>
                    </div>
                    <p class="small text-body-secondary mb-0 mt-2">
                        @AgentText["ApplyAccessHelp"]
                    </p>
                </div>
            }
            else
            {
                <p class="text-body-secondary mb-0 mt-4">@AgentText["SelectAgentForAccess"]</p>
            }
        </div>

        @if (CanManageProfiles)
        {
            <AgentOperatingProfileEditor ProfileHref="@BuildProfileUri(selectedAgentId ?? Guid.Empty)" State="profileState" Profile="selectedAgentProfile" HandleProfileSaveAsync="HandleProfileSaveAsync" />
        }

        <details class="agents-advanced-panel mt-4">
            <summary>
                <span>@AgentText["DirectoryFilters"]</span>
                <small>@AgentText["DirectoryFiltersDescription"]</small>
            </summary>
        <div class="wizard-card">
            <div class="agent-roster-header">
                <div>
                    <span class="dashboard-kicker">@AgentText["CompanyRoster"]</span>
                    <h2 class="h4 mb-0 mt-2">@AgentText["CompanyAgents"]</h2>
                </div>
                <span class="badge text-bg-light">@AgentText["TotalCount", rosterResponse.Items.Count]</span>
            </div>

            @if (!canViewDirectory)
            {
                <p class="text-body-secondary mb-0 mt-3">@AgentText["RestrictedRosterShort"]</p>
            }
            else
            {
                <div class="agent-filter-bar mt-4">
                    <div>
                        <label class="form-label" for="department-filter">@AgentText["Department"]</label>
                        <InputSelect id="department-filter" class="form-select" @bind-Value="Department">
                            <option value="">@AgentText["AllDepartments"]</option>
                            @foreach (var department in rosterResponse.Departments)
                            {
                                <option value="@department">@department</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="form-label" for="status-filter">@AgentText["Status"]</label>
                        <InputSelect id="status-filter" class="form-select" @bind-Value="Status">
                            <option value="">@AgentText["AllStatuses"]</option>
                            @foreach (var status in rosterResponse.Statuses)
                            {
                                <option value="@status">@GetStatusLabel(status)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="dashboard-actions">
                        <button class="btn btn-primary" type="button" @onclick="ApplyFilters">@AgentText["ApplyFilters"]</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearFilters">@AgentText["ClearFilters"]</button>
                    </div>
                </div>

                @if (rosterResponse.Items.Count == 0)
                {
                    <p class="text-body-secondary mb-0 mt-4">@AgentText["NoAgentsMatch"]</p>
                }
                else
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@AgentText["Name"]</th>
                                    <th scope="col">@AgentText["Role"]</th>
                                    <th scope="col">@AgentText["Department"]</th>
                                    <th scope="col">@AgentText["Status"]</th>
                                    <th scope="col">@AgentText["Autonomy"]</th>
                                    <th scope="col">@AgentText["WorkloadAndHealth"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agent in rosterResponse.Items)
                                {
                                    <tr class="@(selectedAgentId == agent.Id ? "table-active" : null)">
                                        <th scope="row">
                                            <a class="fw-semibold text-decoration-none" href="@GetProfileRoute(agent)">@agent.DisplayName</a>
                                            @if (CanManageProfiles)
                                            {
                                                <div class="mt-2">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="@(() => OpenEditor(agent.Id))">@AgentText["Configure"]</button>
                                                </div>
                                            }
                                            @if (IsDirectChatEligible(agent.Status))
                                            {
                                                <div class="mt-2"><a class="btn btn-sm btn-primary" href="@BuildChatUri(agent.CompanyId, agent.Id)">@AgentText["Chat"]</a></div>
                                            }
                                        </th>
                                        <td>@agent.RoleName</td>
                                        <td>@agent.Department</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeCss(agent.Status)">@GetStatusLabel(agent.Status)</span>
                                        </td>
                                        <td>@ToDisplayText(agent.AutonomyLevel)</td>
                                        <td>
                                            <div class="fw-semibold @GetHealthCss(agent.WorkloadSummary.HealthStatus)">@agent.WorkloadSummary.Summary</div>
                                            <div class="small text-body-secondary mt-1">@FormatRosterActivity(agent.WorkloadSummary.LastActivityUtc)</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
        </details>
    </section>
}

@code {
    private readonly AgentOperatingProfileEditorState profileState = new();

    private readonly AgentBriefEditorState briefState = new();
    private readonly AgentRoleAnalysisState analysisState = new();

    [SupplyParameterFromQuery(Name = "companyId")]
    public Guid? CompanyId { get; set; }

    [SupplyParameterFromQuery(Name = "department")]
    public string? Department { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "agentId")]
    public Guid? AgentId { get; set; }

    private static readonly JsonSerializerOptions JsonEditorOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private readonly string[] seniorityOptions = [ "junior", "mid", "senior", "lead", "executive" ];
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? successMessage;
    private CurrentUserContextViewModel? currentUser;
    private CompanyAccessViewModel? companyAccess;
    private List<AgentTemplateCatalogItemViewModel> templates = [];
    private AgentRosterResponseViewModel rosterResponse = new();
    private HireAgentFormModel hireModel = new();
    private AgentOperatingProfileViewModel? selectedAgentProfile;
    private JointAgentBriefFormModel jointBriefModel = new();
    private AgentCapabilityCatalogViewModel? selectedAgentCapabilities;
    private Guid? selectedAgentId;
    private string? selectedTemplateId;
    private async Task HandleLocationChangingAsync(LocationChangingContext context)
    {
        if (!briefState.IsBriefDirty)
        {
            return;
        }

        var shouldLeave = await JS.InvokeAsync<bool>(
            "confirm",
            AgentText["UnsavedBriefNavigationWarning"].Value);
        if (!shouldLeave)
        {
            context.PreventNavigation();
        }
    }
    private bool isLoadingCapabilities;
    private bool isLoadingMailboxConfiguration;
    private string? mailboxActionPurpose;
    private MailboxProviderAvailabilityResponse mailboxProviderAvailability = new();
    private readonly Dictionary<string, MailboxConnectionStatusResponse> mailboxStatuses = new(StringComparer.OrdinalIgnoreCase);
    private string? capabilityErrorMessage;
    private string agentQuestion = string.Empty;
    private AgentQuestionAnswerViewModel? questionAnswer;
    private List<AgentWorkPriorityViewModel> selectedPriorities = [];
    private AgentAiQualityMetricsViewModel? selectedQuality;
    private string planObjective = string.Empty;
    private AgentPlanViewModel? selectedPlan;
    private List<AgentHandoffViewModel> selectedHandoffs = [];
    private List<AgentMemoryCandidateViewModel> selectedMemoryCandidates = [];
    private bool isAskingQuestion;
    private bool isGeneratingPlan;
    private bool isCommittingPlan;
    private bool isUpdatingGovernance;
    private CancellationTokenSource? briefDocumentTrackingCts;
    private bool isNavigatingAway;
    private bool isDisposed;

    private IReadOnlyList<CompanyMembershipViewModel> activeMemberships =>
        currentUser?.Memberships.Where(x => string.Equals(x.Status, "active", StringComparison.OrdinalIgnoreCase)).ToList()
        ?? [];

    private IReadOnlyList<RoleAnalysisOption> RoleAnalysisOptions => AgentRoleAnalysisState.OptionsFor(selectedAgentProfile?.Department);

    private AgentTemplateCatalogItemViewModel? selectedTemplate =>
        templates.FirstOrDefault(x => string.Equals(x.TemplateId, selectedTemplateId, StringComparison.OrdinalIgnoreCase));

    // Owner, admin, and manager memberships can open the operating-profile experience.
    private bool CanManageProfiles =>
        string.Equals(companyAccess?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    private bool CanViewDirectory =>
        CanManageProfiles ||
        string.Equals(companyAccess?.MembershipRole, "manager", StringComparison.OrdinalIgnoreCase);

    private bool CanManageProviderSettings =>
        string.Equals(companyAccess?.MembershipRole, "owner", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(companyAccess?.MembershipRole, "admin", StringComparison.OrdinalIgnoreCase);

    private bool IsAnyMailboxProviderAvailable =>
        mailboxProviderAvailability.Gmail.IsConfigured || mailboxProviderAvailability.Microsoft365.IsConfigured;

    private static readonly IReadOnlyList<MailboxPurposeDefinition> MailboxPurposeDefinitions =
    [
        new("finance", "FinanceMailbox", "FinanceMailboxConnectionDescription", "bi-receipt"),
        new("sales", "SalesMailbox", "SalesMailboxConnectionDescription", "bi-briefcase"),
        new("support", "SupportMailbox", "SupportMailboxConnectionDescription", "bi-headset")
    ];

    private string BuildProfileUri(Guid agentId) => $"/agents/{agentId}?companyId={CompanyId}";

    private string BuildFinanceIntegrationSettingsHref() =>
        FinanceRoutes.BuildFinanceIntegrationSettingsPath("fortnox", CompanyId);

    private string BuildEmailProviderSettingsHref() =>
        FinanceRoutes.WithCompanyContext(FinanceRoutes.EmailProviderSettings, CompanyId);

    private string BuildMailboxConnectionHref(string purpose, string provider)
    {
        if (CompanyId is not Guid companyId)
        {
            return "/agents/manage";
        }

        var agentQuery = selectedAgentId is Guid agentId ? $"&agentId={agentId:D}" : string.Empty;
        return $"/agents/mailboxes/connect?companyId={companyId:D}&purpose={Uri.EscapeDataString(purpose)}&provider={Uri.EscapeDataString(provider)}{agentQuery}";
    }

    private IReadOnlyList<AgentSourceCard> BuildAgentSourceCards() =>
        [
            new(
                AgentText["SourceAuthenticatedEmail"],
                AgentText["SourceAuthenticatedEmailDescription"],
                "OAuth",
                AgentText["SourceEmailOwner"],
                AgentText["BadgeConfigured"],
                "badge text-bg-success"),
            new(
                AgentText["SourceWeb"],
                AgentText["SourceWebDescription"],
                AgentText["SourceWebAuthentication"],
                AgentText["SourceWebOwner"],
                AgentText["BadgePolicy"],
                "badge text-bg-light"),
            new(
                AgentText["SourceDocuments"],
                AgentText["SourceDocumentsDescription"],
                AgentText["SourceAppAccess"],
                AgentText["SourceDocumentsOwner"],
                AgentText["BadgeScoped"],
                "badge text-bg-light"),
            new(
                AgentText["SourceFinance"],
                AgentText["SourceFinanceDescription"],
                AgentText["SourceProviderAuthentication"],
                AgentText["SourceFinanceOwner"],
                AgentText["BadgeFinanceOwned"],
                "badge text-bg-warning"),
            new(
                AgentText["SourceSales"],
                AgentText["SourceSalesDescription"],
                AgentText["SourceMailboxAuthentication"],
                AgentText["SourceSalesOwner"],
                AgentText["BadgeScoped"],
                "badge text-bg-light"),
            new(
                AgentText["SourceSupport"],
                AgentText["SourceSupportDescription"],
                AgentText["SourceSupportAuthentication"],
                AgentText["SourceSupportOwner"],
                AgentText["BadgeScoped"],
                "badge text-bg-light")
        ];

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        isNavigatingAway = false;
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            currentUser = await OnboardingApiClient.GetCurrentUserContextAsync(CompanyId);

            if (CompanyId is null && currentUser?.ActiveCompany is not null)
            {
                NavigateIfChanged($"/agents/manage?companyId={currentUser.ActiveCompany.CompanyId}");
                return;
            }

            if (CompanyId is Guid companyId)
            {
                companyAccess = await OnboardingApiClient.GetCompanyAccessAsync(companyId);
                if (companyAccess is null)
                {
                    errorMessage = "The selected company could not be loaded.";
                    templates = [];
                    rosterResponse = new AgentRosterResponseViewModel();
                }
                else
                {
                    await LoadMailboxConfigurationAsync(companyId);
                    templates = (await AgentApiClient.GetTemplatesAsync(companyId)).ToList();

                    if (selectedTemplateId is null || templates.All(x => !string.Equals(x.TemplateId, selectedTemplateId, StringComparison.OrdinalIgnoreCase)))
                    {
                        selectedTemplateId = templates.FirstOrDefault()?.TemplateId;
                        ResetSelectedTemplate();
                    }
                    rosterResponse = CanViewDirectory
                        ? await AgentApiClient.GetRosterViewAsync(companyId, Department, Status)
                        : new AgentRosterResponseViewModel();

                    if (CanManageProfiles && rosterResponse.Items.Count > 0)
                    {
                        var nextSelectedAgent = AgentId
                            ?? selectedAgentId
                            ?? rosterResponse.Items[0].Id;

                        await SelectAgentAsync(nextSelectedAgent);
                    }
                    else
                    {
                        selectedAgentId = null;
                        selectedAgentProfile = null;
                        profileState.ProfileModel = new AgentOperatingProfileFormModel();
                        profileState.ProfileErrors.Clear();
                    }
                }
            }
        }
        catch (OnboardingApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectTemplate(string templateId)
    {
        selectedTemplateId = templateId;
        ResetSelectedTemplate();
    }

    private void ResetSelectedTemplate()
    {
        if (selectedTemplate is null)
        {
            hireModel = new HireAgentFormModel();
            return;
        }

        hireModel = new HireAgentFormModel
        {
            TemplateId = selectedTemplate.TemplateId,
            DisplayName = selectedTemplate.RoleName,
            AvatarUrl = selectedTemplate.AvatarUrl,
            Department = selectedTemplate.Department,
            RoleName = selectedTemplate.RoleName,
            Personality = selectedTemplate.PersonaSummary,
            Seniority = selectedTemplate.DefaultSeniority
        };
    }

    private async Task SelectAgentAsync(Guid agentId)
    {
        if (CompanyId is not Guid companyId)
        {
            return;
        }

        CancelBriefDocumentTracking();
        selectedAgentId = agentId;
        profileState.ProfileErrorMessage = null;
        profileState.ProfileSuccessMessage = null;
        profileState.ProfileErrors.Clear();

        if (!CanManageProfiles)
        {
            return;
        }

        try
        {
            isLoadingCapabilities = true;
            capabilityErrorMessage = null;
            questionAnswer = null;
            selectedPlan = null;
            analysisState.RoleAnalysisResult = null;
            analysisState.ResetFinanceAnalysis();
            analysisState.RoleAnalysisObjective = string.Empty;
            planObjective = string.Empty;
            selectedAgentProfile = await AgentApiClient.GetOperatingProfileAsync(companyId, agentId);
            analysisState.RoleAnalysisType = RoleAnalysisOptions.FirstOrDefault()?.Value ?? string.Empty;
            if (selectedAgentProfile.Department.Equals("finance", StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    analysisState.FinanceBills = await FinanceApiClient.GetBillsAsync(companyId, 100);
                    analysisState.FinanceClosePeriods = await FinanceApiClient.ListClosePeriodsAsync(companyId, agentId);
                    analysisState.SelectedAccountingBillId = analysisState.FinanceBills.FirstOrDefault()?.Id ?? Guid.Empty;
                    analysisState.SelectedClosePeriodId = analysisState.FinanceClosePeriods.FirstOrDefault()?.Id ?? Guid.Empty;
                }
                catch (FinanceApiException ex)
                {
                    capabilityErrorMessage = $"Finance analysis choices could not be loaded. {ex.Message}";
                }
            }
            profileState.ProfileModel = AgentOperatingProfileFormModel.FromViewModel(selectedAgentProfile);
            briefState.AgentBriefModel = AgentBriefFormModel.FromProfile(selectedAgentProfile);
            briefState.BriefDocuments = (await AgentApiClient.GetBriefDocumentsAsync(companyId, agentId)).ToList();
            try
            {
                selectedAgentCapabilities = await AgentApiClient.GetCapabilitiesAsync(companyId, agentId);
                selectedPriorities = (await AgentApiClient.GetPrioritiesAsync(companyId, agentId, 10)).ToList();
                selectedQuality = await AgentApiClient.GetAiQualityAsync(companyId, DateTime.UtcNow.AddDays(-30), DateTime.UtcNow, agentId);
                selectedHandoffs = (await AgentApiClient.GetHandoffsAsync(companyId, agentId)).Where(x => x.Status is not ("completed" or "rejected" or "cancelled" or "failed")).ToList();
                selectedMemoryCandidates = (await AgentApiClient.GetMemoryCandidatesAsync(companyId, "needs_review")).Where(x => x.ProposingAgentId == agentId).ToList();
            }
            catch (OnboardingApiException ex)
            {
                selectedAgentCapabilities = null;
                capabilityErrorMessage = $"Capability access could not be loaded. {ex.Message}";
            }
            briefState.IsBriefDirty = false;
            briefState.IsGeneratedBriefDraft = false;
            briefState.BriefErrorMessage = null;
            briefState.BriefSuccessMessage = null;
            LoadRecommendedJointBriefForSelectedAgent();
            NavigateIfChanged(BuildAgentsUri(companyId, Department, Status, agentId));
        }
        catch (OnboardingApiException ex)
        {
            selectedAgentProfile = null;
            selectedAgentCapabilities = null;
            profileState.ProfileModel = new AgentOperatingProfileFormModel();
            profileState.ProfileErrorMessage = ex.Message;
        }
        finally
        {
            isLoadingCapabilities = false;
        }
    }

    private async Task LoadMailboxConfigurationAsync(Guid companyId)
    {
        isLoadingMailboxConfiguration = true;
        mailboxStatuses.Clear();

        try
        {
            var availabilityTask = FinanceApiClient.GetMailboxProviderAvailabilityAsync(companyId);
            var statusTasks = MailboxPurposeDefinitions.ToDictionary(
                definition => definition.Purpose,
                definition => FinanceApiClient.GetMailboxConnectionStatusAsync(companyId, definition.Purpose),
                StringComparer.OrdinalIgnoreCase);

            await Task.WhenAll(statusTasks.Values);
            mailboxProviderAvailability = await availabilityTask;

            foreach (var (purpose, task) in statusTasks)
            {
                mailboxStatuses[purpose] = await task ?? new MailboxConnectionStatusResponse { Purpose = purpose };
            }

        }
        catch (FinanceApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoadingMailboxConfiguration = false;
        }
    }

    private async Task ConnectMailboxAsync(string purpose, string provider)
    {
        if (CompanyId is not Guid companyId || !IsMailboxProviderAvailable(provider))
        {
            return;
        }

        mailboxActionPurpose = purpose;
        errorMessage = null;
        try
        {
            var agentQuery = selectedAgentId is Guid agentId ? $"&agentId={agentId}" : string.Empty;
            var returnUri = Navigation.ToAbsoluteUri($"/agents/manage?companyId={companyId}{agentQuery}").ToString();
            var authorizationUrl = await FinanceApiClient.StartPurposeMailboxConnectionAsync(companyId, purpose, provider, returnUri);
            Navigation.NavigateTo(authorizationUrl, forceLoad: true);
        }
        catch (FinanceApiException ex)
        {
            errorMessage = ex.Message;
            mailboxActionPurpose = null;
        }
    }

    private async Task DisconnectMailboxAsync(string purpose)
    {
        if (CompanyId is not Guid companyId)
        {
            return;
        }

        mailboxActionPurpose = purpose;
        errorMessage = null;
        successMessage = null;
        try
        {
            mailboxStatuses[purpose] = await FinanceApiClient.DisconnectMailboxConnectionAsync(companyId, purpose);
            successMessage = AgentText["MailboxDisconnected"];
        }
        catch (FinanceApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            mailboxActionPurpose = null;
        }
    }

    private MailboxConnectionStatusResponse? GetMailboxStatus(string purpose) =>
        mailboxStatuses.GetValueOrDefault(purpose);

    private bool IsMailboxActionRunning(string purpose) =>
        string.Equals(mailboxActionPurpose, purpose, StringComparison.OrdinalIgnoreCase);

    private bool IsMailboxProviderAvailable(string provider) => provider.ToLowerInvariant() switch
    {
        "gmail" => mailboxProviderAvailability.Gmail.IsConfigured,
        "microsoft365" => mailboxProviderAvailability.Microsoft365.IsConfigured,
        _ => false
    };

    private static string GetProviderDisplayName(string? provider) => provider?.ToLowerInvariant() switch
    {
        "gmail" => "Gmail",
        "microsoft365" => "Microsoft 365",
        _ => provider ?? string.Empty
    };

    private string FormatCapabilityAction(string actionType) => actionType.ToLowerInvariant() switch
    {
        "read" => AgentText["CapabilityModeRead"],
        "recommend" => AgentText["CapabilityModeRecommend"],
        "execute" => AgentText["CapabilityModeExecute"],
        _ => actionType
    };

    private string FormatCapabilityState(string state) => state.ToLowerInvariant() switch
    {
        "available" => AgentText["CapabilityStatusAvailable"],
        "approval_required" => AgentText["CapabilityStatusApprovalRequired"],
        "configuration_required" => AgentText["CapabilityStatusConfigurationRequired"],
        "permission_denied" => AgentText["CapabilityStatusRestricted"],
        "integration_unavailable" => AgentText["CapabilityStatusIntegrationUnavailable"],
        "not_implemented" => AgentText["CapabilityStatusNotAvailableYet"],
        _ => AgentText["CapabilityStatusUnavailable"]
    };

    private static string GetCapabilityBadgeClass(string state) => state.ToLowerInvariant() switch
    {
        "available" => "badge text-bg-success",
        "approval_required" => "badge text-bg-warning",
        "configuration_required" => "badge text-bg-warning",
        _ => "badge text-bg-light"
    };

    private static string GetCapabilityActionIconClass(string actionType) => actionType.ToLowerInvariant() switch
    {
        "read" => "bi bi-eye",
        "recommend" => "bi bi-list-check",
        "execute" => "bi bi-play-circle",
        _ => "bi bi-circle"
    };

    private static string GetCapabilityStatusIconClass(string state) => state.ToLowerInvariant() switch
    {
        "available" => "bi bi-check-circle",
        "approval_required" => "bi bi-person-check",
        "configuration_required" => "bi bi-wrench-adjustable",
        "permission_denied" => "bi bi-lock",
        "integration_unavailable" => "bi bi-plug",
        "not_implemented" => "bi bi-clock",
        _ => "bi bi-exclamation-circle"
    };

    private async Task AskSelectedAgentAsync()
    {
        if (CompanyId is not Guid companyId || selectedAgentId is not Guid agentId) return;
        isAskingQuestion = true; capabilityErrorMessage = null;
        try { questionAnswer = await AgentApiClient.AskQuestionAsync(companyId, agentId, new AskAgentQuestionRequest { Question = agentQuestion }); }
        catch (OnboardingApiException ex) { capabilityErrorMessage = ex.Message; }
        finally { isAskingQuestion = false; }
    }

    private async Task GenerateSelectedAgentPlanAsync()
    {
        if (CompanyId is not Guid companyId || selectedAgentId is not Guid agentId) return;
        isGeneratingPlan = true; capabilityErrorMessage = null;
        try { selectedPlan = await AgentApiClient.GeneratePlanAsync(companyId, agentId, new GenerateAgentPlanRequest { Objective = planObjective }); }
        catch (OnboardingApiException ex) { capabilityErrorMessage = ex.Message; }
        finally { isGeneratingPlan = false; }
    }

    private async Task CommitSelectedAgentPlanAsync()
    {
        if (CompanyId is not Guid companyId || selectedAgentId is not Guid agentId || selectedPlan is null) return;
        isCommittingPlan = true; capabilityErrorMessage = null;
        try { selectedPlan = await AgentApiClient.CommitPlanAsync(companyId, agentId, selectedPlan.RunId); }
        catch (OnboardingApiException ex) { capabilityErrorMessage = ex.Message; }
        finally { isCommittingPlan = false; }
    }

    private async Task TransitionHandoffAsync(Guid handoffId, string status)
    {
        if (CompanyId is not Guid companyId) return;
        isUpdatingGovernance = true; capabilityErrorMessage = null;
        try
        {
            var updated = await AgentApiClient.TransitionHandoffAsync(companyId, handoffId, new TransitionAgentHandoffRequest { Status = status });
            selectedHandoffs.RemoveAll(x => x.Id == handoffId);
            selectedHandoffs.Add(updated);
            selectedHandoffs = selectedHandoffs.OrderByDescending(x => x.UpdatedUtc).ToList();
        }
        catch (OnboardingApiException ex) { capabilityErrorMessage = ex.Message; }
        finally { isUpdatingGovernance = false; }
    }

    private async Task ReviewMemoryAsync(Guid candidateId, bool approve)
    {
        if (CompanyId is not Guid companyId) return;
        isUpdatingGovernance = true; capabilityErrorMessage = null;
        try
        {
            await AgentApiClient.ReviewMemoryAsync(companyId, candidateId, new ReviewAgentMemoryRequest { Approve = approve, Reason = approve ? null : "Rejected from the agent memory review queue." });
            selectedMemoryCandidates.RemoveAll(x => x.Id == candidateId);
        }
        catch (OnboardingApiException ex) { capabilityErrorMessage = ex.Message; }
        finally { isUpdatingGovernance = false; }
    }

