    private async Task HandleBriefDocumentUploadAsync(InputFileChangeEventArgs args)
    {
        if (CompanyId is not Guid companyId || selectedAgentProfile is null)
        {
            return;
        }

        var file = args.File;
        var agentId = selectedAgentProfile.Id;
        isUploadingBriefDocument = true;
        briefErrorMessage = null;
        briefSuccessMessage = null;
        AgentBriefDocumentViewModel? uploadedDocument = null;
        try
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            var document = await AgentApiClient.UploadBriefDocumentAsync(
                companyId,
                agentId,
                selectedBriefCategory,
                shareBriefDocumentsWithTeam,
                file.Name,
                file.ContentType,
                stream);
            uploadedDocument = document;
            UpsertBriefDocument(document);
            MarkBriefDirty();
            briefSuccessMessage = AgentText["BriefDocumentQueued", file.Name];
        }
        catch (Exception ex) when (ex is OnboardingApiException or IOException or InvalidOperationException)
        {
            briefErrorMessage = ex.Message;
        }
        finally
        {
            isUploadingBriefDocument = false;
        }

        if (uploadedDocument is not null)
        {
            await TrackBriefDocumentAsync(companyId, agentId, uploadedDocument.Id, file.Name);
        }
    }

    private async Task TrackBriefDocumentAsync(Guid companyId, Guid agentId, Guid documentId, string fileName)
    {
        CancelBriefDocumentTracking();
        briefDocumentTrackingCts = new CancellationTokenSource();
        var cancellationToken = briefDocumentTrackingCts.Token;
        var deadlineUtc = DateTime.UtcNow.AddSeconds(60);

        try
        {
            while (DateTime.UtcNow < deadlineUtc)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                var documents = await AgentApiClient.GetBriefDocumentsAsync(companyId, agentId, cancellationToken);
                var refreshedDocument = documents.SingleOrDefault(document => document.Id == documentId);
                if (refreshedDocument is null)
                {
                    continue;
                }

                UpsertBriefDocument(refreshedDocument);
                await InvokeAsync(StateHasChanged);

                if (!AgentBriefDocumentStatusPresenter.IsTerminal(refreshedDocument))
                {
                    continue;
                }

                if (string.Equals(refreshedDocument.IndexingStatus, "indexed", StringComparison.OrdinalIgnoreCase))
                {
                    briefSuccessMessage = AgentText["BriefDocumentReady", fileName];
                    briefErrorMessage = null;
                }
                else
                {
                    briefSuccessMessage = null;
                    briefErrorMessage = AgentBriefDocumentStatusPresenter.GetDetail(refreshedDocument, AgentText);
                }

                await InvokeAsync(StateHasChanged);
                return;
            }

            briefSuccessMessage = null;
            briefErrorMessage = AgentText["BriefDocumentSlow", fileName];
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (OnboardingApiException ex)
        {
            briefSuccessMessage = null;
            briefErrorMessage = AgentText["BriefDocumentRefreshFailed", ex.Message];
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpsertBriefDocument(AgentBriefDocumentViewModel document)
    {
        briefDocuments.RemoveAll(existing => existing.Id == document.Id);
        briefDocuments.Add(document);
    }

