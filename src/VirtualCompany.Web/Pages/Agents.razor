    private async Task HandleProfileSaveAsync()
    {
        if (CompanyId is not Guid companyId || selectedAgentId is not Guid agentId)
        {
            return;
        }

        if (selectedAgentProfile is null)
        {
            profileState.ProfileErrorMessage = AgentText["SelectProfileBeforeSave"];
            profileState.ProfileSuccessMessage = null;
            return;
        }

        if (!profileState.ProfileModel.TryCreateRequest(selectedAgentProfile.Visibility, out var request, out var localErrors))
        {
            profileState.ProfileErrors = localErrors;
            profileState.ProfileErrorMessage = AgentText["FixProfileFields"];
            profileState.ProfileSuccessMessage = null;
            return;
        }

        profileState.IsSavingProfile = true;
        profileState.ProfileErrorMessage = null;
        profileState.ProfileSuccessMessage = null;
        profileState.ProfileErrors.Clear();

        try
        {
            selectedAgentProfile = await AgentApiClient.UpdateOperatingProfileAsync(companyId, agentId, request);
            profileState.ProfileModel = AgentOperatingProfileFormModel.FromViewModel(selectedAgentProfile);
            rosterResponse = await AgentApiClient.GetRosterViewAsync(companyId, Department, Status);
            profileState.ProfileSuccessMessage = AgentText["ProfileSaved", selectedAgentProfile.DisplayName];
        }
        catch (OnboardingApiException ex)
        {
            profileState.ProfileErrorMessage = ex.Message;
            profileState.ProfileErrors = ex.Errors.ToDictionary(x => x.Key, x => x.Value, StringComparer.OrdinalIgnoreCase);
        }
        finally
        {
            profileState.IsSavingProfile = false;
        }
    }

