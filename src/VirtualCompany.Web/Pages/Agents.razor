    private RenderFragment RenderBriefCheckbox(string label, Func<bool> valueAccessor, Action<bool> setter) => builder =>
    {
        var sequence = 0;
        var id = $"brief-{NormalizeCssToken(label)}";

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "form-check mb-2");

        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "id", id);
        builder.AddAttribute(sequence++, "class", "form-check-input");
        builder.AddAttribute(sequence++, "type", "checkbox");
        builder.AddAttribute(sequence++, "checked", valueAccessor());
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.CreateBinder<bool>(this, setter, valueAccessor()));
        builder.CloseElement();

        builder.OpenElement(sequence++, "label");
        builder.AddAttribute(sequence++, "class", "form-check-label");
        builder.AddAttribute(sequence++, "for", id);
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.CloseElement();
    };

