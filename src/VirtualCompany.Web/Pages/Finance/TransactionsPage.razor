@page "/finance/transactions"
@page "/finance/activity"
@page "/finance/transactions/{TransactionId:guid}"
@page "/finance/activity/{TransactionId:guid}"
@inherits FinancePageBase

<PageTitle>Transactions</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="Transactions"
    Description="All account activity across bank and integrations"
    LoadingMessage="Loading transactions..."
    ShowShellHeader="false"
    ShowShellNavigation="false">
    <section class="transactions-workspace" aria-labelledby="transactions-heading">
        <div class="finance-overview-header">
            <div>
                <span class="finance-overview-kicker">Finance module</span>
                <h1 id="transactions-heading" class="finance-overview-title">Transactions</h1>
                <p class="finance-overview-subtitle">All account activity across bank and integrations</p>
            </div>
            <div class="finance-overview-header__actions">
                <a class="btn finance-overview-button finance-overview-button--primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Home, AccessState.CompanyId)">Finance overview</a>
                <a class="btn finance-overview-button finance-overview-button--secondary" href="@DashboardHref">Company dashboard</a>
            </div>
        </div>

        <FinanceSectionNav CompanyId="@AccessState.CompanyId!.Value" MembershipRole="@AccessState.MembershipRole" />

        <form method="get" class="transactions-filter-bar">
            <input type="hidden" name="@FinanceRoutes.CompanyIdQueryKey" value="@AccessState.CompanyId" />
            <div class="transactions-filter-bar__field transactions-filter-bar__field--date-range">
                <label for="transaction-filter-from">Date range</label>
                <div class="transactions-filter-bar__date-range">
                    <input id="transaction-filter-from" type="date" name="from" value="@FromInputValue" aria-label="From date" />
                    <input id="transaction-filter-to" type="date" name="to" value="@ToInputValue" aria-label="To date" />
                </div>
            </div>
            <div class="transactions-filter-bar__field">
                <label for="transaction-filter-account">Account</label>
                <select id="transaction-filter-account" name="account">
                    <option value="" selected="@string.IsNullOrWhiteSpace(AccountFilterValue)">All accounts</option>
                    @foreach (var option in AccountOptions)
                    {
                        <option value="@option" selected="@IsAccountSelected(option)">@option</option>
                    }
                </select>
            </div>
            <div class="transactions-filter-bar__field transactions-filter-bar__field--wide">
                <label for="transaction-filter-search">Search</label>
                <input id="transaction-filter-search" type="search" name="search" value="@SearchFilterValue" placeholder="Description, counterparty, reference, category, or amount" />
            </div>
            <div class="transactions-filter-bar__actions">
                <button class="btn transactions-button transactions-button--primary" type="submit">Apply filters</button>
                <a class="btn transactions-button transactions-button--secondary" href="@ClearFiltersHref">Clear</a>
            </div>
        </form>

        <div class="transactions-summary-grid">
            <article class="transactions-summary-card">
                <span>Total inflow</span>
                <strong class="transactions-amount transactions-amount--positive">@Summary.DisplayInflow</strong>
                <small>Selected transactions</small>
            </article>
            <article class="transactions-summary-card">
                <span>Total outflow</span>
                <strong class="transactions-amount transactions-amount--negative">@Summary.DisplayOutflow</strong>
                <small>Selected transactions</small>
            </article>
            <article class="transactions-summary-card">
                <span>Uncategorized</span>
                <strong>@Summary.UncategorizedCount</strong>
                <small>Needs category review</small>
            </article>
            <article class="transactions-summary-card">
                <span>Needs review</span>
                <strong>@Summary.NeedsReviewCount</strong>
                <small>Flagged or unusual</small>
            </article>
        </div>

        <div class="transactions-layout">
            <article class="transactions-ledger-card">
                <div class="transactions-ledger-card__header">
                    <div>
                        <h2>Ledger transactions</h2>
                        <p>Review account activity, categories, references, and reconciliation signals.</p>
                    </div>
                    <span>@DisplayedTransactions.Count item@(DisplayedTransactions.Count == 1 ? string.Empty : "s")</span>
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@IsDisplayedListEmpty"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="Loading transactions"
                    LoadingMessage="Fetching account activity."
                    EmptyTitle="@EmptyTitle"
                    EmptyMessage="@EmptyMessage"
                    OnRetry="@ReloadAsync">
                    <div class="transactions-table-wrap">
                        <table class="transactions-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Counterparty</th>
                                    <th>Account</th>
                                    <th class="transactions-table__amount">Amount</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in TransactionRows)
                                {
                                    <tr class="@(transaction.IsSelected ? "is-selected" : string.Empty)" @onclick="() => NavigateToTransaction(transaction.Id)">
                                        <td data-label="Date">@transaction.DisplayDate</td>
                                        <td data-label="Description">
                                            <a href="@BuildTransactionHref(transaction.Id)">@transaction.Description</a>
                                            <small>@transaction.ExternalReference</small>
                                        </td>
                                        <td data-label="Counterparty">@transaction.CounterpartyName</td>
                                        <td data-label="Account">@transaction.AccountName</td>
                                        <td data-label="Amount" class="@($"transactions-table__amount transactions-amount {(transaction.IsPositive ? "transactions-amount--positive" : "transactions-amount--negative")}")">@transaction.DisplayAmount</td>
                                        <td data-label="Category"><span class="transactions-category-pill">@transaction.CategoryLabel</span></td>
                                        <td data-label="Status"><span class="@($"transactions-status-badge transactions-status-badge--{transaction.StatusTone}")">@transaction.StatusLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </FinanceDataState>
            </article>

            <aside class="transactions-detail-card">
                @if (IsDetailLoading)
                {
                    <FinanceLoadingState Title="Loading transaction detail" Message="Opening the selected transaction." />
                }
                else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                {
                    <FinanceErrorState Title="Transaction detail unavailable" Message="@(DetailErrorMessage!)" RetryText="Retry" OnRetry="@ReloadAsync" />
                }
                else if (SelectedTransaction is null)
                {
                    <div class="transactions-detail-empty">
                        <div class="transactions-detail-empty__icon" aria-hidden="true">txn</div>
                        <h2>Select a transaction to inspect details</h2>
                        <p>Use this panel for category review, anomaly investigation, and reconciliation.</p>
                    </div>
                }
                else if (SelectedTransactionDisplay is { } detail)
                {
                    <div class="transactions-detail-panel">
                        <div class="transactions-detail-panel__header">
                            <div>
                                <span class="@($"transactions-status-badge transactions-status-badge--{detail.StatusTone}")">@detail.StatusLabel</span>
                                <h2>@detail.DisplayAmount</h2>
                                <p>@detail.Description</p>
                            </div>
                        </div>

                        <form class="transactions-category-editor" @onsubmit="HandleCategorySaveAsync" @onsubmit:preventDefault="true">
                            <label for="transaction-category-input">Category</label>
                            <div class="transactions-category-editor__control">
                                <input id="transaction-category-input" list="transaction-category-options" @bind="EditableCategory" disabled="@(!CanEditTransactionCategory || IsSavingCategory)" />
                                <button class="btn transactions-button transactions-button--primary" type="submit" disabled="@(!CanEditTransactionCategory || IsSavingCategory)">Save</button>
                            </div>
                            <datalist id="transaction-category-options">
                                @foreach (var option in EditableCategoryOptions)
                                {
                                    <option value="@option">@FormatLabel(option)</option>
                                }
                            </datalist>
                            @if (!string.IsNullOrWhiteSpace(CategoryValidationMessage))
                            {
                                <div class="transactions-validation-message">@CategoryValidationMessage</div>
                            }
                            <p>@(CanEditTransactionCategory ? "Change the category when the ledger classification is wrong." : "Finance edit access is required to update categories.")</p>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(CategorySaveMessage))
                        {
                            <div class="alert alert-success" role="status">@CategorySaveMessage</div>
                        }

                        <dl class="transactions-detail-list">
                            <div><dt>Counterparty</dt><dd>@detail.CounterpartyName</dd></div>
                            <div><dt>Date</dt><dd>@detail.DisplayDate</dd></div>
                            <div><dt>Account</dt><dd>@detail.AccountName</dd></div>
                            <div><dt>Category</dt><dd>@detail.CategoryLabel</dd></div>
                            <div><dt>External reference</dt><dd>@detail.ExternalReference</dd></div>
                            <div><dt>Source</dt><dd>@detail.SourceLabel</dd></div>
                            <div><dt>Anomaly state</dt><dd>@detail.AnomalyLabel</dd></div>
                        </dl>

                        <section class="transactions-insight-card">
                            <span>Agent insight</span>
                            <p>@detail.AgentInsight</p>
                        </section>

                        <section class="transactions-detail-section">
                            <h3>Flags</h3>
                            @if (detail.Flags.Count == 0)
                            {
                                <p>No review flags are recorded for this transaction.</p>
                            }
                            else
                            {
                                <div class="transactions-flag-list">
                                    @foreach (var flag in detail.Flags)
                                    {
                                        <span>@FormatLabel(flag)</span>
                                    }
                                </div>
                            }
                        </section>

                        <section class="transactions-detail-section">
                            <h3>Linked document</h3>
                            <FinanceLinkedResourceState
                                Availability="@SelectedTransaction.LinkedDocument.Availability"
                                Message="@SelectedTransaction.LinkedDocument.Message"
                                ResourceTitle="@SelectedTransaction.LinkedDocument.Document?.Title"
                                SecondaryText="@SelectedTransaction.LinkedDocument.Document?.OriginalFileName"
                                TypeText="@SelectedTransaction.LinkedDocument.Document?.ContentType"
                                CanNavigate="@SelectedTransaction.LinkedDocument.CanNavigate"
                                NavigateHref="@(SelectedTransaction.LinkedDocument.Document is null ? null : BuildDocumentHref(SelectedTransaction.LinkedDocument.Document.Id))"
                                ActionText="Open linked document" />
                        </section>
                    </div>
                }
            </aside>
        </div>
    </section>
</FinancePageLayout>
