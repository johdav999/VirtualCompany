@page "/finance/accounting/reconciliation"
@page "/finance/accounting/reconciliation/{TransactionId:guid}"
@inherits FinancePageBase

<PageTitle>@FinanceText["BankReconciliationTitle"]</PageTitle>

<FinancePageLayout IsLoading="@IsLoading" AccessState="@AccessState" ErrorMessage="@ErrorMessage"
                   Title="@FinanceText["BankReconciliationTitle"]" Description="@FinanceText["BankReconciliationDescription"]"
                   LoadingMessage="@FinanceText["LoadingBankReconciliation"]">
    <AccountingNavigation CompanyId="@AccessState.CompanyId" />

    <div class="reconciliation-heading">
        <div><span class="dashboard-kicker">@FinanceText["NativeAccounting"]</span><h2>@FinanceText["BankReconciliationTitle"]</h2><p>@FinanceText["BankReconciliationHelp"]</p></div>
        <a class="btn btn-outline-primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.AccountingJournal, AccessState.CompanyId)">@FinanceText["OpenJournals"]</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(ActionMessage)) { <div class="alert alert-success" role="status">@ActionMessage</div> }
    @if (!string.IsNullOrWhiteSpace(ActionError)) { <div class="alert alert-danger" role="alert">@ActionError</div> }

    <section class="reconciliation-kpis" aria-label="@FinanceText["ReconciliationSummary"]">
        <article><span class="reconciliation-kpi-icon reconciliation-kpi-icon--amber" aria-hidden="true">!</span><div><small>@FinanceText["NeedsReview"]</small><strong>@Count("unmatched")</strong><span>@FinanceText["UnmatchedBankItems"]</span></div></article>
        <article><span class="reconciliation-kpi-icon reconciliation-kpi-icon--amber" aria-hidden="true">½</span><div><small>@FinanceText["PartiallyMatched"]</small><strong>@Count("partial")</strong><span>@FinanceText["AmountsStillRemaining"]</span></div></article>
        <article><span class="reconciliation-kpi-icon reconciliation-kpi-icon--green" aria-hidden="true">✓</span><div><small>@FinanceText["ReadyOrPosted"]</small><strong>@(Count("matched") + Count("posted"))</strong><span>@FinanceText["GovernedJournalPath"]</span></div></article>
        <article><span class="reconciliation-kpi-icon reconciliation-kpi-icon--red" aria-hidden="true">⌂</span><div><small>@FinanceText["Suspense"]</small><strong>@Count("suspense")</strong><span>@FinanceText["FollowUpStillOpen"]</span></div></article>
    </section>

    <section class="reconciliation-filter-card" aria-label="@FinanceText["ReconciliationFilters"]">
        <div><label for="reconciliation-search">@FinanceText["SearchTransactions"]</label><input id="reconciliation-search" class="form-control" @bind="Search" placeholder="@FinanceText["ReconciliationSearchPlaceholder"]" /></div>
        <div><label for="reconciliation-state">@FinanceText["ReconciliationState"]</label><select id="reconciliation-state" class="form-select" @bind="StateFilter"><option value="">@FinanceText["AllStates"]</option><option value="unmatched">@FinanceText["Unmatched"]</option><option value="partial">@FinanceText["PartiallyMatched"]</option><option value="matched">@FinanceText["ReadyToPost"]</option><option value="posted">@FinanceText["Posted"]</option><option value="suspense">@FinanceText["Suspense"]</option><option value="conflict">@FinanceText["Conflict"]</option><option value="correction">@FinanceText["Corrected"]</option></select></div>
        <div class="reconciliation-filter-actions"><button class="btn btn-link" type="button" @onclick="ClearFiltersAsync">@FinanceText["ClearFilters"]</button><button class="btn btn-primary" type="button" @onclick="ApplyFiltersAsync">@FinanceText["ApplyFilters"]</button></div>
    </section>

    <section class="advanced-reconciliation" aria-label="@FinanceText["AdvancedSettlementGroups"]">
        <header class="advanced-reconciliation-header">
            <div><span class="dashboard-kicker">@FinanceText["ExplainableMatching"]</span><h3>@FinanceText["AdvancedSettlementGroups"]</h3><p>@FinanceText["AdvancedSettlementGroupsHelp"]</p></div>
            @if (AdvancedWorkspace.CurrentRule is { } currentRule) { <span class="reconciliation-badge">@FinanceText["RuleVersion", currentRule.Version]</span> }
        </header>
        <div class="advanced-reconciliation-metrics">
            <div><small>@FinanceText["NeedsReview"]</small><strong>@AdvancedWorkspace.Metrics.NeedsReviewCount</strong></div>
            <div><small>@FinanceText["LowConfidence"]</small><strong>@AdvancedWorkspace.Metrics.LowConfidenceCount</strong></div>
            <div><small>@FinanceText["Conflict"]</small><strong>@AdvancedWorkspace.Metrics.ConflictCount</strong></div>
            <div><small>@FinanceText["StaleSuggestions"]</small><strong>@AdvancedWorkspace.Metrics.StaleCount</strong></div>
        </div>
        <div class="advanced-reconciliation-layout">
            <div class="advanced-group-list">
                <header><strong>@FinanceText["SettlementGroups"]</strong><small>@FinanceText["GroupCount", AdvancedWorkspace.Groups.Count]</small></header>
                @if (AdvancedWorkspace.Groups.Count == 0)
                {
                    <div class="reconciliation-empty"><span aria-hidden="true">◇</span><h4>@FinanceText["NoGroupSelected"]</h4><p>@FinanceText["NoGroupSelectedHelp"]</p></div>
                }
                else
                {
                    @foreach (var group in AdvancedWorkspace.Groups)
                    {
                        <button type="button" class="advanced-group-row @(SelectedAdvanced?.Summary.Id == group.Id ? "selected" : null)" @onclick="() => SelectAdvancedAsync(group.Id)">
                            <span><span class="reconciliation-badge reconciliation-badge--@group.Status">@AdvancedStatusLabel(group.Status)</span><strong>@group.Reference</strong><small>@group.Counterparty · @FinanceText["AdvancedCardinality", group.BankRowCount, group.DocumentCount]</small></span>
                            <span><strong>@Money(group.ExpectedBankTotal, group.Currency)</strong><small class="@(group.IsStale ? "text-danger" : null)">@(group.IsStale ? FinanceText["Stale"] : group.ConfidenceScore.ToString("P0"))</small></span>
                        </button>
                    }
                }
            </div>
            <div class="advanced-group-detail" aria-live="polite">
                @if (SelectedAdvanced is null)
                {
                    <div class="reconciliation-empty"><span aria-hidden="true">↔</span><h4>@FinanceText["NoGroupSelected"]</h4><p>@FinanceText["NoGroupSelectedHelp"]</p></div>
                }
                else
                {
                    <header><div><span class="reconciliation-badge reconciliation-badge--@SelectedAdvanced.Summary.Status">@AdvancedStatusLabel(SelectedAdvanced.Summary.Status)</span><h4>@SelectedAdvanced.Summary.Reference</h4><p>@SelectedAdvanced.Summary.Counterparty</p></div><span class="advanced-balance @(SelectedAdvanced.IsBalanced ? "balanced" : "unbalanced")">@(SelectedAdvanced.IsBalanced ? FinanceText["Balanced"] : FinanceText["Unbalanced"])</span></header>
                    <div class="advanced-control-totals">
                        <div><small>@FinanceText["ExpectedBankTotal"]</small><strong>@Money(SelectedAdvanced.Summary.ExpectedBankTotal, SelectedAdvanced.Summary.Currency)</strong></div>
                        <div><small>@FinanceText["AllocatedAmount"]</small><strong>@Money(SelectedAdvanced.AllocatedAmount, SelectedAdvanced.Summary.Currency)</strong></div>
                        <div><small>@FinanceText["BankFee"]</small><strong>@Money(SelectedAdvanced.FeeAmount, SelectedAdvanced.Summary.Currency)</strong></div>
                        <div><small>@FinanceText["RoundingDifference"]</small><strong>@Money(SelectedAdvanced.RoundingAmount, SelectedAdvanced.Summary.Currency)</strong></div>
                        <div><small>@FinanceText["AdvancedResidual"]</small><strong>@Money(SelectedAdvanced.ResidualAmount, SelectedAdvanced.Summary.Currency)</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SelectedAdvanced.BlockingReason)) { <div class="reconciliation-notice reconciliation-notice--danger"><strong>@FinanceText["NeedsAttention"]</strong><p>@SelectedAdvanced.BlockingReason</p></div> }
                    <div class="advanced-evidence-grid">
                        <section><h5>@FinanceText["AuditableResultGraph"]</h5><div class="advanced-result-graph">
                            @foreach (var node in SelectedAdvanced.Nodes.OrderBy(x => x.Sequence))
                            {
                                <div class="advanced-node advanced-node--@node.NodeType"><span aria-hidden="true">@(node.NodeType == "bank_transaction" ? "▣" : node.NodeType is "invoice" or "bill" ? "▤" : node.NodeType == "payment" ? "✓" : "±")</span><div><strong>@node.Label</strong><small>@AdvancedNodeLabel(node.NodeType) · @node.Reference</small></div><strong>@Money(Math.Max(node.Amount, Math.Max(node.DebitAmount, node.CreditAmount)), node.Currency)</strong></div>
                            }
                        </div></section>
                        <section class="advanced-reasons"><h5>@FinanceText["WhySuggested"]</h5>
                            @foreach (var reason in SelectedAdvanced.ReasonContributions)
                            { <div><span><strong>@FinanceText[reason.FeatureKey switch { "normalized_reference" => "NormalizedReference", "counterparty" => "Counterparty", "amount" => "Amount", "timing" => "Timing", _ => "ProviderPattern" }]</strong><small>@reason.Explanation</small></span><strong class="amount-positive">@reason.Contribution.ToString("P0")</strong></div> }
                            <footer><span>@FinanceText["RuleVersion", SelectedAdvanced.Summary.RuleVersion]</span><strong>@FinanceText["ConfidenceValue", SelectedAdvanced.Summary.ConfidenceScore.ToString("P0")]</strong></footer>
                        </section>
                    </div>
                    <section class="advanced-review"><div><strong>@FinanceText["ReviewRequired"]</strong><p>@(SelectedAdvanced.Summary.RequiresApproval ? FinanceText["MaterialReviewRequired"] : FinanceText["HumanDecisionRequired"])</p></div><textarea class="form-control" rows="2" @bind="AdvancedDecisionReason" placeholder="@FinanceText["AdvancedDecisionReasonPlaceholder"]"></textarea></section>
                    <div class="advanced-actions">
                        @if (SelectedAdvanced.Summary.Status == "proposed")
                        { <button class="btn btn-outline-danger" type="button" disabled="@(!CanApproveAdvancedReconciliation || IsSubmitting || SelectedAdvanced.Summary.IsStale)" @onclick="RejectAdvancedAsync">@FinanceText["RejectSuggestion"]</button><button class="btn btn-primary" type="button" disabled="@(!CanApproveAdvancedReconciliation || IsSubmitting || SelectedAdvanced.Summary.IsStale || !SelectedAdvanced.IsBalanced)" @onclick="AcceptAdvancedAsync">@FinanceText["AcceptAndPost"]</button> }
                        else if (SelectedAdvanced.Summary.Status == "accepted")
                        { <button class="btn btn-outline-danger" type="button" disabled="@(!CanApproveAdvancedReconciliation || IsSubmitting || ReclassificationPeriodId == Guid.Empty)" @onclick="ReverseAdvancedAsync">@FinanceText["CreateLinkedReversal"]</button> }
                    </div>
                    <section class="advanced-history"><h5>@FinanceText["ImmutableHistory"]</h5>@foreach (var history in SelectedAdvanced.History) { <div><span aria-hidden="true">•</span><strong>@AdvancedStatusLabel(history.Action)</strong><small>@history.CreatedUtc.ToLocalTime().ToString("g")</small></div> }</section>
                }
            </div>
        </div>
    </section>

    <div class="reconciliation-subheading"><h3>@FinanceText["IndividualBankTransactions"]</h3><p>@FinanceText["IndividualBankTransactionsHelp"]</p></div>

    <div class="reconciliation-layout">
        <section class="reconciliation-list-card" aria-busy="@IsWorkspaceLoading">
            <header><div><h3>@FinanceText["BankActivity"]</h3><span>@FinanceText["TransactionCount", Workspace.Items.Count]</span></div><button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ApplyFiltersAsync">@CommonText["Refresh"]</button></header>
            <FinanceDataState IsLoading="@IsWorkspaceLoading" IsEmpty="@(!IsWorkspaceLoading && Workspace.Items.Count == 0)" ErrorMessage="@null" LoadingTitle="@FinanceText["LoadingBankActivity"]" LoadingMessage="@FinanceText["LoadingBankActivityHelp"]" EmptyTitle="@FinanceText["NoBankItems"]" EmptyMessage="@FinanceText["NoBankItemsHelp"]" OnRetry="ApplyFiltersAsync">
                <div class="table-responsive"><table class="table reconciliation-table align-middle"><thead><tr><th>@FinanceText["Date"]</th><th>@FinanceText["CounterpartyReference"]</th><th>@FinanceText["Amount"]</th><th>@FinanceText["AllocatedRemaining"]</th><th>@FinanceText["State"]</th></tr></thead><tbody>
                    @foreach (var item in Workspace.Items)
                    {
                        <tr class="@(Selected?.Transaction.Id == item.BankTransactionId ? "selected" : null)" role="button" tabindex="0" aria-selected="@(Selected?.Transaction.Id == item.BankTransactionId)" @onclick="() => SelectAsync(item.BankTransactionId)" @onkeydown="args => HandleTransactionKeyAsync(args, item.BankTransactionId)"><td>@item.BookingDate.ToString("d")</td><td><strong>@item.Counterparty</strong><small>@item.ReferenceText</small></td><td class="@(item.Amount >= 0 ? "amount-positive" : "amount-negative")">@Money(item.Amount, item.Currency)</td><td><strong>@Money(item.AllocatedAmount, item.Currency)</strong><small>@FinanceText["RemainingValue", Money(item.RemainingAmount, item.Currency)]</small></td><td><span class="reconciliation-badge reconciliation-badge--@item.State">@StateLabel(item.State)</span></td></tr>
                    }
                </tbody></table></div>
            </FinanceDataState>
        </section>

        <aside class="reconciliation-detail-card" aria-live="polite" aria-busy="@IsDetailLoading">
            @if (IsDetailLoading) { <FinanceLoadingState Title="@FinanceText["OpeningTransaction"]" Message="@FinanceText["OpeningTransactionHelp"]" /> }
            else if (Selected is null) { <div class="reconciliation-empty"><span aria-hidden="true">↔</span><h3>@FinanceText["SelectBankTransaction"]</h3><p>@FinanceText["SelectBankTransactionHelp"]</p></div> }
            else
            {
                <header class="reconciliation-detail-header"><div><span class="reconciliation-badge reconciliation-badge--@Selected.State">@StateLabel(Selected.State)</span><h3 class="@(Selected.Transaction.Amount >= 0 ? "amount-positive" : "amount-negative")">@Money(Selected.Transaction.Amount, Selected.Transaction.Currency)</h3><p>@Selected.Transaction.Counterparty · @Selected.Transaction.ReferenceText</p></div><small>@Selected.Transaction.BookingDate.ToString("d")</small></header>
                <section class="reconciliation-progress"><div><span>@FinanceText["AllocationProgress"]</span><strong>@FinanceText["AmountOfTotal", Money(Selected.Transaction.ReconciledAmount, Selected.Transaction.Currency), Money(Math.Abs(Selected.Transaction.Amount), Selected.Transaction.Currency)]</strong></div><progress value="@Selected.Transaction.ReconciledAmount" max="@Math.Abs(Selected.Transaction.Amount)"></progress><small>@FinanceText["RemainsVisible", Money(Selected.RemainingAmount, Selected.Transaction.Currency)]</small></section>

                @if (SelectedTreasury is not null)
                {
                    <section class="treasury-treatment" aria-label="@FinanceText["TreasuryTreatment"]">
                        <header class="treasury-treatment__header">
                            <div><span class="dashboard-kicker">@FinanceText["TreasuryTreatment"]</span><h4>@TreasuryTypeLabel(SelectedTreasury.Summary.SourceType)</h4><p>@SelectedTreasury.Summary.DisplayName</p></div>
                            <span class="reconciliation-badge treasury-status--@SelectedTreasury.Summary.Status">@TreasuryStatusLabel(SelectedTreasury.Summary.Status)</span>
                        </header>
                        @if (RelatedTreasurySources.Count > 1)
                        {
                            <div class="treasury-source-tabs" aria-label="@FinanceText["RelatedTreasurySources"]">
                                @foreach (var source in RelatedTreasurySources)
                                { <button type="button" class="@(source.Id == SelectedTreasury.Summary.Id ? "selected" : null)" @onclick="() => SelectTreasuryAsync(source)">@TreasuryTypeLabel(source.SourceType)</button> }
                            </div>
                        }
                        <div class="treasury-treatment__grid">
                            <div><small>@FinanceText["TreasuryGross"]</small><strong>@Money(SelectedTreasury.Summary.GrossAmount, SelectedTreasury.Summary.Currency)</strong></div>
                            <div><small>@FinanceText["TreasuryFees"]</small><strong>@Money(SelectedTreasury.Summary.FeeAmount, SelectedTreasury.Summary.Currency)</strong></div>
                            <div><small>@FinanceText["TreasuryNet"]</small><strong>@Money(SelectedTreasury.Summary.NetAmount, SelectedTreasury.Summary.Currency)</strong></div>
                            <div><small>@FinanceText["TreasuryBankEvidence"]</small><strong>@FinanceText["TreasuryEvidenceCount", SelectedTreasury.BankEvidence.Count]</strong></div>
                        </div>
                        <div class="treasury-control @(SelectedTreasury.AllowedActions.CanPost || SelectedTreasury.Summary.Status is "posted" or "reversed" ? "treasury-control--passed" : "treasury-control--attention")">
                            <span aria-hidden="true">@(SelectedTreasury.AllowedActions.CanPost || SelectedTreasury.Summary.Status is "posted" or "reversed" ? "✓" : "!")</span>
                            <div><strong>@FinanceText[SelectedTreasury.AllowedActions.CanPost || SelectedTreasury.Summary.Status is "posted" or "reversed" ? "TreasuryControlPassed" : "NeedsAttention"]</strong><p>@SelectedTreasury.AllowedActions.Explanation</p></div>
                        </div>
                        <div class="treasury-evidence-list">
                            @foreach (var evidence in SelectedTreasury.BankEvidence)
                            { <a href="@FinanceRoutes.WithCompanyContext($"{FinanceRoutes.AccountingReconciliation}/{evidence.BankTransactionId:D}", AccessState.CompanyId)"><span>@TreasuryStatusLabel(evidence.LegRole == "outbound" || evidence.LegRole == "inbound" ? "in_transit" : SelectedTreasury.Summary.Status)</span><strong>@Money(evidence.Amount, evidence.Currency)</strong><small>@evidence.BookingDate.ToString("d") · @evidence.Counterparty</small></a> }
                            @if (SelectedTreasury.Evidence.Count > SelectedTreasury.BankEvidence.Count)
                            { <div><span>@FinanceText["TreasuryProviderEvidence"]</span><strong>@FinanceText["TreasuryEvidenceCount", SelectedTreasury.Evidence.Count - SelectedTreasury.BankEvidence.Count]</strong></div> }
                        </div>
                        @if (TreasuryPostingPreview is not null)
                        {
                            <section class="treasury-preview"><h5>@FinanceText["TreasuryPostingPreview"]</h5>
                                @foreach (var line in TreasuryPostingPreview.Lines)
                                { <div><span><strong>@line.AccountCode · @line.AccountName</strong><small>@line.Description</small></span><span>@(line.DebitAmount > 0m ? FinanceText["TreasuryDebit", Money(line.DebitAmount, line.Currency)] : FinanceText["TreasuryCredit", Money(line.CreditAmount, line.Currency)])</span></div> }
                                @if (!string.IsNullOrWhiteSpace(TreasuryPostingPreview.BlockingReason)) { <p class="text-danger">@TreasuryPostingPreview.BlockingReason</p> }
                            </section>
                        }
                        <div class="treasury-actions">
                            @if (SelectedTreasury.AllowedActions.CanPreview)
                            { <button class="btn btn-outline-primary" type="button" disabled="@(!CanManageAccounting || IsSubmitting || ReclassificationPeriodId == Guid.Empty)" @onclick="PreviewTreasuryAsync">@FinanceText["ReviewPostingPreview"]</button> }
                            @if (SelectedTreasury.AllowedActions.CanPost)
                            { <button class="btn btn-primary" type="button" disabled="@(!CanApproveAdvancedReconciliation || IsSubmitting || ReclassificationPeriodId == Guid.Empty)" @onclick="PostTreasuryAsync">@FinanceText["PostTreasurySource"]</button> }
                            @if (SelectedTreasury.AllowedActions.CanReverse)
                            { <textarea class="form-control" rows="2" @bind="TreasuryReviewReason" placeholder="@FinanceText["TreasuryReversalReasonPlaceholder"]"></textarea><button class="btn btn-outline-danger" type="button" disabled="@(!CanApproveAdvancedReconciliation || IsSubmitting || ReclassificationPeriodId == Guid.Empty)" @onclick="ReverseTreasuryAsync">@FinanceText["CreateLinkedReversal"]</button> }
                        </div>
                        <section class="treasury-history"><h5>@FinanceText["ImmutableHistory"]</h5>
                            @foreach (var item in SelectedTreasury.History)
                            { <div><span aria-hidden="true">•</span><strong>@item.Action.Replace('_', ' ')</strong><small>@item.CreatedUtc.ToLocalTime().ToString("g")</small></div> }
                        </section>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(Selected.BlockingReason)) { <div class="reconciliation-notice reconciliation-notice--danger"><strong>@FinanceText["NeedsAttention"]</strong><p>@Selected.BlockingReason</p></div> }

                <section class="reconciliation-section"><h4>@FinanceText["MatchCompletedPayment"]</h4>
                    @if (Selected.CandidatePayments.Count == 0) { <p class="text-secondary">@FinanceText["NoCandidatePayment"]</p> }
                    else
                    {
                        <label class="visually-hidden" for="reconciliation-payment">@FinanceText["SelectPayment"]</label>
                        <select id="reconciliation-payment" class="form-select" @bind="SelectedPaymentId"><option value="@Guid.Empty">@FinanceText["SelectPayment"]</option>@foreach (var payment in Selected.CandidatePayments) { <option value="@payment.PaymentId">@payment.CounterpartyReference · @FinanceText["AvailableValue", Money(payment.AvailableAmount, payment.Currency)]</option> }</select>
                        <div class="reconciliation-amount-row"><label class="visually-hidden" for="reconciliation-match-amount">@FinanceText["MatchAmount"]</label><input id="reconciliation-match-amount" class="form-control" type="number" step="0.01" min="0.01" @bind="MatchAmount" /><button class="btn btn-primary" type="button" disabled="@(!CanManageAccounting || IsSubmitting || SelectedPaymentId == Guid.Empty)" @onclick="MatchPaymentAsync">@FinanceText["MatchPayment"]</button></div>
                        @if (SelectedPayment is { } selectedPayment)
                        {
                            <div class="reconciliation-link-list" aria-label="@FinanceText["SelectedPaymentSourceLinks"]">
                                <a href="@PaymentHref(selectedPayment.PaymentId)"><span>@FinanceText["OpenPayment"]</span><small>@FinanceText["OpenPaymentHelp"]</small></a>
                                @if (selectedPayment.InvoiceId is Guid invoiceId) { <a href="@InvoiceHref(invoiceId)"><span>@FinanceText["OpenCustomerInvoice"]</span><small>@(selectedPayment.InvoiceNumber ?? FinanceText["RelatedReceivable"])</small></a> }
                                @if (selectedPayment.BillId is Guid billId) { <a href="@BillHref(billId)"><span>@FinanceText["OpenSupplierBill"]</span><small>@(selectedPayment.BillNumber ?? FinanceText["RelatedPayable"])</small></a> }
                            </div>
                        }
                    }
                </section>

                <section class="reconciliation-section"><h4>@FinanceText["ExplicitDifferenceLines"]</h4><p class="reconciliation-help">@FinanceText["ExplicitDifferenceLinesHelp"]</p><div class="reconciliation-adjustment-grid"><select class="form-select" aria-label="@FinanceText["AdjustmentKind"]" @bind="AdjustmentKind"><option value="bank_fee">@FinanceText["BankFee"]</option><option value="settlement_discount">@FinanceText["SettlementDiscount"]</option><option value="rounding_difference">@FinanceText["RoundingDifference"]</option><option value="exchange_gain">@FinanceText["ExchangeGain"]</option><option value="exchange_loss">@FinanceText["ExchangeLoss"]</option></select><input class="form-control" type="number" min="0" step="0.01" aria-label="@FinanceText["AdjustmentDebit"]" placeholder="@FinanceText["Debit"]" @bind="AdjustmentDebit" /><input class="form-control" type="number" min="0" step="0.01" aria-label="@FinanceText["AdjustmentCredit"]" placeholder="@FinanceText["Credit"]" @bind="AdjustmentCredit" /></div><input class="form-control reconciliation-adjustment-explanation" aria-label="@FinanceText["DifferenceExplanation"]" @bind="AdjustmentExplanation" placeholder="@FinanceText["DifferenceExplanationPlaceholder"]" /></section>

                <section class="reconciliation-section"><h4>@FinanceText["ReviewedHandling"]</h4><textarea class="form-control" aria-label="@FinanceText["ReviewReason"]" rows="2" @bind="ReviewReason" placeholder="@FinanceText["ReviewReasonPlaceholder"]"></textarea><select class="form-select reconciliation-category" aria-label="@FinanceText["ReviewedCategory"]" @bind="CategorizationAccountId"><option value="@Guid.Empty">@FinanceText["SelectReviewedCategory"]</option>@foreach (var account in Accounts.Where(x => x.IsPostingEnabled && !x.IsProtected)) { <option value="@account.Id">@account.Code · @account.Name</option> }</select><div class="reconciliation-choice-grid"><button type="button" class="reconciliation-choice" disabled="@(!CanManageAccounting || IsSubmitting || CategorizationAccountId == Guid.Empty)" @onclick="CategorizeAsync"><strong>@FinanceText["PostReviewedCategory"]</strong><span>@FinanceText["PostReviewedCategoryHelp"]</span></button><button type="button" class="reconciliation-choice" disabled="@(!CanManageAccounting || IsSubmitting || !Selected.CanPostToSuspense)" @onclick="PostSuspenseAsync"><strong>@FinanceText["PostToSuspense"]</strong><span>@FinanceText["PostToSuspenseHelp"]</span></button><button type="button" class="reconciliation-choice" disabled="@(!CanManageAccounting || IsSubmitting)" @onclick="LeaveUnmatchedAsync"><strong>@FinanceText["LeaveUnmatched"]</strong><span>@FinanceText["LeaveUnmatchedHelp"]</span></button></div></section>

                <section class="reconciliation-section"><h4>@FinanceText["SourceAndJournalLinks"]</h4>
                    @if (Selected.Journals.Count == 0) { <p class="text-secondary">@FinanceText["NoJournalPostedForItem"]</p> }
                    else { <div class="reconciliation-link-list">@foreach (var journal in Selected.Journals) { <a href="@JournalHref(journal.LedgerEntryId)"><span>@journal.EntryNumber</span><small>@FinanceText[journal.IsOriginalSuspense ? "OriginalSuspenseJournal" : journal.IsCorrection ? "LinkedCorrection" : "GovernedBankJournal"]</small></a> }</div> }
                </section>

                @if (Selected.CanReclassify)
                {
                    <section class="reconciliation-section reconciliation-correction"><h4>@FinanceText["CorrectSuspenseClassification"]</h4><p>@FinanceText["CorrectSuspenseClassificationHelp"]</p><select class="form-select" aria-label="@FinanceText["ReplacementAccount"]" @bind="ReclassificationAccountId"><option value="@Guid.Empty">@FinanceText["SelectReplacementAccount"]</option>@foreach (var account in Accounts.Where(x => x.IsPostingEnabled && !x.IsProtected)) { <option value="@account.Id">@account.Code · @account.Name</option> }</select><select class="form-select" aria-label="@FinanceText["OpenPeriod"]" @bind="ReclassificationPeriodId"><option value="@Guid.Empty">@FinanceText["SelectOpenPeriod"]</option>@foreach (var period in FiscalYears.SelectMany(x => x.Periods).Where(x => !x.IsClosed && !x.IsReportingLocked)) { <option value="@period.Id">@period.Name</option> }</select><button class="btn btn-outline-primary" type="button" disabled="@(!CanManageAccounting || IsSubmitting)" @onclick="ReclassifyAsync">@FinanceText["CreateLinkedCorrection"]</button></section>
                }

                <section class="reconciliation-laura"><span aria-hidden="true">L</span><div><strong>@FinanceText["LauraFinanceManager"]</strong><p>@LauraReconciliationAdvice</p></div></section>
            }
        </aside>
    </div>
</FinancePageLayout>
