@page "/finance/payments"
@page "/finance/payments/{PaymentId:guid}"
@inherits FinancePageBase

<PageTitle>@FinanceText["Payments"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["Payments"]"
    Description="@FinanceText["PaymentsDescription"]"
    LoadingMessage="@FinanceText["LoadingPayments"]"
    ShowShellHeader="false"
    ShowShellNavigation="false">
    <section class="payments-dashboard" aria-labelledby="payments-heading">
        <div class="finance-overview-header">
            <div>
                <span class="finance-overview-kicker">@FinanceText["FinanceModule"]</span>
                <h1 id="payments-heading" class="finance-overview-title">@FinanceText["Payments"]</h1>
                <p class="finance-overview-subtitle">@FinanceText["PaymentsDescription"]</p>
            </div>
            <div class="finance-overview-header__actions">
                <a class="btn finance-overview-button finance-overview-button--primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Home, AccessState.CompanyId)">@FinanceText["FinanceOverview"]</a>
                <a class="btn finance-overview-button finance-overview-button--secondary" href="@DashboardHref">@FinanceText["CompanyDashboard"]</a>
            </div>
        </div>

        <FinanceSectionNav CompanyId="@AccessState.CompanyId!.Value" MembershipRole="@AccessState.MembershipRole" />

        <form method="get" class="payments-filter-bar">
            <input type="hidden" name="@FinanceRoutes.CompanyIdQueryKey" value="@AccessState.CompanyId" />
            <div class="payments-filter-bar__field">
                <label for="payment-filter-type">@FinanceText["Type"]</label>
                <select id="payment-filter-type" name="type">
                    <option value="" selected="@string.IsNullOrWhiteSpace(TypeFilterValue)">@FinanceText["All"]</option>
                    <option value="incoming" selected="@IsTypeSelected("incoming")">@FinanceText["Incoming"]</option>
                    <option value="outgoing" selected="@IsTypeSelected("outgoing")">@FinanceText["Outgoing"]</option>
                </select>
            </div>
            <div class="payments-filter-bar__actions">
                <button class="btn payments-button payments-button--primary" type="submit">@FinanceText["ApplyFilters"]</button>
                <a class="btn payments-button payments-button--secondary" href="@ClearFiltersHref">@FinanceText["Clear"]</a>
            </div>
        </form>

        <div class="payments-layout">
            <article class="payment-list-card">
                <div class="payment-list-card__header">
                    <div>
                        <h2>@FinanceText["Payments"]</h2>
                        <p>@FinanceText["PaymentListDescription"]</p>
                    </div>
                    <span>@CommonText[Payments.Count == 1 ? "ItemCountOne" : "ItemCountMany", Payments.Count]</span>
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@IsListEmpty"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="@FinanceText["LoadingPayments"]"
                    LoadingMessage="@FinanceText["FetchingPayments"]"
                    EmptyTitle="@FinanceText["NoPaymentsMatched"]"
                    EmptyMessage="@FinanceText["NoPaymentsMatchedDescription"]"
                    OnRetry="@ReloadAsync">
                    <div class="payment-list">
                        @foreach (var payment in PaymentItems)
                        {
                            <a class="@($"payment-list-item {(payment.IsSelected ? "is-selected" : string.Empty)}")" href="@BuildPaymentHref(payment.Id)">
                                <span class="@($"payment-list-item__icon payment-tone--{payment.IconTone}")" aria-hidden="true">@payment.IconText</span>
                                <span class="payment-list-item__main">
                                    <strong>@payment.Reference</strong>
                                    <span>@payment.MethodLabel <span aria-hidden="true">&middot;</span> @payment.DisplayDate</span>
                                </span>
                                <span class="payment-list-item__meta">
                                    <strong>@payment.DisplayAmount</strong>
                                    <span class="@($"payment-status-badge payment-status-badge--{payment.StatusTone}")">@payment.StatusLabel</span>
                                </span>
                                <span class="payment-list-item__chevron" aria-hidden="true">&rsaquo;</span>
                            </a>
                        }
                    </div>
                </FinanceDataState>
            </article>

            <aside class="payments-side-stack">
                <div class="payment-detail-card">
                    @if (IsDetailLoading)
                    {
                        <FinanceLoadingState Title="@FinanceText["LoadingPaymentDetail"]" Message="@FinanceText["OpeningPayment"]" />
                    }
                    else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                    {
                        <FinanceErrorState Title="@FinanceText["PaymentDetailUnavailable"]" Message="@(DetailErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@ReloadAsync" />
                    }
                    else if (SelectedPayment is null)
                    {
                        <div class="payment-detail-empty">
                            <div class="payment-detail-empty__icon" aria-hidden="true">pay</div>
                            <h2>@FinanceText["NoPaymentSelected"]</h2>
                            <p>@FinanceText["SelectPayment"]</p>
                        </div>
                    }
                    else if (SelectedPaymentDisplay is { } detail)
                    {
                        <div class="payment-detail-panel">
                            <div class="payment-detail-panel__header">
                                <div>
                                    <h2>@detail.Reference</h2>
                                    <p>@FinanceText["PaymentTypeSuffix", detail.PaymentTypeLabel]</p>
                                </div>
                                <span class="@($"payment-status-badge payment-status-badge--{detail.StatusTone}")">@detail.StatusLabel</span>
                            </div>

                            <div class="payment-detail-panel__amount">@detail.DisplayAmount</div>

                            <dl class="payment-detail-list">
                                <div><dt>@FinanceText["PaymentType"]</dt><dd>@detail.PaymentTypeLabel</dd></div>
                                <div><dt>@FinanceText["Amount"]</dt><dd>@detail.DisplayAmount</dd></div>
                                <div><dt>@FinanceText["Status"]</dt><dd>@detail.StatusLabel</dd></div>
                                <div><dt>@FinanceText["RelatedInvoiceBill"]</dt><dd>@detail.Reference</dd></div>
                                <div><dt>@FinanceText["PaymentMethod"]</dt><dd>@detail.MethodLabel</dd></div>
                                <div><dt>@FinanceText["Date"]</dt><dd>@detail.DisplayDate</dd></div>
                            </dl>

                            <AgentInsightsPanel
                                Title="@FinanceText["AgentInsights"]"
                                Subtitle="@FinanceText["PaymentAgentInsightsSubtitle"]"
                                EmptyMessage="@FinanceText["NoPaymentAgentInsights"]"
                                TestId="payment-agent-insights-panel"
                                Items="@SelectedPayment.AgentInsights" />
                        </div>
                    }
                </div>

                <section class="payments-laura-card" aria-label="@FinanceText["FinanceManager"]">
                    <div class="payments-laura-card__avatar" aria-hidden="true">L</div>
                    <div>
                        <h2>Laura</h2>
                        <p class="payments-laura-card__role">@FinanceText["FinanceManager"]</p>
                    </div>
                    <p class="payments-laura-card__message">@FinanceText["LauraFinanceMessage"]</p>
                    <a class="btn payments-button payments-button--primary" href="@LauraHref">@FinanceText["MessageLaura"]</a>
                </section>
            </aside>
        </div>
    </section>
</FinancePageLayout>
