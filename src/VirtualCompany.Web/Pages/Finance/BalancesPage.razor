@page "/finance/balances"
@inherits FinanceSummaryPageBase<BalancesSummaryViewModel>

<PageTitle>@FinanceText["Balances"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["Balances"]"
    Description="@FinanceText["BalancesDescription"]"
    LoadingMessage="@FinanceText["LoadingBalances"]">
    <div class="finance-subtab-nav" aria-label="@FinanceText["Cash"]">
        <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.CashPosition, AccessState.CompanyId)">@FinanceText["CashPosition"]</a>
        <a class="finance-subtab-nav__link active" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Balances, AccessState.CompanyId)">@FinanceText["Balances"]</a>
        <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.MonthlySummary, AccessState.CompanyId)">@FinanceText["MonthlySummary"]</a>
    </div>
    <FinanceDataState
        IsLoading="@IsSummaryLoading"
        IsEmpty="@IsSummaryEmpty"
        ErrorMessage="@SummaryErrorMessage"
        LoadingTitle="@FinanceText["LoadingBalances"]"
        LoadingMessage="@FinanceText["FetchingBalances"]"
        EmptyTitle="@FinanceText["NoBalances"]"
        EmptyMessage="@FinanceText["NoBalancesDescription"]"
        RetryText="@FinanceText["ReloadBalances"]"
        OnRetry="@RetryAsync">
        @if (ViewModel is not null)
        {
            <section class="finance-summary-stack" aria-labelledby="balances-heading">
                <div class="finance-summary-grid">
                    <article class="wizard-card finance-metric-card finance-metric-card--hero">
                        <span class="dashboard-kicker">@FinanceText["TotalBalance"]</span>
                        <h2 id="balances-heading" class="finance-metric-card__value">@ViewModel.TotalBalance</h2>
                        <p class="text-body-secondary mb-0">@FinanceText["AsOfValue", ViewModel.AsOf]</p>
                    </article>
                    <article class="wizard-card finance-metric-card">
                        <span class="dashboard-kicker">@FinanceText["TrackedAccounts"]</span>
                        <div class="finance-metric-card__value finance-metric-card__value--compact">@ViewModel.Accounts.Count</div>
                        <p class="text-body-secondary mb-0">@FinanceText["ActiveCompanyScope"]</p>
                    </article>
                </div>
                <article class="wizard-card">
                    <h2 class="h5">@FinanceText["AccountBalances"]</h2>
                    <div class="table-responsive">
                        <table class="table finance-table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@FinanceText["Code"]</th>
                                    <th scope="col">@FinanceText["Account"]</th>
                                    <th scope="col">@FinanceText["Type"]</th>
                                    <th scope="col">@FinanceText["AsOf"]</th>
                                    <th scope="col" class="finance-table__number">@FinanceText["Amount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in ViewModel.Accounts)
                                {
                                    <tr>
                                        <td>@account.AccountCode</td>
                                        <td>@account.AccountName</td>
                                        <td>@account.AccountType</td>
                                        <td>@account.AsOf</td>
                                        <td class="finance-table__number">@account.Amount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            </section>
        }
    </FinanceDataState>
</FinancePageLayout>
