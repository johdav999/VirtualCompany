@page "/simulation-lab"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["SandboxTitle"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["SandboxTitle"]"
    Description="@FinanceText["SandboxDescription"]"
    LoadingMessage="@FinanceText["SandboxLoading"]"
    Area="SimulationLab">
    @if (!HasSandboxAdminAccess)
    {
        <ForbiddenState
            Title="@FinanceText["SandboxAccessRequired"]"
            Message="@FinanceText["SandboxAccessDescription"]"
            ReturnHref="@BuildFinanceHomeHref()"
            ReturnText="@FinanceText["SandboxBackToFinance"]" />
    }
    else
    {
        <section class="finance-summary-stack" aria-label="@FinanceText["SandboxSections"]">
            <article class="wizard-card">
                <div class="mb-3">
                    <span class="dashboard-kicker">@FinanceText["SandboxDataGeneration"]</span>
                    <h2 class="h5 mb-2">@FinanceText["SandboxRegenerateDataset"]</h2>
                    <p class="text-body-secondary mb-0">@FinanceText["SandboxRegenerateDescription"]</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_seedGenerationErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_seedGenerationErrorMessage
                    </div>
                }

                <EditForm EditContext="@_seedGenerationEditContext" OnValidSubmit="@HandleSeedGenerationSubmitAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div id="seed-generation-form" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="seed-company">@FinanceText["SandboxCompany"]</label>
                            <InputSelect id="seed-company"
                                         class="form-select"
                                         Value="_seedGenerationForm.CompanyId"
                                         ValueChanged="@(EventCallback.Factory.Create<Guid>(this, HandleCompanySelectionChangedAsync))"
                                         ValueExpression="() => _seedGenerationForm.CompanyId"
                                         disabled="@(_isSubmittingSeedGeneration || _companyOptions.Count <= 1)">
                                @foreach (var option in _companyOptions)
                                {
                                    <option value="@option.CompanyId">@option.CompanyName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _seedGenerationForm.CompanyId)" />
                            <div class="form-text">@CompanySelectionDescription</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="anchor-date">@FinanceText["SandboxStartDate"]</label>
                            <InputDate id="anchor-date" class="form-control" @bind-Value="_seedGenerationForm.AnchorDateUtc" disabled="@_isSubmittingSeedGeneration" />
                            <ValidationMessage For="@(() => _seedGenerationForm.AnchorDateUtc)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="generation-mode">@FinanceText["SandboxGenerationMode"]</label>
                            <InputSelect id="generation-mode" class="form-select" @bind-Value="_seedGenerationForm.GenerationMode" disabled="@_isSubmittingSeedGeneration">
                                @foreach (var option in _generationModeOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </InputSelect>
                            <div class="form-text">@SelectedGenerationModeDescription</div>
                            <ValidationMessage For="@(() => _seedGenerationForm.GenerationMode)" />
                        </div>
                        <div class="col-12 d-flex align-items-center gap-3">
                            <button id="seed-generate-submit" type="submit" class="btn btn-primary" disabled="@_isSubmittingSeedGeneration">
                                @(_isSubmittingSeedGeneration ? FinanceText["SandboxRegeneratingData"] : FinanceText["SandboxRegenerateData"])
                            </button>
                            @if (_isSubmittingSeedGeneration)
                            {
                                <span class="text-body-secondary">@FinanceText["SandboxActionRunning"]</span>
                            }
                        </div>
                        <div class="col-12">
                            <details class="border rounded p-3">
                                <summary class="fw-semibold">@FinanceText["Advanced"]</summary>
                                <div class="row g-3 mt-1">
                                    <div class="col-md-4">
                                        <label class="form-label" for="seed-value">@FinanceText["SandboxReproducibilityValue"]</label>
                                        <InputNumber id="seed-value" class="form-control" @bind-Value="_seedGenerationForm.SeedValue" disabled="@_isSubmittingSeedGeneration" />
                                        <ValidationMessage For="@(() => _seedGenerationForm.SeedValue)" />
                                        <div class="form-text">@FinanceText["SandboxReproducibilityHelp"]</div>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>
                </EditForm>

                @if (_seedGenerationResult is not null)
                {
                    <div class="mt-4" aria-live="polite">
                        <div class="alert @(_seedGenerationResult.Succeeded ? "alert-success" : "alert-danger")" role="status">
                            @_seedGenerationResult.Message
                        </div>
                        <section class="border rounded p-3 mb-3" aria-labelledby="generation-summary-title">
                            <h3 id="generation-summary-title" class="h6 mb-3">@FinanceText["SandboxGenerationSummary"]</h3>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6 col-lg-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["Created"]</div>
                                        <div class="fs-4 fw-semibold">@_seedGenerationResult.CreatedCount</div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["Updated"]</div>
                                        <div class="fs-4 fw-semibold">@_seedGenerationResult.UpdatedCount</div>
                                    </div>
                                </div>
                            </div>

                            <dl class="row mb-0">
                                <dt class="col-sm-3">@FinanceText["SandboxCompany"]</dt>
                                <dd class="col-sm-9">@_seedGenerationForm.CompanyName</dd>
                                <dt class="col-sm-3">@FinanceText["SandboxStartDate"]</dt>
                                <dd class="col-sm-9">@LocalDateTime.Date(DateOnly.FromDateTime(_seedGenerationResult.AnchorDateUtc))</dd>
                                <dt class="col-sm-3">@FinanceText["SandboxGenerationMode"]</dt>
                                <dd class="col-sm-9">@GetGenerationModeLabel(_seedGenerationResult.GenerationMode)</dd>
                            </dl>
                            <details class="mt-3">
                                <summary class="fw-semibold">@FinanceText["Advanced"]</summary>
                                <dl class="row mt-2 mb-0">
                                    <dt class="col-sm-3">@FinanceText["SandboxReproducibilityValue"]</dt>
                                    <dd class="col-sm-9">@_seedGenerationResult.SeedValue</dd>
                                </dl>
                            </details>
                        </section>

                        <section class="border rounded p-3" aria-labelledby="validation-results-title">
                            <h3 id="validation-results-title" class="h6 mb-3">@FinanceText["SandboxValidationResults"]</h3>

                            @if (_seedGenerationResult.ReferentialIntegrityErrors.Count > 0)
                            {
                                <div class="mb-3">
                                    <h4 class="h6 text-danger">@FinanceText["SandboxReferentialIntegrityErrors"]</h4>
                                    <ul class="mb-0">
                                        @foreach (var issue in _seedGenerationResult.ReferentialIntegrityErrors)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(issue.Code))
                                                {
                                                    <span class="fw-semibold">@FormatPlainLabel(issue.Code):</span>
                                                    <span> </span>
                                                }
                                                @issue.Message
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (_seedGenerationResult.Errors.Count > 0)
                            {
                                <div class="mb-3">
                                    <h4 class="h6 text-danger">@FinanceText["SandboxValidationErrors"]</h4>
                                    <ul class="mb-0">
                                        @foreach (var issue in _seedGenerationResult.Errors)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(issue.Code))
                                                {
                                                    <span class="fw-semibold">@FormatPlainLabel(issue.Code):</span>
                                                    <span> </span>
                                                }
                                                @issue.Message
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (_seedGenerationResult.Warnings.Count > 0)
                            {
                                <div class="mb-0">
                                    <h4 class="h6 text-warning-emphasis">@FinanceText["Warnings"]</h4>
                                    <ul class="mb-0">
                                        @foreach (var issue in _seedGenerationResult.Warnings)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(issue.Code))
                                                {
                                                    <span class="fw-semibold">@FormatPlainLabel(issue.Code):</span>
                                                    <span> </span>
                                                }
                                                @issue.Message
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else if (_seedGenerationResult.Succeeded && _seedGenerationResult.Errors.Count == 0 && _seedGenerationResult.ReferentialIntegrityErrors.Count == 0)
                            {
                                <p class="text-success mb-0">@FinanceText["SandboxValidationPassed"]</p>
                            }
                        </section>
                    </div>
                }
            </article>

            <div @key="DatasetGenerationSectionKey">
                <FinanceSandboxAdminSection TSection="FinanceSandboxDatasetGenerationViewModel"
                                            CompanyId="@AccessState.CompanyId!.Value"
                                            Kicker="@FinanceText["SandboxDataGeneration"]"
                                            Title="@FinanceText["SandboxDatasetGeneration"]"
                                            Description="@FinanceText["SandboxDatasetDescription"]"
                                            LoadingTitle="@FinanceText["SandboxLoadingDataset"]"
                                            LoadingMessage="@FinanceText["SandboxResolvingDataset"]"
                                            EmptyTitle="@FinanceText["SandboxDatasetNotConfigured"]"
                                            EmptyMessage="@FinanceText["SandboxNoDatasetProfile"]"
                                            ErrorTitle="@FinanceText["SandboxDatasetUnavailable"]"
                                            Loader="@LoadDatasetGenerationAsync">
                    <ChildContent Context="dataset">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">@FinanceText["SandboxProfile"]</dt>
                            <dd class="col-sm-8">@FormatProfileName(dataset.ProfileName)</dd>
                        <dt class="col-sm-4">@FinanceText["SandboxLastRefresh"]</dt>
                        <dd class="col-sm-8">@LocalDateTime.DateTime(dataset.LastGeneratedUtc)</dd>
                        <dt class="col-sm-4">@FinanceText["SandboxCoverage"]</dt>
                        <dd class="col-sm-8">@dataset.CoverageSummary</dd>
                    </dl>
                    <div class="mt-3">
                        <strong class="d-block mb-2">@FinanceText["SandboxAvailableProfiles"]</strong>
                        <ul class="mb-0">
                            @foreach (var profile in dataset.AvailableProfiles)
                            {
                            <li>@FormatProfileName(profile)</li>
                            }
                        </ul>
                    </div>
                    </ChildContent>
                </FinanceSandboxAdminSection>
            </div>

            <div @key="AnomalyInjectionSectionKey">
                <FinanceSandboxAdminSection TSection="FinanceSandboxAnomalyInjectionViewModel"
                                            CompanyId="@AccessState.CompanyId!.Value"
                                            Kicker="@FinanceText["SandboxScenarioTools"]"
                                            Title="@FinanceText["SandboxAnomalyScenarios"]"
                                            Description="@FinanceText["SandboxAnomalyDescription"]"
                                            LoadingTitle="@FinanceText["SandboxLoadingAnomalies"]"
                                            LoadingMessage="@FinanceText["SandboxFetchingAnomalies"]"
                                            EmptyTitle="@FinanceText["SandboxNoAnomaliesConfigured"]"
                                            EmptyMessage="@FinanceText["SandboxNoAnomalyProfiles"]"
                                            ErrorTitle="@FinanceText["SandboxAnomaliesUnavailable"]"
                                            Loader="@LoadAnomalyInjectionAsync">
                    <ChildContent Context="injection">
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <dl class="row mb-3">
                                    <dt class="col-sm-4">@FinanceText["SandboxMode"]</dt>
                                    <dd class="col-sm-8">@FormatPlainLabel(injection.Mode)</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxLastAdded"]</dt>
                                    <dd class="col-sm-8">@LocalDateTime.DateTime(injection.LastInjectedUtc)</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxObservation"]</dt>
                                    <dd class="col-sm-8">@injection.Observation</dd>
                                </dl>

                                @if (!string.IsNullOrWhiteSpace(_anomalyInjectionErrorMessage))
                                {
                                    <div class="alert alert-danger" role="alert">
                                        @_anomalyInjectionErrorMessage
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_anomalyInjectionSuccessMessage))
                                {
                                    <div class="alert alert-success" role="status">
                                        @_anomalyInjectionSuccessMessage
                                    </div>
                                }

                                <EditForm id="anomaly-injection-form" EditContext="@_anomalyInjectionEditContext" OnValidSubmit="@HandleAnomalyInjectionSubmitAsync">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label" for="anomaly-profile">@FinanceText["SandboxScenario"]</label>
                                            <InputSelect id="anomaly-profile" class="form-select" @bind-Value="_anomalyInjectionForm.ScenarioProfileCode" disabled="@_isSubmittingAnomalyInjection">
                                                <option value="">@FinanceText["SandboxSelectScenario"]</option>
                                                @foreach (var profile in injection.AvailableScenarioProfiles)
                                                {
                                                    <option value="@profile.Code">@FormatProfileName(profile.Name)</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => _anomalyInjectionForm.ScenarioProfileCode)" />
                                            <div class="form-text">@SelectedScenarioProfileDescription(injection)</div>
                                        </div>
                                        <div class="col-12 d-flex align-items-center gap-3">
                                            <button id="anomaly-inject-submit" type="submit" class="btn btn-primary" disabled="@_isSubmittingAnomalyInjection">
                                                @(_isSubmittingAnomalyInjection ? FinanceText["SandboxAddingAnomaly"] : FinanceText["SandboxAddAnomaly"])
                                            </button>
                                            @if (_isSubmittingAnomalyInjection)
                                            {
                                                <span class="text-body-secondary">@FinanceText["SandboxActionRunning"]</span>
                                            }
                                        </div>
                                    </div>
                                </EditForm>

                                @if (injection.ActiveScenarios.Count > 0)
                                {
                                    <div class="mt-3">
                                        <strong class="d-block mb-2">@FinanceText["SandboxActiveScenarios"]</strong>
                                        <ul class="mb-0">
                                            @foreach (var scenario in injection.ActiveScenarios)
                                            {
                                                <li>@FormatProfileName(scenario)</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                            <div class="col-lg-7">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h3 class="h6 mb-1">@FinanceText["SandboxRegisteredAnomalies"]</h3>
                                        <p class="text-body-secondary mb-0">@FinanceText["SandboxSelectAnomalyHelp"]</p>
                                    </div>
                                </div>

                                @if (injection.RegistryEntries.Count == 0)
                                {
                                    <p class="text-body-secondary mb-0">@FinanceText["SandboxNoRegisteredAnomalies"]</p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table finance-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col">@FinanceText["SandboxReference"]</th>
                                                    <th scope="col">@FinanceText["Type"]</th>
                                                    <th scope="col">@FinanceText["Status"]</th>
                                                    <th scope="col">@FinanceText["SandboxAffectedRecord"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var entry in injection.RegistryEntries)
                                                {
                                                    <tr class="@(_selectedAnomalyId == entry.Id ? "table-active" : null)">
                                                        <td class="text-nowrap">
                                                            <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-start" @onclick="() => HandleAnomalySelectionAsync(entry.Id)">
                                                                @entry.Id.ToString("D")[..8]
                                                            </button>
                                                        </td>
                                                        <td>
                                                            <div class="fw-semibold">@FormatPlainLabel(entry.Type)</div>
                                                            <div class="small text-body-secondary">@FormatProfileName(entry.ScenarioProfileName)</div>
                                                        </td>
                                                        <td>
                                                            <span class="@FinanceAnomalyPresentation.ResolveStatusPillClass(entry.Status)">
                                                                @FormatPlainLabel(entry.Status)
                                                            </span>
                                                        </td>
                                                        <td>@entry.AffectedRecordReference</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                        <section class="border rounded p-3 mt-4" aria-labelledby="sandbox-anomaly-detail-title">
                            <h3 id="sandbox-anomaly-detail-title" class="h6 mb-3">@FinanceText["SandboxSelectedAnomaly"]</h3>

                            @if (_isLoadingSelectedAnomaly)
                            {
                                <p class="text-body-secondary mb-0">@FinanceText["SandboxLoadingAnomalyDetail"]</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedAnomalyErrorMessage))
                            {
                                <div class="alert alert-danger mb-0">@_selectedAnomalyErrorMessage</div>
                            }
                            else if (_selectedAnomalyDetail is null)
                            {
                                <p class="text-body-secondary mb-0">@FinanceText["SandboxSelectAnomalyDetailHelp"]</p>
                            }
                            else
                            {
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">@FinanceText["SandboxScenario"]</dt>
                                    <dd class="col-sm-8">@FormatProfileName(_selectedAnomalyDetail.ScenarioProfileName)</dd>
                                    <dt class="col-sm-4">@FinanceText["Created"]</dt>
                                    <dd class="col-sm-8">@LocalDateTime.DateTime(_selectedAnomalyDetail.CreatedUtc)</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxAffectedRecord"]</dt>
                                    <dd class="col-sm-8">
                                        @if (BuildAffectedRecordHref(_selectedAnomalyDetail) is string affectedRecordHref)
                                        {
                                            <a href="@affectedRecordHref">@_selectedAnomalyDetail.AffectedRecordReference</a>
                                        }
                                        else
                                        {
                                            @_selectedAnomalyDetail.AffectedRecordReference
                                        }
                                    </dd>
                                </dl>
                                @if (!string.IsNullOrWhiteSpace(_selectedAnomalyDetail.ExpectedDetectionMetadataJson))
                                {
                                    <details class="mt-3">
                                        <summary class="fw-semibold">@FinanceText["Advanced"]</summary>
                                        <code>@_selectedAnomalyDetail.ExpectedDetectionMetadataJson</code>
                                    </details>
                                }

                                @if (_selectedAnomalyDetail.Messages.Count > 0)
                                {
                                    <div class="mt-3">
                                        @foreach (var message in _selectedAnomalyDetail.Messages)
                                        {
                                            <div class="@ResolveBackendMessageAlertClass(message.Severity)" role="alert">
                                                @if (!string.IsNullOrWhiteSpace(message.Code))
                                                {
                                                    <span class="fw-semibold">@FormatPlainLabel(message.Code):</span>
                                                    <span> </span>
                                                }
                                                @message.Message
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </section>
                    </ChildContent>
                </FinanceSandboxAdminSection>
            </div>
            @if (SimulationUiVisible)
            {
            <div @key="SimulationDiagnosticsSectionKey">
                    <FinanceSandboxAdminSection TSection="FinanceSandboxSimulationDiagnosticsViewModel"
                                                CompanyId="@AccessState.CompanyId!.Value"
                                                Kicker="@FinanceText["SandboxCurrentStatus"]"
                                                Title="@FinanceText["SandboxStatusHistory"]"
                                                Description="@FinanceText["SandboxStatusDescription"]"
                                                LoadingTitle="@FinanceText["SandboxLoadingStatus"]"
                                                LoadingMessage="@FinanceText["SandboxReadingStatus"]"
                                                EmptyTitle="@FinanceText["SandboxStatusNotAvailable"]"
                                                EmptyMessage="@FinanceText["SandboxNoStatus"]"
                                                ErrorTitle="@FinanceText["SandboxStatusUnavailable"]"
                                                Loader="@LoadSimulationDiagnosticsAsync">
                        <ChildContent Context="diagnostics">
                            @{
                                var latestRun = diagnostics.RecentHistory.OrderByDescending(run => run.LastUpdatedUtc).FirstOrDefault();
                            }

                            @if (!string.IsNullOrWhiteSpace(_simulationLifecycleErrorMessage))
                            {
                                <div class="alert alert-danger" role="alert">@_simulationLifecycleErrorMessage</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_simulationLifecycleSuccessMessage))
                            {
                                <div class="alert alert-success" role="status">@_simulationLifecycleSuccessMessage</div>
                            }

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6 col-xl-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["Status"]</div>
                                        <div class="mt-1">
                                            <span class="@ResolveSimulationLifecycleBadgeClass(diagnostics.Status)">@ResolveSimulationLifecycleLabel(diagnostics.Status)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xl-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["SandboxCurrentSimulatedTime"]</div>
                                        <div class="fs-6 fw-semibold">@FormatUtc(diagnostics.CurrentSimulatedDateTime, FinanceText["SandboxNotStarted"])</div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xl-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["SandboxLastProgression"]</div>
                                        <div class="fs-6 fw-semibold">@FormatUtc(diagnostics.LastProgressionTimestamp, FinanceText["SandboxNoProgression"])</div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xl-3">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-body-secondary small">@FinanceText["SandboxDataGeneration"]</div>
                                        <div class="fs-6 fw-semibold">@(diagnostics.GenerationEnabled == true ? FinanceText["SandboxEnabled"] : diagnostics.GenerationEnabled == false ? FinanceText["SandboxDisabled"] : FinanceText["SandboxUnavailable"])</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-3 mb-3" aria-label="@FinanceText["SandboxSimulationControls"]">
                                @if (diagnostics.CanStart)
                                {
                                    <button type="button" class="btn btn-primary" disabled="@_isChangingSimulationLifecycle" @onclick="() => HandleStartOrResumeSimulationAsync(diagnostics)">
                                        @(_isChangingSimulationLifecycle ? FinanceText["Working"] : FinanceText["SandboxStart"])
                                    </button>
                                }
                                @if (diagnostics.CanPause)
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled="@_isChangingSimulationLifecycle" @onclick="HandlePauseSimulationAsync">
                                        @FinanceText["Pause"]
                                    </button>
                                }
                                @if (diagnostics.CanStop)
                                {
                                    <button type="button" class="btn btn-outline-danger" disabled="@_isChangingSimulationLifecycle" @onclick="HandleStopSimulationAsync">
                                        @FinanceText["Stop"]
                                    </button>
                                }
                                @if (diagnostics.SupportsStepForwardOneDay)
                                {
                                    <button type="button" class="btn btn-outline-primary" disabled="@_isChangingSimulationLifecycle" @onclick="HandleStepForwardOneDayAsync">
                                        @FinanceText["SandboxAdvanceOneDay"]
                                    </button>
                                }
                                @if (diagnostics.CanToggleGeneration && diagnostics.GenerationEnabled.HasValue)
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled="@_isChangingSimulationLifecycle" @onclick="() => HandleToggleGenerationAsync(diagnostics)">
                                        @(diagnostics.GenerationEnabled.Value ? FinanceText["SandboxDisableGeneration"] : FinanceText["SandboxEnableGeneration"])
                                    </button>
                                }
                            </div>

                            <details class="border rounded p-3 mb-3">
                                <summary class="fw-semibold">@FinanceText["Advanced"]</summary>
                                <dl class="row mt-2 mb-0">
                                    <dt class="col-sm-4">@FinanceText["SandboxUiVisibility"]</dt>
                                    <dd class="col-sm-8">@(diagnostics.UiVisible ? FinanceText["Visible"] : FinanceText["Hidden"])</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxBackendExecution"]</dt>
                                    <dd class="col-sm-8">@(diagnostics.BackendExecutionEnabled ? FinanceText["SandboxEnabled"] : FinanceText["SandboxDisabled"])</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxBackgroundJobs"]</dt>
                                    <dd class="col-sm-8">@(diagnostics.BackgroundJobsEnabled ? FinanceText["SandboxEnabled"] : FinanceText["SandboxDisabled"])</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxCurrentSession"]</dt>
                                    <dd class="col-sm-8">@(diagnostics.ActiveSessionId?.ToString("N")[..8] ?? FinanceText["None"])</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxReproducibilityValue"]</dt>
                                    <dd class="col-sm-8">@(diagnostics.Seed?.ToString() ?? FinanceText["SandboxUnavailable"])</dd>
                                </dl>
                            </details>

                            @if (!string.IsNullOrWhiteSpace(diagnostics.DisabledReason))
                            {
                                <div class="alert alert-warning" role="alert">@diagnostics.DisabledReason</div>
                            }

                            <div class="@ResolveSimulationSnapshotAlertClass(latestRun)" role="alert">
                                <div class="fw-semibold">@FinanceText["SandboxIssueState"]</div>
                                <div class="text-body-secondary">
                                    @(latestRun is null
                                        ? FinanceText["SandboxNoSession"]
                                        : FormatSimulationSnapshotMessage(latestRun.InjectedAnomalies, latestRun.Warnings, latestRun.Errors))
                                </div>
                            </div>

                            @if (diagnostics.RecentHistory.Count == 0)
                            {
                                <p class="text-body-secondary mt-3 mb-0">@FinanceText["SandboxNoSessions"]</p>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3 mt-3">
                                    @foreach (var run in diagnostics.RecentHistory)
                                    {
                                        <details class="border rounded p-3">
                                            <summary class="d-flex flex-wrap align-items-center gap-2">
                                                <span class="fw-semibold">@FinanceText["SandboxSession", run.SessionId.ToString("N")[..8]]</span>
                                                <span class="@ResolveSimulationLifecycleBadgeClass(run.Status)">@ResolveSimulationLifecycleLabel(run.Status)</span>
                                                <span class="text-body-secondary">@FinanceText["SandboxStarted", LocalDateTime.DateTime(run.StartedUtc)]</span>
                                            </summary>

                                            <div class="row g-3 mt-2">
                                                <div class="col-lg-4">
                                                    <dl class="row mb-0">
                                                        <dt class="col-sm-5">@FinanceText["SandboxSimulatedStart"]</dt>
                                                        <dd class="col-sm-7">@LocalDateTime.DateTime(run.StartSimulatedDateTime)</dd>
                                                        <dt class="col-sm-5">@FinanceText["SandboxCurrentTime"]</dt>
                                                        <dd class="col-sm-7">@FormatUtc(run.CurrentSimulatedDateTime)</dd>
                                                        <dt class="col-sm-5">@FinanceText["Completed"]</dt>
                                                        <dd class="col-sm-7">@(run.CompletedUtc.HasValue ? LocalDateTime.DateTime(run.CompletedUtc.Value) : FinanceText["SandboxInProgress"])</dd>
                                                        <dt class="col-sm-5">@FinanceText["SandboxGeneration"]</dt>
                                                        <dd class="col-sm-7">@(run.GenerationEnabled ? FinanceText["SandboxEnabled"] : FinanceText["SandboxDisabled"])</dd>
                                                    </dl>
                                                </div>
                                                <div class="col-lg-8">
                                                    <div class="mb-3">
                                                        <h4 class="h6 mb-2">@FinanceText["SandboxStatusTransitions"]</h4>
                                                        @if (run.StatusTransitions.Count == 0)
                                                        {
                                                            <p class="text-body-secondary mb-0">@FinanceText["SandboxNoTransitions"]</p>
                                                        }
                                                        else
                                                        {
                                                            <ul class="mb-0">
                                                                @foreach (var transition in run.StatusTransitions.OrderBy(item => item.TransitionedUtc))
                                                                {
                                                                    <li>
                                                                        <span class="fw-semibold">@ResolveSimulationLifecycleLabel(transition.Status)</span>
                                                                        <span> | @LocalDateTime.DateTime(transition.TransitionedUtc)</span>
                                                                        @if (!string.IsNullOrWhiteSpace(transition.Message))
                                                                        {
                                                                            <span> | @transition.Message</span>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                    <details class="border rounded p-3">
                                                        <summary class="fw-semibold">@FinanceText["SandboxDayRecords"]</summary>
                                                        <div class="table-responsive mt-3">
                                                            <table class="table finance-table mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th scope="col">@FinanceText["SandboxSimulatedDay"]</th>
                                                                    <th scope="col">@FinanceText["SandboxGeneratedRecords"]</th>
                                                                    <th scope="col">@FinanceText["SandboxAlerts"]</th>
                                                                    <th scope="col">@FinanceText["SandboxAnomalies"]</th>
                                                                    <th scope="col">@FinanceText["Warnings"]</th>
                                                                    <th scope="col">@FinanceText["SandboxErrors"]</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var day in run.DayLogs.OrderBy(item => item.SimulatedDateUtc))
                                                                {
                                                                    <tr>
                                                                        <td>@LocalDateTime.Date(DateOnly.FromDateTime(day.SimulatedDateUtc))</td>
                                                                        <td>@day.GeneratedRecordCount</td>
                                                                        <td>@day.AlertsGenerated</td>
                                                                        <td>@FormatAnomalyList(day.InjectedAnomalies)</td>
                                                                        <td>@FormatMessageList(day.Warnings)</td>
                                                                        <td>@FormatMessageList(day.Errors)</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                            </table>
                                                        </div>
                                                    </details>
                                                    <details class="mt-3">
                                                        <summary class="fw-semibold">@FinanceText["Advanced"]</summary>
                                                        <dl class="row mt-2 mb-0">
                                                            <dt class="col-sm-4">@FinanceText["SandboxReproducibilityValue"]</dt>
                                                            <dd class="col-sm-8">@run.Seed</dd>
                                                        </dl>
                                                    </details>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            }
                        </ChildContent>
                </FinanceSandboxAdminSection>
            </div>
            }

                <div>
                @if (SimulationUiVisible)
                {
                    <FinanceSandboxAdminSection TSection="FinanceSandboxSimulationControlsViewModel"
                                                CompanyId="@AccessState.CompanyId!.Value"
                                                Kicker="@FinanceText["SandboxProgressionControls"]"
                                                Title="@FinanceText["SandboxProgressionControls"]"
                                                Description="@FinanceText["SandboxProgressionDescription"]"
                                                LoadingTitle="@FinanceText["SandboxLoadingProgression"]"
                                                LoadingMessage="@FinanceText["SandboxInspectingClock"]"
                                                EmptyTitle="@FinanceText["SandboxProgressionNotConfigured"]"
                                                EmptyMessage="@FinanceText["SandboxNoProgressionControls"]"
                                                ErrorTitle="@FinanceText["SandboxProgressionUnavailable"]"
                                                Loader="@LoadSimulationControlsAsync">
                        <ChildContent Context="simulation">
                        @{
                            var displayedSimulation = _latestSimulationControls ?? simulation;
                            var displayedRun = _latestProgressionRun ?? displayedSimulation.CurrentRun ?? displayedSimulation.RunHistory.FirstOrDefault();
                        }

                        <div class="row g-4">
                            <div class="col-lg-5">
                                <dl class="row mb-3">
                                    <dt class="col-sm-4">@FinanceText["SandboxClockMode"]</dt>
                                    <dd class="col-sm-8">@FormatPlainLabel(displayedSimulation.ClockMode)</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxReferenceTime"]</dt>
                                    <dd class="col-sm-8">@LocalDateTime.DateTime(displayedSimulation.ReferenceUtc)</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxCheckpoint"]</dt>
                                    <dd class="col-sm-8">@displayedSimulation.CheckpointLabel</dd>
                                    <dt class="col-sm-4">@FinanceText["SandboxObservation"]</dt>
                                    <dd class="col-sm-8">@displayedSimulation.Observation</dd>
                                </dl>

                                @if (!string.IsNullOrWhiteSpace(_simulationActionErrorMessage))
                                {
                                    <div class="alert alert-danger" role="alert">@_simulationActionErrorMessage</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_simulationActionSuccessMessage))
                                {
                                    <div class="alert alert-success" role="status">@_simulationActionSuccessMessage</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_simulationRefreshErrorMessage))
                                {
                                    <div class="alert alert-warning" role="alert">@_simulationRefreshErrorMessage</div>
                                }

                                <EditForm EditContext="@_simulationControlsEditContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="simulation-advance-hours">@FinanceText["SandboxAdvanceHours"]</label>
                                            <InputNumber id="simulation-advance-hours" class="form-control" @bind-Value="_simulationControlsForm.AdvanceHours" disabled="@IsSimulationBusy" />
                                            <ValidationMessage For="@(() => _simulationControlsForm.AdvanceHours)" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="progression-run-hours">@FinanceText["SandboxDateRangeHours"]</label>
                                            <InputNumber id="progression-run-hours" class="form-control" @bind-Value="_simulationControlsForm.ProgressionRunHours" disabled="@IsSimulationBusy" />
                                            <ValidationMessage For="@(() => _simulationControlsForm.ProgressionRunHours)" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="simulation-step-hours">@FinanceText["SandboxExecutionStepHours"]</label>
                                            <InputNumber id="simulation-step-hours" class="form-control" @bind-Value="_simulationControlsForm.ExecutionStepHours" disabled="@IsSimulationBusy" />
                                            <ValidationMessage For="@(() => _simulationControlsForm.ExecutionStepHours)" />
                                        </div>
                                        <div class="col-md-6 d-flex align-items-end">
                                            <div class="form-check mb-2">
                                                <InputCheckbox id="simulation-accelerated" class="form-check-input" @bind-Value="_simulationControlsForm.Accelerated" disabled="@IsSimulationBusy" />
                                                <label class="form-check-label" for="simulation-accelerated">@FinanceText["SandboxAcceleratedProgression"]</label>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap gap-3">
                                            <button id="simulation-advance-submit" type="button" class="btn btn-primary" disabled="@IsSimulationBusy" @onclick="HandleAdvanceSimulationAsync">
                                                @(_isAdvancingSimulation ? FinanceText["SandboxAdvancingOneDay"] : _simulationControlsForm.AdvanceHours == 24 ? FinanceText["SandboxAdvanceOneDay"] : FinanceText["SandboxAdvanceTime"])
                                            </button>
                                            <button id="progression-run-submit" type="button" class="btn btn-outline-primary" disabled="@IsSimulationBusy" @onclick="HandleStartProgressionRunAsync">
                                                @(_isStartingProgressionRun
                                                    ? FinanceText["SandboxStartingProgression"]
                                                    : HasActiveProgressionRun
                                                        ? FinanceText["SandboxProgressionInProgress"]
                                                        : FinanceText["SandboxStartProgression"])
                                            </button>
                                            <button id="simulation-refresh-submit" type="button" class="btn btn-outline-secondary" disabled="@_isRefreshingSimulationControls" @onclick="HandleRefreshSimulationControlsAsync">
                                                @(_isRefreshingSimulationControls ? FinanceText["SandboxRefreshingStatus"] : FinanceText["SandboxRefreshStatus"])
                                            </button>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap gap-3 text-body-secondary">
                                            @if (_lastSimulationRefreshUtc.HasValue)
                                            {
                                                <span>@FinanceText["UpdatedAt", LocalDateTime.DateTime(_lastSimulationRefreshUtc.Value)]</span>
                                            }
                                            @if (_isPollingSimulationControls)
                                            {
                                                <span>@FinanceText["SandboxRefreshActive"]</span>
                                            }
                                            @if (HasActiveProgressionRun && !IsSimulationBusy)
                                            {
                                                <span>@FinanceText["SandboxDuplicateRunsDisabled"]</span>
                                            }
                                        </div>
                                    </div>
                                </EditForm>
                            </div>

                            <div class="col-lg-7">
                                <h3 class="h6 mb-3">@FinanceText["SandboxLatestProgression"]</h3>

                                @if (displayedRun is null)
                                {
                                    <p class="text-body-secondary mb-0">@FinanceText["SandboxNoProgressionRun"]</p>
                                }
                                else
                                {
                                    <div class="row g-3 mb-3">
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="border rounded p-3 h-100">
                                                <div class="text-body-secondary small">@FinanceText["Status"]</div>
                                                <div class="mt-1">
                                                    <span class="@FinanceAnomalyPresentation.ResolveStatusPillClass(displayedRun.Status)">
                                                        @FormatPlainLabel(displayedRun.Status)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="border rounded p-3 h-100">
                                                <div class="text-body-secondary small">@FinanceText["SandboxGeneratedRecords"]</div>
                                                <div class="fs-5 fw-semibold">@displayedRun.GeneratedRecordCount</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="border rounded p-3 h-100">
                                                <div class="text-body-secondary small">@FinanceText["SandboxEventsEmitted"]</div>
                                                <div class="fs-5 fw-semibold">@displayedRun.EventsEmitted</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="border rounded p-3 h-100">
                                                <div class="text-body-secondary small">@FinanceText["SandboxAdvancedHours"]</div>
                                                <div class="fs-5 fw-semibold">@displayedRun.AdvancedHours</div>
                                            </div>
                                        </div>
                                    </div>

                                    @foreach (var message in displayedRun.Messages)
                                    {
                                        <div class="@ResolveBackendMessageAlertClass(message.Severity)" role="alert">
                                            @if (!string.IsNullOrWhiteSpace(message.Code))
                                            {
                                                <span class="fw-semibold">@FormatPlainLabel(message.Code):</span>
                                                <span> </span>
                                            }
                                            @message.Message
                                        </div>
                                    }

                                    @if (displayedRun.Steps.Count == 0)
                                    {
                                        <p class="text-body-secondary mb-0">@FinanceText["SandboxNoStepHistory"]</p>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table finance-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">@FinanceText["SandboxWindow"]</th>
                                                        <th scope="col">@FinanceText["Transactions"]</th>
                                                        <th scope="col">@FinanceText["Invoices"]</th>
                                                        <th scope="col">@FinanceText["Bills"]</th>
                                                        <th scope="col">@FinanceText["SandboxGeneratedRecords"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var step in displayedRun.Steps)
                                                    {
                                                        <tr>
                                                            <td>@LocalDateTime.DateTime(step.WindowStartUtc) - @LocalDateTime.DateTime(step.WindowEndUtc)</td>
                                                            <td>@step.TransactionsGenerated</td>
                                                            <td>@step.InvoicesGenerated</td>
                                                            <td>@step.BillsGenerated</td>
                                                            <td>@(step.TransactionsGenerated + step.InvoicesGenerated + step.BillsGenerated + step.RecurringExpenseInstancesGenerated)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <div class="mt-4">
                                        <h4 class="h6 mb-3">@FinanceText["SandboxRunHistory"]</h4>

                                        @if (displayedSimulation.RunHistory.Count == 0)
                                        {
                                            <p class="text-body-secondary mb-0">@FinanceText["SandboxNoCompletedRuns"]</p>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table finance-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">@FinanceText["SandboxRunType"]</th>
                                                            <th scope="col">@FinanceText["Completed"]</th>
                                                            <th scope="col">@FinanceText["Status"]</th>
                                                            <th scope="col">@FinanceText["SandboxGeneratedRecords"]</th>
                                                            <th scope="col">@FinanceText["SandboxMessages"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var run in displayedSimulation.RunHistory)
                                                        {
                                                            <tr>
                                                                <td>@FormatPlainLabel(run.RunType)</td>
                                                                <td>@LocalDateTime.DateTime(run.CompletedUtc)</td>
                                                                <td>@FormatPlainLabel(run.Status)</td>
                                                                <td>@run.GeneratedRecordCount</td>
                                                                <td>@(run.Messages.Count == 0 ? FinanceText["SandboxNoBackendMessages"] : string.Join(" | ", run.Messages.Select(message => message.Message)))</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        </ChildContent>
                    </FinanceSandboxAdminSection>
                }
            </div>

        </section>
    }
</FinancePageLayout>
