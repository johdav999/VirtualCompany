@page "/finance/bill-inbox/{BillId:guid}"
@page "/finance/supplier-bills/review/{BillId:guid}"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["SupplierBillReview"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["BillReviewTitle"]"
    Description="@FinanceText["BillReviewDescription"]"
    LoadingMessage="@FinanceText["LoadingBillReview"]">
    <FinanceDataState
        IsLoading="@IsDetailLoading"
        IsEmpty="@(Detail is null)"
        ErrorMessage="@DetailErrorMessage"
        LoadingTitle="@FinanceText["LoadingBill"]"
        LoadingMessage="@FinanceText["FetchingBillReview"]"
        EmptyTitle="@FinanceText["BillNotFound"]"
        EmptyMessage="@FinanceText["BillNotFoundDescription"]"
        OnRetry="@ReloadAsync">
        @if (Detail is not null)
        {
            <section class="bill-review-workspace" aria-labelledby="bill-review-heading">
                <div class="bill-review-summary-card">
                    <div class="bill-review-summary-card__main">
                        <span class="finance-overview-kicker">@FinanceText["SupplierBill"]</span>
                        <div class="bill-review-summary-card__title-row">
                            <div>
                                <h2 id="bill-review-heading">@Detail.BillReference</h2>
                                <p>@Detail.SupplierName</p>
                            </div>
                            <span class="@BuildBillStatusClass(Detail.Status)">@Detail.Status</span>
                        </div>
                    </div>

                    <div class="bill-review-summary-grid" aria-label="@FinanceText["BillSummary"]">
                        <div>
                            <span>@FinanceText["Amount"]</span>
                            <strong>@FormatAmount(Detail.Amount, Detail.Currency)</strong>
                        </div>
                        <div>
                            <span>@FinanceText["Vat"]</span>
                            <strong>@FormatAmount(Detail.VatAmount, Detail.Currency)</strong>
                        </div>
                        <div>
                            <span>@FinanceText["BillDate"]</span>
                            <strong>@FormatDate(Detail.BillDateUtc)</strong>
                        </div>
                        <div>
                            <span>@FinanceText["DueDate"]</span>
                            <strong>@FormatDate(Detail.DueDateUtc)</strong>
                        </div>
                        <div>
                            <span>@FinanceText["Confidence"]</span>
                            <strong>@Detail.ConfidenceLevel @FormatConfidence(Detail.Confidence)</strong>
                        </div>
                    </div>
                </div>

                <div class="bill-review-layout">
                    <div class="bill-review-main">
                        <article class="bill-review-card bill-review-source-card">
                            <div class="bill-review-card__header">
                                <div>
                                    <h2>@BuildSourcePreviewHeading()</h2>
                                    <p>@FinanceText["SourceReviewDescription"]</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Detail.SourcePreview?.BodyText))
                            {
                                <div class="bill-review-email-meta" aria-label="@FinanceText["EmailDetails"]">
                                    <div>
                                        <span>@FinanceText["Source"]</span>
                                        <strong>@Detail.SourcePreview.SourceLabel</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Detail.SourcePreview.FileName))
                                    {
                                        <div>
                                            <span>@FinanceText["File"]</span>
                                            <strong>@Detail.SourcePreview.FileName</strong>
                                        </div>
                                    }
                                    <div>
                                        <span>@FinanceText["Subject"]</span>
                                        <strong>@Detail.SourcePreview.Title</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Detail.SourcePreview.From))
                                    {
                                        <div>
                                            <span>@FinanceText["From"]</span>
                                            <strong>@Detail.SourcePreview.From</strong>
                                        </div>
                                    }
                                    @if (Detail.SourcePreview.ReceivedUtc.HasValue)
                                    {
                                        <div>
                                            <span>@FinanceText["Received"]</span>
                                            <strong>@FormatDateTime(Detail.SourcePreview.ReceivedUtc.Value)</strong>
                                        </div>
                                    }
                                </div>

                                <pre class="bill-review-email-preview">@Detail.SourcePreview.BodyText</pre>
                            }
                            else
                            {
                                <div class="bill-review-empty-source">
                                    <strong>@FinanceText["SourceContentUnavailable"]</strong>
                                    <p>@FinanceText["SourceContentUnavailableDescription"]</p>
                                </div>
                            }
                        </article>

                        <article class="bill-review-card">
                            <div class="bill-review-card__header">
                                <div>
                                    <h2>@FinanceText["ActionHistory"]</h2>
                                    <p>@FinanceText["ActionHistoryDescription"]</p>
                                </div>
                            </div>
                            @if (Detail.ActionHistory.Count == 0)
                            {
                                <p class="bill-review-muted mb-0">@FinanceText["NoReviewActions"]</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table bill-review-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@FinanceText["Time"]</th>
                                                <th>@FinanceText["Actor"]</th>
                                                <th>@FinanceText["Action"]</th>
                                                <th>@FinanceText["Status"]</th>
                                                <th>@FinanceText["Rationale"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var action in Detail.ActionHistory)
                                            {
                                                <tr>
                                                    <td>@FormatDateTime(action.OccurredUtc)</td>
                                                    <td>@action.ActorDisplayName</td>
                                                    <td>@FormatActionName(action.Action)</td>
                                                    <td>@action.PriorStatus -> @action.NewStatus</td>
                                                    <td>@action.Rationale</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </article>
                    </div>

                    <aside class="bill-review-sidebar" aria-label="@FinanceText["BillActions"]">
                        <article class="bill-review-card bill-review-agent-card">
                            <div class="bill-review-agent-card__profile">
                                <div class="finance-overview-icon finance-overview-icon--neutral" aria-hidden="true">LF</div>
                                <div>
                                    <span>Laura</span>
                                    <strong>@FinanceText["FinanceManager"]</strong>
                                </div>
                            </div>
                            <h2>@FinanceText["LauraRecommendation"]</h2>
                            <strong class="bill-review-recommendation-lead">@BuildLauraRecommendationHeadline()</strong>
                            <p>@BuildLauraRecommendationSummary()</p>
                            <p class="bill-review-next-step">@BuildLauraNextStep()</p>
                            <div class="bill-review-risk-list">
                                <strong>@FinanceText["RiskFlags"]</strong>
                                <ul>
                                    @foreach (var riskFlag in Detail.ProposalSummary.RiskFlags)
                                    {
                                        <li>@riskFlag</li>
                                    }
                                </ul>
                            </div>
                        </article>

                        @if (Detail.FortnoxRegistration is not null)
                        {
                            <article class="bill-review-card bill-review-fortnox-card">
                                <div class="bill-review-card__split-header">
                                    <div>
                                        <h2>Fortnox</h2>
                                        <p>@Detail.FortnoxRegistration.Message</p>
                                    </div>
                                    <span class="@BuildFortnoxStatusClass(Detail.FortnoxRegistration.Status)">@Detail.FortnoxRegistration.Status</span>
                                </div>

                                @if (Detail.FortnoxRegistration.ApprovalId is Guid approvalId)
                                {
                                    <a class="bill-review-inline-link" href="@BuildApprovalHref(approvalId)">@(IsSupplierCreationStep ? FinanceText["OpenSupplierApproval"] : FinanceText["OpenSendingApproval"])</a>
                                }

                                @if (!string.IsNullOrWhiteSpace(FortnoxRegistrationStatusMessage))
                                {
                                    <div class="alert alert-info small mt-3 mb-0">@FortnoxRegistrationStatusMessage</div>
                                }
                            </article>
                        }

                        <article class="bill-review-card">
                            <h2>@FinanceText["Warnings"]</h2>
                            @RenderWarnings(FinanceText["Validation"], Detail.ValidationWarnings)
                            @RenderWarnings(FinanceText["Duplicate"], Detail.DuplicateWarnings)
                        </article>

                        <article class="bill-review-card bill-review-action-card">
                            <h2>@FinanceText["ReviewDecision"]</h2>
                            <p class="bill-review-muted">@(IsBillProposalApproved ? FinanceText["ApprovedSendHelp"] : FinanceText["ChooseReviewDecisionHelp"])</p>

                            @if (!string.IsNullOrWhiteSpace(ActionStatusMessage))
                            {
                                <div class="alert alert-info">@ActionStatusMessage</div>
                            }

                            <label class="form-label" for="bill-action-rationale">@FinanceText["Rationale"]</label>
                            <textarea id="bill-action-rationale" class="form-control" rows="4" @bind="Rationale" placeholder="@FinanceText["RationalePlaceholder"]"></textarea>

                            @if (!Detail.CanApprove && !IsBillProposalApproved && !string.IsNullOrWhiteSpace(Detail.ApprovalBlockedReason))
                            {
                                <div class="alert alert-warning">@Detail.ApprovalBlockedReason</div>
                            }

                            <div class="bill-review-action-stack">
                                @if (!IsBillProposalApproved && Detail.FortnoxRegistration?.CanSendDirect == true && !IsSupplierCreationStep)
                                {
                                    <button class="btn btn-primary" disabled="@(!Detail.CanApprove || IsSubmittingAction)" @onclick="ApproveAndSendToFortnoxAsync">@FinanceText["ApproveRegisterFortnox"]</button>
                                }
                                else if (IsBillProposalApproved && Detail.FortnoxRegistration?.CanSendDirect == true)
                                {
                                    <button class="btn btn-primary" disabled="@IsSubmittingAction" @onclick="SendToFortnoxAsync">@(IsSupplierCreationStep ? FinanceText["CreateSupplierFortnox"] : FinanceText["SendToFortnox"])</button>
                                }

                                @if (!IsBillProposalApproved)
                                {
                                    <button class="btn btn-outline-primary" disabled="@(!Detail.CanApprove || IsSubmittingAction)" @onclick="ApproveAsync">@FinanceText["ApproveInvoice"]</button>
                                }

                                @if (Detail.FortnoxRegistration?.CanRequest == true && Detail.FortnoxRegistration?.CanSendDirect != true)
                                {
                                    <button class="btn btn-outline-primary" disabled="@IsSubmittingAction" @onclick="RequestFortnoxRegistrationAsync">@(IsSupplierCreationStep ? FinanceText["CreateSupplierProposal"] : FinanceText["RequestSendApproval"])</button>
                                }

                                @if (!IsBillProposalApproved)
                                {
                                    <button class="btn btn-outline-danger" disabled="@IsSubmittingAction" @onclick="RejectAsync">@FinanceText["Reject"]</button>
                                    <button class="btn btn-outline-secondary" disabled="@IsSubmittingAction" @onclick="RequestClarificationAsync">@FinanceText["RequestClarification"]</button>
                                }
                            </div>
                        </article>
                    </aside>
                </div>
            </section>
        }
    </FinanceDataState>
</FinancePageLayout>
