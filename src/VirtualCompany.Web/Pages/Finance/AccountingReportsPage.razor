@page "/finance/accounting/reports"
@inherits FinancePageBase

<PageTitle>@FinanceText["ReportsCloseTitle"]</PageTitle>

<FinancePageLayout IsLoading="@IsLoading" AccessState="@AccessState" ErrorMessage="@ErrorMessage"
                   Title="@FinanceText["ReportsCloseTitle"]" Description="@FinanceText["ReportsCloseDescription"]"
                   LoadingMessage="@FinanceText["ReportsLoading"]">
    <AccountingNavigation CompanyId="@AccessState.CompanyId" />

    <div class="accounting-reports-heading">
        <div>
            <span class="dashboard-kicker">@FinanceText["NativeAccounting"]</span>
            <h2>@FinanceText["ReportsCloseTitle"]</h2>
            <p>@FinanceText["ReportsPostedSourceHelp"]</p>
        </div>
        <div class="accounting-reports-actions">
            @if (View is not "schedules" and not "assets")
            {
            <label for="report-period">@FinanceText["FiscalPeriod"]</label>
            <select id="report-period" class="form-select" value="@SelectedPeriodId" @onchange="ChangePeriodAsync">
                @foreach (var period in Periods)
                {
                    <option value="@period.Id">@period.Name · @period.StartDate.ToString("d")–@period.EndDate.ToString("d")</option>
                }
            </select>
            }
            @if (CanManageAccounting && View is not "vat" and not "revaluation" and not "dimensions" and not "schedules" and not "assets")
            {
                <button class="btn btn-primary" type="button" @onclick="RequestExportAsync" disabled="@IsActing">@FinanceText["CreateExport"]</button>
            }
        </div>
    </div>

    @if (View is not "vat" and not "revaluation" and not "dimensions" and not "schedules" and not "assets") { <div class="accounting-compliance-notice" role="note">ⓘ @(TaxSummary?.ComplianceNotice ?? FinanceText["CountryNeutralTaxNotice"])</div> }

    @if (!string.IsNullOrWhiteSpace(ActionMessage)) { <div class="alert alert-success" role="status">@ActionMessage</div> }
    @if (!string.IsNullOrWhiteSpace(ActionError)) { <div class="alert alert-danger" role="alert"><strong>@FinanceText["ActionCouldNotBeCompleted"]</strong><div>@ActionError</div></div> }

    <section class="accounting-report-kpis" aria-label="@FinanceText["ReportSummary"]" aria-busy="@IsReportLoading">
        <button type="button" class="accounting-report-kpi @(View == "trial" ? "active" : null)" aria-pressed="@(View == "trial")" @onclick='() => View = "trial"'><span aria-hidden="true">⚖</span><small>@FinanceText["TrialBalance"]</small><strong>@Money(TrialBalance?.TotalClosingDebits, Currency)</strong><em class="@(TrialBalance?.IsBalanced == true ? "ok" : "warn")">@FinanceText[TrialBalance?.IsBalanced == true ? "Balanced" : "NeedsReview"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "profit-loss" ? "active" : null)" aria-pressed="@(View == "profit-loss")" @onclick='() => View = "profit-loss"'><span aria-hidden="true">↗</span><small>@FinanceText["ProfitAndLoss"]</small><strong>@Money(ProfitAndLoss?.NetIncome, ProfitAndLoss?.Currency)</strong><em>@FinanceText[ProfitAndLoss?.UsedSnapshot == true ? "StoredSnapshot" : "PostedJournals"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "balance-sheet" ? "active" : null)" aria-pressed="@(View == "balance-sheet")" @onclick='() => View = "balance-sheet"'><span aria-hidden="true">▣</span><small>@FinanceText["BalanceSheet"]</small><strong>@Money(BalanceSheet?.TotalAssets, BalanceSheet?.Currency)</strong><em class="@(BalanceSheet?.IsBalanced == true ? "ok" : "warn")">@FinanceText[BalanceSheet?.IsBalanced == true ? "Reconciled" : "NeedsReview"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "tax" ? "active" : null)" aria-pressed="@(View == "tax")" @onclick='() => View = "tax"'><span aria-hidden="true">◇</span><small>@FinanceText["TaxSummary"]</small><strong>@Money(TaxSummary?.Lines.Sum(x => x.TaxAmount), Currency)</strong><em class="@(TaxSummary?.IsReviewed == true ? "ok" : "warn")">@FinanceText[TaxSummary?.IsReviewed == true ? "Reviewed" : "ReviewRequired"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "vat" ? "active" : null)" aria-pressed="@(View == "vat")" @onclick='() => View = "vat"'><span aria-hidden="true">%</span><small>@FinanceText["VatReturn"]</small><strong>@Money(CurrentVatReturn?.SettlementExact, CurrentVatReturn?.Currency)</strong><em class="@(CurrentVatReturn?.Issues.Any(x => x.IsBlocking) == true ? "warn" : "ok")">@(CurrentVatReturn is null ? FinanceText["NotCalculated"] : CurrentVatReturn.IsStale ? FinanceText["StaleData"] : FinanceText["ReadyForReview"])</em></button>
        <button type="button" class="accounting-report-kpi @(View == "revaluation" ? "active" : null)" aria-pressed="@(View == "revaluation")" @onclick='() => View = "revaluation"'><span aria-hidden="true">¤</span><small>@FinanceText["CurrencyRevaluation"]</small><strong>@FinanceText["PeriodEnd"]</strong><em>@FinanceText["RatesEvidencePosting"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "schedules" ? "active" : null)" aria-pressed="@(View == "schedules")" @onclick='() => View = "schedules"'><span aria-hidden="true">↻</span><small>@FinanceText["AccountingSchedules"]</small><strong>@FinanceText["AutomatedPosting"]</strong><em>@FinanceText["SchedulesEvidenceApproval"]</em></button>
        <button type="button" class="accounting-report-kpi @(View == "assets" ? "active" : null)" aria-pressed="@(View == "assets")" @onclick='() => View = "assets"'><span aria-hidden="true">▤</span><small>@FinanceText["FixedAssets"]</small><strong>@FinanceText["AssetRegister"]</strong><em>@FinanceText["DepreciationAndDisposal"]</em></button>
    </section>

    <nav class="accounting-report-tabs" aria-label="@FinanceText["ReportViews"]">
        <button type="button" class="@(View == "trial" ? "active" : null)" aria-pressed="@(View == "trial")" @onclick='() => View = "trial"'>@FinanceText["TrialBalance"]</button>
        <button type="button" class="@(View == "ledger" ? "active" : null)" aria-pressed="@(View == "ledger")" @onclick='() => View = "ledger"'>@FinanceText["GeneralLedger"]</button>
        <button type="button" class="@(View == "profit-loss" ? "active" : null)" aria-pressed="@(View == "profit-loss")" @onclick='() => View = "profit-loss"'>@FinanceText["ProfitAndLoss"]</button>
        <button type="button" class="@(View == "balance-sheet" ? "active" : null)" aria-pressed="@(View == "balance-sheet")" @onclick='() => View = "balance-sheet"'>@FinanceText["BalanceSheet"]</button>
        <button type="button" class="@(View == "tax" ? "active" : null)" aria-pressed="@(View == "tax")" @onclick='() => View = "tax"'>@FinanceText["TaxSummary"]</button>
        <button type="button" class="@(View == "vat" ? "active" : null)" aria-pressed="@(View == "vat")" @onclick='() => View = "vat"'>@FinanceText["VatAndStatutoryExports"]</button>
        <button type="button" class="@(View == "revaluation" ? "active" : null)" aria-pressed="@(View == "revaluation")" @onclick='() => View = "revaluation"'>@FinanceText["CurrencyRevaluation"]</button>
        <button type="button" class="@(View == "dimensions" ? "active" : null)" aria-pressed="@(View == "dimensions")" @onclick='() => View = "dimensions"'>@FinanceText["AccountingDimensions"]</button>
        <button type="button" class="@(View == "schedules" ? "active" : null)" aria-pressed="@(View == "schedules")" @onclick='() => View = "schedules"'>@FinanceText["AccountingSchedules"]</button>
        <button type="button" class="@(View == "assets" ? "active" : null)" aria-pressed="@(View == "assets")" @onclick='() => View = "assets"'>@FinanceText["FixedAssets"]</button>
    </nav>

    @if (View == "vat")
    {
        <VatReturnWorkspace CompanyId="@AccessState.CompanyId" IsLoading="@IsReportLoading" IsActing="@IsActing" CanManage="@CanManageAccounting" ErrorMessage="@VatError"
                            FilingPeriods="@VatFilingPeriods" SelectedFilingPeriodId="@SelectedVatFilingPeriodId" CurrentReturn="@CurrentVatReturn"
                            RelatedReturns="@VatReturns.Where(x => x.CorrectionOfVatReturnId.HasValue).ToArray()" ControlAccounts="@ControlAccounts"
                            Exports="@Exports" PackageDownloadUrl="@VatPackageDownloadUrl" JournalHref="@JournalEntryUrl" ExportDownloadUrl="@ExportDownloadUrl"
                            OnPeriodChanged="ChangeVatPeriodAsync" OnCalculate="CalculateVatAsync" OnRequestApproval="RequestVatApprovalAsync"
                            OnFinalize="FinalizeVatAsync" OnCreateCorrection="CreateVatCorrectionAsync" OnRequestExport="RequestStatutoryExportAsync"
                            OnRetryExport="RetryStatutoryExportAsync" OnRefreshExports="RefreshExportsAsync" />
    }
    else if (View == "revaluation")
    {
        <CurrencyRevaluationWorkspace CompanyId="@AccessState.CompanyId" FiscalPeriodId="@SelectedPeriodId"
            CanManage="@CanManageAccounting" IsPeriodClosed="@(SelectedPeriod?.IsClosed == true)" RequestedRunId="@RequestedRunId" />
    }
    else if (View == "dimensions")
    {
        <AccountingDimensionsWorkspace CompanyId="@AccessState.CompanyId" CanManage="@CanManageAccounting" Currency="@(Currency ?? "SEK")" />
    }
    else if (View == "schedules")
    {
        <AccountingSchedulesWorkspace CompanyId="@AccessState.CompanyId" CanManage="@CanManageAccounting" CanApprove="@CanApproveSchedules" />
    }
    else if (View == "assets")
    {
        <FixedAssetsWorkspace CompanyId="@AccessState.CompanyId" FiscalPeriodId="@SelectedPeriodId"
            PeriodStart="@(SelectedPeriod?.StartDate ?? DateOnly.FromDateTime(DateTime.UtcNow))"
            PeriodEnd="@(SelectedPeriod?.EndDate ?? DateOnly.FromDateTime(DateTime.UtcNow))"
            CanApprove="@CanApproveSchedules" JournalHref="@JournalEntryUrl" />
    }
    else
    {
    <div class="accounting-report-workspace">
        <section class="accounting-report-table-card" aria-busy="@IsReportLoading">
            @if (IsReportLoading)
            {
                <div class="accounting-report-state" role="status"><div class="spinner-border text-primary" aria-hidden="true"></div><h3>@FinanceText["BuildingReport"]</h3><p>@FinanceText["BuildingReportHelp"]</p></div>
            }
            else if (View == "trial")
            {
                <ReportHeader Title="@FinanceText["TrialBalance"]" Detail="@FinanceText["TrialBalanceHelp"]" />
                <div class="table-responsive"><table class="table accounting-report-table"><thead><tr><th>@FinanceText["Account"]</th><th>@FinanceText["Opening"]</th><th>@FinanceText["Debit"]</th><th>@FinanceText["Credit"]</th><th>@FinanceText["Closing"]</th></tr></thead><tbody>
                @foreach (var row in TrialBalance?.Accounts ?? [])
                {
                    <tr class="@(SelectedAccountId == row.AccountId ? "selected" : null)" role="button" tabindex="0" aria-selected="@(SelectedAccountId == row.AccountId)" @onclick="() => SelectAccountAsync(row.AccountId)" @onkeydown="args => HandleAccountKeyAsync(args, row.AccountId)"><td><strong>@row.AccountCode</strong><span>@row.AccountName</span></td><td>@Money(row.OpeningBalance, row.Currency)</td><td>@Money(row.Debit, row.Currency)</td><td>@Money(row.Credit, row.Currency)</td><td><strong>@Money(row.ClosingBalance, row.Currency)</strong></td></tr>
                }
                </tbody><tfoot><tr><th>@FinanceText["Total"]</th><th></th><th>@Money(TrialBalance?.TotalDebits, Currency)</th><th>@Money(TrialBalance?.TotalCredits, Currency)</th><th>@FinanceText[TrialBalance?.IsBalanced == true ? "Balanced" : "OutOfBalance"]</th></tr></tfoot></table></div>
            }
            else if (View == "ledger")
            {
                <ReportHeader Title="@FinanceText["GeneralLedger"]" Detail="@FinanceText["GeneralLedgerSelectHelp"]" />
                @foreach (var account in GeneralLedger?.Accounts ?? [])
                {
                    <button type="button" class="accounting-ledger-account" aria-pressed="@(SelectedAccountId == account.AccountId)" @onclick="() => SelectAccountAsync(account.AccountId)"><span><strong>@account.AccountCode · @account.AccountName</strong><small>@FinanceText["PostedLineCount", account.TotalLineCount]</small></span><span>@Money(account.ClosingBalance, account.Currency) <span aria-hidden="true">›</span></span></button>
                }
            }
            else if (View == "profit-loss")
            {
                <ReportHeader Title="@FinanceText["ProfitAndLoss"]" Detail="@FinanceText["ProfitAndLossHelp"]" />
                <StatementLines Title="@FinanceText["Revenue"]" Lines="@ProfitAndLoss?.RevenueLines" />
                <StatementLines Title="@FinanceText["Expenses"]" Lines="@ProfitAndLoss?.ExpenseLines" />
                <div class="accounting-statement-total"><span>@FinanceText["NetIncome"]</span><strong>@Money(ProfitAndLoss?.NetIncome, ProfitAndLoss?.Currency)</strong></div>
            }
            else if (View == "balance-sheet")
            {
                <ReportHeader Title="@FinanceText["BalanceSheet"]" Detail="@FinanceText["BalanceSheetHelp"]" />
                <StatementLines Title="@FinanceText["Assets"]" Lines="@BalanceSheet?.AssetLines" />
                <StatementLines Title="@FinanceText["Liabilities"]" Lines="@BalanceSheet?.LiabilityLines" />
                <StatementLines Title="@FinanceText["Equity"]" Lines="@BalanceSheet?.EquityLines" />
                <div class="accounting-statement-total"><span>@FinanceText["AssetsLiabilitiesEquity"]</span><strong>@Money(BalanceSheet?.TotalAssets, BalanceSheet?.Currency) / @Money((BalanceSheet?.TotalLiabilities ?? 0) + (BalanceSheet?.TotalEquity ?? 0), BalanceSheet?.Currency)</strong></div>
            }
            else
            {
                <ReportHeader Title="@FinanceText["TaxSummary"]" Detail="@FinanceText["TaxSummaryHelp"]" />
                @if (TaxSummary?.Lines.Count == 0) { <div class="accounting-report-state"><span aria-hidden="true">◇</span><h3>@FinanceText["NoTaxFacts"]</h3><p>@FinanceText["NoTaxFactsHelp"]</p></div> }
                else { <div class="table-responsive"><table class="table accounting-report-table"><thead><tr><th>@FinanceText["TaxRule"]</th><th>@FinanceText["PackVersion"]</th><th>@FinanceText["TaxableAmount"]</th><th>@FinanceText["Tax"]</th></tr></thead><tbody>@foreach (var row in TaxSummary?.Lines ?? []) { <tr><td><strong>@Friendly(row.TaxRuleKey)</strong><span>@Friendly(row.TaxTreatment)</span></td><td>@row.PolicyPackVersion</td><td>@Money(row.TaxableAmount, row.Currency)</td><td><strong>@Money(row.TaxAmount, row.Currency)</strong></td></tr> }</tbody></table></div> }
                @if (CanManageAccounting && TaxSummary?.IsReviewed == false) { <button class="btn btn-primary" type="button" @onclick="ReviewTaxAsync" disabled="@IsActing">@FinanceText["ConfirmTaxReview"]</button> }
            }
        </section>

        <aside class="accounting-evidence-card" aria-live="polite" aria-busy="@IsReportLoading">
            <div class="accounting-card-header"><div><span class="dashboard-kicker">@FinanceText["AccountantEvidence"]</span><h3>@FinanceText["ImmutableJournalDetail"]</h3></div><span class="status-badge status-badge-success">@FinanceText["Posted"]</span></div>
            @if (SelectedLedgerAccount is null)
            {
                <div class="accounting-report-state"><span aria-hidden="true">⌕</span><h3>@FinanceText["SelectAccount"]</h3><p>@FinanceText["SelectAccountEvidenceHelp"]</p></div>
            }
            else
            {
                <div class="accounting-evidence-summary"><strong>@SelectedLedgerAccount.AccountCode · @SelectedLedgerAccount.AccountName</strong><span>@FinanceText["ClosingBalanceValue", Money(SelectedLedgerAccount.ClosingBalance, SelectedLedgerAccount.Currency)]</span></div>
                @foreach (var line in SelectedLedgerAccount.Lines.Take(8))
                {
                    <div class="accounting-evidence-entry"><div><strong>@line.VoucherNumber</strong><span>@line.PostingDate.ToString("d") · @(line.Description ?? FinanceText["PostedJournal"])</span></div><strong>@Money(line.Debit - line.Credit, line.Currency)</strong>@if (line.Evidence.Count > 0) { <small>@FinanceText["LinkedEvidenceVerified", line.Evidence.Count]</small> }</div>
                }
                @if (SelectedLedgerAccount.Lines.Count == 0) { <div class="accounting-report-state"><h3>@FinanceText["OpeningBalanceOnly"]</h3><p>@FinanceText["NoJournalMovement"]</p></div> }
                <a class="btn btn-outline-primary" href="@FinanceRoutes.WithCompanyContext($"/finance/accounting/journals?accountId={SelectedLedgerAccount.AccountId:D}", AccessState.CompanyId)">@FinanceText["ViewFullAuditTrail"]</a>
            }
            <div class="accounting-laura-mini"><span aria-hidden="true">L</span><div><strong>@FinanceText["LauraFinanceManager"]</strong><p>@LauraAdvice</p></div></div>
        </aside>
    </div>

    <div class="accounting-close-grid">
        <section class="accounting-close-card">
            <div class="accounting-card-header"><div><h3>@FinanceText["PeriodCloseChecklist"]</h3><span>@CloseSummary</span></div><button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ValidateCloseAsync" disabled="@IsActing">@FinanceText["RunReview"]</button></div>
            @if (CloseValidation is null) { <div class="accounting-report-state compact"><p>@FinanceText["CloseReviewHelp"]</p></div> }
            else if (CloseValidation.IsReadyToClose) { <div class="accounting-close-ready">✓ @FinanceText["AllCloseChecksPassed"]</div> }
            else { @foreach (var issue in CloseValidation.BlockingIssues) { <div class="accounting-close-issue"><span aria-hidden="true">!</span><div><strong>@Friendly(issue.Code)</strong><p>@issue.Message</p><small>@issue.Remediation</small></div><b>@(issue.Amount.HasValue ? Money(issue.Amount, issue.Currency) : issue.Count.ToString())</b></div> } }
            @if (CanManageAccounting && SelectedPeriod is not null && !SelectedPeriod.IsClosed)
            {
                <div class="accounting-close-action"><label for="close-reason">@FinanceText["CloseNote"]</label><input id="close-reason" class="form-control" @bind="CloseReason" placeholder="@FinanceText["CloseNotePlaceholder"]" /><button class="btn btn-primary" type="button" @onclick="CloseAndLockAsync" disabled="@(IsActing || CloseValidation?.IsReadyToClose != true)">@FinanceText["CloseAndLockReports"]</button></div>
            }
            else if (CanReopen && SelectedPeriod?.IsClosed == true)
            {
                <div class="accounting-close-action"><label for="reopen-reason">@FinanceText["ExceptionalReopenReason"]</label><input id="reopen-reason" class="form-control" @bind="ReopenReason" placeholder="@FinanceText["ReopenReasonPlaceholder"]" /><button class="btn btn-outline-danger" type="button" @onclick="ReopenAsync" disabled="@(IsActing || ReopenReason.Trim().Length < 10)">@FinanceText["ReopenPeriod"]</button></div>
            }
        </section>

        <section class="accounting-close-card"><div class="accounting-card-header"><div><h3>@FinanceText["LockHistory"]</h3><span>@FinanceText["LockHistoryHelp"]</span></div></div>@if (History.Count == 0) { <div class="accounting-report-state compact"><p>@FinanceText["NoLockHistory"]</p></div> } else { @foreach (var item in History) { <div class="accounting-history-row"><span class="@(item.Action == "reopened" ? "warn" : "ok")" aria-hidden="true">●</span><div><strong>@Friendly(item.Action)</strong><p>@item.Reason</p><small>@LocalDateTime.DateTime(item.OccurredUtc) · @(item.SnapshotChecksum is null ? FinanceText["HistoryPreserved"] : FinanceText["SnapshotPrefix", item.SnapshotChecksum[..Math.Min(10, item.SnapshotChecksum.Length)]])</small></div></div> } }</section>

        <section class="accounting-close-card"><div class="accounting-card-header"><div><h3>@FinanceText["ExportJobs"]</h3><span>@FinanceText["ExportJobsHelp"]</span></div><button class="btn btn-sm btn-outline-secondary" type="button" @onclick="RefreshExportsAsync">@CommonText["Refresh"]</button></div>@if (Exports.Count == 0) { <div class="accounting-report-state compact"><p>@FinanceText["NoExportsForPeriod"]</p></div> } else { @foreach (var job in Exports) { <div class="accounting-export-row"><div><strong>@Friendly(job.Status)</strong><span>@LocalDateTime.DateTime(job.RequestedUtc)</span>@if (!string.IsNullOrWhiteSpace(job.FailureSummary)) { <small class="text-danger">@job.FailureSummary</small> }</div>@if (job.CanDownload) { <a class="btn btn-sm btn-outline-primary" href="@ExportDownloadUrl(job.Id)">@FinanceText["Download"]</a> } else { <span class="status-badge">@Friendly(job.Status)</span> }</div> } }</section>
    </div>
    }
</FinancePageLayout>
