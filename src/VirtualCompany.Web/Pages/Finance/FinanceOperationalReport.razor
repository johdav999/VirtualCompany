@page "/finance/receivables-aging"
@page "/finance/payables-aging"
@page "/finance/cash-forecast"
@inherits FinancePageBase
@rendermode InteractiveServer
@implements IDisposable
@inject FinanceApiClient Finance
@inject IJSRuntime JS
@using System.Globalization

<PageTitle>@Title</PageTitle>
<FinancePageLayout IsLoading="@IsLoading" AccessState="@AccessState" ErrorMessage="@ErrorMessage" Title="@Title" Description="Inspect the included obligations and dated cash evidence." ShowShellHeader="false" ReportStyle="true">
    <main class="vc-page finance-report" data-testid="finance-operational-report">
        <header class="finance-report-header">
            <div><span class="finance-report-kicker">FINANCE / @(Kind == "forecast" ? "CASH PLANNING" : "OBLIGATION REVIEW")</span><h1>@Title</h1>
                <p>@(Kind == "forecast" ? "Operational cash outlook based on recorded balances and open obligations." : "Review outstanding amounts and overdue obligations, separated by currency.")</p>
            </div>
            <div class="finance-report-actions">
                <button class="btn btn-outline-primary" disabled="@loading" type="button" @onclick="Load">Refresh</button>
                <button class="btn btn-primary" data-testid="finance-report-download" disabled="@(loading || report is null)" type="button" @onclick="Download">Download CSV</button>
            </div>
        </header>
        @if (report is not null)
        {
            <div class="finance-report-metadata"><span>As of @Date(report.AsOfDate) UTC</span>
                @if (Kind == "forecast") { <span>Through @Date(report.ThroughDate) UTC</span><span>@(report.ThroughDate.DayNumber - report.AsOfDate.DayNumber)-day horizon</span> }
                <span>Updated @report.ObservedAtUtc.ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture) UTC</span>
            </div>
        }
        <form class="vc-panel finance-report-filters" @onsubmit="Apply" @onsubmit:preventDefault>
            <label>As-of date (UTC)<input type="date" @bind="cutoff" /></label>
            <label>Currency code<input maxlength="3" pattern="[A-Za-z]{3}" placeholder="All currencies" @bind="currency" @bind:event="oninput" /></label>
            <label>Aging bucket<select @bind="bucket"><option value="">All buckets</option><option value="current">Not overdue</option><option value="overdue">All overdue</option><option value="past_due_1_30">1–30 days</option><option value="past_due_31_60">31–60 days</option><option value="past_due_61_90">61–90 days</option><option value="past_due_over_90">Over 90 days</option></select></label>
            @if (Kind == "forecast") { <label>Horizon (days)<input type="number" min="1" max="30" @bind="horizon" /></label> }
            <button class="btn btn-primary" disabled="@loading" type="submit">Apply filters</button>
        </form>
        @if (downloadMessage is not null) { <p class="finance-report-feedback" role="status">@downloadMessage</p> }
        @if (loading) { <section class="vc-panel finance-report-state" role="status"><h2>Updating your report</h2><p>Loading the current balances and obligations for this company.</p></section> }
        else if (error is not null) { <section class="vc-panel finance-report-state" role="alert"><h2>Finance evidence unavailable</h2><p>@error</p><button class="btn btn-primary" @onclick="Load">Retry</button></section> }
        else if (report is not null)
        {
            <section class="finance-report-summary" aria-label="Financial summary">
                @foreach (var total in report.Totals)
                {
                    <div class="finance-report-currency" data-currency="@total.Currency">
                        <div class="finance-report-section-heading"><h2>@total.Currency</h2><span>Amounts in this currency only</span></div>
                        <dl class="finance-report-totals @(Kind == "forecast" ? "" : "finance-report-totals--aging")">
                            @if (Kind == "forecast")
                            {
                                <div class="vc-panel finance-report-metric"><dt>Starting cash</dt><dd data-testid="forecast-starting-cash">@Money(total.StartingCash, total.Currency)</dd><small>At the selected cutoff</small></div>
                                <div class="vc-panel finance-report-metric"><dt>Expected inflows</dt><dd data-testid="forecast-inflows">@Money(total.ExpectedInflows, total.Currency)</dd><small>Included customer invoices</small></div>
                                <div class="vc-panel finance-report-metric"><dt>Expected outflows</dt><dd data-testid="forecast-outflows">@Money(total.ExpectedOutflows, total.Currency)</dd><small>Included supplier obligations</small></div>
                                <div class="vc-panel finance-report-metric finance-report-metric--projected"><dt>Projected cash</dt><dd data-testid="forecast-projected-cash">@Money(total.ProjectedCash, total.Currency)</dd><small>At the end of the horizon</small></div>
                            }
                            else
                            {
                                <div class="vc-panel finance-report-metric"><dt>Remaining</dt><dd>@Money(Kind == "receivables" ? total.Receivables : total.Payables, total.Currency)</dd><small>Open recorded obligations</small></div>
                                <div class="vc-panel finance-report-metric"><dt>Overdue</dt><dd>@Money(Kind == "receivables" ? total.OverdueReceivables : total.OverduePayables, total.Currency)</dd><small>Past their recorded due date</small></div>
                            }
                        </dl>
                    </div>
                }
                @if (report.Totals.Count == 0) { <div class="vc-panel finance-report-state"><h2>No currency totals available</h2><p>No recorded financial evidence matches the selected currency and filters.</p></div> }
            </section>
            @if (report.CoverageGaps.Count > 0)
            {
                <section class="finance-report-coverage" role="status"><div><strong>Coverage needs attention</strong>
                    @if (report.CoverageGaps.Count == 1) { <p>@report.CoverageGaps[0]</p> }
                    else { <p>@report.CoverageGaps.Count source limitations are recorded. Review the coverage notes before relying on this report.</p> }
                    <details><summary>Coverage notes (@report.CoverageGaps.Count)</summary><ul>@foreach (var gap in report.CoverageGaps) { <li>@gap</li> }</ul></details>
                </div><a href="@BuildFinancePath(FinanceRoutes.Balances)">Review balances →</a></section>
            }
            <div class="finance-report-layout">
                <section class="vc-panel finance-report-table">
                    <div class="finance-report-table-header"><div><h2>@(Kind == "forecast" ? "Included cash movements" : "Included source obligations")</h2>
                        <p>@(Kind == "forecast" ? $"Due on or before {Date(report.ThroughDate)} UTC. Open amounts are assumed collected or paid in full." : "Outstanding records matching the selected cutoff and aging filters.")</p></div>
                        <span class="finance-report-record-count">@Rows.Count @(Rows.Count == 1 ? "record" : "records")</span>
                    </div>
                    @if (Rows.Count == 0) { <div class="finance-report-empty"><h3>No obligations match these filters</h3><p>Try another currency, aging bucket or horizon. Missing cash evidence remains unavailable.</p></div> }
                    else
                    {
                        <div class="finance-report-scroll" tabindex="0" role="region" aria-label="Included obligations, scroll horizontally to review all columns">
                            <table><caption class="visually-hidden">Included obligations, separated by currency</caption><thead><tr><th scope="col">Record</th><th scope="col">Counterparty</th><th scope="col">Due date (UTC)</th>
                                <th scope="col">@(Kind == "forecast" ? "Cash flow" : "Days overdue")</th><th scope="col" class="finance-report-amount">Remaining amount</th><th scope="col">Status</th><th scope="col">Action</th>
                            </tr></thead><tbody>
                                @foreach (var row in Rows)
                                {
                                    <tr><th scope="row">@row.Number</th><td>@row.Counterparty</td><td class="finance-report-date">@row.DueUtc.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</td>
                                        <td>@if (Kind == "forecast") { <span class="finance-report-flow @(report.Receivables.Contains(row) ? "finance-report-flow--in" : "finance-report-flow--out")">@(report.Receivables.Contains(row) ? "Inflow" : "Outflow")</span> } else { @row.DaysOverdue }</td>
                                        <td class="finance-report-amount">@Money(row.RemainingAmount, row.Currency)</td><td><span class="finance-report-status">@row.Status.Replace('_', ' ')</span></td>
                                        <td><a class="finance-report-review" aria-label="Review @row.Number" href="@BuildFinancePath(row.DeepLink)">Review →</a></td>
                                    </tr>
                                }
                            </tbody></table>
                        </div>
                    }
                    <footer class="finance-report-table-footer">CSV export refreshes the authorized records and uses these same filters.</footer>
                </section>
                <aside class="finance-report-rail" aria-label="Report sources and next steps">
                    @if (Kind == "forecast")
                    {
                        <section class="vc-panel finance-report-source"><h2>Starting cash evidence</h2>
                            @if (report.CashEvidence.Count == 0) { <p>No cash source is available for this cutoff.</p> }
                            @foreach (var cash in VisibleCashEvidence)
                            {
                                <article><h3>@cash.AccountName</h3><strong>@Money(cash.Amount, cash.Currency)</strong>
                                    <p>Observed @(cash.SourceObservedUtc is DateTime observed ? observed.ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture) + " UTC" : "time unavailable")</p>
                                    @if (!string.IsNullOrWhiteSpace(cash.Basis)) { <small>@cash.Basis</small> }
                                </article>
                            }
                            @if (report.CashEvidence.Count > 0 && VisibleCashEvidence.Count == 0) { <p>All recorded cash accounts have zero balances.</p> }
                            @if (report.CashEvidence.Count > VisibleCashEvidence.Count)
                            {
                                <details><summary>All @report.CashEvidence.Count cash accounts</summary><ul>
                                    @foreach (var cash in report.CashEvidence)
                                    {
                                        <li><span>@cash.AccountName</span><strong>@Money(cash.Amount, cash.Currency)</strong>
                                            <small>Observed @(cash.SourceObservedUtc is DateTime observed ? observed.ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture) + " UTC" : "time unavailable")</small>
                                            @if (!string.IsNullOrWhiteSpace(cash.Basis)) { <small>@cash.Basis</small> }
                                        </li>
                                    }
                                </ul></details>
                            }
                            <a href="@BuildFinancePath(FinanceRoutes.Balances)">Review balances →</a>
                        </section>
                    }
                    <section class="vc-panel finance-report-basis"><h2>@(Kind == "forecast" ? "Forecast basis" : "Report basis")</h2>
                        <p>@(Kind == "forecast" ? "Included open amounts are assumed collected or paid in full. Currencies are kept separate." : "Based on recorded outstanding obligations at the selected cutoff.")</p>
                        <details><summary>Calculation details</summary><div><p>@report.Meaning</p>
                            @if (Kind == "forecast") { <p>@report.ForecastAssumptions</p> }
                            <dl><dt>Cutoff</dt><dd>@Date(report.AsOfDate) UTC</dd><dt>Calculation</dt><dd>@report.CalculationVersion</dd></dl>
                        </div></details>
                    </section>
                    <section class="vc-panel finance-report-next"><h2>Next steps</h2><p>Review the underlying records before taking action.</p>
                        <a href="@BuildFinancePath(FinanceRoutes.Invoices)">Review customer invoices →</a>
                        <a href="@BuildFinancePath(FinanceRoutes.Payments)">Review payments →</a>
                        <a href="@BuildFinancePath(FinanceRoutes.AccountingReconciliation)">Bank reconciliation →</a>
                    </section>
                </aside>
            </div>
        }
    </main>
</FinancePageLayout>
@code {
    [SupplyParameterFromQuery(Name = "asOfDate")] public string? AsOfDate { get; set; }
    [SupplyParameterFromQuery(Name = "currency")] public string? Currency { get; set; }
    [SupplyParameterFromQuery(Name = "bucket")] public string? Bucket { get; set; }
    [SupplyParameterFromQuery(Name = "horizonDays")] public int? HorizonDays { get; set; }
    private string Kind => new Uri(Navigation.Uri).AbsolutePath switch { "/finance/payables-aging" => "payables", "/finance/cash-forecast" => "forecast", _ => "receivables" };
    private string Title => Kind == "payables" ? "Payables aging" : Kind == "forecast" ? "Short-term cash forecast" : "Receivables aging";
    private DateTime cutoff = DateTime.UtcNow.Date; private string? currency; private string? bucket; private int horizon = 14;
    private FinanceOperationalReportResponse? report; private bool loading; private string? error; private string? downloadMessage;
    private CancellationTokenSource? cts; private int version;
    private IReadOnlyList<FinanceObligationRowResponse> Rows => report is null ? [] : Kind == "receivables" ? report.Receivables : Kind == "payables" ? report.Payables : report.Receivables.Concat(report.Payables).Where(x => DateOnly.FromDateTime(x.DueUtc) <= report.ThroughDate).ToArray();
    private string Money(decimal? amount, string code) => amount.HasValue ? LocalMoney.Format(amount.Value, code) : "Unavailable";
    private static string Date(DateOnly date) => date.ToString("dd MMM yyyy", CultureInfo.CurrentCulture);
    private IReadOnlyList<FinanceCashEvidenceResponse> VisibleCashEvidence => report?.CashEvidence.Where(x => x.Amount != 0).Take(3).ToArray() ?? [];
    protected override async Task OnParametersSetAsync()
    {
        cts?.Cancel(); report = null; error = null; downloadMessage = null;
        await base.OnParametersSetAsync(); if (!AccessState.IsAllowed) return;
        cutoff = DateTime.UtcNow.Date;
        if (AsOfDate is not null && !DateTime.TryParseExact(AsOfDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out cutoff)) { error = "Choose a valid UTC cutoff date."; return; }
        currency = Currency; bucket = Bucket; horizon = HorizonDays ?? 14; await Load();
    }
    private void Apply() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["asOfDate"] = cutoff.ToString("yyyy-MM-dd"), ["currency"] = currency, ["bucket"] = bucket, ["horizonDays"] = horizon }));
    private async Task Load()
    {
        if (AccessState.CompanyId is not Guid company || !AccessState.IsAllowed) return;
        cts?.Cancel(); cts?.Dispose(); cts = new(); var token = cts.Token; var read = ++version; var location = Navigation.Uri;
        report = null; error = null; loading = true;
        var appliedCutoff = DateOnly.FromDateTime(DateTime.UtcNow);
        if (AsOfDate is not null && !DateOnly.TryParseExact(AsOfDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out appliedCutoff)) { loading = false; error = "Choose a valid UTC cutoff date."; return; }
        try { var result = await Finance.GetOperationalReportAsync(company, appliedCutoff, HorizonDays ?? 14, Currency, Bucket, token, OperationalSource);
            if (read == version && location == Navigation.Uri && !token.IsCancellationRequested) report = result ?? throw new FinanceApiException("No report response was returned."); }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is FinanceApiException or HttpRequestException) { if (read == version && location == Navigation.Uri) error = ex is FinanceApiException ? ex.Message : "Finance could not be reached. Retry the report."; }
        finally { if (read == version) loading = false; }
    }
    private async Task Download()
    {
        downloadMessage = null; var location = Navigation.Uri; var kind = Kind;
        await Load(); if (report is null || location != Navigation.Uri || !AccessState.IsAllowed) return;
        try { await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reportDownload.js");
            await module.InvokeVoidAsync("downloadReport", $"finance-{kind}.csv", FinanceOperationalCsv.Build(report, kind)); downloadMessage = "Current authorized CSV passed to your browser."; }
        catch (JSException) { downloadMessage = "The browser download could not start. Retry the download."; }
    }
    public void Dispose() { ++version; cts?.Cancel(); cts?.Dispose(); }
}
