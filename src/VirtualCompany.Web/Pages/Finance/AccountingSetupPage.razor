@page "/finance/accounting/setup"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["AccountingSetupTitle"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["AccountingSetupTitle"]"
    Description="@FinanceText["AccountingSetupDescription"]"
    LoadingMessage="@FinanceText["AccountingSetupLoading"]">
    <AccountingNavigation CompanyId="@AccessState.CompanyId" />

    @if (SetupStatus?.IsConfigured == true)
    {
        <section class="accounting-complete-card" aria-labelledby="accounting-setup-complete-title">
            <div class="accounting-complete-card__icon" aria-hidden="true">✓</div>
            <div>
                <span class="dashboard-kicker">@FinanceText["AccountingSetupCompleteKicker"]</span>
                <h2 id="accounting-setup-complete-title">@FinanceText["AccountingSetupCompleteTitle"]</h2>
                <p>@FinanceText["AccountingSetupCompleteDescription"]</p>
                @if (SetupStatus.Configuration is not null)
                {
                    <dl class="accounting-summary-list">
                        <div><dt>@FinanceText["BaseCurrency"]</dt><dd>@SetupStatus.Configuration.BaseCurrency</dd></div>
                        <div><dt>@FinanceText["AccountingPolicy"]</dt><dd>@DisplayPolicyName</dd></div>
                        <div><dt>@FinanceText["FiscalYearStarts"]</dt><dd>@FormatFiscalStart(SetupStatus.Configuration)</dd></div>
                        <div><dt>@FinanceText["AccountingReadiness"]</dt><dd>@(SetupStatus.IsReady ? FinanceText["Ready"] : FinanceText["NeedsReview"])</dd></div>
                    </dl>
                }
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a class="btn btn-primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.AccountingAccounts, AccessState.CompanyId)">@FinanceText["ReviewAccounts"]</a>
                    <a class="btn btn-outline-primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.AccountingPeriods, AccessState.CompanyId)">@FinanceText["ReviewPeriods"]</a>
                    <button class="btn btn-outline-secondary" type="button" @onclick="ReloadAsync">@CommonText["Refresh"]</button>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="accounting-setup-layout">
            <aside class="accounting-stepper" aria-label="@FinanceText["AccountingSetupSteps"]">
                @foreach (var step in Steps)
                {
                    <button class="@GetStepClass(step.Number)" type="button" @onclick="() => GoToStep(step.Number)" disabled="@(step.Number > HighestAvailableStep)">
                        <span>@step.Number</span>
                        <strong>@FinanceText[step.ResourceKey]</strong>
                    </button>
                }
            </aside>

            <main class="accounting-setup-main">
                @if (!string.IsNullOrWhiteSpace(ActionError))
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@FinanceText["AccountingActionFailed"]</strong>
                        <div>@ActionError</div>
                        <button class="btn btn-sm btn-outline-danger mt-2" type="button" @onclick="ReloadPreviewAsync">@CommonText["TryAgain"]</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                {
                    <div class="alert alert-success" role="status">@SuccessMessage</div>
                }

                @if (CurrentStep == 1)
                {
                    <section class="accounting-panel" aria-labelledby="setup-basics-title">
                        <div class="accounting-panel__header">
                            <div>
                                <span class="dashboard-kicker">@FinanceText["AccountingStep", CurrentStep, Steps.Count]</span>
                                <h2 id="setup-basics-title">@FinanceText["AccountingBasicsTitle"]</h2>
                                <p>@FinanceText["AccountingBasicsDescription"]</p>
                            </div>
                        </div>
                        <div class="accounting-form-grid">
                            <div class="accounting-field-card">
                                <label for="accounting-ledger">@FinanceText["AccountingLedger"]</label>
                                <input id="accounting-ledger" class="form-control" value="@FinanceText["InternalLedger"]" disabled />
                                <small>@FinanceText["InternalLedgerHelp"]</small>
                            </div>
                            <div class="accounting-field-card">
                                <label for="base-currency">@FinanceText["BaseCurrency"]</label>
                                <InputText id="base-currency" class="form-control text-uppercase" maxlength="3" @bind-Value="Draft.BaseCurrency" />
                                <small>@FinanceText["BaseCurrencyHelp"]</small>
                            </div>
                            <div class="accounting-field-card">
                                <label for="fiscal-year-start">@FinanceText["FiscalYearStarts"]</label>
                                <InputDate id="fiscal-year-start" class="form-control" @bind-Value="Draft.FiscalYearStart" />
                                <small>@FinanceText["FiscalYearStartHelp"]</small>
                            </div>
                            <div class="accounting-field-card">
                                <label for="policy-pack">@FinanceText["AccountingPolicy"]</label>
                                <InputSelect id="policy-pack" class="form-select" @bind-Value="Draft.PolicyPackIdentity">
                                    @foreach (var pack in PolicyPacks)
                                    {
                                        <option value="@PackIdentity(pack)">@pack.DisplayName</option>
                                    }
                                </InputSelect>
                                <small>@FinanceText["AccountingPolicyHelp"]</small>
                            </div>
                            <div class="accounting-field-card accounting-field-card--wide">
                                <label for="chart-template">@FinanceText["ChartTemplate"]</label>
                                <InputSelect id="chart-template" class="form-select" @bind-Value="Draft.ChartTemplateKey">
                                    @foreach (var template in SelectedPackTemplates)
                                    {
                                        <option value="@template.TemplateKey">@template.DisplayName (@FinanceText["AccountCount", template.AccountCount])</option>
                                    }
                                </InputSelect>
                                <small>@FinanceText["ChartTemplateHelp"]</small>
                            </div>
                        </div>
                        <div class="accounting-notice accounting-notice--warning" role="note">
                            <span aria-hidden="true">!</span>
                            <div><strong>@FinanceText["CountryNeutralNoticeTitle"]</strong><p>@FinanceText["CountryNeutralNotice"]</p></div>
                        </div>
                    </section>
                }
                else if (CurrentStep == 2)
                {
                    <section class="accounting-panel" aria-labelledby="setup-accounts-title">
                        <div class="accounting-panel__header">
                            <div><span class="dashboard-kicker">@FinanceText["AccountingStep", CurrentStep, Steps.Count]</span><h2 id="setup-accounts-title">@FinanceText["ReviewChartTitle"]</h2><p>@FinanceText["ReviewChartDescription"]</p></div>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ReloadPreviewAsync" disabled="@IsPreviewLoading">@CommonText["Refresh"]</button>
                        </div>
                        <FinanceDataState IsLoading="@IsPreviewLoading" IsEmpty="@(Preview is not null && Preview.Accounts.Count == 0)" ErrorMessage="@PreviewError" LoadingTitle="@FinanceText["AccountingPreviewLoading"]" LoadingMessage="@FinanceText["AccountingPreviewLoadingHelp"]" EmptyTitle="@FinanceText["NoAccountsInTemplate"]" EmptyMessage="@FinanceText["NoAccountsInTemplateHelp"]" OnRetry="ReloadPreviewAsync">
                            <div class="table-responsive">
                                <table class="table accounting-table align-middle">
                                    <thead><tr><th>@FinanceText["AccountCode"]</th><th>@FinanceText["AccountName"]</th><th>@FinanceText["AccountClass"]</th><th>@FinanceText["ControlRole"]</th><th>@FinanceText["Reporting"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var account in Preview?.Accounts ?? [])
                                        {
                                            <tr><td><strong>@account.Code</strong></td><td>@account.Name</td><td>@FinanceText[AccountingPresentation.AccountClassResourceKey(account.AccountClass)]</td><td>@(account.RoleName ?? FinanceText["NoControlRole"])</td><td>@account.ReportingPlacement</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="accounting-summary-grid mt-3">
                                <div><span>@FinanceText["TaxBehavior"]</span><strong>@Preview?.TaxBehavior</strong></div>
                                <div><span>@FinanceText["ControlAccounts"]</span><strong>@(Preview?.Accounts.Count(account => account.IsControlAccount) ?? 0)</strong></div>
                                <div><span>@FinanceText["ChartTemplate"]</span><strong>@Preview?.ChartTemplateName</strong></div>
                            </div>
                        </FinanceDataState>
                    </section>
                }
                else if (CurrentStep == 3)
                {
                    <section class="accounting-panel" aria-labelledby="setup-periods-title">
                        <div class="accounting-panel__header"><div><span class="dashboard-kicker">@FinanceText["AccountingStep", CurrentStep, Steps.Count]</span><h2 id="setup-periods-title">@FinanceText["ReviewPeriodsAndSeriesTitle"]</h2><p>@FinanceText["ReviewPeriodsAndSeriesDescription"]</p></div></div>
                        <div class="accounting-review-columns">
                            <div>
                                <h3>@FinanceText["MonthlyPeriods"]</h3>
                                <div class="accounting-period-preview">
                                    @foreach (var period in Preview?.Periods ?? [])
                                    {
                                        <div><strong>@period.Name</strong><span>@period.StartDate.ToString("d") – @period.EndDate.ToString("d")</span></div>
                                    }
                                </div>
                            </div>
                            <div>
                                <h3>@FinanceText["VoucherSeries"]</h3>
                                <div class="accounting-series-list">
                                    @foreach (var series in Preview?.VoucherSeries ?? [])
                                    {
                                        <div><span class="accounting-code">@series.NumberPrefix</span><div><strong>@series.DisplayName</strong><small>@FinanceText["SequentialNumberingHelp"]</small></div></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <section class="accounting-panel" aria-labelledby="setup-review-title">
                        <div class="accounting-panel__header"><div><span class="dashboard-kicker">@FinanceText["AccountingStep", CurrentStep, Steps.Count]</span><h2 id="setup-review-title">@FinanceText["ConfirmAccountingSetupTitle"]</h2><p>@FinanceText["ConfirmAccountingSetupDescription"]</p></div></div>
                        @if (Preview?.Warnings.Count > 0)
                        {
                            @foreach (var warning in Preview.Warnings)
                            {
                                <div class="accounting-notice accounting-notice--warning" role="note"><span aria-hidden="true">!</span><div><strong>@FinanceText["ImportantDecision"]</strong><p>@warning.Explanation</p></div></div>
                            }
                        }
                        @if (Preview?.Issues.Count > 0)
                        {
                            <div class="accounting-notice accounting-notice--danger" role="alert">
                                <span aria-hidden="true">×</span>
                                <div>
                                    <strong>@FinanceText["SetupNeedsChanges"]</strong>
                                    @foreach (var issue in Preview.Issues)
                                    {
                                        <p>@issue.Explanation</p>
                                    }
                                </div>
                            </div>
                        }
                        <dl class="accounting-summary-list accounting-summary-list--review">
                            <div><dt>@FinanceText["AccountingLedger"]</dt><dd>@FinanceText["InternalLedger"]</dd></div>
                            <div><dt>@FinanceText["BaseCurrency"]</dt><dd>@Preview?.BaseCurrency</dd></div>
                            <div><dt>@FinanceText["FiscalYear"]</dt><dd>@Preview?.FiscalYearStart.ToString("d") – @Preview?.FiscalYearEnd.ToString("d")</dd></div>
                            <div><dt>@FinanceText["AccountingPolicy"]</dt><dd>@Preview?.PolicyPackName</dd></div>
                            <div><dt>@FinanceText["Accounts"]</dt><dd>@FinanceText["AccountCount", Preview?.Accounts.Count ?? 0]</dd></div>
                            <div><dt>@FinanceText["MonthlyPeriods"]</dt><dd>@FinanceText["PeriodCount", Preview?.Periods.Count ?? 0]</dd></div>
                            <div><dt>@FinanceText["VoucherSeries"]</dt><dd>@FinanceText["SeriesCount", Preview?.VoucherSeries.Count ?? 0]</dd></div>
                            <div><dt>@FinanceText["TaxBehavior"]</dt><dd>@Preview?.TaxBehavior</dd></div>
                        </dl>
                    </section>
                }

                @if (CurrentStep < Steps.Count && Preview?.Issues.Any(issue => issue.IsBlocking) == true)
                {
                    <div class="accounting-notice accounting-notice--danger" role="alert">
                        <span aria-hidden="true">×</span>
                        <div>
                            <strong>@FinanceText["SetupNeedsChanges"]</strong>
                            @foreach (var issue in Preview.Issues.Where(issue => issue.IsBlocking))
                            {
                                <p>@issue.Explanation</p>
                            }
                        </div>
                    </div>
                }

                <footer class="accounting-setup-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="PreviousStep" disabled="@(CurrentStep == 1 || IsSaving)">@FinanceText["Back"]</button>
                    @if (CurrentStep < Steps.Count)
                    {
                        <button class="btn btn-primary" type="button" @onclick="NextStepAsync" disabled="@(IsPreviewLoading || IsSaving)">@(IsPreviewLoading ? FinanceText["Reviewing"] : FinanceText["Continue"])</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" type="button" @onclick="CompleteSetupAsync" disabled="@(!CanManageAccounting || IsSaving || Preview?.IsValid != true)">@(IsSaving ? FinanceText["CompletingSetup"] : FinanceText["CompleteSetup"])</button>
                    }
                </footer>
            </main>

            <aside class="accounting-laura-card">
                <div class="accounting-laura-card__identity"><span aria-hidden="true">L</span><div><strong>@FinanceText["Laura"]</strong><small>@FinanceText["FinanceManager"]</small></div></div>
                <p>@FinanceText["LauraAccountingSetupAdvice"]</p>
                <ul><li>@FinanceText["SetupBenefitBooks"]</li><li>@FinanceText["SetupBenefitReports"]</li><li>@FinanceText["SetupBenefitReview"]</li></ul>
                @if (!CanManageAccounting)
                {
                    <div class="accounting-notice accounting-notice--info"><span aria-hidden="true">i</span><p>@FinanceText["AccountingAdminRequired"]</p></div>
                }
            </aside>
        </div>
    }
</FinancePageLayout>
