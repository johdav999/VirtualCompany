@page "/finance/invoices"
@page "/finance/invoices/{InvoiceId:guid}"
@inherits FinancePageBase

<PageTitle>@FinanceText["Invoices"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["Invoices"]"
    Description="@FinanceText["InvoicesDescription"]"
    LoadingMessage="@FinanceText["LoadingInvoices"]"
    ShowShellHeader="false"
    ShowShellNavigation="false">
    <section class="invoices-dashboard" aria-labelledby="invoices-heading">
        <div class="finance-overview-header">
            <div>
                <span class="finance-overview-kicker">@FinanceText["FinanceModule"]</span>
                <h1 id="invoices-heading" class="finance-overview-title">@FinanceText["Invoices"]</h1>
                <p class="finance-overview-subtitle">@FinanceText["InvoicesDescription"]</p>
            </div>
            <div class="finance-overview-header__actions">
                <a class="btn finance-overview-button finance-overview-button--primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Home, AccessState.CompanyId)">@FinanceText["FinanceOverview"]</a>
                <a class="btn finance-overview-button finance-overview-button--secondary" href="@DashboardHref">@FinanceText["CompanyDashboard"]</a>
            </div>
        </div>

        <FinanceSectionNav CompanyId="@AccessState.CompanyId!.Value" MembershipRole="@AccessState.MembershipRole" />
        <div class="finance-subtab-nav" aria-label="@FinanceText["Invoices"]">
            <a class="finance-subtab-nav__link active" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Invoices, AccessState.CompanyId)">@FinanceText["Invoices"]</a>
            <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Reviews, AccessState.CompanyId)">@FinanceText["Review"]</a>
        </div>

        <div class="invoices-layout">
            <article class="invoice-list-card">
                <div class="invoice-list-card__header">
                    <div>
                        <h2>@FinanceText["InvoiceList"]</h2>
                        <p>@FinanceText["InvoiceListDescription"]</p>
                    </div>
                    <span>@CommonText[Invoices.Count == 1 ? "ItemCountOne" : "ItemCountMany", Invoices.Count]</span>
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@IsListEmpty"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="@FinanceText["LoadingInvoices"]"
                    LoadingMessage="@FinanceText["FetchingInvoices"]"
                    EmptyTitle="@FinanceText["NoInvoices"]"
                    EmptyMessage="@FinanceText["NoInvoicesDescription"]"
                    OnRetry="@ReloadAsync">
                    <div class="invoice-list">
                        @foreach (var invoice in InvoiceItems)
                        {
                            <a class="@($"invoice-list-item {(invoice.IsSelected ? "is-selected" : string.Empty)}")" href="@BuildInvoiceHref(invoice.Id)">
                                <span class="@($"invoice-list-item__icon invoice-tone--{invoice.IconTone}")" aria-hidden="true">inv</span>
                                <span class="invoice-list-item__main">
                                    <strong>@invoice.DisplayInvoiceNumber</strong>
                                    <span>@invoice.DisplayCustomerName</span>
                                    <small>@invoice.DateSummary</small>
                                </span>
                                <span class="invoice-list-item__meta">
                                    <strong>@invoice.DisplayAmount</strong>
                                    <span class="@($"invoice-status-badge invoice-status-badge--{invoice.StatusTone}")">@invoice.FriendlyStatusLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(invoice.ReviewBadgeLabel))
                                    {
                                        <span class="@($"invoice-status-badge invoice-status-badge--{invoice.ReviewBadgeTone}")">@invoice.ReviewBadgeLabel</span>
                                    }
                                </span>
                                <span class="invoice-list-item__chevron" aria-hidden="true">›</span>
                            </a>
                        }
                    </div>
                </FinanceDataState>
            </article>

            <aside class="invoice-detail-card">
                @if (IsDetailLoading)
                {
                    <FinanceLoadingState Title="@FinanceText["LoadingInvoiceDetail"]" Message="@FinanceText["OpeningInvoice"]" />
                }
                else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                {
                    <FinanceErrorState Title="@FinanceText["InvoiceDetailUnavailable"]" Message="@(DetailErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@ReloadAsync" />
                }
                else if (SelectedInvoice is null)
                {
                    <div class="invoice-detail-empty">
                        <div class="invoice-detail-empty__icon" aria-hidden="true">doc</div>
                        <h2>@FinanceText["NoInvoiceSelected"]</h2>
                        <p>@FinanceText["SelectInvoiceDetail"]</p>
                    </div>
                }
                else if (SelectedInvoiceDisplay is { } detail)
                {
                    <div class="invoice-detail-panel">
                        <div class="invoice-detail-panel__header">
                            <div>
                                <h2>@detail.DisplayInvoiceNumber</h2>
                                <p>@detail.DisplayCustomerName</p>
                            </div>
                            <div class="invoice-detail-panel__badges">
                                <span class="@($"invoice-status-badge invoice-status-badge--{detail.StatusTone}")">@detail.FriendlyStatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(detail.ReviewBadgeLabel))
                                {
                                    <span class="@($"invoice-status-badge invoice-status-badge--{detail.ReviewBadgeTone}")">@detail.ReviewBadgeLabel</span>
                                }
                            </div>
                        </div>

                        <div class="invoice-detail-panel__amount">@detail.DisplayAmount</div>

                        <dl class="invoice-detail-list">
                            <div><dt>@FinanceText["Customer"]</dt><dd>@detail.DisplayCustomerName</dd></div>
                            <div><dt>@FinanceText["IssuedDate"]</dt><dd>@detail.DisplayIssuedDate</dd></div>
                            <div><dt>@FinanceText["DueDate"]</dt><dd>@detail.DisplayDueDate</dd></div>
                            <div><dt>@FinanceText["DocumentType"]</dt><dd>@detail.DocumentKindLabel</dd></div>
                            <div><dt>@FinanceText["PaymentStatus"]</dt><dd>@detail.FriendlyStatusLabel</dd></div>
                            @if (detail.PaymentSummary is not null)
                            {
                                <div><dt>@FinanceText["PaymentDetails"]</dt><dd>@detail.PaymentSummary.Summary</dd></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detail.ReviewBadgeLabel))
                            {
                                <div><dt>@FinanceText["FlagStatus"]</dt><dd>@detail.ReviewBadgeLabel</dd></div>
                            }
                            <div><dt>@FinanceText["ApprovalStatus"]</dt><dd>@detail.ApprovalStatus</dd></div>
                        </dl>

                        <form class="invoice-detail-form" @onsubmit="HandleStatusSaveAsync" @onsubmit:preventDefault="true">
                            <label class="form-label" for="invoice-status-input">@FinanceText["UpdateStatus"]</label>
                            <select id="invoice-status-input" class="form-select" @bind="EditableStatus" disabled="@(!CanChangeInvoiceApprovalStatus || IsSavingStatus)">
                                @foreach (var option in EditableStatusOptions)
                                {
                                    <option value="@option">@FormatInvoiceStatusLabel(option)</option>
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(StatusValidationMessage))
                            {
                                <div class="text-danger small mt-1">@StatusValidationMessage</div>
                            }
                            <div class="form-text">@(CanChangeInvoiceApprovalStatus ? FinanceText["InvoiceStatusSaveHelp"] : FinanceText["InvoiceStatusApprovalHelp"])</div>
                            <div class="invoice-detail-actions">
                                <button class="btn btn-primary" type="submit" disabled="@(!CanChangeInvoiceApprovalStatus || IsSavingStatus)">@FinanceText["SaveStatus"]</button>
                                @if (detail.CanOpenApproval && detail.ApprovalRequestId is Guid approvalRequestId)
                                {
                                    <a class="btn btn-outline-secondary" href="@BuildApprovalHref(approvalRequestId)">@FinanceText["OpenApproval"]</a>
                                }
                                @if (detail.CanOpenReview && detail.WorkflowInstanceId is Guid workflowInstanceId)
                                {
                                    <a class="btn btn-outline-secondary" href="@BuildWorkflowHref(workflowInstanceId)">@FinanceText["ReviewInvoice"]</a>
                                }
                            </div>
                        </form>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusSaveMessage))
                    {
                        <div class="alert alert-success" role="status">@StatusSaveMessage</div>
                    }

                    <section class="invoice-detail-section">
                        <h3>@FinanceText["ReviewNotes"]</h3>
                        @if (detail.PaymentSummary?.IsPartiallyPaid == true)
                        {
                            <p>@detail.PaymentSummary.ReviewReason</p>
                        }
                        else
                        {
                            <p>@detail.ReviewSummary</p>
                        }
                    </section>

                    <section class="invoice-detail-section">
                        <h3>@FinanceText["RelatedTransactions"]</h3>
                        @if (detail.RelatedTransactions.Count == 0)
                        {
                            <p>@FinanceText["NoInvoiceTransactions"]</p>
                        }
                        else
                        {
                            <div class="invoice-related-transactions">
                                @foreach (var transaction in detail.RelatedTransactions)
                                {
                                    <a class="invoice-related-transaction" href="@BuildTransactionHref(transaction.Id)">
                                        <span class="@($"invoice-status-badge invoice-status-badge--{transaction.TypeTone}")">@transaction.TypeLabel</span>
                                        <span>
                                            <strong>@transaction.Description</strong>
                                            <small>@transaction.DisplayDate - @transaction.CategoryLabel - @transaction.ExternalReference</small>
                                        </span>
                                        <strong>@transaction.DisplayAmount</strong>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    @if (detail.SourceDetails.Count > 0)
                    {
                        <section class="invoice-detail-section">
                            <h3>@FinanceText["SourceDetails"]</h3>
                            <dl class="invoice-detail-list invoice-source-detail-list">
                                @foreach (var sourceDetail in detail.SourceDetails)
                                {
                                    <div><dt>@sourceDetail.Label</dt><dd>@sourceDetail.Value</dd></div>
                                }
                            </dl>
                        </section>
                    }

                    <section class="invoice-detail-section">
                        <h3>@FinanceText["LinkedDocument"]</h3>
                    <FinanceLinkedResourceState
                        Availability="@SelectedInvoice.LinkedDocument.Availability"
                        Message="@SelectedInvoice.LinkedDocument.Message"
                        ResourceTitle="@SelectedInvoice.LinkedDocument.Document?.Title"
                        SecondaryText="@SelectedInvoice.LinkedDocument.Document?.OriginalFileName"
                        TypeText="@SelectedInvoice.LinkedDocument.Document?.ContentType"
                        CanNavigate="@SelectedInvoice.LinkedDocument.CanNavigate"
                        NavigateHref="@(SelectedInvoice.LinkedDocument.Document is null ? null : BuildDocumentHref(SelectedInvoice.LinkedDocument.Document.Id))"
                        ActionText="@FinanceText["OpenLinkedDocument"]" />
                    </section>

                    <AgentInsightsPanel
                        Title="@FinanceText["AgentInsights"]"
                        Subtitle="@FinanceText["InvoiceAgentInsightsSubtitle"]"
                        EmptyMessage="@FinanceText["NoInvoiceAgentInsights"]"
                        TestId="invoice-agent-insights-panel"
                        Items="@SelectedInvoice.AgentInsights" />
                }
            </aside>
        </div>
    </section>
</FinancePageLayout>
