@page "/finance/supplier-subscriptions"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["SupplierSubscriptionsTitle"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["SupplierSubscriptionsTitle"]"
    Description="@FinanceText["SupplierSubscriptionsDescription"]"
    LoadingMessage="@FinanceText["LoadingSupplierSubscriptions"]"
    ShowShellHeader="false"
    ShowShellNavigation="false">
    <section class="supplier-subscriptions" aria-labelledby="supplier-subscriptions-heading" aria-busy="@(IsListLoading || IsDetailLoading || IsProposalLoading)">
        <div class="finance-overview-header">
            <div>
                <span class="finance-overview-kicker">@FinanceText["FinanceKicker"]</span>
                <h1 id="supplier-subscriptions-heading" class="finance-overview-title">@FinanceText["SupplierSubscriptionsTitle"]</h1>
                <p class="finance-overview-subtitle">@FinanceText["SupplierSubscriptionsLauraHelp"]</p>
            </div>
            <div class="finance-overview-header__actions">
                <button type="button" class="btn finance-overview-button finance-overview-button--primary" @onclick="StartCreate">@FinanceText["AddSupplierSubscription"]</button>
            </div>
        </div>

        <FinanceSectionNav CompanyId="@AccessState.CompanyId!.Value" MembershipRole="@AccessState.MembershipRole" />

        <section class="subscription-discovery-panel" aria-labelledby="subscription-discovery-heading">
            <div class="subscription-discovery-panel__header">
                <div>
                    <span class="dashboard-kicker">@FinanceText["InboxDiscovery"]</span>
                    <h2 id="subscription-discovery-heading">@FinanceText["DiscoveredAgreements"]</h2>
                    <p>@FinanceText["DiscoveredAgreementsHelp"]</p>
                </div>
                <span class="subscription-badge subscription-badge--warning">@FinanceText["NeedReviewCount", ReviewProposals.Count]</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(ProposalErrorMessage))
            {
                <p class="subscription-message subscription-message--danger" role="alert">@ProposalErrorMessage</p>
            }
            else if (IsProposalLoading && ReviewProposals.Count == 0)
            {
                <p class="subscription-muted" role="status">@FinanceText["ScanningDiscoveredAgreements"]</p>
            }
            else if (ReviewProposals.Count == 0)
            {
                <p class="subscription-muted">@FinanceText["NoDiscoveredAgreementsNeedReview"]</p>
            }
            else
            {
                <div class="subscription-discovery-grid">
                    <div class="subscription-proposal-list" role="list">
                        @foreach (var proposal in ReviewProposals.Take(6))
                        {
                            <button type="button" class="subscription-proposal-row @(SelectedProposal?.Id == proposal.Id ? "is-selected" : string.Empty)" aria-pressed="@(SelectedProposal?.Id == proposal.Id)" @onclick="() => SelectProposalAsync(proposal.Id)">
                                <span class="subscription-row__icon" aria-hidden="true">@Initials(proposal.SupplierName)</span>
                                <span>
                                    <strong>@proposal.AgreementName</strong>
                                    <small>@proposal.SupplierName · @FormatOptionalMoney(proposal.ExpectedAmount, proposal.Currency) · @Label(proposal.Cadence ?? "needs_review")</small>
                                </span>
                                <span class="subscription-badge subscription-badge--@Tone(proposal.Status)">@Label(proposal.Status)</span>
                            </button>
                        }
                    </div>
                    <aside class="subscription-proposal-detail">
                        @if (SelectedProposal is null)
                        {
                            <p class="subscription-muted">@FinanceText["SelectDiscoveredAgreement"]</p>
                        }
                        else
                        {
                            <div class="subscription-detail-header">
                                <div>
                                    <span class="subscription-badge subscription-badge--@Tone(SelectedProposal.Status)">@Label(SelectedProposal.Status)</span>
                                    <h3>@(SelectedProposal.Terms.Name ?? FinanceText["SubscriptionProposal"])</h3>
                                    <p>@SelectedProposal.SupplierName</p>
                                </div>
                                <strong>@SelectedProposal.ConfidenceScore%</strong>
                            </div>
                            <p class="subscription-muted">@SelectedProposal.EvidenceSummary</p>
                            <div class="subscription-proposal-form" aria-label="@FinanceText["ReviewProposalTerms"]">
                                <div class="subscription-proposal-source">
                                    <span>@FinanceText["Source"]</span>
                                    <strong>@(SelectedProposal.SourceAttachmentName ?? SelectedProposal.SourceSubject ?? FinanceText["EmailEvidence"])</strong>
                                </div>
                                <div class="subscription-supplier-picker">
                                    <label for="proposal-supplier-search">@FinanceText["Supplier"]</label>
                                    <div class="subscription-supplier-picker__control">
                                        <input id="proposal-supplier-search" class="form-control" placeholder="@FinanceText["SearchSuppliers"]" autocomplete="off" @bind="ProposalSupplierSearchText" @bind:event="oninput" @onfocus="ShowProposalSupplierPicker" disabled="@IsSuppliersLoading" />
                                        @if (ProposalForm.CounterpartyId is Guid)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearProposalSupplier">@FinanceText["Clear"]</button>
                                        }
                                    </div>
                                    @if (SelectedProposalSupplier is not null)
                                    {
                                        <div class="subscription-supplier-picker__selected">
                                            <span class="subscription-row__icon" aria-hidden="true">@Initials(SelectedProposalSupplier.Name)</span>
                                            <div>
                                                <strong>@SelectedProposalSupplier.Name</strong>
                                                <small>@SupplierMeta(SelectedProposalSupplier)</small>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="subscription-muted">@FinanceText["SupplierNeedsReview"]</p>
                                    }
                                    @if (IsProposalSupplierPickerOpen)
                                    {
                                        <div class="subscription-supplier-picker__menu" role="listbox" aria-label="@FinanceText["SupplierResults"]">
                                            @if (FilteredProposalSupplierOptions.Count == 0)
                                            {
                                                <p class="subscription-muted">@FinanceText["NoSuppliersMatchSearch"]</p>
                                            }
                                            else
                                            {
                                                @foreach (var supplier in FilteredProposalSupplierOptions)
                                                {
                                                    <button type="button" class="subscription-supplier-option" role="option" aria-selected="@(supplier.Id == ProposalForm.CounterpartyId)" @onclick="() => SelectProposalSupplier(supplier)">
                                                        <span class="subscription-row__icon" aria-hidden="true">@Initials(supplier.Name)</span>
                                                        <span>
                                                            <strong>@supplier.Name</strong>
                                                            <small>@SupplierMeta(supplier)</small>
                                                        </span>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                <label>@FinanceText["Name"]<input class="form-control" @bind="ProposalForm.Name" /></label>
                                <label>@FinanceText["Currency"]<input class="form-control" @bind="ProposalForm.Currency" /></label>
                                <label>@FinanceText["ExpectedAmount"]<input class="form-control" type="number" step="0.01" @bind="ProposalForm.ExpectedAmount" /></label>
                                <label>@FinanceText["Cadence"]<select class="form-select" @bind="ProposalForm.Cadence"><option value="monthly">@FinanceText["Monthly"]</option><option value="quarterly">@FinanceText["Quarterly"]</option><option value="yearly">@FinanceText["Yearly"]</option></select></label>
                                <label>@FinanceText["BillingDay"]<input class="form-control" type="number" min="1" max="31" @bind="ProposalForm.BillingDay" /></label>
                                <label>@FinanceText["StartDate"]<input class="form-control" type="date" @bind="ProposalForm.StartDateUtc" /></label>
                                <label>@FinanceText["NextExpectedBill"]<input class="form-control" type="date" @bind="ProposalForm.NextExpectedBillDateUtc" /></label>
                                <label>@FinanceText["NoticePeriodDays"]<input class="form-control" type="number" min="0" @bind="ProposalForm.NoticePeriodDays" /></label>
                                <label>@FinanceText["ContractReference"]<input class="form-control" @bind="ProposalForm.ContractReference" /></label>
                            </div>
                            @if (!CanAcceptSelectedProposal)
                            {
                                <p class="subscription-message subscription-message--warning">@FinanceText["SubscriptionProposalAcceptanceRequired"]</p>
                            }
                            <div class="subscription-actions">
                                <button type="button" class="btn btn-primary btn-sm" disabled="@(IsProposalSubmitting || !CanAcceptSelectedProposal)" @onclick="() => AcceptProposalAsync(SelectedProposal.Id)">@FinanceText["AcceptAsDraft"]</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@IsProposalSubmitting" @onclick="() => RetryProposalAsync(SelectedProposal.Id)">@FinanceText["RetryExtraction"]</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@IsProposalSubmitting" @onclick="() => RejectProposalAsync(SelectedProposal.Id)">@FinanceText["Reject"]</button>
                            </div>
                        }
                    </aside>
                </div>
            }
        </section>
        <div class="subscription-workspace">
            <article class="subscription-list-panel">
                <div class="subscription-filter-card" aria-label="@FinanceText["SupplierSubscriptionFilters"]">
                    <input class="form-control" aria-label="@FinanceText["SearchAgreementsOrSuppliers"]" placeholder="@FinanceText["SearchAgreementsOrSuppliers"]" @bind="SearchText" @bind:event="oninput" />
                    <select class="form-select" @bind="StatusFilter">
                        <option value="">@FinanceText["AllStatuses"]</option>
                        <option value="active">@FinanceText["Active"]</option>
                        <option value="draft">@FinanceText["Draft"]</option>
                        <option value="paused">@FinanceText["Paused"]</option>
                        <option value="cancelled">@FinanceText["Cancelled"]</option>
                    </select>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ReloadAsync">@FinanceText["Refresh"]</button>
                </div>

                <div class="subscription-list-panel__summary">
                    <div><strong>@FilteredSubscriptions.Count</strong><span>@FinanceText["Agreements"]</span></div>
                    <div><strong>@Subscriptions.Count(x => x.Health == "needs_review")</strong><span>@FinanceText["NeedReview"]</span></div>
                    <div><strong>@Subscriptions.Count(x => x.Health == "missing_bill")</strong><span>@FinanceText["MissingBill"]</span></div>
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@(!IsListLoading && string.IsNullOrWhiteSpace(ListErrorMessage) && FilteredSubscriptions.Count == 0)"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="@FinanceText["LoadingSubscriptions"]"
                    LoadingMessage="@FinanceText["LoadingSubscriptionsHelp"]"
                    EmptyTitle="@FinanceText["NoSupplierSubscriptions"]"
                    EmptyMessage="@FinanceText["NoSupplierSubscriptionsHelp"]"
                    OnRetry="@ReloadAsync">
                    <div class="subscription-list" role="list">
                        @foreach (var subscription in FilteredSubscriptions)
                        {
                            <button type="button" class="subscription-row @(SelectedSubscription?.Id == subscription.Id ? "is-selected" : string.Empty)" aria-pressed="@(SelectedSubscription?.Id == subscription.Id)" @onclick="() => SelectSubscriptionAsync(subscription.Id)">
                                <span class="subscription-row__icon" aria-hidden="true">@Initials(subscription.SupplierName)</span>
                                <span class="subscription-row__main">
                                    <strong>@subscription.Name</strong>
                                    <span>@subscription.SupplierName</span>
                                    <small>@subscription.HealthMessage</small>
                                </span>
                                <span class="subscription-row__meta">
                                    <span class="subscription-badge subscription-badge--@Tone(subscription.Health)">@Label(subscription.Health)</span>
                                    <strong>@FormatMoney(subscription.ExpectedAmount, subscription.Currency)</strong>
                                    <small>@FinanceText["CadenceNextDate", Label(subscription.Cadence), FormatDate(subscription.NextExpectedBillDateUtc)]</small>
                                </span>
                            </button>
                        }
                    </div>
                </FinanceDataState>
            </article>

            <aside class="subscription-detail-panel">
                @if (IsDetailLoading)
                {
                    <FinanceLoadingState Title="@FinanceText["OpeningSubscription"]" Message="@FinanceText["OpeningSubscriptionHelp"]" />
                }
                else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                {
                    <FinanceErrorState Title="@FinanceText["SubscriptionUnavailable"]" Message="@DetailErrorMessage" RetryText="@FinanceText["Retry"]" OnRetry="@ReloadAsync" />
                }
                else if (IsEditing)
                {
                    <EditForm Model="Form" OnValidSubmit="SaveAsync" class="subscription-form">
                        <DataAnnotationsValidator />
                        <div class="subscription-detail-header">
                            <div>
                                <span class="dashboard-kicker">@FinanceText["Agreement"]</span>
                                <h2>@FinanceText[EditingSubscriptionId.HasValue ? "EditSupplierSubscription" : "AddSupplierSubscription"]</h2>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">@FinanceText["Cancel"]</button>
                        </div>

                        <ValidationSummary />
                        @if (!string.IsNullOrWhiteSpace(FormErrorMessage))
                        {
                            <p class="subscription-message subscription-message--danger" role="alert">@FormErrorMessage</p>
                        }

                        <div class="subscription-form-grid">
                            <label>@FinanceText["Name"]<input class="form-control" @bind="Form.Name" /></label>
                            <div class="subscription-supplier-picker">
                                <label for="subscription-supplier-search">@FinanceText["Supplier"]</label>
                                <div class="subscription-supplier-picker__control">
                                    <input id="subscription-supplier-search" class="form-control" placeholder="@FinanceText["SearchSuppliers"]" autocomplete="off" @bind="SupplierSearchText" @bind:event="oninput" @onfocus="ShowSupplierPicker" disabled="@IsSuppliersLoading" />
                                    @if (Form.CounterpartyId != Guid.Empty)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSupplier">@FinanceText["Clear"]</button>
                                    }
                                </div>
                                @if (SelectedSupplier is not null)
                                {
                                    <div class="subscription-supplier-picker__selected">
                                        <span class="subscription-row__icon" aria-hidden="true">@Initials(SelectedSupplier.Name)</span>
                                        <div>
                                            <strong>@SelectedSupplier.Name</strong>
                                            <small>@SupplierMeta(SelectedSupplier)</small>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(SuppliersErrorMessage))
                                {
                                    <p class="subscription-message subscription-message--danger" role="alert">@SuppliersErrorMessage</p>
                                }
                                else if (IsSupplierPickerOpen)
                                {
                                    <div class="subscription-supplier-picker__menu" role="listbox" aria-label="@FinanceText["SupplierResults"]">
                                        @if (IsSuppliersLoading)
                                        {
                                            <p class="subscription-muted" role="status">@FinanceText["LoadingSuppliers"]</p>
                                        }
                                        else if (FilteredSupplierOptions.Count == 0)
                                        {
                                            <p class="subscription-muted">@FinanceText["NoSuppliersMatchSearch"]</p>
                                        }
                                        else
                                        {
                                            @foreach (var supplier in FilteredSupplierOptions)
                                            {
                                                <button type="button" class="subscription-supplier-option" role="option" aria-selected="@(supplier.Id == Form.CounterpartyId)" @onclick="() => SelectSupplier(supplier)">
                                                    <span class="subscription-row__icon" aria-hidden="true">@Initials(supplier.Name)</span>
                                                    <span>
                                                        <strong>@supplier.Name</strong>
                                                        <small>@SupplierMeta(supplier)</small>
                                                    </span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            <label>@FinanceText["Currency"]<input class="form-control" @bind="Form.Currency" /></label>
                            <label>@FinanceText["ExpectedAmount"]<input class="form-control" type="number" step="0.01" @bind="Form.ExpectedAmount" /></label>
                            <label>@FinanceText["Cadence"]<select class="form-select" @bind="Form.Cadence"><option value="monthly">@FinanceText["Monthly"]</option><option value="quarterly">@FinanceText["Quarterly"]</option><option value="yearly">@FinanceText["Yearly"]</option></select></label>
                            <label>@FinanceText["BillingDay"]<input class="form-control" type="number" min="1" max="31" @bind="Form.BillingDay" /></label>
                            <label>@FinanceText["StartDate"]<input class="form-control" type="date" @bind="Form.StartDate" /></label>
                            <label>@FinanceText["NextExpectedBill"]<input class="form-control" type="date" @bind="Form.NextExpectedBillDate" /></label>
                            <label>@FinanceText["AmountTolerance"]<input class="form-control" type="number" step="0.01" @bind="Form.AmountTolerance" /></label>
                            <label>@FinanceText["DateToleranceDays"]<input class="form-control" type="number" min="0" @bind="Form.DateToleranceDays" /></label>
                            <label>@FinanceText["NoticePeriodDays"]<input class="form-control" type="number" min="0" @bind="Form.NoticePeriodDays" /></label>
                            <label>@FinanceText["ContractReference"]<input class="form-control" @bind="Form.ContractReference" /></label>
                        </div>
                        <label>@FinanceText["Description"]<textarea class="form-control" rows="3" @bind="Form.Description"></textarea></label>
                        <label class="subscription-check"><input type="checkbox" @bind="Form.AutoRenews" /> @FinanceText["AutoRenews"]</label>
                        <button type="submit" class="btn btn-primary" disabled="@IsSaving">@FinanceText[IsSaving ? "Saving" : "SaveSupplierSubscription"]</button>
                    </EditForm>
                }
                else if (SelectedSubscription is null)
                {
                    <div class="subscription-empty-detail">
                        <div aria-hidden="true">@FinanceText["LauraName"]</div>
                        <h2>@FinanceText["SelectSupplierSubscription"]</h2>
                        <p>@FinanceText["SelectSupplierSubscriptionHelp"]</p>
                    </div>
                }
                else
                {
                    <div class="subscription-detail">
                        <div class="subscription-detail-header">
                            <div>
                                <span class="subscription-badge subscription-badge--@Tone(SelectedSubscription.Health)">@Label(SelectedSubscription.Health)</span>
                                <h2>@SelectedSubscription.Name</h2>
                                <p>@SelectedSubscription.SupplierName</p>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartEdit">@FinanceText["Edit"]</button>
                        </div>

                        <dl class="subscription-terms">
                            <div><dt>@FinanceText["ExpectedAmount"]</dt><dd>@FormatMoney(SelectedSubscription.ExpectedAmount, SelectedSubscription.Currency)</dd></div>
                            <div><dt>@FinanceText["Cadence"]</dt><dd>@Label(SelectedSubscription.Cadence)</dd></div>
                            <div><dt>@FinanceText["NextExpectedBill"]</dt><dd>@FormatDate(SelectedSubscription.NextExpectedBillDateUtc)</dd></div>
                            <div><dt>@FinanceText["AmountTolerance"]</dt><dd>@FormatMoney(SelectedSubscription.AmountTolerance, SelectedSubscription.Currency)</dd></div>
                            <div><dt>@FinanceText["DateTolerance"]</dt><dd>@FinanceText["DaysValue", SelectedSubscription.DateToleranceDays]</dd></div>
                            <div><dt>@FinanceText["Status"]</dt><dd>@Label(SelectedSubscription.Status)</dd></div>
                        </dl>

                        @if (SelectedSubscription.SourceEvidence is not null)
                        {
                            <section class="subscription-source-evidence" aria-label="@FinanceText["SourceAgreementEvidence"]">
                                <div>
                                    <span class="dashboard-kicker">@FinanceText["SourceAgreement"]</span>
                                    <h3>@(SelectedSubscription.SourceEvidence.SourceAttachmentName ?? SelectedSubscription.SourceEvidence.SourceSubject ?? FinanceText["InboxAgreementEvidence"])</h3>
                                    <p>@SelectedSubscription.SourceEvidence.EvidenceSummary</p>
                                </div>
                                <dl class="subscription-terms subscription-terms--compact">
                                    <div><dt>@FinanceText["ReviewStatus"]</dt><dd>@Label(SelectedSubscription.SourceEvidence.Status)</dd></div>
                                    <div><dt>@FinanceText["Reviewed"]</dt><dd>@FormatOptionalDate(SelectedSubscription.SourceEvidence.DecidedUtc)</dd></div>
                                    <div><dt>@FinanceText["Decision"]</dt><dd>@(SelectedSubscription.SourceEvidence.DecisionReason ?? FinanceText["AcceptedIntoDraftSubscription"])</dd></div>
                                    <div><dt>@FinanceText["Created"]</dt><dd>@FormatDate(SelectedSubscription.SourceEvidence.CreatedUtc)</dd></div>
                                </dl>
                            </section>
                        }

                        <div class="subscription-actions">
                            @foreach (var action in AvailableLifecycleActions)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@IsLifecycleSubmitting" @onclick="() => ChangeStatusAsync(action.Value)">@Label(action.Value)</button>
                            }
                        </div>

                        <section class="subscription-match-section">
                            <h3>@FinanceText["SuggestedBillMatches"]</h3>
                            @if (ReviewMatches.Count == 0)
                            {
                                <p class="subscription-muted">@FinanceText["NoSuggestedMatchesNeedReview"]</p>
                            }
                            else
                            {
                                @foreach (var match in ReviewMatches)
                                {
                                    <div class="subscription-match-card">
                                        <div>
                                            <strong>@(string.IsNullOrWhiteSpace(match.BillNumber) ? FinanceText["SupplierBill"] : match.BillNumber)</strong>
                                            <p>@match.EvidenceSummary</p>
                                            <small>@FinanceText["AmountForDate", FormatMoney(match.ActualAmount, match.Currency), FormatDate(match.ExpectedBillDateUtc)]</small>
                                        </div>
                                        <div class="subscription-match-actions">
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@IsMatchSubmitting" @onclick="() => DecideMatchAsync(match.Id, true)">@FinanceText["ConfirmMatch"]</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@IsMatchSubmitting" @onclick="() => DecideMatchAsync(match.Id, false)">@FinanceText["Reject"]</button>
                                        </div>
                                    </div>
                                }
                            }
                        </section>

                        <section class="subscription-match-section">
                            <h3>@FinanceText["BillHistory"]</h3>
                            @if (SelectedSubscription.Matches.Count == 0)
                            {
                                <p class="subscription-muted">@FinanceText["NoBillEvidenceLinked"]</p>
                            }
                            else
                            {
                                <div class="subscription-history-list">
                                    @foreach (var match in SelectedSubscription.Matches.Take(8))
                                    {
                                        <div><span class="subscription-badge subscription-badge--@Tone(match.Status)">@Label(match.Status)</span><strong>@(string.IsNullOrWhiteSpace(match.BillNumber) ? FinanceText["SupplierBill"] : match.BillNumber)</strong><small>@FinanceText["DateRange", FormatDate(match.PeriodStartUtc), FormatDate(match.PeriodEndUtc)]</small></div>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                }
            </aside>
        </div>
    </section>
</FinancePageLayout>


