@page "/finance/bills"
@page "/finance/supplier-bills"
@page "/finance/bills/{BillId:guid}"
@page "/finance/supplier-bills/{BillId:guid}"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["SupplierBills"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["SupplierBills"]"
    Description="@FinanceText["SupplierBillsDescription"]"
    LoadingMessage="@FinanceText["LoadingBills"]"
    ShowShellHeader="false"
    ShowShellNavigation="false">
    <section class="bills-dashboard" aria-labelledby="bills-heading">
        <div class="finance-overview-header">
            <div>
                <span class="finance-overview-kicker">@FinanceText["FinanceModule"]</span>
                <h1 id="bills-heading" class="finance-overview-title">@FinanceText["SupplierBills"]</h1>
                <p class="finance-overview-subtitle">@FinanceText["SupplierBillsDescription"]</p>
            </div>
            <div class="finance-overview-header__actions">
                <a class="btn finance-overview-button finance-overview-button--primary" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Home, AccessState.CompanyId)">@FinanceText["FinanceOverview"]</a>
                <a class="btn finance-overview-button finance-overview-button--secondary" href="@DashboardHref">@FinanceText["CompanyDashboard"]</a>
            </div>
        </div>

        <FinanceSectionNav CompanyId="@AccessState.CompanyId!.Value" MembershipRole="@AccessState.MembershipRole" />

        <div class="finance-subtab-nav" aria-label="@FinanceText["SupplierBillSections"]">
            <a class="finance-subtab-nav__link active" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.SupplierBills, AccessState.CompanyId)">@FinanceText["Bills"]</a>
            <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.SupplierBillsReview, AccessState.CompanyId)">@FinanceText["Review"]</a>
        </div>

        <div class="bills-layout">
            <article class="bill-list-card">
                <div class="bill-list-card__header">
                    <div>
                        <h2>@FinanceText["BillList"]</h2>
                        <p>@FinanceText["BillListDescription"]</p>
                    </div>
                    <span>@CommonText[FilteredBills.Count == 1 ? "ItemCountOne" : "ItemCountMany", FilteredBills.Count]</span>
                </div>

                <div class="bill-filter-bar" aria-label="@FinanceText["BillFilters"]">
                    @foreach (var filter in BillFilters)
                    {
                        <button
                            type="button"
                            class="@($"bill-filter-pill {(filter.IsActive ? "is-active" : string.Empty)}")"
                            @onclick="() => SetBillFilter(filter.Value)">
                            <span>@filter.Label</span>
                            <strong>@filter.Count</strong>
                        </button>
                    }
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@IsListEmpty"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="@FinanceText["LoadingBills"]"
                    LoadingMessage="@FinanceText["FetchingBills"]"
                    EmptyTitle="@FinanceText["NoBills"]"
                    EmptyMessage="@FinanceText["NoBillsDescription"]"
                    OnRetry="@ReloadAsync">
                    <div class="bill-list">
                        @foreach (var bill in BillItems)
                        {
                            <a class="@($"bill-list-item {(bill.IsSelected ? "is-selected" : string.Empty)}")" href="@BuildBillHref(bill.Id)">
                                <span class="@($"bill-list-item__icon bill-tone--{bill.IconTone}")" aria-hidden="true">bill</span>
                                <span class="bill-list-item__main">
                                    <strong>@bill.DisplayBillNumber</strong>
                                    <span>@bill.DisplaySupplierName</span>
                                    <small>@bill.DateSummary</small>
                                </span>
                                <span class="bill-list-item__meta">
                                    <strong>@bill.DisplayAmount</strong>
                                    <span class="@($"bill-status-badge bill-status-badge--{bill.StatusTone}")">@bill.FriendlyStatusLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(bill.ReviewBadgeLabel))
                                    {
                                        <span class="@($"bill-status-badge bill-status-badge--{bill.ReviewBadgeTone}")">@bill.ReviewBadgeLabel</span>
                                    }
                                </span>
                                <span class="bill-list-item__chevron" aria-hidden="true">›</span>
                            </a>
                        }
                    </div>
                </FinanceDataState>
            </article>

            <aside class="bill-detail-card">
                @if (IsDetailLoading)
                {
                    <FinanceLoadingState Title="@FinanceText["LoadingBillDetail"]" Message="@FinanceText["OpeningBill"]" />
                }
                else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                {
                    <FinanceErrorState Title="@FinanceText["BillDetailUnavailable"]" Message="@(DetailErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@ReloadAsync" />
                }
                else if (SelectedBill is null)
                {
                    <div class="bill-detail-empty">
                        <div class="bill-detail-empty__icon" aria-hidden="true">doc</div>
                        <h2>@FinanceText["NoBillSelected"]</h2>
                        <p>@FinanceText["SelectBill"]</p>
                    </div>
                }
                else if (SelectedBillDisplay is { } detail)
                {
                    <div class="bill-detail-panel">
                        <div class="bill-detail-panel__header">
                            <div>
                                <h2>@detail.DisplayBillNumber</h2>
                                <p>@detail.DisplaySupplierName</p>
                            </div>
                            <div class="bill-detail-panel__badges">
                                <span class="@($"bill-status-badge bill-status-badge--{detail.StatusTone}")">@detail.FriendlyStatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(detail.ReviewBadgeLabel))
                                {
                                    <span class="@($"bill-status-badge bill-status-badge--{detail.ReviewBadgeTone}")">@detail.ReviewBadgeLabel</span>
                                }
                            </div>
                        </div>

                        <div class="bill-detail-panel__amount">@detail.DisplayAmount</div>

                        <dl class="bill-detail-list">
                            <div><dt>@FinanceText["Supplier"]</dt><dd>@detail.DisplaySupplierName</dd></div>
                            <div><dt>@FinanceText["ReceivedDate"]</dt><dd>@detail.DisplayReceivedDate</dd></div>
                            <div><dt>@FinanceText["DueDate"]</dt><dd>@detail.DisplayDueDate</dd></div>
                            <div><dt>@FinanceText["DocumentType"]</dt><dd>@detail.DocumentKindLabel</dd></div>
                            <div><dt>@FinanceText["LifecycleStatus"]</dt><dd>@detail.FriendlyStatusLabel</dd></div>
                            @if (detail.PaymentSummary is not null)
                            {
                                <div><dt>@FinanceText["PaymentDetails"]</dt><dd>@detail.PaymentSummary.Summary</dd></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detail.ReviewBadgeLabel))
                            {
                                <div><dt>@FinanceText["FlagStatus"]</dt><dd>@detail.ReviewBadgeLabel</dd></div>
                            }
                            <div><dt>@FinanceText["ApprovalStatus"]</dt><dd>@detail.ApprovalStatus</dd></div>
                        </dl>

                        @{ var progress = BuildSupplierBillProgress(detail); }
                        <SupplierBillProgressFlow Progress="@progress">
                            <CurrentStepContent>
                                @switch (progress.CurrentStepKey)
                                {
                                    case "checked":
                                    case "supplier":
                                    case "bill_approval":
                                        <p class="bill-progress-action-copy">Review the source invoice and confirm the extracted business details.</p>
                                        <a class="btn btn-primary" href="@BuildBillReviewHref()">Review supplier bill</a>
                                        break;
                                    case "fortnox":
                                        <p class="bill-progress-action-copy">@detail.DraftAction.Description</p>
                                        @if (detail.DraftAction.CanUpdate)
                                        {
                                            <button type="button" class="btn btn-secondary" disabled="@IsDraftUpdateSubmitting" @onclick="UpdateFortnoxDraftAsync">
                                                @(IsDraftUpdateSubmitting ? FinanceText["Working"] : FinanceText["UpdateFortnoxDraft"])
                                            </button>
                                        }
                                        @if (detail.DraftAction.CanBookkeep)
                                        {
                                            <button type="button" class="btn btn-primary" disabled="@IsDraftBookkeepingSubmitting" @onclick="BookkeepFortnoxDraftAsync">
                                                @(IsDraftBookkeepingSubmitting ? FinanceText["Working"] : FinanceText["BookkeepSupplierInvoice"])
                                            </button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(DraftActionMessage))
                                        {
                                            <p class="bill-detail-section__message">@DraftActionMessage</p>
                                        }
                                        break;
                                    case "payment_approval":
                                        @if (detail.PaymentProposal?.ApprovalRequestId is Guid paymentApprovalRequestId)
                                        {
                                            <SupplierBillPaymentApprovalCard
                                                CompanyId="@AccessState.CompanyId!.Value"
                                                ApprovalRequestId="@paymentApprovalRequestId"
                                                SupplierName="@detail.DisplaySupplierName"
                                                Amount="@detail.PaymentProposal.Amount"
                                                Currency="@detail.PaymentProposal.Currency"
                                                DueUtc="@detail.PaymentProposal.DueUtc"
                                                PaymentReference="@detail.PaymentProposal.PaymentReference"
                                                OnDecisionCompleted="@RefreshAfterPaymentApprovalAsync" />
                                        }
                                        else if (detail.CanRequestPaymentProposal)
                                        {
                                            <p class="bill-progress-action-copy">Laura will prepare the payment details and request the required approval. No payment is initiated at this stage.</p>
                                            <button type="button" class="btn btn-primary" disabled="@IsPaymentProposalSubmitting" @onclick="RequestPaymentProposalAsync">
                                                @(IsPaymentProposalSubmitting ? FinanceText["Sending"] : FinanceText["RequestPaymentApproval"])
                                            </button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(PaymentProposalMessage))
                                        {
                                            <p class="bill-detail-section__message">@PaymentProposalMessage</p>
                                        }
                                        break;
                                    case "payment_registration":
                                        @if (detail.PaymentProposal is { } currentProposal)
                                        {
                                            <dl class="bill-progress-action-details">
                                                <div><dt>@FinanceText["Amount"]</dt><dd>@currentProposal.DisplayAmount</dd></div>
                                                <div><dt>@FinanceText["DueDate"]</dt><dd>@currentProposal.DisplayDueDate</dd></div>
                                                <div><dt>@FinanceText["PaymentReference"]</dt><dd>@currentProposal.PaymentReference</dd></div>
                                            </dl>
                                            @if (currentProposal.CanRegisterPayment)
                                            {
                                                <button type="button" class="btn btn-primary" disabled="@IsPaymentExportSubmitting" @onclick='@(() => ExportPaymentInstructionAsync("register_payment"))'>
                                                    @(IsPaymentExportSubmitting ? FinanceText["Working"] : currentProposal.ExportActionLabel)
                                                </button>
                                            }
                                            @if (currentProposal.CanPreparePaymentFile)
                                            {
                                                <button type="button" class="btn btn-secondary" disabled="@IsPaymentExportSubmitting" @onclick='@(() => ExportPaymentInstructionAsync("prepare_payment_file"))'>
                                                    @(IsPaymentExportSubmitting ? FinanceText["Working"] : FinanceText["PreparePaymentFile"])
                                                </button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(currentProposal.ExportResponseSummary))
                                            {
                                                <p class="bill-progress-action-note">@currentProposal.ExportResponseSummary</p>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(PaymentExportMessage))
                                        {
                                            <p class="bill-detail-section__message">@PaymentExportMessage</p>
                                        }
                                        break;
                                    case "settled":
                                        <p class="bill-progress-action-copy">Payment is registered. Refresh reconciliation after the matching bank transaction appears.</p>
                                        @if (detail.Enrichment.CanReconcile)
                                        {
                                            <button type="button" class="btn btn-primary" disabled="@IsReconciliationSubmitting" @onclick="ReconcileSupplierInvoiceAsync">
                                                @(IsReconciliationSubmitting ? FinanceText["Working"] : FinanceText["RefreshReconciliation"])
                                            </button>
                                        }
                                        break;
                                }
                            </CurrentStepContent>
                        </SupplierBillProgressFlow>

                        <section class="bill-detail-section">
                            <h3>@FinanceText["FollowUp"]</h3>
                            <p>@detail.WarningSummary</p>
                        </section>

                        <section class="bill-detail-section">
                            <div class="bill-detail-section__header">
                                <h3>@FinanceText["LauraEnrichment"]</h3>
                                <span class="@($"bill-status-badge bill-status-badge--{detail.Enrichment.StatusTone}")">@detail.Enrichment.StatusLabel</span>
                            </div>
                            <p>@detail.Enrichment.Description</p>
                            @if (!string.IsNullOrWhiteSpace(detail.Enrichment.SuggestionSummary))
                            {
                                <p>@detail.Enrichment.SuggestionSummary</p>
                            }
                            @if (detail.Enrichment.SuggestionItems.Count > 0)
                            {
                                <ul class="bill-detail-list-simple">
                                    @foreach (var item in detail.Enrichment.SuggestionItems)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            @if (detail.Enrichment.WarningItems.Count > 0)
                            {
                                <div class="bill-risk-list">
                                    @foreach (var warning in detail.Enrichment.WarningItems)
                                    {
                                        <p>@warning</p>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detail.Enrichment.ProviderKey) ||
                                 detail.Enrichment.RequestedUtc is not null ||
                                 detail.Enrichment.ApprovedUtc is not null ||
                                 detail.Enrichment.SyncedUtc is not null)
                            {
                                <dl class="bill-detail-list bill-source-detail-list">
                                    @if (!string.IsNullOrWhiteSpace(detail.Enrichment.ProviderKey))
                                    {
                                        <div><dt>@FinanceText["Provider"]</dt><dd>@detail.Enrichment.ProviderKey</dd></div>
                                    }
                                    @if (detail.Enrichment.RequestedUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Requested"]</dt><dd>@FormatFriendlyDate(detail.Enrichment.RequestedUtc.Value)</dd></div>
                                    }
                                    @if (detail.Enrichment.ApprovedUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Approved"]</dt><dd>@FormatFriendlyDate(detail.Enrichment.ApprovedUtc.Value)</dd></div>
                                    }
                                    @if (detail.Enrichment.SyncedUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Synced"]</dt><dd>@FormatFriendlyDate(detail.Enrichment.SyncedUtc.Value)</dd></div>
                                    }
                                </dl>
                            }
                            @if (!string.IsNullOrWhiteSpace(EnrichmentMessage))
                            {
                                <p class="bill-detail-section__message">@EnrichmentMessage</p>
                            }
                        </section>

                        <section class="bill-detail-section">
                            <div class="bill-detail-section__header">
                                <h3>@FinanceText["PaymentProposal"]</h3>
                                @if (detail.PaymentProposal is not null)
                                {
                                    <span class="@($"bill-status-badge bill-status-badge--{detail.PaymentProposal.StatusTone}")">@detail.PaymentProposal.StatusLabel</span>
                                }
                            </div>

                            @if (detail.PaymentProposal is { } proposal)
                            {
                                <p>@proposal.Description</p>
                                <dl class="bill-detail-list bill-source-detail-list">
                                    <div><dt>@FinanceText["Amount"]</dt><dd>@proposal.DisplayAmount</dd></div>
                                    <div><dt>@FinanceText["DueDate"]</dt><dd>@proposal.DisplayDueDate</dd></div>
                                    <div><dt>@FinanceText["PaymentReference"]</dt><dd>@proposal.PaymentReference</dd></div>
                                </dl>

                            }
                            else if (detail.CanRequestPaymentProposal)
                            {
                                <p>Payment approval has not started. Use the current workflow step above to continue.</p>
                            }
                            else
                            {
                                <p>@FinanceText["PaymentProposalIneligible"]</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(PaymentProposalMessage))
                            {
                                <p class="bill-detail-section__message">@PaymentProposalMessage</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(PaymentExportMessage))
                            {
                                <p class="bill-detail-section__message">@PaymentExportMessage</p>
                            }
                        </section>

                        <section class="bill-detail-section">
                            <div class="bill-detail-section__header">
                                <h3>@FinanceText["FortnoxDraft"]</h3>
                                <span class="@($"bill-status-badge bill-status-badge--{detail.DraftAction.StatusTone}")">@detail.DraftAction.StatusLabel</span>
                            </div>
                            <p>@detail.DraftAction.Description</p>
                            <div class="bill-paid-expense-status">
                                <div class="bill-detail-section__header">
                                    <h4>@FinanceText["ExpensePosting"]</h4>
                                    <span class="@($"bill-status-badge bill-status-badge--{detail.PaidExpensePosting.StatusTone}")">@detail.PaidExpensePosting.StatusLabel</span>
                                </div>
                                <p>@detail.PaidExpensePosting.Message</p>
                                @if (!string.IsNullOrWhiteSpace(detail.PaidExpensePosting.AccountCode))
                                {
                                    <dl class="bill-detail-list bill-source-detail-list">
                                        <div><dt>@FinanceText["ExpenseAccount"]</dt><dd>@detail.PaidExpensePosting.AccountCode</dd></div>
                                    </dl>
                                }
                                @if (detail.PaidExpensePosting.CanPost)
                                {
                                    <div class="bill-action-row">
                                        <button
                                            type="button"
                                            class="btn btn-primary"
                                            disabled="@IsPaidExpensePostingSubmitting"
                                            @onclick="PostPaidSupplierBillExpenseAsync">
                                            @(IsPaidExpensePostingSubmitting ? FinanceText["Working"] : FinanceText["AskLauraPostExpense"])
                                        </button>
                                    </div>
                                }
                                else if (detail.PaidExpensePosting.BlockingReasons.Count > 1)
                                {
                                    <ul class="bill-detail-list-simple">
                                        @foreach (var reason in detail.PaidExpensePosting.BlockingReasons)
                                        {
                                            <li>@reason</li>
                                        }
                                    </ul>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(detail.DraftAction.ProviderKey) ||
                                 detail.DraftAction.RequestedUtc is not null ||
                                 detail.DraftAction.UpdatedInProviderUtc is not null ||
                                 detail.DraftAction.BookedUtc is not null)
                            {
                                <dl class="bill-detail-list bill-source-detail-list">
                                    @if (!string.IsNullOrWhiteSpace(detail.DraftAction.ProviderKey))
                                    {
                                        <div><dt>@FinanceText["Provider"]</dt><dd>@detail.DraftAction.ProviderKey</dd></div>
                                    }
                                    @if (detail.DraftAction.RequestedUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Requested"]</dt><dd>@FormatFriendlyDate(detail.DraftAction.RequestedUtc.Value)</dd></div>
                                    }
                                    @if (detail.DraftAction.UpdatedInProviderUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Updated"]</dt><dd>@FormatFriendlyDate(detail.DraftAction.UpdatedInProviderUtc.Value)</dd></div>
                                    }
                                    @if (detail.DraftAction.BookedUtc is not null)
                                    {
                                        <div><dt>@FinanceText["Booked"]</dt><dd>@FormatFriendlyDate(detail.DraftAction.BookedUtc.Value)</dd></div>
                                    }
                                </dl>
                            }
                            @if (!string.IsNullOrWhiteSpace(DraftActionMessage))
                            {
                                <p class="bill-detail-section__message">@DraftActionMessage</p>
                            }
                        </section>

                        <section class="bill-detail-section">
                            <div class="bill-detail-section__header">
                                <h3>@FinanceText["Corrections"]</h3>
                            </div>

                            <div class="bill-payment-export-action">
                                <div class="bill-detail-section__header">
                                    <h4>@FinanceText["Cancellation"]</h4>
                                    <span class="@($"bill-status-badge bill-status-badge--{detail.Corrections.CancellationStatusTone}")">@detail.Corrections.CancellationStatusLabel</span>
                                </div>
                                <p>@detail.Corrections.CancellationDescription</p>
                                @if (detail.Corrections.CanCancel)
                                {
                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        disabled="@IsCancellationSubmitting"
                                        @onclick="CancelSupplierInvoiceAsync">
                                        @(IsCancellationSubmitting ? FinanceText["Working"] : FinanceText["CancelSupplierInvoice"])
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(detail.Corrections.CancellationProviderKey) ||
                                     detail.Corrections.CancellationRequestedUtc is not null ||
                                     detail.Corrections.CancellationApprovedUtc is not null ||
                                     detail.Corrections.CancellationCompletedUtc is not null)
                                {
                                    <dl class="bill-detail-list bill-source-detail-list">
                                        @if (!string.IsNullOrWhiteSpace(detail.Corrections.CancellationProviderKey))
                                        {
                                            <div><dt>@FinanceText["Provider"]</dt><dd>@detail.Corrections.CancellationProviderKey</dd></div>
                                        }
                                        @if (detail.Corrections.CancellationRequestedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Requested"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CancellationRequestedUtc.Value)</dd></div>
                                        }
                                        @if (detail.Corrections.CancellationApprovedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Approved"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CancellationApprovedUtc.Value)</dd></div>
                                        }
                                        @if (detail.Corrections.CancellationCompletedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Completed"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CancellationCompletedUtc.Value)</dd></div>
                                        }
                                    </dl>
                                }
                            </div>

                            <div class="bill-payment-export-action">
                                <div class="bill-detail-section__header">
                                    <h4>@FinanceText["CreditNote"]</h4>
                                    <span class="@($"bill-status-badge bill-status-badge--{detail.Corrections.CreditNoteStatusTone}")">@detail.Corrections.CreditNoteStatusLabel</span>
                                </div>
                                <p>@detail.Corrections.CreditNoteDescription</p>
                                @if (detail.Corrections.CanCreateCreditNote)
                                {
                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        disabled="@IsCreditNoteSubmitting"
                                        @onclick="CreateSupplierCreditNoteAsync">
                                        @(IsCreditNoteSubmitting ? FinanceText["Working"] : FinanceText["CreateSupplierCreditNote"])
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(detail.Corrections.CreditNoteProviderKey) ||
                                     detail.Corrections.CreditNoteRequestedUtc is not null ||
                                     detail.Corrections.CreditNoteApprovedUtc is not null ||
                                     detail.Corrections.CreditNoteCompletedUtc is not null ||
                                     !string.IsNullOrWhiteSpace(detail.Corrections.ProviderCreditNoteNumber))
                                {
                                    <dl class="bill-detail-list bill-source-detail-list">
                                        @if (!string.IsNullOrWhiteSpace(detail.Corrections.CreditNoteProviderKey))
                                        {
                                            <div><dt>@FinanceText["Provider"]</dt><dd>@detail.Corrections.CreditNoteProviderKey</dd></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(detail.Corrections.ProviderCreditNoteNumber))
                                        {
                                            <div><dt>@FinanceText["CreditNote"]</dt><dd>@detail.Corrections.ProviderCreditNoteNumber</dd></div>
                                        }
                                        @if (detail.Corrections.CreditNoteRequestedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Requested"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CreditNoteRequestedUtc.Value)</dd></div>
                                        }
                                        @if (detail.Corrections.CreditNoteApprovedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Approved"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CreditNoteApprovedUtc.Value)</dd></div>
                                        }
                                        @if (detail.Corrections.CreditNoteCompletedUtc is not null)
                                        {
                                            <div><dt>@FinanceText["Completed"]</dt><dd>@FormatFriendlyDate(detail.Corrections.CreditNoteCompletedUtc.Value)</dd></div>
                                        }
                                    </dl>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(CorrectionActionMessage))
                            {
                                <p class="bill-detail-section__message">@CorrectionActionMessage</p>
                            }
                        </section>

                        <section class="bill-detail-section">
                            <h3>@FinanceText["RelatedTransactions"]</h3>
                            @if (detail.RelatedTransactions.Count == 0)
                            {
                                <p>@FinanceText["NoRelatedTransactions"]</p>
                            }
                            else
                            {
                                <div class="bill-related-transactions">
                                    @foreach (var transaction in detail.RelatedTransactions)
                                    {
                                        <a class="bill-related-transaction" href="@BuildTransactionHref(transaction.Id)">
                                            <span class="@($"bill-status-badge bill-status-badge--{transaction.TypeTone}")">@transaction.TypeLabel</span>
                                            <span>
                                                <strong>@transaction.Description</strong>
                                                <small>@transaction.DisplayDate - @transaction.CategoryLabel - @transaction.ExternalReference</small>
                                            </span>
                                            <strong>@transaction.DisplayAmount</strong>
                                        </a>
                                    }
                                </div>
                            }
                        </section>

                        @if (detail.SourceDetails.Count > 0)
                        {
                            <section class="bill-detail-section">
                                <h3>@FinanceText["SourceDetails"]</h3>
                                <dl class="bill-detail-list bill-source-detail-list">
                                    @foreach (var sourceDetail in detail.SourceDetails)
                                    {
                                        <div><dt>@sourceDetail.Label</dt><dd>@sourceDetail.Value</dd></div>
                                    }
                                </dl>
                            </section>
                        }
                    </div>

                    <section class="bill-detail-section">
                        <h3>@FinanceText["LinkedDocument"]</h3>
                    <FinanceLinkedResourceState
                        Availability="@SelectedBill.LinkedDocument.Availability"
                        Message="@SelectedBill.LinkedDocument.Message"
                        ResourceTitle="@SelectedBill.LinkedDocument.Document?.Title"
                        SecondaryText="@SelectedBill.LinkedDocument.Document?.OriginalFileName"
                        TypeText="@SelectedBill.LinkedDocument.Document?.ContentType"
                        CanNavigate="@SelectedBill.LinkedDocument.CanNavigate"
                        NavigateHref="@(SelectedBill.LinkedDocument.Document is null ? null : BuildDocumentHref(SelectedBill.LinkedDocument.Document.Id))"
                        ActionText="@FinanceText["OpenLinkedDocument"]" />
                    </section>

                    <section class="bill-detail-section">
                        <div class="bill-detail-section__header">
                            <h3>@FinanceText["SourceDocumentAttachment"]</h3>
                            <span class="@($"bill-status-badge bill-status-badge--{detail.SourceDocumentAttachment.StatusTone}")">@detail.SourceDocumentAttachment.StatusLabel</span>
                        </div>
                        <p>@detail.SourceDocumentAttachment.Description</p>
                        @if (detail.SourceDocumentAttachment.CanAttach)
                        {
                            <button
                                type="button"
                                class="btn btn-primary"
                                disabled="@IsSourceDocumentAttachmentSubmitting"
                                @onclick="AttachSourceDocumentAsync">
                                @(IsSourceDocumentAttachmentSubmitting ? FinanceText["Working"] : FinanceText["AttachSourceDocument"])
                            </button>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.SourceDocumentAttachment.ProviderKey) ||
                             detail.SourceDocumentAttachment.RequestedUtc is not null ||
                             detail.SourceDocumentAttachment.AttachedUtc is not null)
                        {
                            <dl class="bill-detail-list bill-source-detail-list">
                                @if (!string.IsNullOrWhiteSpace(detail.SourceDocumentAttachment.ProviderKey))
                                {
                                    <div><dt>@FinanceText["Provider"]</dt><dd>@detail.SourceDocumentAttachment.ProviderKey</dd></div>
                                }
                                @if (detail.SourceDocumentAttachment.RequestedUtc is not null)
                                {
                                    <div><dt>@FinanceText["Requested"]</dt><dd>@FormatFriendlyDate(detail.SourceDocumentAttachment.RequestedUtc.Value)</dd></div>
                                }
                                @if (detail.SourceDocumentAttachment.AttachedUtc is not null)
                                {
                                    <div><dt>@FinanceText["Attached"]</dt><dd>@FormatFriendlyDate(detail.SourceDocumentAttachment.AttachedUtc.Value)</dd></div>
                                }
                            </dl>
                        }
                        @if (!string.IsNullOrWhiteSpace(SourceDocumentAttachmentMessage))
                        {
                            <p class="bill-detail-section__message">@SourceDocumentAttachmentMessage</p>
                        }
                    </section>

                    <AgentInsightsPanel
                        Title="@FinanceText["AgentInsights"]"
                        Subtitle="@FinanceText["BillAgentInsightsSubtitle"]"
                        EmptyMessage="@FinanceText["NoBillAgentInsights"]"
                        TestId="bill-agent-insights-panel"
                        Items="@SelectedBill.AgentInsights" />
                }
            </aside>
        </div>
    </section>
</FinancePageLayout>
