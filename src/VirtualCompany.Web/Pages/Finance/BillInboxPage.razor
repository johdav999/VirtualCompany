@page "/finance/bill-inbox"
@page "/finance/supplier-bills/review"
@inherits FinancePageBase

<PageTitle>@FinanceText["SupplierBillReview"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["SupplierBills"]"
    Description="@FinanceText["SupplierBillReviewListDescription"]"
    LoadingMessage="@FinanceText["LoadingSupplierBillReview"]">
    <div class="finance-subtab-nav mb-3" aria-label="@FinanceText["SupplierBillSections"]">
        <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.SupplierBills, AccessState.CompanyId)">@FinanceText["Bills"]</a>
        <a class="finance-subtab-nav__link active" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.SupplierBillsReview, AccessState.CompanyId)">@FinanceText["Review"]</a>
    </div>

    <div class="wizard-card wizard-card--compact">
        <div class="d-flex justify-content-between gap-3 align-items-center mb-3">
            <div>
                <h2 class="h5 mb-1">@FinanceText["Review"]</h2>
                <p class="text-body-secondary mb-0">@FinanceText["ReviewItemsDescription"]</p>
            </div>
            <span class="badge text-bg-light">@CommonText[Items.Count == 1 ? "ItemCountOne" : "ItemCountMany", Items.Count]</span>
        </div>

        <FinanceDataState
            IsLoading="@IsListLoading"
            IsEmpty="@IsListEmpty"
            ErrorMessage="@ListErrorMessage"
            LoadingTitle="@FinanceText["LoadingReviewItems"]"
            LoadingMessage="@FinanceText["FetchingReviewItems"]"
            EmptyTitle="@FinanceText["NoBillsNeedReview"]"
            EmptyMessage="@FinanceText["NoBillsNeedReviewDescription"]"
            OnRetry="@ReloadAsync">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@FinanceText["Bill"]</th>
                            <th>@FinanceText["Supplier"]</th>
                            <th>@FinanceText["Amount"]</th>
                            <th>@FinanceText["Status"]</th>
                            <th>@FinanceText["Confidence"]</th>
                            <th>@FinanceText["Warnings"]</th>
                            <th class="text-end">@FinanceText["Review"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.BillReference</strong>
                                    <div class="text-body-secondary small">@FormatDate(item.DetectedUtc)</div>
                                </td>
                                <td>@item.SupplierName</td>
                                <td>@FormatAmount(item.Amount, item.Currency)</td>
                                <td><span class="badge text-bg-light">@item.Status</span></td>
                                <td>@item.ConfidenceLevel</td>
                                <td>@FormatWarnings(item)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="@BuildDetailHref(item.Id)">@FinanceText["Open"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </FinanceDataState>
    </div>
</FinancePageLayout>
