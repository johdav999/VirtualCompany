@page "/system/admin/tool-registry"
@inherits FinanceTransparencyPageBase

<PageTitle>@FinanceText["ToolRegistry"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["ToolRegistry"]"
    Description="@FinanceText["ToolRegistryDescription"]"
    LoadingMessage="@FinanceText["LoadingToolRegistry"]"
    Area="SystemAdmin">
    @if (!HasTransparencyAccess)
    {
        <ForbiddenState
            Title="@FinanceText["SystemAccessRequired"]"
            Message="@FinanceText["SystemAccessRequiredMessage"]"
            ReturnHref="@BuildFinanceHomeHref()"
            ReturnText="@FinanceText["BackToFinance"]" />
    }
    else
    {
        <div class="wizard-card wizard-card--compact">
            <div class="d-flex justify-content-between gap-3 align-items-center mb-3">
                <div>
                            <h2 class="h5 mb-1">@FinanceText["ToolManifestRegistry"]</h2>
                    <p class="text-body-secondary mb-0">@(string.IsNullOrWhiteSpace(Summary) ? FinanceText["ToolManifestRegistrySummary"] : Summary)</p>
                </div>
                <span class="badge text-bg-light">@FinanceText["ItemCount", Items.Count]</span>
            </div>

            <FinanceDataState
                IsLoading="@IsListLoading"
                IsEmpty="@IsListEmpty"
                ErrorMessage="@ListErrorMessage"
                LoadingTitle="@FinanceText["LoadingFinanceToolManifests"]"
                LoadingMessage="@FinanceText["ResolvingFinanceToolManifests"]"
                EmptyTitle="@FinanceText["NoFinanceToolManifests"]"
                EmptyMessage="@FinanceText["NoFinanceToolManifestsMessage"]"
                ErrorTitle="@FinanceText["FinanceToolManifestsUnavailable"]"
                OnRetry="@ReloadAsync">
                <div class="table-responsive">
                    <table class="table finance-table mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@FinanceText["Tool"]</th>
                                <th scope="col">@FinanceText["Version"]</th>
                                <th scope="col">@FinanceText["VersionMetadata"]</th>
                                <th scope="col">@FinanceText["ContractSummary"]</th>
                                <th scope="col">@FinanceText["SchemaSummary"]</th>
                                <th scope="col">@FinanceText["ManifestSource"]</th>
                                <th scope="col">@FinanceText["ProviderAdapter"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Items)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold">@item.ToolName</td>
                                    <td class="text-nowrap">@item.Version</td>
                                    <td>@item.VersionMetadata</td>
                                    <td>@item.ContractSummary</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.SchemaSummary) ? item.ContractSummary : item.SchemaSummary)</td>
                                    <td>@FormatLabel(item.ManifestSource)</td>
                                    <td>
                                        <div>@FormatValue(item.ProviderAdapterName)</div>
                                        @if (!string.IsNullOrWhiteSpace(item.ProviderAdapterId))
                                        {
                                            <div class="small text-body-secondary">@item.ProviderAdapterId</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </FinanceDataState>
        </div>
    }
</FinancePageLayout>
