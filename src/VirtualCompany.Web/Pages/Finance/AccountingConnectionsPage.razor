@page "/finance/accounting/connections"
@inherits FinancePageBase

<PageTitle>@FinanceText["AccountingMigrationTitle"]</PageTitle>

<FinancePageLayout IsLoading="@IsLoading" AccessState="@AccessState" ErrorMessage="@ErrorMessage"
                   Title="@FinanceText["AccountingConnections"]"
                   Description="@FinanceText["AccountingConnectionsWorkspaceDescription"]"
                   LoadingMessage="@FinanceText["LoadingAccountingMigration"]">
    <AccountingNavigation CompanyId="@AccessState.CompanyId" />

    @if (!string.IsNullOrWhiteSpace(ActionMessage))
    {
        <div class="alert alert-success mt-3" role="status" tabindex="-1">@ActionMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(ActionError))
    {
        <div class="alert alert-danger mt-3" role="alert" tabindex="-1" data-testid="migration-connection-lost"><strong>@FinanceText["ActionCouldNotBeCompleted"]</strong><div>@ActionError</div><button class="btn btn-sm btn-outline-danger mt-2" @onclick="ReloadAsync">@FinanceText["TryAgain"]</button></div>
    }

    @if (SelectedSwitch is not null && AccessState.CompanyId is Guid workspaceCompanyId)
    {
        <AccountingMigrationWorkspace CompanyId="@workspaceCompanyId"
                                      Switch="@SelectedSwitch"
                                      Authority="@Authority"
                                      AllowedActions="@SwitchAllowedActions"
                                      Assessment="@Assessment"
                                      Completeness="@Completeness"
                                      Mappings="@Mappings"
                                      Rehearsal="@Rehearsal"
                                      PlanReadiness="@PlanReadiness"
                                      InternalReadiness="@InternalReadiness"
                                      Preparation="@Preparation"
                                      Transfer="@Transfer"
                                      Cutover="@SwitchCutover"
                                      Monitoring="@SwitchMonitoring"
                                      Operations="@SwitchOperations"
                                      FuturePeriodAvailable="@(EffectiveFiscalPeriodId != Guid.Empty)"
                                      Guidance="@Guidance"
                                      Recommendation="@Recommendation"
                                      AuditEvidence="@AuditEvidence"
                                      MonitoringEvidence="@MonitoringEvidence"
                                      PartialFailures="@PartialFailures"
                                      CanManage="@CanManageAccounting"
                                      IsActing="@IsActing"
                                      OnAction="@HandleMigrationActionAsync"
                                      OnAcceptMonitoringException="@AcceptMonitoringExceptionAsync" />
    }
    else
    {
        <section class="accounting-migration-empty-state" data-testid="no-active-accounting-migration">
            <div class="accounting-migration-empty-state__copy">
                <span class="dashboard-kicker">@FinanceText["AccountingMigrationKicker"]</span>
                <h2>@FinanceText["AccountingConnections"]</h2>
                <p>@(Authority?.Explanation ?? FinanceText["AccountingAuthorityNotConfigured"])</p>
                <div class="accounting-current-authority">
                    <span aria-hidden="true">@AuthorityIcon(Authority?.CurrentPeriod?.Authority ?? string.Empty)</span>
                    <div><small>@FinanceText["CurrentAuthority"]</small><strong>@CurrentAuthorityLabel</strong><em>@CurrentEffectivePeriod</em></div>
                </div>
            </div>
            <div class="accounting-migration-start-card">
                <header><div><h3>@FinanceText["StartGuidedMigration"]</h3><p>@FinanceText["StartGuidedMigrationDescription"]</p></div><span aria-hidden="true">→</span></header>
                @if (CanManageAccounting)
                {
                    <div class="accounting-migration-start-fields">
                        <label>@FinanceText["MoveAccountingTo"]
                            <select class="form-select" @bind="MigrationTarget">
                                <option value="internal">@FinanceText["VirtualCompanyBuiltInAccounting"]</option>
                                @foreach (var provider in Authority?.Providers ?? [])
                                {
                                    <option value="external:@provider.ProviderKey">@provider.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label>@FinanceText["EffectiveAccountingPeriod"]
                            <select class="form-select" @bind="EffectiveFiscalPeriodId">
                                @foreach (var period in AvailablePeriods)
                                {
                                    <option value="@period.Id">@period.Name · @period.StartDate.ToString("d")</option>
                                }
                            </select>
                        </label>
                        <label>@FinanceText["MigrationBoundary"]
                            <select class="form-select" @bind="MigrationStrategy">
                                <option value="opening_balances_and_open_items">@FinanceText["OpeningBalancesAndOpenItems"]</option>
                                <option value="current_fiscal_year">@FinanceText["CurrentFiscalYear"]</option>
                                <option value="full_history">@FinanceText["FullHistory"]</option>
                            </select>
                        </label>
                        <label>@FinanceText["ReasonForMigration"]
                            <textarea class="form-control" rows="2" @bind="MigrationReason"></textarea>
                        </label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="StartGuidedMigrationAsync" disabled="@(IsActing || EffectiveFiscalPeriodId == Guid.Empty)">@FinanceText["StartGuidedMigration"]</button>
                    @if (AvailablePeriods.Count == 0)
                    {
                        <p class="accounting-migration-start-warning">@FinanceText["FutureMonthlyPeriodRequired"]</p>
                    }
                }
                else
                {
                    <div class="accounting-view-only"><strong>@FinanceText["ViewOnlyMigrationAccess"]</strong><p>@FinanceText["ViewOnlyMigrationAccessDescription"]</p></div>
                }
            </div>
        </section>
    }

    <section class="accounting-connection-card accounting-provider-access mt-3" aria-labelledby="provider-access-heading">
        <header><div><h3 id="provider-access-heading">@FinanceText["ConnectedAccountingSystems"]</h3><p>@FinanceText["ConnectedAccountingSystemsDescription"]</p></div></header>
        <div class="accounting-provider-access-grid">
            @foreach (var provider in Authority?.Providers ?? [])
            {
                <article>
                    <span>@ProviderMark(provider.DisplayName)</span>
                    <div><strong>@provider.DisplayName</strong><small>@provider.ModeExplanation</small></div>
                    <em class="@(provider.IsConnected ? "status-badge status-badge-success" : "status-badge")">@(provider.IsConnected ? FinanceText["Connected"] : FinanceText["NotConnected"])</em>
                    <a class="btn btn-sm btn-outline-primary" href="@FinanceRoutes.BuildFinanceIntegrationSettingsPath(provider.ProviderKey, AccessState.CompanyId)">@FinanceText["ManageConnection"]</a>
                </article>
            }
        </div>
    </section>

    <section id="accounting-exports" class="accounting-connection-card accounting-export-card mt-3">
        <header><div><h3>@FinanceText["ExportAndReconciliation"]</h3><p>@FinanceText["ExportAndReconciliationDescription"]</p></div></header>
        @if (Authority?.Exports.Count > 0)
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>@FinanceText["Journal"]</th><th>@FinanceText["Period"]</th><th>@FinanceText["Provider"]</th><th>@FinanceText["Status"]</th><th>@FinanceText["LastUpdate"]</th><th><span class="visually-hidden">@FinanceText["Actions"]</span></th></tr></thead>
                    <tbody>
                    @foreach (var export in Authority.Exports)
                    {
                        <tr>
                            <td><strong>@export.JournalNumber</strong><small>@SourceLabel(export.SourceType)</small></td>
                            <td>@export.PostingDate.ToString("yyyy-MM")</td>
                            <td>@export.ProviderName</td>
                            <td><span class="@ExportBadge(export.Status)">@export.StatusLabel</span>@if (!string.IsNullOrWhiteSpace(export.SafeSummary)) { <small>@export.SafeSummary</small> }</td>
                            <td>@LocalDateTime.DateTime(export.UpdatedUtc)</td>
                            <td>
                                @if (CanManageAccounting && export.Status == "reconciliation_required")
                                {
                                    <div class="accounting-export-actions">
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ReconcileExportAsync(export, true)" disabled="@IsActing">@FinanceText["ConfirmExported"]</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReconcileExportAsync(export, false)" disabled="@IsActing">@FinanceText["ConfirmNotSent"]</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="accounting-connection-empty"><strong>@FinanceText["NoProviderExportsYet"]</strong><p>@FinanceText["NoProviderExportsYetDescription"]</p></div>
        }
    </section>

    @if (SelectedSwitch is null && CurrentCutover is not null)
    {
        <details class="accounting-legacy-cutover mt-3">
            <summary>@FinanceText["LegacyCutoverChecks"]</summary>
            <section class="accounting-connection-card accounting-cutover-card">
                <header><div><h3>@FinanceText["CutoverReadiness"]</h3><p>@FinanceText["LegacyCutoverDescription"]</p></div></header>
                @if (CanManageAccounting)
                {
                    <label><input type="checkbox" @bind="OpeningBalancesReconciled" /> <span>@FinanceText["OpeningBalances"]</span></label>
                    <label><input type="checkbox" @bind="TrialBalanceReconciled" /> <span>@FinanceText["TrialBalance"]</span></label>
                    <label><input type="checkbox" @bind="SourceMappingsReconciled" /> <span>@FinanceText["SourceMappings"]</span></label>
                    <label class="is-conflict"><span>@FinanceText["UnresolvedConflicts"]</span><input class="form-control" type="number" min="0" @bind="ConflictCount" /></label>
                    <textarea class="form-control" rows="3" @bind="CutoverSummary" aria-label="@FinanceText["CutoverValidationSummary"]"></textarea>
                    <button class="btn btn-outline-primary w-100" @onclick="SaveCutoverValidationAsync" disabled="@IsActing">@FinanceText["SaveReconciliationChecks"]</button>
                    <button class="btn btn-primary w-100" @onclick="CompleteCutoverAsync" disabled="@(!CurrentCutover.IsCutoverReady || IsActing)">@FinanceText["CompleteCutover"]</button>
                }
            </section>
        </details>
    }
</FinancePageLayout>
