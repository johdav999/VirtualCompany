@page "/finance/mailbox"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["FinanceMailbox"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["FinanceMailbox"]"
    Description="@FinanceText["FinanceMailboxDescription"]"
    LoadingMessage="@FinanceText["LoadingMailboxIntegration"]">
    <div class="wizard-card wizard-card--compact">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h2 class="h5 mb-1">@FinanceText["MailboxConnection"]</h2>
                <p class="text-body-secondary mb-0">
                    @FinanceText["MailboxConnectionDescription"]
                </p>
            </div>
            <button class="btn btn-outline-secondary" type="button" @onclick="ReloadAsync" disabled="@IsStatusLoading">@FinanceText["Refresh"]</button>
        </div>

        <FinanceDataState
            IsLoading="@IsStatusLoading"
            IsEmpty="false"
            ErrorMessage="@StatusErrorMessage"
            LoadingTitle="@FinanceText["LoadingMailboxStatus"]"
            LoadingMessage="@FinanceText["ReadingMailboxConnection"]"
            ErrorTitle="@FinanceText["MailboxStatusUnavailable"]"
            OnRetry="@ReloadAsync">
            <div class="row g-3">
                <div class="col-12 col-lg-4">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="small text-uppercase text-body-secondary fw-semibold mb-1">@FinanceText["Connection"]</div>
                        <div><span class="@ConnectionBadgeClass">@ConnectionStatusLabel</span></div>
                        @if (!string.IsNullOrWhiteSpace(Status?.LastErrorSummary))
                        {
                            <div class="small text-danger mt-2">@Status.LastErrorSummary</div>
                        }
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="small text-uppercase text-body-secondary fw-semibold mb-1">@FinanceText["Provider"]</div>
                        <div class="fw-semibold">@ProviderLabel</div>
                        <div class="small text-body-secondary mt-1">@MailboxLabel</div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="small text-uppercase text-body-secondary fw-semibold mb-1">@FinanceText["LastSuccessfulScan"]</div>
                        <div class="fw-semibold">@FormatDateTime(Status?.LastSuccessfulScanAtUtc)</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-semibold">Gmail</div>
                                <div class="small text-body-secondary">@FinanceText["GmailAvailability"]</div>
                            </div>
                            <span class="@GetProviderAvailabilityBadgeClass(ProviderAvailability?.Gmail)">@GmailProviderStatus</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-semibold">Microsoft 365</div>
                                <div class="small text-body-secondary">@FinanceText["Microsoft365Availability"]</div>
                            </div>
                            <span class="@GetProviderAvailabilityBadgeClass(ProviderAvailability?.Microsoft365)">@Microsoft365ProviderStatus</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <NavLink class="btn btn-primary" href="@BuildAgentMailboxSettingsHref()">
                    <span class="bi bi-gear" aria-hidden="true"></span>
                    @FinanceText["ManageMailboxConnection"]
                </NavLink>
                <button class="btn btn-outline-secondary" type="button" @onclick="TriggerScanAsync" disabled="@IsScanDisabled">
                    @(IsScanInFlight ? FinanceText["StartingScan"] : FinanceText["AskLauraScanAgain"])
                </button>
            </div>

            @if (!CanScan)
            {
                <div class="alert alert-warning mt-3 mb-0" role="status">
                    @FinanceText["ConnectMailboxBeforeScan"]
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(ProviderSetupMessage))
            {
                <div class="alert alert-warning mt-3 mb-0" role="status">
                    @ProviderSetupMessage
                    <NavLink href="@BuildAgentMailboxSettingsHref()" class="alert-link">@FinanceText["ManageMailboxSettings"]</NavLink>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ActionMessage))
            {
                <div class="alert alert-success mt-3 mb-0" role="status">@ActionMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(ActionErrorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@ActionErrorMessage</div>
            }
        </FinanceDataState>
    </div>

    <div class="wizard-card wizard-card--compact mt-4">
        <div class="d-flex justify-content-between gap-3 align-items-start mb-3">
            <div>
                <h2 class="h5 mb-1">@FinanceText["ScannedInbox"]</h2>
                <p class="text-body-secondary mb-0">@FinanceText["ScannedInboxDescription"]</p>
            </div>
        </div>

        <FinanceDataState
            IsLoading="@IsMessagesLoading"
            IsEmpty="@(ScannedMessages.Count == 0)"
            ErrorMessage="@MessagesErrorMessage"
            LoadingTitle="@FinanceText["LoadingScannedMessages"]"
            LoadingMessage="@FinanceText["ReadingMessageSnapshots"]"
            EmptyTitle="@FinanceText["NoReviewedMessages"]"
            EmptyMessage="@FinanceText["NoReviewedMessagesDescription"]"
            ErrorTitle="@FinanceText["ScannedMessagesUnavailable"]"
            OnRetry="@ReloadAsync">
            <div class="row g-3">
                <div class="col-12 col-xl-5">
                    <div class="list-group mailbox-message-list">
                        @foreach (var message in ScannedMessages)
                        {
                            var isSelected = SelectedMessage?.Id == message.Id;
                            <button type="button"
                                    class="list-group-item list-group-item-action @(isSelected ? "active" : null)"
                                    @onclick="@(() => SelectMessage(message))">
                                <div class="d-flex justify-content-between gap-3">
                                    <span class="fw-semibold text-truncate">@(!string.IsNullOrWhiteSpace(message.Subject) ? message.Subject : FinanceText["NoSubject"])</span>
                                    <span class="@GetDecisionBadgeClass(message) flex-shrink-0">@FormatDecisionLabel(message)</span>
                                </div>
                                <div class="small flex-shrink-0 @(isSelected ? "text-white-50" : "text-body-secondary")">@FormatDateTime(message.ReceivedUtc)</div>
                                <div class="small text-truncate @(isSelected ? "text-white-50" : "text-body-secondary")">@FormatSender(message)</div>
                                <div class="small text-truncate @(isSelected ? "text-white-50" : "text-body-secondary")">@message.ReasonSummary</div>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-12 col-xl-7">
                    @if (SelectedMessage is null)
                    {
                        <FinanceEmptyState Title="@FinanceText["NoMessageSelected"]" Message="@FinanceText["SelectFetchedEmail"]" />
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 h-100">
                            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                                <div>
                                    <div class="small text-uppercase text-body-secondary fw-semibold mb-1">@FinanceText["Subject"]</div>
                                    <h3 class="h6 mb-0">@(!string.IsNullOrWhiteSpace(SelectedMessage.Subject) ? SelectedMessage.Subject : FinanceText["NoSubject"])</h3>
                                </div>
                                <span class="@GetDecisionBadgeClass(SelectedMessage) align-self-start">@FormatDecisionLabel(SelectedMessage)</span>
                            </div>
                            <dl class="row small mb-3">
                                <dt class="col-sm-4">@FinanceText["From"]</dt>
                                <dd class="col-sm-8">@FormatSender(SelectedMessage)</dd>
                                <dt class="col-sm-4">@FinanceText["Received"]</dt>
                                <dd class="col-sm-8">@FormatDateTime(SelectedMessage.ReceivedUtc)</dd>
                                <dt class="col-sm-4">@FinanceText["Folder"]</dt>
                                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(SelectedMessage.FolderDisplayName) ? SelectedMessage.FolderDisplayName : FormatMailboxCode(SelectedMessage.FolderId))</dd>
                                <dt class="col-sm-4">@FinanceText["Source"]</dt>
                                <dd class="col-sm-8">@FormatMailboxCode(SelectedMessage.SourceType)</dd>
                                <dt class="col-sm-4">@FinanceText["Rules"]</dt>
                                <dd class="col-sm-8">@FormatRules(SelectedMessage.MatchedRules)</dd>
                                <dt class="col-sm-4">@FinanceText["Attachments"]</dt>
                                <dd class="col-sm-8">@FormatAttachments(SelectedMessage.Attachments)</dd>
                            </dl>
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                                    <div>
                                        <div class="fw-semibold">@FinanceText["BillReview"]</div>
                                        @if (SelectedMessage.DetectedBillId is Guid)
                                        {
                                            <div class="small text-body-secondary">@FinanceText["ReviewExtractedBill"]</div>
                                        }
                                        else if (IsCandidate(SelectedMessage))
                                        {
                                            <div class="small text-body-secondary">@FinanceText["CandidateWithoutReview"]</div>
                                        }
                                        else
                                        {
                                            <div class="small text-body-secondary">@FinanceText["NotSupplierBill"]</div>
                                        }
                                    </div>
                                    @if (SelectedMessage.DetectedBillId is Guid detectedBillId)
                                    {
                                        <NavLink class="btn btn-primary" href="@BuildBillReviewHref(detectedBillId)">@FinanceText["ReviewBill"]</NavLink>
                                    }
                                </div>
                            </div>
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                                    <div>
                                        <div class="fw-semibold">Subscription discovery</div>
                                        @if (SelectedMessage.DetectedSubscriptionProposalId is Guid)
                                        {
                                            <div class="small text-body-secondary">Agreement evidence was found and needs finance review.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-body-secondary">No subscription agreement proposal was created from this message.</div>
                                        }
                                    </div>
                                    @if (SelectedMessage.DetectedSubscriptionProposalId is Guid proposalId)
                                    {
                                        <NavLink class="btn btn-outline-primary" href="@BuildSubscriptionProposalHref(proposalId)">Review agreement</NavLink>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SelectedMessage.DetectedSubscriptionProposalStatus))
                                {
                                    <div class="small text-body-secondary mt-2">Status: @FormatMailboxCode(SelectedMessage.DetectedSubscriptionProposalStatus)</div>
                                }
                            </div>
                            <div class="small text-uppercase text-body-secondary fw-semibold mb-1">@FinanceText["ExtractedEmailText"]</div>
                            @if (string.IsNullOrWhiteSpace(SelectedMessage.BodyPreview))
                            {
                                <p class="text-body-secondary mb-0">@FinanceText["NoBodyText"]</p>
                            }
                            else
                            {
                                <pre class="mailbox-message-body mb-0">@SelectedMessage.BodyPreview</pre>
                            }
                        </div>
                    }
                </div>
            </div>
        </FinanceDataState>
    </div>

    <div class="wizard-card wizard-card--compact mt-4">
        <div class="d-flex justify-content-between gap-3 align-items-start mb-3">
            <div>
                <h2 class="h5 mb-1">@FinanceText["RecentScan"]</h2>
                <p class="text-body-secondary mb-0">@FinanceText["RecentScanDescription"]</p>
            </div>
        </div>

        @if (Status?.LastRun is null)
        {
            <FinanceEmptyState Title="@FinanceText["NoMailboxScans"]" Message="@FinanceText["NoMailboxScansDescription"]" />
        }
        else
        {
            var run = Status.LastRun;
            <dl class="mb-0">
                <dt>@FinanceText["Provider"]</dt>
                <dd>@FormatProvider(run.Provider)</dd>
                <dt>@FinanceText["Started"]</dt>
                <dd>@FormatDateTime(run.StartedUtc)</dd>
                <dt>@FinanceText["Completed"]</dt>
                <dd>@FormatDateTime(run.CompletedUtc)</dd>
                <dt>@FinanceText["ScanWindow"]</dt>
                <dd>@FinanceText["RangeTo", FormatDateTime(run.ScanFromUtc), FormatDateTime(run.ScanToUtc)]</dd>
                <dt>@FinanceText["MessagesScanned"]</dt>
                <dd>@run.ScannedMessageCount</dd>
                <dt>@FinanceText["DetectedCandidates"]</dt>
                <dd>@run.DetectedCandidateCount</dd>
                @if (!string.IsNullOrWhiteSpace(run.FailureDetails))
                {
                    <dt>@FinanceText["Failure"]</dt>
                    <dd class="text-danger">@run.FailureDetails</dd>
                }
            </dl>
        }
    </div>
</FinancePageLayout>
