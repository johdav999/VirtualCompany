@page "/finance/settings"
@page "/finance/settings/email-settings"
@page "/finance/settings/integrations/{ProviderKey}"
@rendermode InteractiveServer
@inherits FinancePageBase
@using System.Globalization

<PageTitle>@FinanceText["FinanceSettings"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["FinanceSettings"]"
    Description="@FinanceText["FinanceSettingsDescription"]"
    LoadingMessage="@FinanceText["LoadingFinanceSettings"]">
    <div class="wizard-card wizard-card--compact">
        <ul class="finance-settings-tabs" aria-label="@FinanceText["FinanceSettingsSections"]">
            <li>
                <NavLink class="finance-settings-tab" href="@EmailSettingsHref" Match="NavLinkMatch.Prefix">@FinanceText["EmailSettings"]</NavLink>
            </li>
            <li>
                <NavLink class="finance-settings-tab" href="@IntegrationSettingsHref" Match="NavLinkMatch.Prefix">@FinanceText["Integrations"]</NavLink>
            </li>
        </ul>
        @if (!IsIntegrationSettingsRoute)
        {
        <FinanceDataState
            IsLoading="@IsSettingsLoading"
            IsEmpty="false"
            ErrorMessage="@SettingsErrorMessage"
            LoadingTitle="@FinanceText["LoadingEmailSettings"]"
            LoadingMessage="@FinanceText["ReadingProviderConfiguration"]"
            ErrorTitle="@FinanceText["EmailSettingsUnavailable"]"
            OnRetry="@ReloadAsync">
            <section class="finance-settings-integration-callout mb-4">
                <div class="finance-integration-card__identity">
                    <div class="finance-integration-card__mark" aria-hidden="true">Fi</div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0">@FinanceText["FinancialIntegrations"]</h2>
                            <span class="finance-integration-source-badge">@FinanceText["AccountingIntegration"]</span>
                        </div>
                        <p class="text-body-secondary mb-0">
                            @FinanceText["FinancialIntegrationsCallout"]
                        </p>
                    </div>
                </div>
                <NavLink class="btn btn-primary" href="@IntegrationSettingsHref">@FinanceText["OpenFinancialIntegrations"]</NavLink>
            </section>

            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h2 class="h5 mb-1">@FinanceText["EmailIntegrationSettings"]</h2>
                    <p class="text-body-secondary mb-0">
                        @FinanceText["EmailIntegrationSettingsDescription"]
                    </p>
                </div>
                <button class="btn btn-outline-secondary" type="button" @onclick="ReloadAsync" disabled="@IsBusy">@FinanceText["Refresh"]</button>
            </div>

            @if (Settings?.IsWritable != true)
            {
                <div class="alert alert-warning" role="status">
                    @FinanceText["DevelopmentEditingOnly"]
                </div>
            }

            <section class="border rounded-3 p-3 mb-4">
                <h3 class="h6 mb-2">@FinanceText["ProviderRedirectUris"]</h3>
                <p class="small text-body-secondary mb-3">
                    @FinanceText["ProviderRedirectUrisDescription"]
                </p>
                <dl class="row small mb-0">
                    <dt class="col-12 col-md-3">@FinanceText["GmailLocalDevelopment"]</dt>
                    <dd class="col-12 col-md-9">
                        <code>http://localhost:5301/api/mailbox-connections/gmail/callback</code>
                    </dd>
                    <dt class="col-12 col-md-3">@FinanceText["MicrosoftLocalDevelopment"]</dt>
                    <dd class="col-12 col-md-9">
                        <code>http://localhost:5301/api/mailbox-connections/microsoft365/callback</code>
                    </dd>
                    <dt class="col-12 col-md-3">@FinanceText["Production"]</dt>
                    <dd class="col-12 col-md-9 mb-0">
                        @FinanceText["ProductionCallbackHelp"]
                    </dd>
                </dl>
            </section>

            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <section class="border rounded-3 p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h6 mb-1">Gmail</h3>
                                <p class="small text-body-secondary mb-0">@FinanceText["EnableConnectGmail"]</p>
                            </div>
                            <span class="@GetProviderBadgeClass(Settings?.Gmail)">@GetProviderStatus(Settings?.Gmail)</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="gmail-client-id">@FinanceText["ClientId"]</label>
                            <input id="gmail-client-id" class="form-control" autocomplete="off" @bind="GmailClientId" disabled="@IsFormDisabled" />
                        </div>
                        <div>
                            <label class="form-label" for="gmail-client-secret">@FinanceText["ClientSecret"]</label>
                            <input id="gmail-client-secret" class="form-control" type="password" autocomplete="new-password" placeholder="@GetSecretPlaceholder(Settings?.Gmail)" @bind="GmailClientSecret" disabled="@IsFormDisabled" />
                        </div>
                    </section>
                </div>

                <div class="col-12 col-xl-6">
                    <section class="border rounded-3 p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h6 mb-1">Microsoft 365</h3>
                                <p class="small text-body-secondary mb-0">@FinanceText["EnableConnectMicrosoft"]</p>
                            </div>
                            <span class="@GetProviderBadgeClass(Settings?.Microsoft365)">@GetProviderStatus(Settings?.Microsoft365)</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="microsoft-client-id">@FinanceText["ClientId"]</label>
                            <input id="microsoft-client-id" class="form-control" autocomplete="off" @bind="Microsoft365ClientId" disabled="@IsFormDisabled" />
                        </div>
                        <div>
                            <label class="form-label" for="microsoft-client-secret">@FinanceText["ClientSecret"]</label>
                            <input id="microsoft-client-secret" class="form-control" type="password" autocomplete="new-password" placeholder="@GetSecretPlaceholder(Settings?.Microsoft365)" @bind="Microsoft365ClientSecret" disabled="@IsFormDisabled" />
                        </div>
                    </section>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@IsFormDisabled">
                    @(IsSaving ? FinanceText["Saving"] : FinanceText["SaveEmailSettings"])
                </button>
                <NavLink class="btn btn-outline-secondary" href="@MailboxHref">@FinanceText["BackToMailbox"]</NavLink>
            </div>

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="alert alert-success mt-3 mb-0" role="status">@SuccessMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(SaveErrorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@SaveErrorMessage</div>
            }
        </FinanceDataState>
        }
        else
        {
        <FinanceDataState
            IsLoading="@IsFinanceIntegrationLoading"
            IsEmpty="false"
            ErrorMessage="@FinanceIntegrationErrorMessage"
            LoadingTitle="@FinanceText["LoadingFinancialIntegrations"]"
            LoadingMessage="@FinanceText["ReadingAccountingConnection"]"
            ErrorTitle="@FinanceText["FinancialIntegrationsUnavailable"]"
            OnRetry="@ReloadFinanceIntegrationsAsync">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h2 class="h5 mb-1">@FinanceText["FinancialIntegrations"]</h2>
                    <p class="text-body-secondary mb-0">@FinanceText["FinancialIntegrationsDescription"]</p>
                </div>
                <button class="btn btn-outline-secondary" type="button" @onclick="ReloadFinanceIntegrationsAsync" disabled="@IsFinanceIntegrationBusy">@FinanceText["Refresh"]</button>
            </div>

            <section class="@($"finance-integration-card finance-integration-card--{FinanceIntegrationState}")">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div class="finance-integration-card__identity">
                        <div class="finance-integration-card__mark" aria-hidden="true">Fi</div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h3 class="h5 mb-0">@SelectedProviderDisplayName</h3>
                                <span class="@FinanceIntegrationBadgeClass">@FinanceIntegrationStateLabel</span>
                            </div>
                            <p class="text-body-secondary mb-0">@FinanceIntegrationStateDescription</p>
                        </div>
                    </div>
                    @if (CanManageFinanceIntegrations)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @if (ShowConnectAction)
                            {
                                <button class="btn btn-primary" type="button" @onclick="ConnectFinanceIntegrationAsync" disabled="@IsFinanceIntegrationBusy">
                                    @(IsFinanceIntegrationConnecting ? FinanceText["Connecting"] : FinanceText["ConnectAccountingSystem"])
                                </button>
                            }
                            @if (ShowReconnectAction)
                            {
                                <button class="btn btn-primary" type="button" @onclick="ReconnectFinanceIntegrationAsync" disabled="@IsFinanceIntegrationBusy">
                                    @(IsFinanceIntegrationConnecting ? FinanceText["Reconnecting"] : FinanceText["Reconnect"])
                                </button>
                            }
                            @if (ShowSyncAction)
                            {
                                <button class="btn btn-outline-primary" type="button" @onclick="SyncFinanceIntegrationAsync" disabled="@IsFinanceIntegrationSyncDisabled" title="@FinanceIntegrationSyncDisabledReason">
                                    @(IsFinanceIntegrationSyncing ? FinanceText["Syncing"] : FinanceText["SyncData"])
                                </button>
                            }
                            @if (ShowDisconnectAction)
                            {
                                <button class="btn btn-outline-danger" type="button" @onclick="DisconnectFinanceIntegrationAsync" disabled="@IsFinanceIntegrationBusy">@FinanceText["Disconnect"]</button>
                            }
                            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleFinanceIntegrationHistoryAsync" disabled="@IsFinanceIntegrationBusy">
                                @(ShowFinanceIntegrationHistory ? FinanceText["HideSyncHistory"] : FinanceText["ViewSyncHistory"])
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="finance-integration-card__readonly" role="status">
                            @FinanceText["IntegrationAdminRequired"]
                        </div>
                    }
                    @if (!CanManageFinanceIntegrations)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ToggleFinanceIntegrationHistoryAsync" disabled="@IsFinanceIntegrationBusy">
                            @(ShowFinanceIntegrationHistory ? FinanceText["HideSyncHistory"] : FinanceText["ViewSyncHistory"])
                        </button>
                    }
                </div>

                <div class="finance-integration-card__metrics">
                    <div>
                        <span>@FinanceText["Connection"]</span>
                        <strong>@FinanceIntegrationConnectionSummary</strong>
                    </div>
                    <div>
                        <span>@FinanceText["LastSuccessfulSync"]</span>
                        <strong>@FormatDateTime(FinanceIntegrationStatus?.LastSuccessfulSyncUtc)</strong>
                    </div>
                    <div>
                        <span>@FinanceText["LastIssue"]</span>
                        <strong>@LastFailureSummary</strong>
                    </div>
                </div>

                <div class="finance-integration-card__notice">
                    <strong>@FinanceText["ApprovalGatedWrites"]</strong>
                    <span>@FinanceText["ApprovalGatedWritesDescription"]</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(FinanceIntegrationSuccessMessage))
                {
                    <div class="alert alert-success mt-3 mb-0" role="status">@FinanceIntegrationSuccessMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(FinanceIntegrationActionErrorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@FinanceIntegrationActionErrorMessage</div>
                }
            </section>

            @if (ShowFinanceIntegrationHistory)
            {
                <section class="finance-integration-history-card mt-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h3 class="h6 mb-1">@FinanceText["SyncHistory"]</h3>
                            <p class="small text-body-secondary mb-0">@FinanceText["SyncHistoryDescription"]</p>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="LoadFinanceIntegrationHistoryAsync" disabled="@IsFinanceIntegrationHistoryLoading">@FinanceText["Refresh"]</button>
                    </div>
                    @if (IsFinanceIntegrationHistoryLoading)
                    {
                        <p class="text-body-secondary mb-0">@FinanceText["LoadingSyncHistory"]</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(FinanceIntegrationHistoryErrorMessage))
                    {
                        <div class="alert alert-warning mb-0" role="status">@FinanceIntegrationHistoryErrorMessage</div>
                    }
                    else if (FinanceIntegrationHistory?.Items.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@FinanceText["Started"]</th>
                                        <th>@FinanceText["Status"]</th>
                                        <th>@FinanceText["ImportedRecords"]</th>
                                        <th>@FinanceText["Duration"]</th>
                                        <th>@FinanceText["SafeErrorSummary"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FinanceIntegrationHistory.Items)
                                    {
                                        var importedCount = item.Created + item.Updated;
                                        <tr>
                                            <td>@LocalDateTime.DateTime(item.StartedUtc)</td>
                                            <td><span class="@FortnoxIntegrationDisplayMapper.GetHistoryBadgeClass(item.Status)">@FortnoxIntegrationDisplayMapper.FormatSyncStatus(item.Status)</span></td>
                                            <td>
                                                <strong>@importedCount</strong>
                                                <span class="d-block small text-body-secondary">@FortnoxIntegrationDisplayMapper.FormatImportCounts(item.Created, item.Updated, item.Skipped, item.Errors)</span>
                                            </td>
                                            <td>@FormatDuration(item.StartedUtc, item.CompletedUtc)</td>
                                            <td>
                                                <span>@FormatSafeErrorSummary(item)</span>
                                                @if (item.Entities.Count > 0)
                                                {
                                                    <details class="finance-sync-details mt-2">
                                                        <summary>@FinanceText["ViewSyncedRecords"]</summary>
                                                        <div class="table-responsive mt-2">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>@FinanceText["Records"]</th>
                                                                        <th>@FinanceText["Created"]</th>
                                                                        <th>@FinanceText["Updated"]</th>
                                                                        <th>@FinanceText["Skipped"]</th>
                                                                        <th>@FinanceText["Issues"]</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var entity in item.Entities)
                                                                    {
                                                                        <tr>
                                                                            <td>@FortnoxIntegrationDisplayMapper.FormatEntityType(entity.EntityType)</td>
                                                                            <td>@entity.Created</td>
                                                                            <td>@entity.Updated</td>
                                                                            <td>@entity.Skipped</td>
                                                                            <td>
                                                                                @entity.Errors
                                                                                @if (!string.IsNullOrWhiteSpace(entity.ErrorSummary))
                                                                                {
                                                                                    <span class="d-block small text-body-secondary">@FortnoxIntegrationDisplayMapper.FormatSafeText(entity.ErrorSummary, "Review this record type.")</span>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </details>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">@FinanceText["NoAccountingSyncs"]</p>
                    }
                </section>
            }
        </FinanceDataState>
        }
    </div>
</FinancePageLayout>
