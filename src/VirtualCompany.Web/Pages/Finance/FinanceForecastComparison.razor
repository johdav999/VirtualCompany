@page "/finance/reports/forecast-comparison"
@rendermode InteractiveServer
@inherits FinancePlanningPageBase
@inject IJSRuntime JS
<PageTitle>Compare forecast versions</PageTitle>
<main class="vc-page"><header class="vc-page-header"><div><span class="vc-kicker">FINANCE / PLANNING</span><h1>Compare forecast versions</h1><p>Original saved assumptions and source evidence</p></div><a href="@Back">Back to previous view</a></header>
    <nav class="vc-section-tabs"><a href="@Link("/finance/reports/variance")">Actual versus plan</a><a href="@Link("/finance/reports/rolling-forecast")">Rolling forecast</a></nav>
    <section class="vc-panel comparison-filters"><label>Earlier version<select @bind="earlier"><option value="">Choose earlier version</option>@foreach(var h in history){<option value="@h.Id">@h.Name · @h.SavedUtc.ToString("yyyy-MM-dd HH:mm") UTC</option>}</select></label><label>Later version<select @bind="later"><option value="">Choose later version</option>@foreach(var h in history){<option value="@h.Id">@h.Name · @h.SavedUtc.ToString("yyyy-MM-dd HH:mm") UTC</option>}</select></label><label>Currency<input maxlength="3" @bind="currency" placeholder="Separate currencies" /></label><label>Cost center<select @bind="dimension"><option value="">All cost centers</option>@foreach(var d in dimensions){<option value="@d.Id">@d.Name</option>}</select></label><button class="btn btn-primary" disabled="@Busy" @onclick="Compare">Compare saved versions</button><button disabled="@Busy" @onclick="Reload">Reload</button><button disabled="@(Busy||skip==0)" @onclick="PreviousPage">Previous history</button><button disabled="@(Busy||history.Count<20)" @onclick="NextPage">Next history</button></section>
    @if(Busy){<section class="vc-panel" role="status">Loading saved Finance versions…</section>}
    @if(Error!=null){<section class="vc-panel" role="alert">@Error <button disabled="@Busy" @onclick="Reload">Retry</button></section>}
    @if(comparison!=null&&Report!=null){<div class="comparison-layout"><section class="vc-panel comparison-values"><h2>Monthly account values</h2><p>@comparison.Earlier.Summary.Name → @comparison.Later.Summary.Name. Missing values are unavailable. Actuals and forecasts remain distinct; changes are later forecast minus earlier forecast.</p><div class="planning-scroll" tabindex="0"><table class="table"><thead><tr><th>Month</th><th>Account</th><th>Cost center</th><th>Currency</th><th>Earlier actual</th><th>Later actual</th><th>Earlier forecast</th><th>Later forecast</th><th>Change</th><th>Explanation</th></tr></thead><tbody>@foreach(var r in comparison.Rows){<tr><td>@r.MonthUtc.ToString("MMM yyyy")</td><th scope="row">@Account(r.AccountId)</th><td>@(dimensions.FirstOrDefault(d=>d.Id==r.CostCenterId)?.Name??"Unassigned")</td><td>@r.Currency</td><td>@Money(r.EarlierActual)</td><td>@Money(r.LaterActual)</td><td>@Money(r.EarlierForecast)</td><td>@Money(r.LaterForecast)</td><td>@Money(r.Change)</td><td>@r.Explanation</td></tr>}</tbody></table></div>@if(comparison.Rows.Count==0){<p>No retained values match these currency and dimension filters.</p>}</section><aside class="vc-panel comparison-aside"><h2>Laura · Finance</h2><p>Saved values retain their original sources. Later ledger or budget edits do not rewrite these versions.</p><p>Earlier saved @comparison.Earlier.Summary.SavedUtc.ToString("yyyy-MM-dd HH:mm") UTC. Source as of @comparison.Earlier.Summary.SourceAsOfUtc.ToString("yyyy-MM-dd HH:mm") UTC.</p><p>Later saved @comparison.Later.Summary.SavedUtc.ToString("yyyy-MM-dd HH:mm") UTC. Source as of @comparison.Later.Summary.SourceAsOfUtc.ToString("yyyy-MM-dd HH:mm") UTC.</p><a href="@VersionPath(comparison.Earlier.Summary.Id)">Open earlier assumptions and source drilldown</a><a href="@VersionPath(comparison.Later.Summary.Id)">Open later assumptions and source drilldown</a><button disabled="@Busy" @onclick="Download">Download comparison CSV</button></aside></div>}
    else if(!Busy&&Error==null){<section class="vc-panel">Choose two saved versions. Save a named forecast first if history is empty.</section>}
</main>
@code{
    [SupplyParameterFromQuery]public Guid? Earlier{get;set;}[SupplyParameterFromQuery]public Guid? Later{get;set;}
    private IReadOnlyList<FinanceForecastRevisionSummary> history=[];private IReadOnlyList<FinancePlanningChoice> dimensions=[];private VirtualCompany.Web.Services.FinanceForecastComparison? comparison;private string earlier="",later="",currency="",dimension="";private int skip;
    private string Account(Guid id)=>comparison!.Earlier.Preview.Report.Accounts.Concat(comparison.Later.Preview.Report.Accounts).FirstOrDefault(a=>a.Id==id)?.Name??"Retained account";
    protected override void Restricted(){base.Restricted();comparison=null;history=[];dimensions=[];}
    private string VersionPath(Guid id)=>Link($"/finance/reports/rolling-forecast?version={id:D}");
    protected override async Task Load(CancellationToken ct){comparison=null;history=[];dimensions=[];var list=await Planning.History(Company,skip,ct);
        var value=Earlier.HasValue&&Later.HasValue?await Planning.Compare(Company,Earlier.Value,Later.Value,Text(Currency)?.ToUpperInvariant(),CostCenterId,ct):null;
        if(ct.IsCancellationRequested)return;history=list;comparison=value;Report=value?.Later.Preview.Report;earlier=Earlier?.ToString()??"";later=Later?.ToString()??"";currency=Currency??"";dimension=CostCenterId?.ToString()??"";
        if(value!=null)dimensions=value.Earlier.Preview.Report.CostCenters.Concat(value.Later.Preview.Report.CostCenters).DistinctBy(d=>d.Id).ToArray();}
    private Task Compare()=>Run(()=>{if(!Guid.TryParse(earlier,out var a)||!Guid.TryParse(later,out var b))throw new ArgumentException("Choose two saved versions.");Navigation.NavigateTo(Link($"/finance/reports/forecast-comparison?earlier={a:D}&later={b:D}&currency={Uri.EscapeDataString(Text(currency)?.ToUpperInvariant()??"")}&costCenterId={dimension}"));return Task.CompletedTask;});
    private Task Download()=>Run(async()=>{if(comparison==null)return;var ct=Reads.Token;var export=await Planning.ComparisonExport(Company,comparison.Earlier.Summary.Id,comparison.Later.Summary.Id,Text(Currency)?.ToUpperInvariant(),CostCenterId,ct);if(ct.IsCancellationRequested)return;await using var module=await JS.InvokeAsync<IJSObjectReference>("import",ct,"./js/reportDownload.js");ct.ThrowIfCancellationRequested();await module.InvokeVoidAsync("downloadReport",ct,export.FileName,export.Content);});
    private Task Page()=>Run(async()=>{var ct=Reads.Token;var list=await Planning.History(Company,skip,ct);if(!ct.IsCancellationRequested)history=list;});
    private Task PreviousPage(){skip=Math.Max(0,skip-20);return Page();}private Task NextPage(){skip+=20;return Page();}
}
