@page "/finance/counterparties"
@inherits FinancePageBase

<PageTitle>@FinanceText["FinanceCounterparties"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["FinanceCounterparties"]"
    Description="@FinanceText["CounterpartiesDescription"]"
    LoadingMessage="@FinanceText["LoadingCounterparties"]">
    <ReceivablesNavigation CompanyId="@AccessState.CompanyId!.Value" ActiveView="customers" />
    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <div class="wizard-card wizard-card--compact">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="btn-group" role="group" aria-label="@FinanceText["CounterpartyType"]">
                        <button type="button" class="btn @(SelectedType == "customer" ? "btn-primary" : "btn-outline-primary")" @onclick='() => HandleTypeChangedAsync("customer")'>@FinanceText["Customers"]</button>
                        <button type="button" class="btn @(SelectedType == "supplier" ? "btn-primary" : "btn-outline-primary")" @onclick='() => HandleTypeChangedAsync("supplier")'>@FinanceText["Suppliers"]</button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="HandleNewAsync" disabled="@(!CanEdit)">@FinanceText["New"]</button>
                </div>

                <FinanceDataState
                    IsLoading="@IsListLoading"
                    IsEmpty="@(!IsListLoading && string.IsNullOrWhiteSpace(ListErrorMessage) && Items.Count == 0)"
                    ErrorMessage="@ListErrorMessage"
                    LoadingTitle="@FinanceText["LoadingCounterparties"]"
                    LoadingMessage="@FinanceText["FetchingCounterparties"]"
                    EmptyTitle="@FinanceText["NoCounterparties"]"
                    EmptyMessage="@FinanceText["NoCounterpartiesDescription"]"
                    OnRetry="@ReloadAsync">
                    <div class="list-group">
                        @foreach (var item in Items)
                        {
                            <button type="button" class="@(SelectedId == item.Id ? "list-group-item list-group-item-action active" : "list-group-item list-group-item-action")" @onclick="() => HandleSelectAsync(item.Id)">
                                <div class="d-flex justify-content-between gap-3">
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="small text-body-secondary">@FormatOptionalValue(item.Email)</div>
                                        <div class="small text-body-secondary">@BuildListMetadata(item)</div>
                                    </div>
                                    <div class="text-end small">
                                        <div>@FormatOptionalValue(item.PaymentTerms)</div>
                                        <div>@FormatOptionalValue(item.PreferredPaymentMethod)</div>
                                        <div>@FormatOptionalValue(item.DefaultAccountMapping)</div>
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                </FinanceDataState>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="wizard-card wizard-card--compact">
                <h2 class="h5 mb-3">@FinanceText[IsCreatingNew ? "CreateCounterparty" : "EditCounterparty", TitleCase(SelectedType)]</h2>

                @if (!string.IsNullOrWhiteSpace(SaveMessage))
                {
                    <div class="alert alert-success" role="status">@SaveMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(ValidationMessage))
                {
                    <div class="alert alert-danger" role="alert">@ValidationMessage</div>
                }

                <EditForm Model="@Editor" OnValidSubmit="@HandleSaveAsync">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-name">@FinanceText["Name"]</label>
                            <InputText id="counterparty-name" class="form-control" @bind-Value="Editor.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-email">@FinanceText["Email"]</label>
                            <InputText id="counterparty-email" class="form-control" @bind-Value="Editor.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-payment-terms">@FinanceText["PaymentTerms"]</label>
                            <InputText id="counterparty-payment-terms" class="form-control" @bind-Value="Editor.PaymentTerms" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-tax-id">@FinanceText["TaxId"]</label>
                            <InputText id="counterparty-tax-id" class="form-control" @bind-Value="Editor.TaxId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-credit-limit">@FinanceText["CreditLimit"]</label>
                            <InputNumber id="counterparty-credit-limit" class="form-control" @bind-Value="Editor.CreditLimit" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="counterparty-payment-method">@FinanceText["PreferredPaymentMethod"]</label>
                            <InputText id="counterparty-payment-method" class="form-control" @bind-Value="Editor.PreferredPaymentMethod" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="counterparty-account-mapping">@FinanceText["DefaultAccountMapping"]</label>
                            <InputText id="counterparty-account-mapping" class="form-control" @bind-Value="Editor.DefaultAccountMapping" />
                            <div class="form-text">@FinanceText["AccountMappingHelp"]</div>
                        </div>
                        @if (!IsCreatingNew && Selected is not null)
                        {
                            <div class="col-12">
                                <dl class="row mb-0">
                                    <dt class="col-sm-3">@FinanceText["Email"]</dt>
                                    <dd class="col-sm-9">@FormatOptionalValue(Selected.Email)</dd>
                                    <dt class="col-sm-3">@FinanceText["PaymentTerms"]</dt>
                                    <dd class="col-sm-9">@FormatOptionalValue(Selected.PaymentTerms)</dd>
                                    <dt class="col-sm-3">@FinanceText["TaxId"]</dt>
                                    <dd class="col-sm-9">@FormatOptionalValue(Selected.TaxId)</dd>
                                    <dt class="col-sm-3">@FinanceText["CreditLimit"]</dt>
                                    <dd class="col-sm-9">@FormatCreditLimit(Selected.CreditLimit)</dd>
                                    <dt class="col-sm-3">@FinanceText["PaymentMethodShort"]</dt>
                                    <dd class="col-sm-9">@FormatOptionalValue(Selected.PreferredPaymentMethod)</dd>
                                    <dt class="col-sm-3">@FinanceText["AccountMappingShort"]</dt>
                                    <dd class="col-sm-9">@FormatOptionalValue(Selected.DefaultAccountMapping)</dd>
                                    <dt class="col-sm-3">@FinanceText["Type"]</dt>
                                    <dd class="col-sm-9">@TitleCase(Selected.CounterpartyType)</dd>
                                    <dt class="col-sm-3">@FinanceText["Created"]</dt>
                                    <dd class="col-sm-9">@Selected.CreatedUtc.ToString("u")</dd>
                                    <dt class="col-sm-3">@FinanceText["Updated"]</dt>
                                    <dd class="col-sm-9">@Selected.UpdatedUtc.ToString("u")</dd>
                                </dl>
                            </div>
                        }
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@(!CanEdit || IsSaving)">@(IsSaving ? FinanceText["Saving"] : CommonText["Save"])</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="HandleNewAsync">@FinanceText["Reset"]</button>
                            @if (!IsCreatingNew && SelectedType == "customer" && SelectedId is Guid customerId)
                            {
                                <a class="btn btn-outline-primary" href="@FinanceRoutes.BuildCustomerBillingPath(customerId, AccessState.CompanyId)">@FinanceText["OpenBillingProfile"]</a>
                            }
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</FinancePageLayout>
