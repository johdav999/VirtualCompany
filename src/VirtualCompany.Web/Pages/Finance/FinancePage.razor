@page "/finance"
@rendermode InteractiveServer
@inherits FinancePageBase

<PageTitle>@FinanceText["FinanceModule"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["FinanceModule"]"
    Description="@FinanceText["FinanceOverviewDescription"]"
    LoadingMessage="@FinanceText["LoadingFinanceOverview"]"
    ShowShellHeader="false"
    ShowShellNavigation="false">
    @if (AccessState.IsAllowed && AccessState.CompanyId is Guid financeCompanyId)
    {
        <div class="d-flex justify-content-end mb-3">
            <GuidedWorkshopLaunch CompanyId="financeCompanyId" AgentDepartment="Finance" ArtifactType="finance_budget" />
        </div>
    }
    @if (OperatingMode is not null)
    {
        <section class="alert @OperatingModeAlertClass mb-3" role="status" aria-label="Finance operating mode">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <strong>Accounting authority: @OperatingModeAuthorityLabel</strong>
                <span class="badge text-bg-light">Data source: @OperatingModeSourceLabel</span>
                @if (!OperatingMode.IsReadyForOperationalPosting)
                {
                    <span class="badge text-bg-warning">Posting is paused</span>
                }
            </div>
            <div class="small mt-1">@OperatingMode.NextAction</div>
        </section>
    }
    <FinanceDataState
        IsLoading="@IsOverviewLoading"
        IsEmpty="@IsOverviewEmpty"
        ErrorMessage="@OverviewErrorMessage"
        LoadingTitle="@FinanceText["LoadingFinanceOverview"]"
        LoadingMessage="@FinanceText["ReadingFinanceOverview"]"
        EmptyTitle="@FinanceText["NoFinanceActivity"]"
        EmptyMessage="@FinanceText["NoFinanceActivityDescription"]"
        ErrorTitle="@FinanceText["FinanceOverviewUnavailable"]"
        RetryText="@FinanceText["ReloadFinanceOverview"]"
        OnRetry="@ReloadOverviewAsync">
        @if (Overview is not null)
        {
            <FinanceOverviewPage Overview="@Overview" CompanyId="@AccessState.CompanyId" />
        }
    </FinanceDataState>
</FinancePageLayout>
