@page "/system/admin/tool-executions"
@page "/system/admin/tool-executions/{ExecutionId:guid}"
@inherits FinanceTransparencyPageBase

<PageTitle>@FinanceText["ToolExecutions"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["ToolExecutions"]"
    Description="@FinanceText["ToolExecutionsDescription"]"
    LoadingMessage="@FinanceText["LoadingToolExecutions"]"
    Area="SystemAdmin">
    @if (!HasTransparencyAccess)
    {
        <ForbiddenState
            Title="@FinanceText["SystemAccessRequired"]"
            Message="@FinanceText["SystemAccessRequiredMessage"]"
            ReturnHref="@BuildFinanceHomeHref()"
            ReturnText="@FinanceText["BackToFinance"]" />
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-xl-7">
                <div class="wizard-card wizard-card--compact">
                    <div class="d-flex justify-content-between gap-3 align-items-center mb-3">
                        <div>
                            <h2 class="h5 mb-1">@FinanceText["ToolExecutionHistory"]</h2>
                            <p class="text-body-secondary mb-0">@(string.IsNullOrWhiteSpace(Summary) ? FinanceText["ToolExecutionHistorySummary"] : Summary)</p>
                        </div>
                        <span class="badge text-bg-light">@FinanceText["ItemCount", Items.Count]</span>
                    </div>

                    <FinanceDataState
                        IsLoading="@IsListLoading"
                        IsEmpty="@IsListEmpty"
                        ErrorMessage="@ListErrorMessage"
                        LoadingTitle="@FinanceText["LoadingFinanceToolExecutions"]"
                        LoadingMessage="@FinanceText["ReadingFinanceToolExecutions"]"
                        EmptyTitle="@FinanceText["NoFinanceToolExecutions"]"
                        EmptyMessage="@FinanceText["NoFinanceToolExecutionsMessage"]"
                        ErrorTitle="@FinanceText["FinanceToolExecutionsUnavailable"]"
                        OnRetry="@ReloadAsync">
                        <div class="table-responsive">
                            <table class="table finance-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@FinanceText["Tool"]</th>
                                        <th scope="col">@FinanceText["State"]</th>
                                        <th scope="col">@FinanceText["Request"]</th>
                                        <th scope="col">@FinanceText["Response"]</th>
                                        <th scope="col">@FinanceText["Executed"]</th>
                                        <th scope="col">@FinanceText["Correlation"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Items)
                                    {
                                        <tr class="@(ExecutionId == item.ExecutionId ? "table-active" : null)">
                                            <td class="text-nowrap">
                                                <a id="@($"finance-execution-{item.ExecutionId:D}")" class="btn btn-link p-0 text-start text-decoration-none fw-semibold" href="@BuildExecutionDetailHref(item.ExecutionId)">@item.ToolName</a>
                                                <div class="small text-body-secondary">@item.ToolVersion</div>
                                            </td>
                                            <td class="text-nowrap"><span class="badge text-bg-light">@FormatLabel(item.LifecycleState)</span></td>
                                            <td>@item.RequestSummary</td>
                                            <td>@item.ResponseSummary</td>
                                            <td class="text-nowrap">@FormatTimestamp(item.ExecutionTimestampUtc)</td>
                                            <td>@FormatValue(item.CorrelationId)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </FinanceDataState>
                </div>
            </div>

            <div class="col-xl-5">
                <div class="wizard-card wizard-card--compact">
                    @if (IsDetailLoading)
                    {
                        <FinanceLoadingState Title="@FinanceText["LoadingExecutionDetail"]" Message="@FinanceText["ResolvingExecutionDetail"]" />
                    }
                    else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                    {
                        <FinanceErrorState Title="@FinanceText["ExecutionDetailUnavailable"]" Message="@(DetailErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@ReloadAsync" />
                    }
                    else if (SelectedExecution is null)
                    {
                        <FinanceEmptyState Title="@FinanceText["NoExecutionSelected"]" Message="@FinanceText["NoExecutionSelectedMessage"]" />
                    }
                    else
                    {

                        <h2 class="h5">@FinanceText["ExecutionDetail"]</h2>
                        <dl class="mb-4">
                            <dt>@FinanceText["Tool"]</dt>
                            <dd>@SelectedExecution.ToolName (@SelectedExecution.ToolVersion)</dd>
                            <dt>@FinanceText["LifecycleState"]</dt>
                            <dd>@FormatLabel(SelectedExecution.LifecycleState)</dd>
                            <dt>@FinanceText["Executed"]</dt>
                            <dd>@FormatTimestamp(SelectedExecution.ExecutionTimestampUtc)</dd>
                            <dt>@FinanceText["ApprovalRequest"]</dt>
                            <dd>@FormatValue(SelectedExecution.ApprovalRequestDisplay)</dd>
                            <dt>@FinanceText["Correlation"]</dt>
                            <dd>@FormatValue(SelectedExecution.CorrelationId)</dd>
                            <dt>@FinanceText["OriginatingFinanceAction"]</dt>
                            <dd>@FormatValue(SelectedExecution.OriginatingFinanceActionDisplay)</dd>
                            <dt>@FinanceText["OriginatingEntity"]</dt>
                            <dd>@FormatValue(SelectedExecution.OriginatingEntityReference)</dd>
                        </dl>

                        <h3 class="h6">@FinanceText["RequestSummary"]</h3>
                        <p>@SelectedExecution.RequestSummary</p>

                        <h3 class="h6">@FinanceText["ResponseSummary"]</h3>
                        <p class="mb-4">@SelectedExecution.ResponseSummary</p>

                        <h3 class="h6">@FinanceText["RelatedRecords"]</h3>
                        @if (SelectedExecution.RelatedRecords.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@FinanceText["NoExecutionRelatedRecords"]</p>
                        }
                        else
                        {
                            @foreach (var record in SelectedExecution.RelatedRecords)
                            {
                                var href = BuildRelatedRecordHref(record);

                                <div class="border rounded p-3 mb-2">
                                    <div class="d-flex justify-content-between gap-3 align-items-start">
                                        <div>
                                            <div class="fw-semibold">@BuildRelatedRecordTitle(record)</div>
                                            @if (!string.IsNullOrWhiteSpace(record.Reference))
                                            {
                                                <div class="small text-body-secondary">@record.Reference</div>
                                            }
                                            <div class="small text-body-secondary">@FinanceText["ResolvedVia", FormatLabel(record.ResolutionSource)]</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(href))
                                        {
                                            <a class="btn btn-outline-secondary btn-sm" href="@href">@CommonText["Open"]</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }
</FinancePageLayout>
