@page "/system/admin/transparency-events"
@page "/system/admin/transparency-events/{EventId:guid}"
@inherits FinanceTransparencyPageBase

<PageTitle>@FinanceText["TransparencyEvents"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["TransparencyEvents"]"
    Description="@FinanceText["TransparencyEventsDescription"]"
    LoadingMessage="@FinanceText["LoadingTransparencyEvents"]"
    Area="SystemAdmin">
    @if (!HasTransparencyAccess)
    {
        <ForbiddenState
            Title="@FinanceText["SystemAccessRequired"]"
            Message="@FinanceText["SystemAccessRequiredMessage"]"
            ReturnHref="@BuildFinanceHomeHref()"
            ReturnText="@FinanceText["BackToFinance"]" />
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-xl-7">
                <div class="wizard-card wizard-card--compact">
                    <div class="d-flex justify-content-between gap-3 align-items-center mb-3">
                        <div>
                            <h2 class="h5 mb-1">@FinanceText["TransparencyEvents"]</h2>
                            <p class="text-body-secondary mb-0">@(string.IsNullOrWhiteSpace(Summary) ? FinanceText["TransparencyEventsSummary"] : Summary)</p>
                        </div>
                        <span class="badge text-bg-light">@FinanceText["ItemCount", Events.Count]</span>
                    </div>

                    <FinanceDataState
                        IsLoading="@IsListLoading"
                        IsEmpty="@IsListEmpty"
                        ErrorMessage="@ListErrorMessage"
                        LoadingTitle="@FinanceText["LoadingFinanceEvents"]"
                        LoadingMessage="@FinanceText["ReadingFinanceEvents"]"
                        EmptyTitle="@FinanceText["NoFinanceEvents"]"
                        EmptyMessage="@FinanceText["NoFinanceEventsMessage"]"
                        ErrorTitle="@FinanceText["FinanceEventsUnavailable"]"
                        OnRetry="@ReloadAsync">
                        <div class="table-responsive">
                            <table class="table finance-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@FinanceText["EventType"]</th>
                                        <th scope="col">@FinanceText["Timestamp"]</th>
                                        <th scope="col">@FinanceText["Correlation"]</th>
                                        <th scope="col">@FinanceText["AffectedEntity"]</th>
                                        <th scope="col">@FinanceText["PayloadSummary"]</th>
                                        <th scope="col">@FinanceText["Trace"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Events)
                                    {
                                        <tr class="@(EventId == item.Id ? "table-active" : null)">
                                            <td class="text-nowrap">
                                                <a id="@($"finance-event-{item.Id:D}")" class="btn btn-link p-0 text-start text-decoration-none fw-semibold" href="@BuildEventDetailHref(item.Id)">@item.EventType</a>
                                            </td>
                                            <td class="text-nowrap">@FormatTimestamp(item.OccurredAtUtc)</td>
                                            <td>@FormatValue(item.CorrelationId)</td>
                                            <td>@item.EntityReference</td>
                                            <td>@item.PayloadSummary</td>
                                            <td class="text-nowrap">
                                                <span class="badge @(item.HasTriggerTrace ? "text-bg-info" : "text-bg-light")">@(item.HasTriggerTrace ? FinanceText["TraceAvailable"] : FinanceText["NoTrace"])</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </FinanceDataState>
                </div>
            </div>

            <div class="col-xl-5">
                <div class="wizard-card wizard-card--compact">
                    @if (IsDetailLoading)
                    {
                        <FinanceLoadingState Title="@FinanceText["LoadingEventDetail"]" Message="@FinanceText["ResolvingEventDetail"]" />
                    }
                    else if (!string.IsNullOrWhiteSpace(DetailErrorMessage))
                    {
                        <FinanceErrorState Title="@FinanceText["EventDetailUnavailable"]" Message="@(DetailErrorMessage!)" RetryText="@CommonText["Retry"]" OnRetry="@ReloadAsync" />
                    }
                    else if (SelectedEvent is null)
                    {
                        <FinanceEmptyState Title="@FinanceText["NoEventSelected"]" Message="@FinanceText["NoEventSelectedMessage"]" />
                    }
                    else
                    {
                        var entityHref = BuildFinanceEntityHref(SelectedEvent.EntityType, SelectedEvent.EntityId);

                        <h2 class="h5">@FinanceText["EventDetail"]</h2>
                        <dl class="mb-4">
                            <dt>@FinanceText["EventType"]</dt>
                            <dd>@SelectedEvent.EventType</dd>
                            <dt>@FinanceText["Occurred"]</dt>
                            <dd>@FormatTimestamp(SelectedEvent.OccurredAtUtc)</dd>
                            <dt>@FinanceText["Correlation"]</dt>
                            <dd>@FormatValue(SelectedEvent.CorrelationId)</dd>
                            <dt>@FinanceText["AffectedEntity"]</dt>
                            <dd>@SelectedEvent.EntityReference</dd>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(entityHref))
                        {
                            <div class="dashboard-actions mb-4">
                                <a class="btn btn-outline-secondary" href="@entityHref">@FinanceText["OpenAffectedFinanceRecord"]</a>
                            </div>
                        }

                        <h3 class="h6">@FinanceText["PayloadSummary"]</h3>
                        <p class="mb-4">@SelectedEvent.PayloadSummary</p>

                        <h3 class="h6">@FinanceText["RelatedRecords"]</h3>
                        @if (SelectedEvent.RelatedRecords.Count == 0)
                        {
                            <p class="text-body-secondary mb-4">@FinanceText["NoEventRelatedRecords"]</p>
                        }
                        else
                        {
                            <div class="mb-4">
                                @foreach (var record in SelectedEvent.RelatedRecords)
                                {
                                    var href = BuildRelatedRecordHref(record);

                                    <div class="border rounded p-3 mb-2">
                                        <div class="d-flex justify-content-between gap-3 align-items-start">
                                            <div>
                                                <div class="fw-semibold">@BuildRelatedRecordTitle(record)</div>
                                                @if (!string.IsNullOrWhiteSpace(record.Reference))
                                                {
                                                    <div class="small text-body-secondary">@record.Reference</div>
                                                }
                                                <div class="small text-body-secondary">@FinanceText["ResolvedVia", FormatLabel(record.ResolutionSource)]</div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(href))
                                            {
                                                <a class="btn btn-outline-secondary btn-sm" href="@href">@CommonText["Open"]</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <h3 class="h6">@FinanceText["TriggerConsumptionTrace"]</h3>
                        @if (SelectedEvent.TriggerConsumptionTrace.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@FinanceText["NoTriggerTrace"]</p>
                        }
                        else
                        {
                            <ul class="mb-0">
                                @foreach (var item in SelectedEvent.TriggerConsumptionTrace)
                                {
                                    <li><strong>@item.DisplayName</strong>: @FormatValue(item.Reference)</li>
                                }
                            </ul>
                        }
                    }
                </div>
            </div>
        </div>
    }
</FinancePageLayout>
