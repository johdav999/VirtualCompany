@page "/finance/monthly-summary"
@inherits FinanceSummaryPageBase<MonthlySummaryViewModel>

<PageTitle>@FinanceText["MonthlySummary"]</PageTitle>

<FinancePageLayout
    IsLoading="@IsLoading"
    AccessState="@AccessState"
    ErrorMessage="@ErrorMessage"
    Title="@FinanceText["MonthlySummary"]"
    Description="@FinanceText["MonthlySummaryDescription"]"
    LoadingMessage="@FinanceText["LoadingMonthlySummary"]">
    <div class="finance-subtab-nav" aria-label="@FinanceText["Cash"]">
        <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.CashPosition, AccessState.CompanyId)">@FinanceText["CashPosition"]</a>
        <a class="finance-subtab-nav__link" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.Balances, AccessState.CompanyId)">@FinanceText["Balances"]</a>
        <a class="finance-subtab-nav__link active" href="@FinanceRoutes.WithCompanyContext(FinanceRoutes.MonthlySummary, AccessState.CompanyId)">@FinanceText["MonthlySummary"]</a>
    </div>
    <FinanceDataState
        IsLoading="@IsSummaryLoading"
        IsEmpty="@IsSummaryEmpty"
        ErrorMessage="@SummaryErrorMessage"
        LoadingTitle="@FinanceText["LoadingMonthlySummary"]"
        LoadingMessage="@FinanceText["BuildingMonthlySummary"]"
        EmptyTitle="@FinanceText["NoMonthlySummary"]"
        EmptyMessage="@FinanceText["NoMonthlySummaryDescription"]"
        RetryText="@FinanceText["ReloadMonthlySummary"]"
        OnRetry="@RetryAsync">
        @if (ViewModel is not null)
        {
            <section class="finance-summary-stack" aria-labelledby="monthly-summary-heading">
                <div class="finance-summary-grid">
                    <article class="wizard-card finance-metric-card finance-metric-card--hero">
                        <span class="dashboard-kicker">@FinanceText["ReportingPeriod"]</span>
                        <h2 id="monthly-summary-heading" class="finance-metric-card__value finance-metric-card__value--compact">@ViewModel.Period</h2>
                        <p class="text-body-secondary mb-0">@FinanceText["MonthlyPerformanceSnapshot"]</p>
                    </article>
                    <article class="wizard-card finance-metric-card">
                        <span class="dashboard-kicker">@FinanceText["Revenue"]</span>
                        <div class="finance-metric-card__value finance-metric-card__value--compact">@ViewModel.Revenue</div>
                    </article>
                    <article class="wizard-card finance-metric-card">
                        <span class="dashboard-kicker">@FinanceText["Expenses"]</span>
                        <div class="finance-metric-card__value finance-metric-card__value--compact">@ViewModel.Expenses</div>
                    </article>
                    <article class="wizard-card finance-metric-card">
                        <span class="dashboard-kicker">@FinanceText["NetResult"]</span>
                        <div class="finance-metric-card__value finance-metric-card__value--compact">@ViewModel.NetResult</div>
                    </article>
                </div>
                @if (ViewModel.ExpenseCategories.Count > 0)
                {
                    <article class="wizard-card">
                        <h2 class="h5">@FinanceText["ExpenseBreakdown"]</h2>
                        <div class="table-responsive">
                            <table class="table finance-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@FinanceText["Category"]</th>
                                        <th scope="col" class="finance-table__number">@FinanceText["Amount"]</th>
                                        <th scope="col" class="finance-table__number">@FinanceText["Share"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in ViewModel.ExpenseCategories)
                                    {
                                        <tr>
                                            <td>@category.Category</td>
                                            <td class="finance-table__number">@category.Amount</td>
                                            <td class="finance-table__number">@category.Share</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>
                }
                else
                {
                    <article class="wizard-card">
                        <h2 class="h5">@FinanceText["ExpenseBreakdown"]</h2>
                        <p class="text-body-secondary mb-0">@FinanceText["NoCategoryAggregates"]</p>
                    </article>
                }
            </section>
        }
    </FinanceDataState>
</FinancePageLayout>
