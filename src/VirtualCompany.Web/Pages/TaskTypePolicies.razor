@page "/settings/agents/task-policies"
@rendermode InteractiveServer
@inject TaskTypePolicyApiClient Policies
@inject AgentWorkApiClient WorkApi
@inject NavigationManager Navigation
@implements IDisposable
<PageTitle>Task policies</PageTitle>
<section class="vc-page policy-page">
    <header class="vc-page-header"><div><span class="vc-kicker">SETTINGS</span><h1>Task policies</h1><p>Review what agents may prepare internally, with limits and expiry.</p></div><a href="@($"/settings/agents?companyId={CompanyId:D}")">Back to agent settings</a></header>
    @if(error is not null){<p role="alert">@error <button type="button" @onclick="Reload">Reload current settings</button></p>}
    @if(busy){<p role="status">Checking current policy…</p>}
    @if(catalogue is not null && authority is not null){
        <div class="policy-grid"><aside class="policy-card"><h2>Task catalogue</h2><label for="policy-agent">Agent</label><select id="policy-agent" value="@selected" @onchange="SelectAgent">@foreach(var agent in authority.AvailableAgents){<option value="@agent.Id">@agent.Name</option>}</select>
            <nav aria-label="Task types">@foreach(var item in catalogue){<button type="button" class="@(type==item.Code?"selected":"")" aria-pressed="@(type==item.Code)" @onclick="()=>SelectType(item.Code)">@item.Name<small>@item.Department · internal only</small></button>}</nav>
            <p>Delivery, publication, accounting posting and money movement retain their separately approved workflows.</p>
        </aside><div class="policy-card"><h2>Configure task policy</h2><p>@Entry?.Name</p>
            <fieldset disabled="@busy"><legend>Permission mode</legend>
                @foreach(var option in new[]{("disabled","Disabled","Block work under this task policy."),("review","Require review","An authorized human reviews the internal action."),("automatic","Internal work where supported","Prepare internal work within current company, agent and workflow limits.")}){
                    <label class="policy-mode"><input type="radio" name="policy-mode" value="@option.Item1" checked="@(mode==option.Item1)" @onchange="()=>EditMode(option.Item1)" /> <strong>@option.Item2</strong><small>@option.Item3</small></label>
                }
            </fieldset>
            <label for="policy-limit">@(Entry?.Finance==true?"Maximum runs per template window":"Maximum actions per UTC day")</label><input id="policy-limit" type="number" min="1" max="@(Entry?.Finance==true?1:100)" @bind="limit" @bind:after="ClearPreview" />
            <p>@(Entry?.Finance==true?"The reviewed Finance template retains its own record, action, time-window and freshness bounds.":"One record and one internal action per queued task.")</p>
            <label for="policy-expiry">Policy expiry (UTC)</label><input id="policy-expiry" type="datetime-local" @bind="expiry" @bind:after="ClearPreview" />
            <label for="policy-reason">Reason for change</label><textarea id="policy-reason" maxlength="2000" @bind="rationale" @bind:after="ClearPreview"></textarea>
            @if(Entry?.Finance!=true){
            <label for="policy-record">Simulation and work record</label><select id="policy-record" @bind="recordText" @bind:after="ClearPreview"><option value="">No record selected</option>@foreach(var record in choices?.Records??[]){<option value="@record.Id">@record.Name</option>}</select>
            <label for="policy-goal">Company goal</label><select id="policy-goal" @bind="goalText"><option value="">Choose an active goal</option>@foreach(var goal in choices?.Goals??[]){<option value="@goal.Id">@goal.Name</option>}</select>
            <p>Choose a current company record and an active goal for queued work. No content is generated by preview.</p>
            @if(choices is not null && (choices.Records.Count==0||choices.Goals.Count==0)){<p>No eligible record or goal is available for this agent and task type. Configure the responsibility and active goal first.</p>}
            }
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="Preview">Preview changes</button>
            <a href="@($"/settings/agents/authority?companyId={CompanyId:D}&agentId={selected:D}")">View current authority and company limits</a>
        </div><div class="policy-rail">
            <section class="policy-card" aria-label="Policy preview"><h2>Preview changes</h2>@if(preview is null){<p>Choose a mode, bounds and reason, then preview before applying.</p>}else{
                <p><strong>Version @preview.Before.Version → @preview.AfterVersion</strong></p><p>@preview.Type.Name · @authority.AvailableAgents.SingleOrDefault(x=>x.Id==selected)?.Name</p>
                <p>Before: @(preview.Before.History.FirstOrDefault() is { } before?ModeLabel(before.Mode):"No task policy") → Proposed: @ModeLabel(preview.Change.Mode)</p><p>Expiry: @preview.Change.ExpiresUtc.ToString("u")</p><dl>@foreach(var bound in preview.Limits??[]){<dt>@bound.Label</dt><dd>@bound.Value</dd>}</dl>
                <p><strong>@AgentAuthorityTransparencyPresenter.CheckLabel(preview.Check.State)</strong> · @preview.Check.Explanation</p><p>@preview.SimulationExplanation</p>
                <p class="policy-notice">No actions run. No live action budgets consumed. Applying a setting does not remove current company, agent, evidence or workflow restrictions.</p>
                <button type="button" class="btn btn-primary" disabled="@(busy||!preview.CanApply)" @onclick="Apply">Apply reviewed change</button>
            }</section>
            <section class="policy-card"><h2>Policy history</h2>@if(view is null||view.History.Count==0){<p>No task policy has been activated for this agent and type.</p>}else{
                <p>Current policy record version @view.Version</p>@foreach(var row in view.History){<article class="policy-history"><strong>Version @row.Version · @ModeLabel(row.Mode)</strong><p>@row.Rationale</p><small>Activated @row.ActivatedUtc.ToString("u") · Expires @row.ExpiresUtc.ToString("u")<br />@row.ActorName</small><p>@row.MaximumActionsPerDay @(Entry?.Finance==true?"runs per template window":"actions per day")</p></article>}
                <button type="button" disabled="@busy" @onclick="PrepareRevoke">Preview revocation</button>
            }</section>
            <section class="policy-card"><h2>Observed work</h2>@if(Entry?.Finance==true){<p>Monitoring and bounded internal review tasks run through the existing Finance template, trigger, grant, budget and executor.</p><p>No payment, posting, final close, statutory signoff, external sending, self approval or ambiguous-outcome resolution is enabled.</p><a href="@($"/finance?companyId={CompanyId:D}")">Open Finance</a>}else{
                <p>Queue a company record under the current policy. The owning dispatcher rechecks policy, agent, company, evidence and budgets.</p>
                <button type="button" disabled="@(busy||!CanQueue)" @onclick="Queue">Queue internal work</button>
            }</section>
        </div></div>
    }
</section>
@code {
    [SupplyParameterFromQuery]public Guid CompanyId{get;set;}
    [SupplyParameterFromQuery]public Guid? AgentId{get;set;}
    private IReadOnlyList<TaskTypePolicyCatalogueEntry>? catalogue;private AuthorityExplanationDto? authority;private TaskPolicyView? view;private TaskPolicyPreview? preview;
    private TaskPolicyQueueContext? choices;private Guid selected;private string type="sales.account_research",mode="review",rationale="",recordText="",goalText="";private int limit=5;private DateTime expiry=DateTime.UtcNow.AddDays(7);private bool busy;private string? error;
    private CancellationTokenSource read=new();private int generation;
    private TaskTypePolicyCatalogueEntry? Entry=>catalogue?.SingleOrDefault(x=>x.Code==type);
    private bool CanQueue=>view?.History.FirstOrDefault() is { } current && current.Mode!="disabled" && current.ExpiresUtc>DateTime.UtcNow && Guid.TryParse(recordText,out var record) && record!=Guid.Empty && Guid.TryParse(goalText,out var goal) && goal!=Guid.Empty;
    protected override Task OnParametersSetAsync()=>Reload();
    private async Task Reload(){var current=++generation;read.Cancel();read.Dispose();read=new();busy=true;error=null;preview=null;view=null;choices=null;catalogue=null;authority=null;
        try{var token=read.Token;var list=await Policies.Catalogue(CompanyId,token);var choices=await WorkApi.AuthorityAsync(CompanyId,null,null,null,token);if(current!=generation)return;catalogue=list;authority=choices;selected=AgentId??choices?.AvailableAgents.FirstOrDefault()?.Id??Guid.Empty;await LoadPolicy();}
        catch(OperationCanceledException){}catch(Exception ex)when(ex is OnboardingApiException or ArgumentException){if(current==generation)error=ex.Message;}finally{if(current==generation)busy=false;}}
    private async Task LoadPolicy(){var current=generation;var company=CompanyId;var agent=selected;var code=type;var token=read.Token;view=null;preview=null;choices=null;recordText="";goalText="";if(agent==Guid.Empty)return;var policy=await Policies.Get(company,agent,code,token);var records=await Policies.Records(company,agent,code,token);if(current!=generation||company!=CompanyId||agent!=selected||code!=type)return;view=policy;choices=records;if(policy.History.FirstOrDefault() is { } active){mode=active.Mode=="read_monitor"?"automatic":active.Mode;limit=active.MaximumActionsPerDay;expiry=active.ExpiresUtc;}else{mode="review";limit=Entry?.Finance==true?1:5;expiry=DateTime.UtcNow.AddDays(7);}rationale="";}
    private Task SelectAgent(ChangeEventArgs args){Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("agentId",args.Value?.ToString()));return Task.CompletedTask;}
    private async Task SelectType(string code){generation++;read.Cancel();read.Dispose();read=new();type=code;limit=Entry?.Finance==true?1:5;await Run(LoadPolicy);}
    private void ClearPreview()=>preview=null;
    private void EditMode(string value){mode=value;ClearPreview();}
    private TaskPolicyChange Change()=>new(selected,type,mode,limit,DateTime.SpecifyKind(expiry,DateTimeKind.Utc),rationale,view?.Version??0,string.IsNullOrWhiteSpace(recordText)?null:Guid.Parse(recordText));
    private Task Preview()=>Run(async()=>{var current=generation;var change=Change();var result=await Policies.Preview(CompanyId,change,read.Token);if(current==generation&&change==Change())preview=result;});
    private Task Apply()=>Run(async()=>{if(preview is null)return;var current=generation;var applied=await Policies.Apply(CompanyId,new(preview.Change,preview.PreviewHash),read.Token);if(current!=generation)return;view=applied;preview=null;});
    private Task PrepareRevoke(){mode="disabled";rationale="Revoke current task authority.";expiry=DateTime.UtcNow.AddDays(1);return Preview();}
    private Task Queue()=>Run(async()=>{if(!CanQueue)throw new ArgumentException("Choose a current enabled policy, a company record and an active goal.");var current=generation;var company=CompanyId;var id=await Policies.Queue(company,new(selected,type,Guid.Parse(recordText),view!.Version,Guid.Parse(goalText)),read.Token);if(current==generation)Navigation.NavigateTo($"/agents/work/task/{id:D}?companyId={company:D}");});
    private async Task Run(Func<Task> action){var current=generation;busy=true;error=null;try{await action();}catch(OperationCanceledException){}catch(Exception ex)when(ex is OnboardingApiException or ArgumentException or FormatException){if(current==generation){error=ex.Message;preview=null;if(ex is OnboardingApiException)view=null;}}finally{if(current==generation)busy=false;}}
    private static string ModeLabel(string mode)=>mode switch{"disabled"=>"Disabled / revoked","review"=>"Require review","automatic"=>"Internal work where supported","read_monitor"=>"Finance read and monitor",_=>AgentAuthorityTransparencyPresenter.HumanLabel(mode)};
    public void Dispose(){generation++;read.Cancel();read.Dispose();}
}
