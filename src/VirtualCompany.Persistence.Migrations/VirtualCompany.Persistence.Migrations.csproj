<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VirtualCompany.Persistence\VirtualCompany.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The generated EF migration set is large enough to trigger a Roslyn
         AccessViolation on Windows. Keep compilation local and avoid analyzer
         and debug-symbol work for generated migration sources. Migration
         execution and EF design-time metadata are unaffected. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
