    {"second": 420, "type": "barge_in"},
    {"second": 600, "type": "grounded_question"},
    {"second": 900, "type": "human_takeover"},
    {"second": 960, "type": "resume"},
    {"second": 1260, "type": "reconnect"},
    {"second": 1740, "type": "closing"},
    {"second": 1800, "type": "drain"}
