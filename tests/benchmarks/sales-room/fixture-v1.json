  "speech_detection_scenarios": [
    {"duty_cycle_percent": 10, "seed": 1010, "features": ["quiet_speech", "short_words", "overlap", "background_noise", "output_echo"]},
    {"duty_cycle_percent": 30, "seed": 1030, "features": ["quiet_speech", "short_words", "overlap", "background_noise", "output_echo"]},
    {"duty_cycle_percent": 60, "seed": 1060, "features": ["quiet_speech", "short_words", "overlap", "background_noise", "output_echo"]}
  ],
  "utterances": {
    "en": ["Yes.", "No.", "Alex, what is the supported rollout sequence?", "Please stop; we need to discuss security."],
    "sv": ["Ja.", "Nej.", "Alex, vilken lanseringsordning stöds?", "Vänta, vi behöver diskutera säkerhet."]
  },
  "quality": {
