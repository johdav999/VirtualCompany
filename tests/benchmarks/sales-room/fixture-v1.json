    "latency_targets_ms": {"join": 5000, "takeover_to_silence": 300, "answer_start": 3000, "slide_sync": 500}
  },
  "audio": {
    "format": "pcm_s16le",
    "sample_rate_hz": 24000,
    "frame_ms": 20,
    "generation": "The production-path driver generates deterministic synthetic speech/noise from this manifest and records exact asset SHA-256 hashes before a live run. Agent output echo must stay on an excluded agent track."
  }
