{
  "schema_version": "1.0",
  "name": "browser-sales-room-30-minute",
  "duration_seconds": 1800,
  "category_seconds": {
    "approved_presentation": 1080,
    "human_discussion": 360,
    "live_answers": 180,
    "host_activity_and_pauses": 180
